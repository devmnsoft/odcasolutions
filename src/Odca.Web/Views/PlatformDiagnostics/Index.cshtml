@model Odca.Contracts.Administration.PlatformDiagnosticsPayload
@{
    var _c = (string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey];
    ViewData["Title"] = L.T("platform.diag_title", _c);
    var labels = new Dictionary<string, string>
    {
        ["pdf.renderer"] = L.T("platform.diag_dep_pdf_renderer", _c),
        ["documents.pdf-text"] = L.T("platform.diag_dep_pdf_text", _c),
        ["documents.pdf-render"] = L.T("platform.diag_dep_pdf_render", _c),
        ["documents.ocr"] = L.T("platform.diag_dep_ocr", _c),
        ["documents.pdf-info"] = L.T("platform.diag_dep_pdf_info", _c),
        ["security.scanner"] = L.T("platform.diag_dep_malware", _c),
        ["notifications.transport"] = L.T("platform.diag_dep_notif", _c),
        ["signatures.external-envelope"] = L.T("platform.diag_dep_signatures", _c)
    };
    string Label(string key) => labels.TryGetValue(key, out var label) ? label : key;
    string StatusBadge(string status) => status switch
    {
        "verified" => "badge-success",
        "accessible" => "badge-info",
        "configured" => "badge-warning",
        "unavailable" => "badge-danger",
        _ => "badge-muted"
    };
    string StatusLabel(string status) => status switch
    {
        "verified" => L.T("platform.diag_st_verified", _c),
        "accessible" => L.T("platform.diag_st_accessible", _c),
        "configured" => L.T("platform.diag_st_configured", _c),
        "unavailable" => L.T("platform.diag_st_unavailable", _c),
        "not_applicable" => L.T("common.na", _c),
        _ => status
    };
}
<section class="page-heading">
    <div>
        <p class="eyebrow">@L.T("layout.platform",_c)</p>
        <h1>@L.T("platform.diag_title",_c)</h1>
        <p class="muted">
            @L.T("platform.diag_intro",_c)
        </p>
    </div>
    <div class="button-row">
        <a class="button button-quiet" asp-controller="Home" asp-action="Index">@L.T("platform.diag_back",_c)</a>
    </div>
</section>
<details class="help-card"><summary>@L.T("common.how_to_use",_c)</summary><ol><li>@L.T("platform.diag_manual_1",_c)</li><li>@L.T("platform.diag_manual_2",_c)</li><li>@L.T("platform.diag_manual_3",_c)</li></ol></details>
<div class="panel responsive-table">
    <table>
        <thead>
            <tr><th>@L.T("platform.diag_th_dependency",_c)</th><th>@L.T("platform.diag_th_config",_c)</th><th>@L.T("common.state",_c)</th><th>@L.T("platform.diag_th_probe",_c)</th></tr>
        </thead>
        <tbody>
            @foreach (var d in Model.Dependencies)
            {
                <tr>
                    <td data-label="@L.T("platform.diag_th_dependency",_c)"><strong>@Label(d.Key)</strong></td>
                    <td data-label="@L.T("platform.diag_th_config",_c)"><code>@d.ConfigKey</code></td>
                    <td data-label="@L.T("common.state",_c)"><span class="badge @(StatusBadge(d.Status))">@StatusLabel(d.Status)</span></td>
                    <td data-label="@L.T("platform.diag_th_probe",_c)">@d.Detail</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<h2>@L.T("platform.diag_queues_h",_c)</h2>
<p class="muted">@L.T("platform.diag_queues_intro",_c)</p>
<div class="panel responsive-table">
    <table>
        <thead>
            <tr><th>@L.T("platform.diag_q_queue",_c)</th><th>@L.T("platform.diag_q_pending",_c)</th><th>@L.T("platform.diag_q_stalled",_c)</th><th>@L.T("platform.diag_q_failed",_c)</th><th>@L.T("platform.diag_q_oldest",_c)</th></tr>
        </thead>
        <tbody>
            @foreach (var q in Model.Queues)
            {
                <tr>
                    <td data-label="@L.T("platform.diag_q_queue",_c)">@q.Queue</td>
                    <td data-label="@L.T("platform.diag_q_pending",_c)">@q.PendingCount</td>
                    <td data-label="@L.T("platform.diag_q_stalled",_c)">@q.StalledCount</td>
                    <td data-label="@L.T("platform.diag_q_failed",_c)">@q.FailedCount</td>
                    <td data-label="@L.T("platform.diag_q_oldest",_c)">@(q.OldestPendingAt is { } oldest ? CulturedTime.DateTime(oldest.ToLocalTime(), _c) : "—")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
