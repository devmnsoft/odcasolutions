@model Odca.Web.Models.RenewalWorkspaceViewModel
@{
  ViewData["Title"]=L.T("ren.title",(string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey]);
  var _c=(string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey];
  var tenantId=ViewData["TenantId"];
  var q=Context.Request.Query;
  System.Func<string,string>StLabel=s=>s switch{
    "expiring"=>L.T("ren.st_expiring",_c),"expired"=>L.T("ren.st_expired",_c),"indeterminate"=>L.T("ren.st_indeterminate",_c),"outside_window"=>L.T("ren.st_outside_window",_c),
    "draft"=>L.T("ren.st_draft",_c),"in_review"=>L.T("common.status_in_review",_c),"internally_approved"=>L.T("common.status_internally_approved",_c),"awaiting_formalization"=>L.T("ren.st_awaiting_formalization",_c),
    "formalized"=>L.T("ren.st_formalized",_c),"cancelled"=>L.T("ren.st_not_renewing",_c),"conflict"=>L.T("ren.st_conflict",_c),_=>s.Replace('_',' ')};
  System.Func<string?,string?>PrioLabel=p=>p switch{"low"=>L.T("common.prio_low",_c),"normal"=>L.T("common.prio_normal",_c),"high"=>L.T("common.prio_high",_c),"critical"=>L.T("common.prio_critical",_c),_=>null};
  System.Func<string?,string?>PrioClass=p=>p switch{"low"=>"prio-low","normal"=>"prio-normal","high"=>"prio-high","critical"=>"prio-critical",_=>null};
  System.Func<int,int,int>Remind=(i,f)=>Model.ReminderDays is not null&&i<Model.ReminderDays.Length?Model.ReminderDays[i]:f;
  System.Func<string?,string?>KindLabel=k=>k switch{"renewal"=>L.T("ren.kind_renewal",_c),"amendment"=>L.T("ren.kind_amendment",_c),"revision"=>L.T("ren.kind_revision",_c),_=>null};
}
<header class="renewal-heading"><div><p class="eyebrow">@L.T("ren.header_eyebrow",_c)</p><h1>@L.T("ren.title",_c)</h1><p class="muted">@L.T("ren.subtitle",_c)</p></div><a class="button button-quiet" href="#como-usar">@L.T("common.how_to_use",_c)</a></header>

<section class="renewal-cards" aria-label="@L.T("ren.cards_aria",_c)">
 <a asp-action="Index" asp-route-tenantId="@tenantId" asp-route-status="expiring"><strong>@Model.Results.Summary.Expiring</strong><span>@L.T("ren.card_expiring",_c)</span></a>
 <a asp-action="Index" asp-route-tenantId="@tenantId" asp-route-status="expired"><strong>@Model.Results.Summary.Expired</strong><span>@L.T("ren.card_expired",_c)</span></a>
 <a asp-action="Index" asp-route-tenantId="@tenantId" asp-route-status="indeterminate"><strong>@Model.Results.Summary.Indeterminate</strong><span>@L.T("ren.st_indeterminate",_c)</span></a>
 <a asp-action="Index" asp-route-tenantId="@tenantId" asp-route-status="draft"><strong>@Model.Results.Summary.Preparing</strong><span>@L.T("ren.st_draft",_c)</span></a>
 <a asp-action="Index" asp-route-tenantId="@tenantId" asp-route-status="in_review"><strong>@Model.Results.Summary.InReview</strong><span>@L.T("common.status_in_review",_c)</span></a>
 <a asp-action="Index" asp-route-tenantId="@tenantId" asp-route-status="formalized"><strong>@Model.Results.Summary.Scheduled</strong><span>@L.T("ren.card_formalized",_c)</span></a>
 <a asp-action="Index" asp-route-tenantId="@tenantId" asp-route-status="cancelled"><strong>@Model.Results.Summary.NotRenewing</strong><span>@L.T("ren.st_not_renewing",_c)</span></a>
</section>

<section class="reminder-config" aria-label="@L.T("ren.reminder_title",_c)">
 <div class="reminder-copy"><h2>@L.T("ren.reminder_title",_c)</h2><p class="muted">@L.T("ren.reminder_copy",_c,Remind(0,30).ToString(),Remind(1,15).ToString(),Remind(2,7).ToString())</p></div>
 @if(Model.CanManageConfig){<form method="post" asp-action="SaveConfig" asp-route-tenantId="@tenantId" class="reminder-form">@Html.AntiForgeryToken()
  <label>@L.T("ren.reminder_day1",_c)<input type="number" name="day1" min="1" max="365" required value="@Remind(0,30)"/></label>
  <label>@L.T("ren.reminder_day2",_c)<input type="number" name="day2" min="1" max="365" required value="@Remind(1,15)"/></label>
  <label>@L.T("ren.reminder_day3",_c)<input type="number" name="day3" min="1" max="365" required value="@Remind(2,7)"/></label>
  <button type="submit" class="button button-primary">@L.T("ren.reminder_save",_c)</button></form>}
 else{<p class="permission-note">@L.T("ren.reminder_readonly",_c)</p>}
</section>

<details class="filter-panel" open><summary>@L.T("common.filters",_c)</summary><div asp-validation-summary="All" class="validation-summary" role="alert"></div><form method="get" class="renewal-filters">
 <label>@L.T("ren.filter_from",_c)<input type="date" name="from" value="@q["from"]"/></label><label>@L.T("ren.filter_to",_c)<input type="date" name="to" value="@q["to"]"/></label>
 <label>@L.T("ren.filter_contract_type",_c)<input name="contractType" value="@q["contractType"]" placeholder="@L.T("ren.filter_contract_type_ph",_c)"/></label><label>@L.T("ren.filter_counterparty",_c)<input name="counterparty" value="@q["counterparty"]"/></label>
 <label>@L.T("common.situation",_c)<select name="status"><option value="">@L.T("common.all",_c)</option><option value="expiring">@L.T("ren.st_expiring",_c)</option><option value="expired">@L.T("ren.st_expired",_c)</option><option value="indeterminate">@L.T("ren.st_indeterminate",_c)</option><option value="draft">@L.T("ren.st_draft",_c)</option><option value="in_review">@L.T("common.status_in_review",_c)</option><option value="formalized">@L.T("ren.st_formalized",_c)</option><option value="cancelled">@L.T("ren.st_not_renewing",_c)</option></select></label>
 <label>@L.T("common.priority",_c)<select name="priority"><option value="">@L.T("common.all",_c)</option><option value="low">@L.T("common.prio_low",_c)</option><option value="normal">@L.T("common.prio_normal",_c)</option><option value="high">@L.T("common.prio_high",_c)</option><option value="critical">@L.T("common.prio_critical",_c)</option></select></label>
 <label class="check-line"><input type="checkbox" name="mine" value="true" checked="@(q["mine"]=="true")"/> @L.T("ren.filter_mine",_c)</label><label class="check-line"><input type="checkbox" name="withoutOwner" value="true" checked="@(q["withoutOwner"]=="true")"/> @L.T("ren.filter_without_owner",_c)</label><button class="button button-primary">@L.T("common.apply",_c)</button>
</form></details>

<section class="renewal-list" aria-live="polite"><div class="list-header"><h2>@L.T("ren.list_title",_c)</h2><span>@L.T("ren.total_count",_c,Model.Results.Total.ToString())</span></div>
@if(Model.Results.Items.Count==0){<div class="empty-state"><strong>@L.T("ren.empty_title",_c)</strong><p>@L.T("ren.empty_body",_c)</p></div>}
else foreach(var item in Model.Results.Items){var urgent=item.DaysRemaining is <=30;<article class="renewal-row @(urgent?"urgent":null)"><div><span class="status-label">@(urgent?L.T("ren.urgent_prefix",_c):"")@StLabel(item.Status)</span> @if(item.Kind is not null){<span class="status-label kind-tag">@KindLabel(item.Kind)</span>} <h3>@item.Name</h3><p>@(item.Counterparty??L.T("ren.counterparty_unknown",_c)) · @(item.OwnerName??L.T("ren.filter_without_owner",_c))</p>@if(item.Priority is not null){<span class="prio-badge @PrioClass(item.Priority)">@L.T("common.priority",_c): @PrioLabel(item.Priority)</span>}</div><dl><div><dt>@L.T("ren.end_date",_c)</dt><dd>@(item.EndDate.HasValue?CulturedTime.Date(item.EndDate.Value,_c):L.T("ren.st_indeterminate",_c))</dd></div><div><dt>@L.T("ren.decide_by",_c)</dt><dd>@(item.DecisionDueOn.HasValue?CulturedTime.Date(item.DecisionDueOn.Value,_c):L.T("common.not_defined",_c))</dd></div><div><dt>@L.T("common.due_date",_c)</dt><dd>@(item.DaysRemaining.HasValue?L.T("ren.days_remaining",_c,item.DaysRemaining.Value.ToString()):L.T("common.na",_c))</dd></div></dl><div class="next-action"><span>@L.T("common.next_action",_c)</span><strong>@item.NextAction</strong><div class="form-actions-row">@if(item.RequestId.HasValue){<a class="button button-quiet" asp-action="Detail" asp-route-tenantId="@tenantId" asp-route-id="@item.RequestId.Value">@L.T("ren.open_detail",_c)</a>}<a class="button button-quiet" asp-controller="Contracts" asp-action="Sheet" asp-route-tenantId="@tenantId" asp-route-contractId="@item.ContractId">@L.T("ren.view_sheet",_c)</a>@if(item.RequestId.HasValue && item.Status == "formalized"){<form id="apply-form-@item.RequestId.Value" method="post" asp-action="Apply" asp-route-tenantId="@tenantId" asp-route-requestId="@item.RequestId.Value" style="display:inline;">@Html.AntiForgeryToken()<input type="hidden" name="rowVersion" value="@item.ContractVersion"/><button type="button" class="button button-primary" data-confirm-open data-confirm-form="apply-form-@item.RequestId.Value" data-confirm-title="@L.T("ren.apply_confirm_title",_c)" data-confirm-body="@L.T("ren.apply_confirm_body",_c)" data-confirm-action="@L.T("ren.apply_button",_c)">@L.T("ren.apply_button",_c)</button></form>}</div></div></article>}
</section>
<nav class="pagination" aria-label="@L.T("common.pagination_aria",_c)">@if(Model.Results.Page>1){<a asp-all-route-data="@(q.ToDictionary(x=>x.Key,x=>x.Value.ToString()))" asp-route-page="@(Model.Results.Page-1)">@L.T("common.prev",_c)</a>}<span>@L.T("common.page_number",_c,Model.Results.Page.ToString())</span>@if(Model.Results.Page*Model.Results.PageSize<Model.Results.Total){<a asp-all-route-data="@(q.ToDictionary(x=>x.Key,x=>x.Value.ToString()))" asp-route-page="@(Model.Results.Page+1)">@L.T("common.next",_c)</a>}</nav>
<aside id="como-usar" class="help-card"><h2>@L.T("common.how_to_use",_c)</h2><ol><li>@L.T("ren.how_1",_c)</li><li>@L.T("ren.how_2",_c)</li><li>@L.T("ren.how_3",_c)</li><li>@L.T("ren.how_4",_c)</li><li>@L.T("ren.how_5",_c)</li></ol><p><strong>@L.T("ren.how_note_prefix",_c)</strong> @L.T("ren.how_note",_c)</p></aside>
