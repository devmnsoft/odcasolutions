@model Odca.Contracts.Reviews.ReviewQueuePage
@{var tenantId=(Guid)ViewData["TenantId"]!;var status=ViewData["Status"] as string;var mine=(bool)(ViewData["Mine"]??true);}
<nav class="breadcrumb"><a asp-controller="Onboarding" asp-action="CustomerHome">Visão geral</a><span>/</span><span>Solicitações</span></nav>
<header class="page-heading"><div><p class="eyebrow">Consultoria</p><h1>Solicitações de revisão</h1><p>Acompanhe o atendimento e as pendências ligadas às versões enviadas.</p></div></header>
<section class="help-card" aria-labelledby="review-help"><h2 id="review-help">Como usar</h2><p>Use os filtros para localizar uma revisão. Abra o detalhe para conversar com a consultoria. Uma conclusão do atendimento não substitui a aprovação formal do contrato.</p></section>
<form method="get" class="filter-bar"><label>Situação<select name="status"><option value="">Todas</option>@foreach(var option in new[]{("in_review","Em revisão"),("changes_requested","Ajustes solicitados"),("internally_approved","Aprovada"),("cancelled","Cancelada")}){<option value="@option.Item1" selected="@(status==option.Item1)">@option.Item2</option>}</select></label><label>Escopo<select name="mine"><option value="true" selected="@mine">Relacionadas a mim</option><option value="false" selected="@(!mine)">Fila da organização (gestores)</option></select></label><button class="button button-primary" type="submit">Filtrar</button></form>
@if(ViewData["LoadError"] is string error){<div class="alert alert-error" role="alert"><strong>Falha de carregamento.</strong> @error <a asp-route-tenantId="@tenantId">Tentar novamente</a></div>}
else if(Model.Items.Count==0){<div class="empty-state"><h2>Nenhuma solicitação encontrada</h2><p>Envie uma versão pela ficha do contrato ou altere os filtros.</p></div>}
else{<div class="table-scroll"><table><thead><tr><th>Contrato</th><th>Situação</th><th>Responsável</th><th>Atualização</th><th>Ação</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td><strong>@item.Contract</strong><small>Solicitante: @item.Requester</small></td><td><span class="badge">@item.Status</span></td><td>@(item.Assignee??"Aguardando atribuição")</td><td>@item.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</td><td><a class="button button-quiet" asp-action="Detail" asp-route-tenantId="@tenantId" asp-route-reviewId="@item.Id">Ver detalhes</a></td></tr>}</tbody></table></div>}
