@model Odca.Contracts.Reviews.ReviewQueuePage
@{
    var _c=(string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey];
    ViewData["Title"]=L.T("rev.title",_c);
    var tenantId=(Guid)ViewData["TenantId"]!; var status=ViewData["Status"] as string;
    var scope=ViewData["Scope"] as string ?? "requested"; var from=ViewData["From"] as DateOnly?; var to=ViewData["To"] as DateOnly?;
    var search=ViewData["Search"] as string; var assignees=ViewData["Assignees"] as Odca.Contracts.Reviews.ReviewAssignee[] ?? [];
    string StatusLabel(string value) => value switch { "in_review"=>L.T("common.status_in_review",_c), "changes_requested"=>L.T("rev.st_changes_requested",_c), "internally_approved"=>L.T("common.status_internally_approved",_c), "cancelled"=>L.T("rev.st_cancelled",_c), "superseded"=>L.T("rev.st_superseded",_c), _=>value };
    string NextAction(string value) => value switch { "in_review"=>L.T("rev.na_in_review",_c), "changes_requested"=>L.T("rev.na_changes_requested",_c), "internally_approved"=>L.T("rev.na_internally_approved",_c), _=>L.T("rev.na_default",_c) };
}
<nav class="breadcrumb" aria-label="@L.T("common.breadcrumb_aria",_c)"><a asp-controller="Onboarding" asp-action="CustomerHome">@L.T("common.overview",_c)</a><span>/</span><span aria-current="page">@L.T("rev.title_short",_c)</span></nav>
<header class="page-heading"><div><p class="eyebrow">@L.T("rev.eyebrow",_c)</p><h1>@L.T("rev.title",_c)</h1><p>@L.T("rev.subtitle",_c)</p></div></header>
<section class="help-card" aria-labelledby="review-help"><h2 id="review-help">@L.T("common.how_to_use",_c)</h2><p>@L.T("rev.help_before",_c) <strong>@L.T("rev.help_opened_bold",_c)</strong>@L.T("rev.help_after",_c)</p></section>
<form method="get" class="review-filters" aria-label="@L.T("rev.filters_aria",_c)">
 <label>@L.T("common.situation",_c)<select name="status"><option value="">@L.T("common.all",_c)</option>@foreach(var option in new[]{("in_review",L.T("common.status_in_review",_c)),("changes_requested",L.T("rev.st_changes_requested",_c)),("internally_approved",L.T("common.status_internally_approved",_c)),("cancelled",L.T("rev.st_cancelled",_c))}){<option value="@option.Item1" selected="@(status==option.Item1)">@option.Item2</option>}</select></label>
 <label>@L.T("inbox.scope",_c)<select name="scope"><option value="requested" selected="@(scope=="requested")">@L.T("rev.scope_requested",_c)</option><option value="assigned" selected="@(scope=="assigned")">@L.T("rev.scope_assigned",_c)</option><option value="all" selected="@(scope=="all")">@L.T("rev.scope_all",_c)</option></select></label>
 <label>@L.T("common.responsible",_c)<select name="assigneeId"><option value="">@L.T("common.everyone",_c)</option>@foreach(var person in assignees){<option value="@person.Id" selected="@(ViewData["AssigneeId"] as Guid? == person.Id)">@person.Name — @person.Profile</option>}</select></label>
 <label>@L.T("rev.search_contract",_c)<input name="search" type="search" value="@search" maxlength="200" placeholder="@L.T("rev.search_ph",_c)" /></label>
 <label>@L.T("rev.from_label",_c)<input name="from" type="date" value="@from?.ToString("yyyy-MM-dd")" /></label>
 <label>@L.T("rev.to_label",_c)<input name="to" type="date" value="@to?.ToString("yyyy-MM-dd")" /></label>
 <button class="button button-primary" type="submit">@L.T("common.apply_filters",_c)</button>
</form>
<p class="result-count" aria-live="polite"><strong>@Model.Total</strong> @L.T("rev.count_suffix",_c)</p>
@if(ViewData["LoadError"] is string error){<div class="alert alert-error" role="alert"><strong>@L.T("rev.load_error_title",_c)</strong> @error <a asp-route-tenantId="@tenantId">@L.T("common.retry",_c)</a></div>}
else if(Model.Items.Count==0){<div class="empty-state"><h2>@L.T("rev.empty_title",_c)</h2><p>@L.T("rev.empty_body",_c)</p></div>}
else
{
 <div class="table-scroll"><table><thead><tr><th>@L.T("rev.th_contract",_c)</th><th>@L.T("common.situation",_c)</th><th>@L.T("common.responsible",_c)</th><th>@L.T("rev.th_opened_due",_c)</th><th>@L.T("rev.th_updated",_c)</th><th>@L.T("common.next_action",_c)</th></tr></thead><tbody>
 @foreach(var item in Model.Items){<tr><td data-label="@L.T("common.contract",_c)"><strong>@item.Contract</strong><small>@item.Requester</small></td><td data-label="@L.T("common.situation",_c)"><span class="status-badge status-@item.Status">@StatusLabel(item.Status)</span></td><td data-label="@L.T("common.responsible",_c)">@(item.Assignee??L.T("rev.unassigned",_c))</td><td data-label="@L.T("rev.th_opened_due",_c)">@CulturedTime.Date(item.OpenedAt,_c)<small>@(item.DueAt is null?L.T("rev.no_due",_c):L.T("rev.due_prefix",_c,CulturedTime.Date(item.DueAt.Value,_c)))</small></td><td data-label="@L.T("rev.th_updated",_c)">@CulturedTime.DateTime(item.UpdatedAt,_c)</td><td data-label="@L.T("common.next_action",_c)"><span>@NextAction(item.Status)</span><a class="button button-quiet" asp-action="Detail" asp-route-tenantId="@tenantId" asp-route-reviewId="@item.Id">@L.T("rev.open_button",_c)</a></td></tr>}
 </tbody></table></div>
 @if(Model.Page>1 || Model.Page*Model.PageSize<Model.Total){<nav class="pagination" aria-label="@L.T("common.pagination_aria",_c)">@if(Model.Page>1){<a class="button button-quiet" asp-route-tenantId="@tenantId" asp-route-status="@status" asp-route-scope="@scope" asp-route-assigneeId="@ViewData["AssigneeId"]" asp-route-from="@from" asp-route-to="@to" asp-route-search="@search" asp-route-page="@(Model.Page-1)">@L.T("common.prev",_c)</a>}<span>@L.T("common.page_number",_c,Model.Page.ToString())</span>@if(Model.Page*Model.PageSize<Model.Total){<a class="button button-quiet" asp-route-tenantId="@tenantId" asp-route-status="@status" asp-route-scope="@scope" asp-route-assigneeId="@ViewData["AssigneeId"]" asp-route-from="@from" asp-route-to="@to" asp-route-search="@search" asp-route-page="@(Model.Page+1)">@L.T("common.next",_c)</a>}</nav>}
}
