@model Odca.Contracts.Reviews.ReviewDetail
@{var tenantId=(Guid)ViewData["TenantId"]!;}
<nav class="breadcrumb"><a asp-action="Index" asp-route-tenantId="@tenantId">Solicitações</a><span>/</span><span>@Model.Contract</span></nav>
<header class="page-heading"><div><p class="eyebrow">Atendimento contratual</p><h1>@Model.Contract</h1><p>Solicitada por @Model.Requester em @Model.OpenedAt.ToString("dd/MM/yyyy").</p></div><span class="badge">@Model.Status</span></header>
<section class="summary-grid"><article><span>Responsável</span><strong>@(Model.Assignee??"Aguardando atribuição")</strong></article><article><span>Próxima ação</span><strong>@(Model.Status=="changes_requested"?"Cliente deve responder aos ajustes":Model.Status=="in_review"?"Consultoria está analisando":"Consultar histórico")</strong></article><article><span>Versão da fila</span><strong>@Model.Version</strong></article></section>
@if(TempData["ReviewNotice"] is string notice){<div class="alert alert-success" role="status">@notice</div>}@if(TempData["ReviewError"] is string error){<div class="alert alert-error" role="alert">@error</div>}
<div class="workspace-grid"><section><h2>Mensagens e notas</h2>@if(Model.Messages.Count==0){<div class="empty-state"><p>Ainda não há mensagens visíveis.</p></div>}else{@foreach(var message in Model.Messages){<article class="comment-card @(message.Visibility=="internal"?"internal-note":null)"><header><strong>@message.Author</strong><span>@(message.Visibility=="internal"?"Nota interna — invisível ao cliente":"Mensagem ao cliente")</span></header><p>@message.Body</p><small>@message.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small></article>}}
<form method="post" asp-action="AddMessage" asp-route-tenantId="@tenantId" asp-route-reviewId="@Model.Id" data-prevent-double-submit><label for="body">Mensagem <span aria-hidden="true">*</span></label><textarea id="body" name="body" required maxlength="4000"></textarea><fieldset><legend>Visibilidade <span aria-hidden="true">*</span></legend><label><input type="radio" name="visibility" value="client" checked/> Visível ao cliente</label><label><input type="radio" name="visibility" value="internal"/> Nota interna da consultoria</label></fieldset><button class="button button-primary" type="submit">Enviar mensagem</button></form></section>
<aside><h2>Histórico</h2><ol class="timeline">@foreach(var item in Model.History){<li><strong>@item.Type</strong><span>@item.Actor · @item.OccurredAt.ToString("dd/MM/yyyy HH:mm")</span></li>}</ol><h2>Como usar</h2><p>Mensagens ao cliente são compartilhadas. Notas internas ficam disponíveis somente a usuários autorizados da consultoria.</p></aside></div>
@if(Model.Status=="in_review")
{
<section class="help-card" aria-labelledby="review-decision-title">
 <h2 id="review-decision-title">Decisão da versão em análise</h2>
 <p>A aprovação é interna e não comprova assinatura. Para aditivos, a formalização documental continuará pendente.</p>
 <form method="post" asp-action="Decide" asp-route-tenantId="@tenantId" asp-route-reviewId="@Model.Id" data-prevent-double-submit>
  <input type="hidden" name="expectedVersion" value="@Model.Version" />
  <label for="justification">Justificativa da decisão <span aria-hidden="true">*</span></label>
  <textarea id="justification" name="justification" required maxlength="2000"></textarea>
  <div class="form-actions-row">
   <button class="button button-quiet" type="submit" name="action" value="request_changes">Solicitar ajustes</button>
   <button class="button button-primary" type="submit" name="action" value="approve">Aprovar versão</button>
  </div>
 </form>
</section>
}
