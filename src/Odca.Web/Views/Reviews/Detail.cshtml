@model Odca.Contracts.Reviews.ReviewDetail
@{var _c=(string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey];ViewData["Title"]=L.T("rev.detail_title",_c);var tenantId=(Guid)ViewData["TenantId"]!;var assignees=ViewData["Assignees"] as Odca.Contracts.Reviews.ReviewAssignee[] ?? [];var canDecide=ViewData["CanDecide"] as bool?==true;var canCancel=ViewData["CanCancel"] as bool?==true;string StatusLabel(string value) => value switch { "in_review"=>L.T("common.status_in_review",_c), "changes_requested"=>L.T("rev.st_changes_requested",_c), "internally_approved"=>L.T("common.status_internally_approved",_c), "cancelled"=>L.T("rev.st_cancelled",_c), "superseded"=>L.T("rev.st_superseded",_c), _=>value };}
<nav class="breadcrumb"><a asp-action="Index" asp-route-tenantId="@tenantId">@L.T("rev.title_short",_c)</a><span>/</span><span>@Model.Contract</span></nav>
<header class="page-heading"><div><p class="eyebrow">@L.T("rev.detail_eyebrow",_c)</p><h1>@Model.Contract</h1><p>@L.T("rev.opened_by",_c,Model.Requester,CulturedTime.Date(Model.OpenedAt,_c))</p></div><span class="status-badge status-@Model.Status">@StatusLabel(Model.Status)</span></header>
<section class="summary-grid" aria-label="@L.T("rev.summary_aria",_c)"><article><span>@L.T("common.responsible",_c)</span><strong>@(Model.Assignee??L.T("rev.waiting_assignment",_c))</strong></article><article><span>@L.T("common.next_action",_c)</span><strong>@(Model.Status=="changes_requested"?L.T("rev.na2_changes",_c):Model.Status=="in_review"?L.T("rev.na2_analyze",_c):Model.Status=="cancelled"?L.T("rev.na2_cancelled",_c):L.T("rev.na_default",_c))</strong></article><article><span>@L.T("rev.version_under_review",_c)</span><strong>@(Model.DocumentVersionNumber is int number ? L.T("rev.version_number",_c,number.ToString()) : L.T("rev.version_linked",_c))</strong><small>@L.T("rev.version_scope_note",_c)</small></article></section>
@if(Model.GeneratedVersionId is Guid generatedVersionId){<div class="form-actions-row"><a class="button button-quiet" asp-controller="Studio" asp-action="Version" asp-route-tenantId="@tenantId" asp-route-versionId="@generatedVersionId">@L.T("rev.view_version",_c)</a>@if(Model.Status=="changes_requested"){<a class="button button-primary" asp-controller="Studio" asp-action="Version" asp-route-tenantId="@tenantId" asp-route-versionId="@generatedVersionId">@L.T("rev.continue_studio",_c)</a>}</div>}
@if(TempData["ReviewNotice"] is string notice){<div class="alert alert-success" role="status">@notice</div>}@if(TempData["ReviewError"] is string error){<div class="alert alert-error" role="alert">@error</div>}
@if(Model.Status=="internally_approved")
{
<section class="help-card" aria-labelledby="approved-next-step">
 <h2 id="approved-next-step">@L.T("rev.next_step_title",_c)</h2>
 <p>@L.T("rev.next_step_body",_c)</p>
 <div class="form-actions-row">
  <a class="button button-primary" asp-controller="Contracts" asp-action="Sheet" asp-route-tenantId="@tenantId" asp-route-contractId="@Model.ContractId" asp-fragment="obrigacoes">@L.T("rev.next_step_obligations",_c)</a>
  <a class="button button-quiet" asp-controller="Obligations" asp-action="Index" asp-route-tenantId="@tenantId" asp-route-contractId="@Model.ContractId">@L.T("rev.next_step_track",_c)</a>
 </div>
</section>
}
<div class="workspace-grid"><section><h2>@L.T("rev.messages_title",_c)</h2>@if(Model.Messages.Count==0){<div class="empty-state"><p>@L.T("rev.messages_empty",_c)</p></div>}else{@foreach(var message in Model.Messages){<article class="comment-card @(message.Visibility=="internal"?"internal-note":null)"><header><strong>@message.Author</strong><span>@(message.Visibility=="internal"?L.T("rev.note_internal",_c):L.T("rev.note_client",_c))</span></header><p>@message.Body</p><small>@CulturedTime.DateTime(message.CreatedAt,_c)</small></article>}}
<form method="post" asp-action="AddMessage" asp-route-tenantId="@tenantId" asp-route-reviewId="@Model.Id" data-prevent-double-submit>@Html.AntiForgeryToken()<label for="body">@L.T("rev.message_label",_c) <span aria-hidden="true">*</span></label><textarea id="body" name="body" required maxlength="4000">@TempData["ReviewBody"]</textarea><fieldset><legend>@L.T("rev.visibility_legend",_c) <span aria-hidden="true">*</span></legend><label><input type="radio" name="visibility" value="client" checked="@(TempData["ReviewVisibility"] as string != "internal")"/> @L.T("rev.vis_client",_c)</label><label><input type="radio" name="visibility" value="internal" checked="@(TempData["ReviewVisibility"] as string == "internal")"/> @L.T("rev.vis_internal",_c)</label></fieldset><button class="button button-primary" type="submit">@L.T("rev.send_message",_c)</button></form></section>
<aside><h2>@L.T("common.history",_c)</h2><ol class="timeline">@foreach(var item in Model.History){<li><strong>@item.Type</strong><span>@item.Actor · @CulturedTime.DateTime(item.OccurredAt,_c)</span></li>}</ol><h2>@L.T("common.how_to_use",_c)</h2><p>@L.T("rev.how_body",_c)</p></aside></div>
@if(canDecide && Model.Status=="in_review" && assignees.Length>0)
{
<section class="help-card" aria-labelledby="review-assignment-title">
 <h2 id="review-assignment-title">@L.T("rev.assign_title",_c)</h2>
 <p>@L.T("rev.assign_body",_c)</p>
 @if(TempData["ReviewAssignmentConflict"] as bool? == true){<div class="alert alert-error" role="alert">@L.T("rev.assign_conflict",_c)</div>}
 <form method="post" asp-action="Reassign" asp-route-tenantId="@tenantId" asp-route-reviewId="@Model.Id" data-prevent-double-submit>
  @Html.AntiForgeryToken()
  <input type="hidden" name="expectedVersion" value="@Model.Version" />
  <label for="assigneeId">@L.T("rev.assign_new",_c) <span aria-hidden="true">*</span></label>
  <select id="assigneeId" name="assigneeId" required><option value="">@L.T("common.select",_c)</option>@foreach(var person in assignees){<option value="@person.Id">@person.Name — @person.Profile</option>}</select>
  <label for="assignmentReason">@L.T("common.justification",_c) <span aria-hidden="true">*</span></label>
  <textarea id="assignmentReason" name="reason" required maxlength="2000">@TempData["ReviewAssignmentReason"]</textarea>
  <button class="button button-quiet" type="submit">@L.T("rev.assign_confirm",_c)</button>
 </form>
</section>
}
@if(canDecide && Model.Status=="in_review")
{
<section class="help-card" aria-labelledby="review-decision-title">
 <h2 id="review-decision-title">@L.T("rev.decision_title",_c)</h2>
 <p>@L.T("rev.decision_body",_c)</p>
 @if(TempData["ReviewConflict"] as bool? == true){<div class="alert alert-error" role="alert">@L.T("rev.decision_conflict",_c) <a asp-action="Detail" asp-route-tenantId="@tenantId" asp-route-reviewId="@Model.Id">@L.T("rev.decision_conflict_link",_c)</a>.</div>}
 <form method="post" asp-action="Decide" asp-route-tenantId="@tenantId" asp-route-reviewId="@Model.Id" data-prevent-double-submit>
  @Html.AntiForgeryToken()
  <input type="hidden" name="expectedVersion" value="@Model.Version" />
  <label for="justification">@L.T("rev.decision_just_label",_c) <span aria-hidden="true">*</span></label>
  <textarea id="justification" name="justification" required maxlength="2000">@TempData["ReviewJustification"]</textarea>
  <div class="form-actions-row">
   <button class="button button-quiet" type="submit" name="action" value="request_changes">@L.T("rev.btn_request_changes",_c)</button>
   <button class="button button-primary" type="submit" name="action" value="approve">@L.T("rev.btn_approve",_c)</button>
  </div>
 </form>
</section>
}
@if(canCancel && Model.Status is "in_review" or "changes_requested")
{
<section class="help-card" aria-labelledby="review-cancel-title">
 <h2 id="review-cancel-title">@L.T("rev.cancel_title",_c)</h2>
 <p>@L.T("rev.cancel_body",_c)</p>
 <form method="post" asp-action="Cancel" asp-route-tenantId="@tenantId" asp-route-reviewId="@Model.Id" data-prevent-double-submit>
  @Html.AntiForgeryToken()
  <input type="hidden" name="expectedVersion" value="@Model.Version" />
  <label for="cancelJustification">@L.T("common.justification",_c) <span aria-hidden="true">*</span></label>
  <textarea id="cancelJustification" name="justification" required maxlength="2000"></textarea>
  <button class="button button-danger" type="submit">@L.T("rev.cancel_title",_c)</button>
 </form>
</section>
}
