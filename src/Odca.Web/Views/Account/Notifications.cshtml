@model Odca.Contracts.Account.NotificationPage
@{
    var _culture=(string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey];
    ViewData["Title"] = L.T("notificacoes",_culture);
    var hasTenant = ViewData["TenantId"] is not null;
    var tenantId = ViewData["TenantId"] as string;
}
<section class="narrow">
    <header class="page-heading"><div><p class="eyebrow">@L.T("minha-conta",_culture)</p><h1>@L.T("notificacoes",_culture)</h1><p>@L.T("notif.subtitle",_culture)</p></div></header>

    <div class="card">
        @if (Model.UnreadCount > 0) { <p><span class="status-badge">@L.T("notif.unread_count",_culture,Model.UnreadCount.ToString(System.Globalization.CultureInfo.InvariantCulture))</span></p> }
        @if (Model.Items.Count == 0)
        {
            <div class="empty-state"><strong>@L.T("notif.empty_title",_culture)</strong><p>@L.T("notif.empty_body",_culture)</p></div>
        }
        else
        {
            @if (hasTenant)
            {
                <form method="post" action="/minha-conta/notificacoes/marcar-lidas" class="form-actions-row" style="margin-bottom:.75rem;" data-prevent-double-submit>
                    @Html.AntiForgeryToken()
                    <button type="submit" class="button button-secondary">@L.T("notif.mark_all_read",_culture)</button>
                </form>
            }
            <ul class="check-list">
                @foreach (var n in Model.Items)
                {
                    <li class="@(n.ReadAt is null ? "notification-unread" : null)">
                        <strong>@n.Title</strong>
                        <br /><span>@n.Body</span>
                        <br />
                        <small>@n.CreatedAtFormatted@(n.ReadAt is null ? "" : " · " + L.T("notif.read_marker",_culture))</small>
                        @if (n.CanOpen && n.TargetType == "obligation" && n.TargetId.HasValue && hasTenant)
                        {
                            <br /><a href="/organizacoes/@tenantId/obrigacoes/@n.TargetId/historico" class="notification-link">@L.T("notif.view_obligation",_culture)</a>
                        }
                        @if (n.ReadAt is null && hasTenant)
                        {
                            <form method="post" action="/minha-conta/notificacoes/@n.Id/ler" style="display:inline;margin-left:.5rem;" data-prevent-double-submit>
                                @Html.AntiForgeryToken()
                                <button type="submit" class="button button-quiet" style="font-size:.8rem;padding:.2rem .5rem;">@L.T("notif.mark_read",_culture)</button>
                            </form>
                        }
                    </li>
                }
            </ul>
        }
    </div>

    @if (hasTenant)
    {
        <div class="card" style="margin-top:1rem;">
            <h3>@L.T("notif.prefs_card_title",_culture)</h3>
            <p>@L.T("notif.prefs_card_body",_culture)</p>
            <a class="button button-secondary" asp-controller="Account" asp-action="NotificationPreferences">@L.T("notif.manage_prefs",_culture)</a>
        </div>
    }

    @if (Model.Total > Model.PageSize)
    {
        <div class="pagination" style="margin-top:1rem;display:flex;gap:.5rem;align-items:center;">
            @if (Model.Page > 1)
            {
                <a class="button button-quiet" asp-controller="Account" asp-action="Notifications" asp-route-page="(Model.Page - 1)" asp-route-pageSize="@Model.PageSize">← @L.T("inbox.prev",_culture)</a>
            }
            <span>@L.T("notif.page_info",_culture,Model.Page.ToString(System.Globalization.CultureInfo.InvariantCulture),((int)Math.Ceiling((double)Model.Total / Model.PageSize)).ToString(System.Globalization.CultureInfo.InvariantCulture),Model.Total.ToString(System.Globalization.CultureInfo.InvariantCulture))</span>
            @if (Model.HasMore)
            {
                <a class="button button-quiet" asp-controller="Account" asp-action="Notifications" asp-route-page="(Model.Page + 1)" asp-route-pageSize="@Model.PageSize">@L.T("inbox.next",_culture) →</a>
            }
        </div>
    }

    <div class="button-row"><a class="button button-quiet" asp-controller="Account" asp-action="Conta">@L.T("notif.back_account",_culture)</a></div>
</section>
