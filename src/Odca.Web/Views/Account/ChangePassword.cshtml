@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Alterar senha";
}
<section class="narrow">
    <div class="card">
        <p class="eyebrow">Primeiro acesso</p>
        <h1>Crie uma senha só sua</h1>
        <p class="muted">Use 12 ou mais caracteres, incluindo maiúscula, minúscula, número e símbolo.</p>
        <form method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="validation" role="alert"></div>
            <label asp-for="CurrentPassword"></label>
            <input asp-for="CurrentPassword" autocomplete="current-password" />
            <span asp-validation-for="CurrentPassword" class="validation"></span>
            <label asp-for="NewPassword"></label>
            <input asp-for="NewPassword" autocomplete="new-password" />
            <span asp-validation-for="NewPassword" class="validation"></span>
            <label asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="validation"></span>
            <button class="button button-primary" type="submit">Salvar nova senha</button>
        </form>
    </div>
</section>
