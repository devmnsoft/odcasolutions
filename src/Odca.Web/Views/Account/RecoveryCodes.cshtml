@model MfaRecoveryCodesViewModel
@{
    var _culture=(string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey];
    ViewData["Title"] = L.T("acct.recovery_title",_culture);
}
<section class="narrow">
    <div class="card">
        <p class="eyebrow">@L.T("acct.recovery_eyebrow",_culture)</p>
        <h1>@L.T("acct.recovery_h",_culture)</h1>
        <p class="muted">@L.T("acct.recovery_sub",_culture)</p>
        <ul class="recovery-codes" aria-label="@L.T("acct.recovery_aria",_culture)">
            @foreach (var code in Model.Codes)
            {
                <li><code>@code</code></li>
            }
        </ul>
        <a class="button button-primary" asp-controller="Home" asp-action="Index">@L.T("acct.btn_continue",_culture)</a>
    </div>
</section>
