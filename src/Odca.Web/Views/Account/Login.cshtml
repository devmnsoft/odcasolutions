@model LoginViewModel
@{
    var _culture=(string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey];
    ViewData["Title"] = L.T("acct.login_title",_culture);
}
<section class="auth-layout">
    <div class="auth-intro">
        <p class="eyebrow">@L.T("acct.login_eyebrow",_culture)</p>
        <h1>@L.T("acct.login_h",_culture)</h1>
        <p>@L.T("acct.login_sub",_culture)</p>
        <p><a asp-controller="Catalog" asp-action="Plans">@L.T("acct.link_plans",_culture)</a></p>
    </div>
    <div class="card auth-card">
        @if (TempData["LogoutWarning"] is string warning)
        {
            <div class="warning" role="status">@warning</div>
        }
        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success" role="status">@success</div>
        }
        <h2>@L.T("acct.login_card_h",_culture)</h2>
        <p class="muted">@L.T("acct.login_card_sub",_culture)</p>
        <details class="help-card"><summary>@L.T("common.how_to_use",_culture)</summary><p>@L.T("acct.login_manual_body",_culture)</p></details>
        <form method="post" novalidate data-processing>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="validation" role="alert"></div>
            <label asp-for="Login"></label>
            <input asp-for="Login" autocomplete="username" autofocus />
            <span asp-validation-for="Login" class="validation"></span>
            <label asp-for="Password"></label>
            <div class="field-with-action">
                <input asp-for="Password" autocomplete="current-password" />
                <button class="field-action" type="button" data-password-toggle data-toggle-show="@L.T("acct.toggle_show",_culture)" data-toggle-hide="@L.T("acct.toggle_hide",_culture)" aria-pressed="false">@L.T("acct.toggle_show",_culture)</button>
            </div>
            <span asp-validation-for="Password" class="validation"></span>
            <button class="button button-primary button-block" type="submit" data-processing-label="@L.T("acct.btn_login_processing",_culture)">@L.T("acct.btn_login",_culture)</button>
        </form>
    </div>
</section>
