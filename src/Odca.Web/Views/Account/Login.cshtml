@model LoginViewModel
@{
    ViewData["Title"] = "Entrar";
}
<section class="auth-layout">
    <div class="auth-intro">
        <p class="eyebrow">Acesso corporativo</p>
        <h1>Seu ambiente de contratos, com acesso controlado.</h1>
        <p>Use sua identidade individual. Organização e permissões são verificadas a cada acesso.</p>
        <p><a asp-controller="Catalog" asp-action="Plans">Conheça os planos publicados</a></p>
    </div>
    <div class="card auth-card">
        @if (TempData["LogoutWarning"] is string warning)
        {
            <div class="warning" role="status">@warning</div>
        }
        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success" role="status">@success</div>
        }
        <h2>Acesse sua conta</h2>
        <p class="muted">Use seu e-mail ou CPF e sua senha pessoal.</p>
        <form method="post" novalidate data-processing>
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="validation" role="alert"></div>
            <label asp-for="Login"></label>
            <input asp-for="Login" autocomplete="username" autofocus />
            <span asp-validation-for="Login" class="validation"></span>
            <label asp-for="Password"></label>
            <div class="field-with-action">
                <input asp-for="Password" autocomplete="current-password" />
                <button class="field-action" type="button" data-password-toggle aria-pressed="false">Mostrar</button>
            </div>
            <span asp-validation-for="Password" class="validation"></span>
            <button class="button button-primary button-block" type="submit" data-processing-label="Entrando…">Entrar</button>
        </form>
    </div>
</section>
