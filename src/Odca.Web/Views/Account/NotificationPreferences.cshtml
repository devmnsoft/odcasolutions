@model Odca.Contracts.Account.NotificationPreferences
@{
    var _culture=(string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey];
    ViewData["Title"] = L.T("notif.prefs_card_title",_culture);
    var idx = 0;
}
<section class="narrow">
    <header class="page-heading"><div><p class="eyebrow">@L.T("minha-conta",_culture)</p><h1>@L.T("notif.prefs_card_title",_culture)</h1><p>@L.T("notif.prefs_subtitle",_culture)</p></div></header>

    <div class="card">
        <form method="post" action="/minha-conta/notificacoes/preferencias" data-prevent-double-submit>
            @Html.AntiForgeryToken()

            <fieldset style="margin-bottom:1.5rem;">
                <legend>@L.T("notif.lang_legend",_culture)</legend>
                <p>@L.T("notif.lang_help",_culture)</p>
                <select name="PreferredLanguage" style="max-width:220px;">
                    <option value="pt-BR" selected="@(Model.PreferredLanguage == "pt-BR" ? "selected" : null)">@L.T("notif.lang.pt-BR",_culture)</option>
                    <option value="en-US" selected="@(Model.PreferredLanguage == "en-US" ? "selected" : null)">@L.T("notif.lang.en-US",_culture)</option>
                    <option value="fr-FR" selected="@(Model.PreferredLanguage == "fr-FR" ? "selected" : null)">@L.T("notif.lang.fr-FR",_culture)</option>
                    <option value="es-ES" selected="@(Model.PreferredLanguage == "es-ES" ? "selected" : null)">@L.T("notif.lang.es-ES",_culture)</option>
                </select>
            </fieldset>

            <fieldset>
                <legend>@L.T("notif.kind_legend",_culture)</legend>
                <table class="data-table" style="width:100%;">
                    <thead>
                        <tr><th>@L.T("notif.th_type",_culture)</th><th>@L.T("notif.th_active",_culture)</th><th>@L.T("notif.th_in_app",_culture)</th><th>@L.T("notif.th_email",_culture)</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var k in Model.Kinds)
                        {
                            <tr>
                                <td>
                                    <input type="hidden" name="Kinds[@idx].Kind" value="@k.Kind" />
                                    @(k.Kind switch
                                    {
                                        "obligation_due" => L.T("notif.kind.obligation_due",_culture),
                                        "renewal_due" => L.T("notif.kind.renewal_due",_culture),
                                        "review_assigned" => L.T("notif.kind.review_assigned",_culture),
                                        "review_decided" => L.T("notif.kind.review_decided",_culture),
                                        "solicitation_opened" => L.T("notif.kind.solicitation_opened",_culture),
                                        "solicitation_updated" => L.T("notif.kind.solicitation_updated",_culture),
                                        "signature_pending" => L.T("notif.kind.signature_pending",_culture),
                                        "signature_completed" => L.T("notif.kind.signature_completed",_culture),
                                        _ => k.Kind
                                    })
                                </td>
                                <td><input type="checkbox" name="Kinds[@idx].Enabled" value="true" @(k.Enabled ? "checked" : "") /></td>
                                <td><input type="checkbox" name="Kinds[@idx].ChannelInApp" value="true" @(k.ChannelInApp ? "checked" : "") /></td>
                                <td><input type="checkbox" name="Kinds[@idx].ChannelEmail" value="true" @(k.ChannelEmail ? "checked" : "") /></td>
                            </tr>
                            idx++;
                        }
                    </tbody>
                </table>
            </fieldset>

            <div class="form-actions-row" style="margin-top:1rem;">
                <button type="submit" class="button">@L.T("notif.save_btn",_culture)</button>
                <a class="button button-quiet" asp-controller="Account" asp-action="Notifications">@L.T("action.cancel",_culture)</a>
            </div>
        </form>
    </div>

    <div class="button-row"><a class="button button-quiet" asp-controller="Account" asp-action="Notifications">@L.T("notif.back_notifications",_culture)</a></div>
</section>
