@model MfaEnrollmentViewModel
@{
    var _culture=(string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey];
    ViewData["Title"] = L.T("acct.enroll_title",_culture);
}
<section class="narrow">
    <div class="card">
        <p class="eyebrow">@L.T("acct.enroll_eyebrow",_culture)</p>
        <h1>@L.T("acct.enroll_h",_culture)</h1>
        <p class="muted">@L.T("acct.enroll_sub",_culture)</p>
        @if (Model.Regenerated)
        {
            <div class="notice" role="status">@L.T("acct.enroll_regen_notice",_culture)</div>
        }
        <dl class="secret-list">
            @if (!string.IsNullOrWhiteSpace(Model.QrDataUri))
            {
                <dt>@L.T("acct.dt_qr",_culture)</dt>
                <dd><img class="qr-code" src="@Model.QrDataUri" alt="@L.T("acct.qr_alt",_culture)" /></dd>
            }
            <dt>@L.T("acct.dt_manual_key",_culture)</dt>
            <dd><code>@Model.ManualKey</code></dd>
            <dt>@L.T("acct.dt_totp_uri",_culture)</dt>
            <dd><code>@Model.OtpAuthUri</code></dd>
        </dl>
        <form method="post" novalidate>
            @Html.AntiForgeryToken()
            <input asp-for="ManualKey" type="hidden" />
            <input asp-for="OtpAuthUri" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="validation" role="alert"></div>
            <label asp-for="Code"></label>
            <input asp-for="Code" inputmode="numeric" autocomplete="one-time-code" autofocus />
            <span asp-validation-for="Code" class="validation"></span>
            <button class="button button-primary" type="submit">@L.T("acct.btn_confirm_mfa",_culture)</button>
        </form>
        <form method="post" action="/mfa/inscricao/regenerar" class="form-alt">
            @Html.AntiForgeryToken()
            <button class="button button-secondary button-small" type="submit">@L.T("acct.btn_gen_new_key",_culture)</button>
        </form>
        <p class="muted help-text">@L.T("acct.enroll_help",_culture)</p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
