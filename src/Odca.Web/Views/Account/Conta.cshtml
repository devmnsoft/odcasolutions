@{
    var _culture=(string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey];
    ViewData["Title"] = L.T("minha-conta",_culture);
    var mfaPending = User.FindFirst("requires_mfa_enrollment")?.Value == "true";
}
<section class="narrow">
    <header class="page-heading"><div><p class="eyebrow">@L.T("minha-conta",_culture)</p><h1>@L.T("acct.conta_h",_culture)</h1><p>@L.T("acct.conta_sub",_culture)</p></div></header>

    <div class="card">
        <h2>@L.T("acct.section_password",_culture)</h2>
        <p class="muted">@L.T("acct.password_sub",_culture)</p>
        <div class="button-row">
            <a class="button button-primary" asp-controller="Account" asp-action="ChangePassword">@L.T("acct.btn_change_pass",_culture)</a>
        </div>
    </div>

    <div class="card">
        <h2>@L.T("acct.section_mfa",_culture)</h2>
        @if (mfaPending)
        {
            <p><span class="status-badge">@L.T("acct.mfa_pending",_culture)</span></p>
            <p class="muted">@L.T("acct.mfa_pending_sub",_culture)</p>
            <div class="button-row">
                <a class="button button-primary" asp-controller="Account" asp-action="MfaEnrollment">@L.T("acct.btn_activate_mfa",_culture)</a>
            </div>
        }
        else
        {
            <p><span class="status-badge">@L.T("acct.mfa_active",_culture)</span></p>
            <p class="muted">@L.T("acct.mfa_active_sub",_culture)</p>
            <form method="post" action="/mfa/inscricao/regenerar" class="form-actions-row" data-prevent-double-submit>
                @Html.AntiForgeryToken()
                <button class="button button-secondary" type="submit">@L.T("acct.btn_regen_keys",_culture)</button>
            </form>
        }
    </div>

    <div class="card">
        <h2>@L.T("acct.section_notif",_culture)</h2>
        <p class="muted">@L.T("acct.notif_sub",_culture)</p>
        <div class="button-row">
            <a class="button button-secondary" asp-controller="Account" asp-action="Notifications">@L.T("acct.btn_view_notif",_culture)</a>
        </div>
    </div>

    <details class="help-card"><summary>@L.T("acct.help_summary",_culture)</summary><p>@L.T("acct.help_body",_culture)</p></details>
</section>
