@model NewDocumentViewModel
@{
    ViewData["Title"] = "Novo documento";
    var tenantId = Model.TenantId;
    var returnUrlForNewPatient = Url.Action("NewDocument", "Documents", new { tenantId, patientSearch = Model.PatientSearch, patientPage = Model.PatientPage });
    var _culture = (string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey];
}

<section class="page-heading">
    <div>
        <p class="eyebrow">Gestão documental</p>
        <h1>Novo documento</h1>
        <p class="muted">Inicie a criação de um documento a partir de um modelo oficial ou rascunho de sua organização.</p>
    </div>
    <div class="button-row">
        <a class="button button-quiet" asp-controller="Documents" asp-action="Index" asp-route-tenantId="@tenantId" asp-route-patientId="@Model.PatientId">
            ← Voltar para Central de Documentos
        </a>
        @if (Model.PatientId is Guid patientId)
        {
            <a class="button button-quiet" asp-controller="Patients" asp-action="Details" asp-route-tenantId="@tenantId" asp-route-patientId="@patientId">Voltar à ficha do paciente</a>
        }
    </div>
</section>

@if (TempData["SuccessMessage"] is string successNotice) { <div class="success" role="status">@successNotice</div> }
@if (TempData["ErrorMessage"] is string errorNotice) { <div class="error" role="alert">@errorNotice</div> }

<ol class="journey" aria-label="Etapas do documento">
    <li class="is-current"><span>1</span> Modelo</li>
    <li class="is-current"><span>2</span> Partes</li>
    <li><span>3</span> Campos</li>
    <li><span>4</span> Conferência</li>
    <li><span>5</span> Revisão e emissão</li>
</ol>
<details class="help" style="margin-bottom: 1.5rem;">
    <summary>Como funciona a criação de documentos</summary>
    <p>
        A elaboração de documentos no ODCA Legal Med segue um fluxo seguro em etapas:
        <strong>1. Origem:</strong> escolha o modelo da biblioteca oficial ou de sua organização a partir do qual a minuta será criada;
        <strong>2. Partes/Paciente:</strong> selecione o paciente correspondente ou continue sem paciente caso seja uma relação B2B entre pessoas jurídicas;
        <strong>3. Modelo:</strong> selecione o modelo de contrato ou termo mais adequado na biblioteca;
        <strong>4. Preenchimento e geração:</strong> revise os dados no estúdio e gere versões auditáveis com hash criptográfico SHA-256.
    </p>
</details>

<div class="form-grid" style="grid-template-columns: 1fr; gap: 1.5rem; margin-bottom: 2rem;">
    @* Card 1: Criar por Modelo *@
    <section class="card" style="display: flex; flex-direction: column; justify-content: space-between; border-top: 4px solid var(--color-primary, #0a2540);">
        <div>
            <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">
                <span class="badge badge-primary">Recomendado</span>
                <span class="badge badge-muted">Etapas 1 e 2</span>
            </div>
            <h2>Elaborar a partir de modelo</h2>
            <p class="muted">
                Utilize modelos estruturados em Legal Design (Prestação de Serviços, Consentimento Informado, Confidencialidade, Locação, etc.) com preenchimento assistido e conferência cadastral.
            </p>

            <form id="patient-search" method="get" asp-action="NewDocument" asp-route-tenantId="@tenantId"></form>
            <form method="get" asp-controller="Studio" asp-action="Index" asp-route-tenantId="@tenantId" style="margin-top: 1.5rem;">
                <input type="hidden" name="tenantId" value="@tenantId" />

                @if (!string.IsNullOrWhiteSpace(Model.PatientErrorMessage))
                {
                    <div class="error" role="alert">@Model.PatientErrorMessage</div>
                }
                <label style="display: block; margin-bottom: 0.75rem; font-weight: 600;">
                    Buscar paciente por nome ou identificador
                    <input name="patientSearch" form="patient-search" value="@Model.PatientSearch" placeholder="Nome ou CPF/CNPJ autorizado" style="width: 100%; margin-top: 0.25rem;" />
                </label>
                <div style="display:flex; gap:0.5rem; align-items:center; margin-bottom: 1rem;">
                    <button class="button button-quiet" type="submit" form="patient-search">Buscar</button>
                    @if (Model.PatientTotal > Model.PatientPageSize)
                    {
                        <span class="muted">Página @Model.PatientPage de @Math.Ceiling((double)Model.PatientTotal / Model.PatientPageSize)</span>
                        @if (Model.PatientPage > 1)
                        {
                            <a class="button button-small button-quiet" asp-action="NewDocument" asp-route-tenantId="@tenantId" asp-route-patientSearch="@Model.PatientSearch" asp-route-patientId="@Model.PatientId" asp-route-patientPage="@(Model.PatientPage - 1)">Anteriores</a>
                        }
                        @if (Model.PatientPage * Model.PatientPageSize < Model.PatientTotal)
                        {
                            <a class="button button-small button-quiet" asp-action="NewDocument" asp-route-tenantId="@tenantId" asp-route-patientSearch="@Model.PatientSearch" asp-route-patientId="@Model.PatientId" asp-route-patientPage="@(Model.PatientPage + 1)">Próximos</a>
                        }
                    }
                </div>
                <label style="display: block; margin-bottom: 1rem; font-weight: 600;">
                    Vincular paciente (opcional para B2B):
                    <select name="patientId" id="patientSelector" style="width: 100%; margin-top: 0.25rem;">
                        <option value="">Nenhum (relação B2B / Contrato sem paciente)</option>
                        @foreach (var patient in Model.Patients)
                        {
                            <option value="@patient.Id" selected="@(Model.PatientId == patient.Id)">
                                @patient.FullName (@(patient.MaskedIdentifier ?? "Sem documento"))
                            </option>
                        }
                    </select>
                </label>

                <p class="muted" style="font-size: 0.875rem; margin-bottom: 1rem;">
                    Não encontrou o paciente?
                    @if (Model.CanManagePatients)
                    {
                        <a asp-controller="Patients" asp-action="Create" asp-route-tenantId="@tenantId" asp-route-returnUrl="@returnUrlForNewPatient" style="font-weight: 600;">
                            + Cadastrar novo paciente agora
                        </a>
                    }
                    else
                    {
                        <span class="muted">Solicite o cadastro a um administrador da organização.</span>
                    }
                </p>

                <button class="button button-primary" type="submit" style="width: 100%; margin-top: 0.5rem;">
                    Avançar para escolha de modelo →
                </button>
            </form>
            @if (Model.CanManagePatients)
            {
                <details class="help" style="margin-top: 1rem;">
                    <summary>@L.T("patient.quick_summary",_culture)</summary>
                    <p class="muted">@L.T("patient.quick_hint",_culture)</p>
                    <form method="post" asp-action="CreatePatientInline" asp-route-tenantId="@tenantId">
                        @Html.AntiForgeryToken()
                        <label>@L.T("patient.full_name",_culture)<input name="fullName" required minlength="2" maxlength="160" /></label>
                        <label>@L.T("patient.quick_doc_label",_culture)<select name="identifierType"><option value="cpf">@L.T("patient.id_cpf",_culture)</option><option value="cnpj">@L.T("patient.id_cnpj",_culture)</option><option value="passport">@L.T("patient.id_passport",_culture)</option><option value="other">@L.T("patient.id_other",_culture)</option></select></label>
                        <label>@L.T("patient.quick_doc_number",_culture)<input name="identifierValue" required minlength="3" maxlength="60" /></label>
                        <label>@L.T("patient.birth_optional",_culture)<input type="date" name="birthDate" max="@DateTime.Now.ToString("yyyy-MM-dd")" /></label>
                        <label>@L.T("patient.rep_optional",_culture)<input name="representativeName" maxlength="160" /></label>
                        <label>@L.T("patient.rep_relation_optional",_culture)<input name="representativeRelation" maxlength="120" /></label>
                        <button class="button button-primary" type="submit">@L.T("patient.quick_submit",_culture)</button>
                    </form>
                </details>
            }
        </div>
    </section>

    @* Card 2: Importar Documento Existente *@
    <section class="card" style="display: flex; flex-direction: column; justify-content: space-between; border-top: 4px solid var(--color-secondary, #475569);">
        <div>
            <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">
                <span class="badge badge-muted">Arquivo Externo</span>
            </div>
            <h2>Importar documento já assinado ou legado</h2>
            <p class="muted">
                Caso já possua um contrato ou termo assinado em papel ou PDF externo, ele poderá ser catalogado na Central de Importações, disponível em uma próxima versão. Enquanto o recurso estiver indisponível, nenhum arquivo é enviado e nenhuma cobrança é registrada.
            </p>
        </div>
        <div style="margin-top: 1.5rem;">
            <span class="muted" style="display: inline-block; width: 100%; text-align: center;">Importação de arquivo externo — disponível em breve</span>
        </div>
    </section>
</div>
