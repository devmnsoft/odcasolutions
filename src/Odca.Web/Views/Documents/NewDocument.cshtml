@model NewDocumentViewModel
@{
    var _culture = (string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey];
    ViewData["Title"] = L.T("documents.new_document", _culture);
    var tenantId = Model.TenantId;
    var returnUrlForNewPatient = Url.Action("NewDocument", "Documents", new { tenantId, patientSearch = Model.PatientSearch, patientPage = Model.PatientPage });
}

<section class="page-heading">
    <div>
        <p class="eyebrow">@L.T("documents.hub_eyebrow", _culture)</p>
        <h1>@L.T("documents.new_document", _culture)</h1>
        <p class="muted">@L.T("documents.new_subtitle", _culture)</p>
    </div>
    <div class="button-row">
        <a class="button button-quiet" asp-controller="Documents" asp-action="Index" asp-route-tenantId="@tenantId" asp-route-patientId="@Model.PatientId">
            @L.T("documents.back_to_hub", _culture)
        </a>
        @if (Model.PatientId is Guid patientId)
        {
            <a class="button button-quiet" asp-controller="Patients" asp-action="Details" asp-route-tenantId="@tenantId" asp-route-patientId="@patientId">@L.T("documents.back_to_patient", _culture)</a>
        }
    </div>
</section>

@if (TempData["SuccessMessage"] is string successNotice) { <div class="success" role="status">@successNotice</div> }
@if (TempData["ErrorMessage"] is string errorNotice) { <div class="error" role="alert">@errorNotice</div> }

<ol class="journey" aria-label="@L.T("documents.journey_aria", _culture)">
    <li class="is-current"><span>1</span> @L.T("documents.step_model", _culture)</li>
    <li class="is-current"><span>2</span> @L.T("documents.step_parts", _culture)</li>
    <li><span>3</span> @L.T("documents.step_fields", _culture)</li>
    <li><span>4</span> @L.T("documents.step_check", _culture)</li>
    <li><span>5</span> @L.T("documents.step_review_issue", _culture)</li>
</ol>
<details class="help" style="margin-bottom: 1.5rem;">
    <summary>@L.T("documents.new_how_title", _culture)</summary>
    <p>
        @L.T("documents.new_how_intro", _culture)
        <strong>1. @L.T("documents.new_how_origin_label", _culture)</strong> @L.T("documents.new_how_origin_body", _culture)
        <strong>2. @L.T("documents.new_how_parts_label", _culture)</strong> @L.T("documents.new_how_parts_body", _culture)
        <strong>3. @L.T("documents.new_how_template_label", _culture)</strong> @L.T("documents.new_how_template_body", _culture)
        <strong>4. @L.T("documents.new_how_generation_label", _culture)</strong> @L.T("documents.new_how_generation_body", _culture)
    </p>
</details>

<div class="form-grid" style="grid-template-columns: 1fr; gap: 1.5rem; margin-bottom: 2rem;">
    @* Card 1: Criar por Modelo *@
    <section class="card" style="display: flex; flex-direction: column; justify-content: space-between; border-top: 4px solid var(--color-primary, #0a2540);">
        <div>
            <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">
                <span class="badge badge-primary">@L.T("documents.recommended", _culture)</span>
                <span class="badge badge-muted">@L.T("documents.steps_badge", _culture)</span>
            </div>
            <h2>@L.T("documents.compose_title", _culture)</h2>
            <p class="muted">
                @L.T("documents.compose_desc", _culture)
            </p>

            <form id="patient-search" method="get" asp-action="NewDocument" asp-route-tenantId="@tenantId"></form>
            <form method="get" asp-controller="Studio" asp-action="Index" asp-route-tenantId="@tenantId" style="margin-top: 1.5rem;">
                <input type="hidden" name="tenantId" value="@tenantId" />

                @if (!string.IsNullOrWhiteSpace(Model.PatientErrorMessage))
                {
                    <div class="error" role="alert">@Model.PatientErrorMessage</div>
                }
                <label style="display: block; margin-bottom: 0.75rem; font-weight: 600;">
                    @L.T("documents.patient_search_by", _culture)
                    <input name="patientSearch" form="patient-search" value="@Model.PatientSearch" placeholder="@L.T("documents.patient_name_doc_ph", _culture)" style="width: 100%; margin-top: 0.25rem;" />
                </label>
                <div style="display:flex; gap:0.5rem; align-items:center; margin-bottom: 1rem;">
                    <button class="button button-quiet" type="submit" form="patient-search">@L.T("common.search", _culture)</button>
                    @if (Model.PatientTotal > Model.PatientPageSize)
                    {
                        <span class="muted">@L.T("common.page_of", _culture, Model.PatientPage.ToString(System.Globalization.CultureInfo.InvariantCulture), ((int)Math.Ceiling((double)Model.PatientTotal / Model.PatientPageSize)).ToString(System.Globalization.CultureInfo.InvariantCulture))</span>
                        @if (Model.PatientPage > 1)
                        {
                            <a class="button button-small button-quiet" asp-action="NewDocument" asp-route-tenantId="@tenantId" asp-route-patientSearch="@Model.PatientSearch" asp-route-patientId="@Model.PatientId" asp-route-patientPage="@(Model.PatientPage - 1)">@L.T("documents.prev_narrow", _culture)</a>
                        }
                        @if (Model.PatientPage * Model.PatientPageSize < Model.PatientTotal)
                        {
                            <a class="button button-small button-quiet" asp-action="NewDocument" asp-route-tenantId="@tenantId" asp-route-patientSearch="@Model.PatientSearch" asp-route-patientId="@Model.PatientId" asp-route-patientPage="@(Model.PatientPage + 1)">@L.T("documents.next_narrow", _culture)</a>
                        }
                    }
                </div>
                <label style="display: block; margin-bottom: 1rem; font-weight: 600;">
                    @L.T("documents.bind_patient", _culture)
                    <select name="patientId" id="patientSelector" style="width: 100%; margin-top: 0.25rem;">
                        <option value="">@L.T("documents.patient_none", _culture)</option>
                        @foreach (var patient in Model.Patients)
                        {
                            <option value="@patient.Id" selected="@(Model.PatientId == patient.Id)">
                                @patient.FullName (@(patient.MaskedIdentifier ?? L.T("documents.patient_no_doc", _culture)))
                            </option>
                        }
                    </select>
                </label>

                <p class="muted" style="font-size: 0.875rem; margin-bottom: 1rem;">
                    @L.T("documents.patient_not_found", _culture)
                    @if (Model.CanManagePatients)
                    {
                        <a asp-controller="Patients" asp-action="Create" asp-route-tenantId="@tenantId" asp-route-returnUrl="@returnUrlForNewPatient" style="font-weight: 600;">
                            @L.T("documents.register_patient_now", _culture)
                        </a>
                    }
                    else
                    {
                        <span class="muted">@L.T("documents.patient_admin_hint", _culture)</span>
                    }
                </p>

                <button class="button button-primary" type="submit" style="width: 100%; margin-top: 0.5rem;">
                    @L.T("documents.advance_template", _culture)
                </button>
            </form>
            @if (Model.CanManagePatients)
            {
                <details class="help" style="margin-top: 1rem;">
                    <summary>@L.T("patient.quick_summary",_culture)</summary>
                    <p class="muted">@L.T("patient.quick_hint",_culture)</p>
                    <form method="post" asp-action="CreatePatientInline" asp-route-tenantId="@tenantId">
                        @Html.AntiForgeryToken()
                        <label>@L.T("patient.full_name",_culture)<input name="fullName" required minlength="2" maxlength="160" /></label>
                        <label>@L.T("patient.quick_doc_label",_culture)<select name="identifierType"><option value="cpf">@L.T("patient.id_cpf",_culture)</option><option value="cnpj">@L.T("patient.id_cnpj",_culture)</option><option value="passport">@L.T("patient.id_passport",_culture)</option><option value="other">@L.T("patient.id_other",_culture)</option></select></label>
                        <label>@L.T("patient.quick_doc_number",_culture)<input name="identifierValue" required minlength="3" maxlength="60" /></label>
                        <label>@L.T("patient.birth_optional",_culture)<input type="date" name="birthDate" max="@DateTime.Now.ToString("yyyy-MM-dd")" /></label>
                        <label>@L.T("patient.rep_optional",_culture)<input name="representativeName" maxlength="160" /></label>
                        <label>@L.T("patient.rep_relation_optional",_culture)<input name="representativeRelation" maxlength="120" /></label>
                        <button class="button button-primary" type="submit">@L.T("patient.quick_submit",_culture)</button>
                    </form>
                </details>
            }
        </div>
    </section>

    @* Card 2: Importar Documento Existente *@
    <section class="card" style="display: flex; flex-direction: column; justify-content: space-between; border-top: 4px solid var(--color-secondary, #475569);">
        <div>
            <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">
                <span class="badge badge-muted">@L.T("documents.external_file_badge", _culture)</span>
            </div>
            <h2>@L.T("documents.import_title", _culture)</h2>
            <p class="muted">
                @L.T("documents.import_desc", _culture)
            </p>
        </div>
        <div style="margin-top: 1.5rem;">
            <span class="muted" style="display: inline-block; width: 100%; text-align: center;">@L.T("documents.import_soon", _culture)</span>
        </div>
    </section>
</div>
