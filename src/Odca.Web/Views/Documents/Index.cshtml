@model DocumentsIndexViewModel
@{
    ViewData["Title"] = "Central de Documentos";
    var tenantId = Model.TenantId;
    var docs = Model.Documents;
}

<section class="page-heading">
    <div>
        <p class="eyebrow">Gestão documental</p>
        <h1>Central de Documentos</h1>
        <p class="muted">Acompanhe minutas, versões, revisões e preparações para assinatura de forma centralizada e rastreável.</p>
    </div>
    <div class="button-row">
        @if (Model.CanCreateDocument)
        {
            <a class="button button-primary" asp-controller="Documents" asp-action="NewDocument" asp-route-tenantId="@tenantId" asp-route-patientId="@Model.PatientId">
                <span aria-hidden="true">+</span> Novo documento
            </a>
        }
        @if (Model.CanManagePatients)
        {
            <a class="button" asp-controller="Patients" asp-action="Create" asp-route-tenantId="@tenantId">
                <span aria-hidden="true">♙</span> Cadastrar paciente
            </a>
        }
    </div>
</section>

<details class="help">
    <summary>Como usar a Central de Documentos</summary>
    <p>
        Esta central reúne todos os documentos contratuais e termos da sua organização. Cada documento evolui pelas seguintes etapas:
        <strong>1. Minuta:</strong> escolha um modelo publicado e preencha os dados do paciente ou contrato;
        <strong>2. Conferência:</strong> valide as pendências cadastrais e o checklist obrigatório;
        <strong>3. Versão & PDF:</strong> gere uma versão imutável com identificador criptográfico SHA-256 e gere o PDF para download;
        <strong>4. Revisão interna:</strong> solicite a conferência por outro profissional antes da formalização;
        <strong>5. Preparação para assinatura:</strong> configure os signatários e confirme a composição documental.
    </p>
</details>

@if (TempData["ErrorMessage"] is string tempError)
{
    <div class="error" role="alert" style="margin-bottom: 1rem;">
        <strong>Aviso:</strong> @tempError
    </div>
}

@if (Model.ErrorMessage is not null)
{
    <div class="error" role="alert" style="margin-bottom: 1rem;">
        <strong>Falha ao carregar documentos:</strong> @Model.ErrorMessage
    </div>
}

<form method="get" class="studio-filter" role="search" aria-label="Filtro de documentos">
    <label>
        Pesquisar
        <input name="search" value="@Model.Search" placeholder="Título, referência ou paciente" />
    </label>
    <label>
        Tipo
        <select name="type">
            <option value="">Todos os tipos</option>
            <option value="service" selected="@(Model.Type == "service")">Prestação de serviços</option>
            <option value="consent" selected="@(Model.Type == "consent")">Consentimento informado</option>
            <option value="nda" selected="@(Model.Type == "nda")">Confidencialidade</option>
            <option value="amendment" selected="@(Model.Type == "amendment")">Aditivo contratual</option>
            <option value="supply" selected="@(Model.Type == "supply")">Fornecimento</option>
            <option value="lease" selected="@(Model.Type == "lease")">Locação</option>
        </select>
    </label>
    @if (Model.CanReadPatients)
    {
        <label>
            Buscar paciente
            <input name="patientSearch" value="@Model.PatientSearch" placeholder="Filtrar paciente por nome" />
        </label>
        <label>
            Paciente
            <select name="patientId">
                <option value="">Todos os pacientes</option>
                @if (Model.SelectedPatient is not null && !Model.PatientOptions.Any(p => p.Id == Model.SelectedPatient.Id))
                {
                    <option value="@Model.SelectedPatient.Id" selected="selected">
                        @Model.SelectedPatient.FullName (@(Model.SelectedPatient.MaskedIdentifier ?? "—"))@(Model.SelectedPatient.Active ? "" : " [Inativo]")
                    </option>
                }
                @foreach (var p in Model.PatientOptions)
                {
                    <option value="@p.Id" selected="@(Model.PatientId == p.Id)">
                        @p.FullName (@(p.MaskedIdentifier ?? "—"))@(p.Active ? "" : " [Inativo]")
                    </option>
                }
            </select>
        </label>
        @if (Model.PatientTotal > Model.PatientPageSize)
        {
            <div style="font-size: 0.8rem; grid-column: 1 / -1; display:flex; gap: 0.5rem; align-items: center;" class="muted">
                <span>Pacientes (pág. @Model.PatientPage de @Math.Ceiling((double)Model.PatientTotal / Model.PatientPageSize)):</span>
                @if (Model.PatientPage > 1)
                {
                    <a class="button button-small button-quiet" asp-action="Index" asp-route-tenantId="@tenantId" asp-route-search="@Model.Search" asp-route-type="@Model.Type" asp-route-stage="@Model.Stage" asp-route-patientSearch="@Model.PatientSearch" asp-route-patientId="@Model.PatientId" asp-route-patientPage="@(Model.PatientPage - 1)">← Anteriores</a>
                }
                @if (Model.PatientPage * Model.PatientPageSize < Model.PatientTotal)
                {
                    <a class="button button-small button-quiet" asp-action="Index" asp-route-tenantId="@tenantId" asp-route-search="@Model.Search" asp-route-type="@Model.Type" asp-route-stage="@Model.Stage" asp-route-patientSearch="@Model.PatientSearch" asp-route-patientId="@Model.PatientId" asp-route-patientPage="@(Model.PatientPage + 1)">Próximos →</a>
                }
            </div>
        }
    }
    <label>
        Etapa
        <select name="stage">
            <option value="">Todas as etapas</option>
            <option value="draft" selected="@(Model.Stage == "draft")">Minutas em edição</option>
            <option value="in_review" selected="@(Model.Stage == "in_review")">Em revisão interna</option>
            <option value="approved" selected="@(Model.Stage == "approved")">Aprovados internamente</option>
            <option value="ready_for_signature" selected="@(Model.Stage == "ready_for_signature")">Prontos para assinatura</option>
            <option value="completed" selected="@(Model.Stage == "completed")">Assinados / Concluídos</option>
        </select>
    </label>
    <div style="display:flex; gap:0.5rem; align-items:flex-end;">
        <button class="button button-primary" type="submit">Filtrar</button>
        <a class="button button-quiet" asp-action="Index" asp-route-tenantId="@tenantId">Limpar</a>
    </div>
</form>

@if (Model.SelectedPatient is not null)
{
    <div class="card" style="padding: 0.75rem 1rem; margin-bottom: 1.5rem; background: var(--color-surface-subtle, #f8fafc); display: flex; justify-content: space-between; align-items: center;">
        <div>
            <span class="muted">Filtrando por paciente:</span>
            <strong>@Model.SelectedPatient.FullName</strong>
            @if (!string.IsNullOrWhiteSpace(Model.SelectedPatient.MaskedIdentifier))
            {
                <small class="muted">(@Model.SelectedPatient.MaskedIdentifier)</small>
            }
            @if (!Model.SelectedPatient.Active)
            {
                <span class="badge badge-muted" style="margin-left: 0.5rem;">Inativo no cadastro</span>
            }
        </div>
        <a class="button button-small button-quiet"
           asp-action="Index"
           asp-route-tenantId="@tenantId"
           asp-route-search="@Model.Search"
           asp-route-type="@Model.Type"
           asp-route-stage="@Model.Stage">
            Remover filtro de paciente ✕
        </a>
    </div>
}

@if (Model.PatientErrorMessage is not null)
{
    <div class="error" role="alert" style="margin-bottom: 1rem;">
        <strong>Aviso da lista de pacientes:</strong> @Model.PatientErrorMessage
    </div>
}

@if (docs.Items.Count > 0)
{
    <div class="table-responsive">
        <table class="table" aria-label="Lista de documentos">
            <thead>
                <tr>
                    <th>Documento</th>
                    <th>Tipo</th>
                    <th>Paciente</th>
                    <th>Situação do fluxo</th>
                    <th>Próxima ação</th>
                    <th>Atualização</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var doc in docs.Items)
                {
                    <tr>
                        <td>
                            <strong>@doc.Title</strong>
                            @if (!string.IsNullOrWhiteSpace(doc.Reference))
                            {
                                <br /><small class="muted">Ref: @doc.Reference</small>
                            }
                            <br /><small class="muted">Modelo: @doc.TemplateName</small>
                        </td>
                        <td>
                            <span class="badge badge-muted">
                                @(doc.DocumentType switch {
                                    "service" => "Serviços",
                                    "consent" => "Consentimento",
                                    "nda" => "Confidencialidade",
                                    "amendment" => "Aditivo",
                                    _ => doc.DocumentType
                                })
                            </span>
                        </td>
                        <td>
                            @if (doc.PatientId.HasValue)
                            {
                                <a asp-controller="Patients" asp-action="Details" asp-route-tenantId="@tenantId" asp-route-patientId="@doc.PatientId.Value">
                                    @(doc.PatientName ?? "Paciente")
                                </a>
                            }
                            else
                            {
                                <span class="muted">Não vinculado</span>
                            }
                        </td>
                        <td>
                            <div style="display:flex; flex-direction:column; gap:4px;">
                                <small>
                                    <strong>Minuta:</strong>
                                    @(doc.DraftStatus switch {
                                        "draft" => "Em edição",
                                        _ => doc.LatestVersionNumber.HasValue ? $"Versão {doc.LatestVersionNumber}" : "Sem minuta"
                                    })
                                </small>
                                <small>
                                    <strong>Revisão:</strong>
                                    @(doc.ReviewStatus switch {
                                        "none" => "Não solicitada",
                                        "draft" => "Em preparação",
                                        "submitted" or "in_review" => "Em análise",
                                        "changes_requested" => "Ajustes solicitados",
                                        "internally_approved" => "Aprovada internamente",
                                        _ => doc.ReviewStatus
                                    })
                                </small>
                                <small>
                                    <strong>PDF:</strong>
                                    @(doc.PdfStatus switch {
                                        "completed" => "Gerado",
                                        "failed" => "Falha na geração",
                                        "not_generated" => "Pendente",
                                        _ => doc.PdfStatus
                                    })
                                </small>
                                <small>
                                    <strong>Assinatura:</strong>
                                    @(doc.SignatureStatus switch {
                                        "not_started" => "Não iniciada",
                                        "preparing" => "Em preparação",
                                        "confirmed" => "Composição confirmada",
                                        "externally_signed" => "Assinado",
                                        _ => doc.SignatureStatus
                                    })
                                </small>
                            </div>
                        </td>
                        <td>
                            <span class="badge @(doc.NextAction switch {
                                "edit_draft" => "badge-primary",
                                "submit_review" or "in_review" => "badge-warning",
                                "download_pdf" => "badge-info",
                                "prepare_signature" => "badge-success",
                                "completed" => "badge-muted",
                                _ => "badge-muted"
                            })">
                                @(doc.NextAction switch {
                                    "edit_draft" => "Continuar minuta",
                                    "submit_review" => "Solicitar revisão",
                                    "in_review" => "Aguardando revisão",
                                    "download_pdf" => "Baixar PDF",
                                    "prepare_signature" => "Preparar assinatura",
                                    "completed" => "Concluído",
                                    _ => doc.NextAction
                                })
                            </span>
                        </td>
                        <td>
                            <time datetime="@doc.UpdatedAt.ToString("o")">
                                @doc.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                            </time>
                        </td>
                        <td>
                            <div class="button-row">
                                @if (doc.DraftId.HasValue && doc.CanEdit)
                                {
                                    <a class="button button-small button-primary"
                                       asp-controller="Studio"
                                       asp-action="Edit"
                                       asp-route-tenantId="@tenantId"
                                       asp-route-draftId="@doc.DraftId.Value">
                                        Continuar
                                    </a>
                                }
                                @if (doc.LatestVersionId.HasValue && doc.CanDownloadPdf)
                                {
                                    <a class="button button-small"
                                       href="/api/v1/organizations/@tenantId/studio/versions/@doc.LatestVersionId.Value/pdf"
                                       download>
                                        PDF
                                    </a>
                                }
                                @if (doc.LatestVersionId.HasValue)
                                {
                                    <a class="button button-small"
                                       asp-controller="Studio"
                                       asp-action="Version"
                                       asp-route-tenantId="@tenantId"
                                       asp-route-versionId="@doc.LatestVersionId.Value">
                                        Versão
                                    </a>
                                }
                                <a class="button button-small"
                                   asp-controller="Contracts"
                                   asp-action="Sheet"
                                   asp-route-tenantId="@tenantId"
                                   asp-route-contractId="@doc.ContractId">
                                    Ficha
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (docs.Total > docs.PageSize)
    {
        <nav class="pagination" aria-label="Paginação de documentos">
            @if (docs.Page > 1)
            {
                <a class="button button-quiet"
                   asp-route-tenantId="@tenantId"
                   asp-route-search="@Model.Search"
                   asp-route-type="@Model.Type"
                   asp-route-stage="@Model.Stage"
                   asp-route-patientId="@Model.PatientId"
                   asp-route-patientSearch="@Model.PatientSearch"
                   asp-route-page="@(docs.Page - 1)">Anterior</a>
            }
            <span>Página @docs.Page de @(Math.Ceiling((double)docs.Total / docs.PageSize)) (@docs.Total documento(s))</span>
            @if (docs.Page * docs.PageSize < docs.Total)
            {
                <a class="button button-quiet"
                   asp-route-tenantId="@tenantId"
                   asp-route-search="@Model.Search"
                   asp-route-type="@Model.Type"
                   asp-route-stage="@Model.Stage"
                   asp-route-patientId="@Model.PatientId"
                   asp-route-patientSearch="@Model.PatientSearch"
                   asp-route-page="@(docs.Page + 1)">Próxima</a>
            }
        </nav>
    }
}
else if (Model.ErrorMessage is null)
{
    <div class="card empty-state">
        <h2>Nenhum documento encontrado</h2>
        <p>Não há documentos para os filtros aplicados. Clique no botão abaixo para iniciar uma nova minuta a partir de um modelo publicado.</p>
        <div class="button-row" style="margin-top: 1rem;">
            @if (Model.CanCreateDocument)
            {
                <a class="button button-primary" asp-controller="Documents" asp-action="NewDocument" asp-route-tenantId="@tenantId" asp-route-patientId="@Model.PatientId">
                    Criar primeiro documento
                </a>
            }
            @if (Model.CanManagePatients)
            {
                <a class="button" asp-controller="Patients" asp-action="New" asp-route-tenantId="@tenantId">
                    Cadastrar paciente
                </a>
            }
        </div>
    </div>
}
