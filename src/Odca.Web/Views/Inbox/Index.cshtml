@model Odca.Web.Models.InboxWorkspaceViewModel
@{
    var _culture = (string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey];
    var tenantId = ViewData["TenantId"];
    var notice = TempData["SavedViewNotice"] as string;
    var error = TempData["SavedViewError"] as string ?? Model.Error;
    var currentViewId = Model.CurrentView?.Id;
}
<header class="renewal-heading">
    <div>
        <p class="eyebrow">@L.T("inbox.eyebrow", _culture)</p>
        <h1>@L.T("inbox.title", _culture)</h1>
        <p class="muted">@L.T("inbox.subtitle", _culture)</p>
    </div>
    <div class="form-actions-row">
        <a class="button button-quiet" asp-controller="Agenda" asp-action="Index" asp-route-tenantId="@tenantId">@L.T("inbox.open_agenda", _culture)</a>
    </div>
</header>

@if (!string.IsNullOrWhiteSpace(notice))
{
    <div class="banner-notice-success" role="status">
        @notice
    </div>
}

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="validation-summary" role="alert">
        @error
    </div>
}

@if (Model.Page.Overdue > 0)
{
    <div class="banner-notice-warning" role="status">
        <strong>⚠ @Model.Page.Overdue @L.T("inbox.overdue_items", _culture)</strong>
        <a class="button button-quiet"
           asp-action="Index" asp-route-tenantId="@tenantId"
           asp-route-scope="@Model.Scope" asp-route-kind="@Model.Kind"
           asp-route-urgency="Overdue" asp-route-viewId="@currentViewId">@L.T("inbox.view_overdue", _culture)</a>
    </div>
}

<section class="inbox-summary-cards" aria-label="@L.T("inbox.aria_summary", _culture)">
    <a asp-action="Index" asp-route-tenantId="@tenantId" asp-route-scope="@Model.Scope" asp-route-kind="@Model.Kind" asp-route-urgency="Overdue" asp-route-viewId="@currentViewId">
        <strong>@Model.Page.Overdue</strong><span>@L.T("inbox.summary_overdue", _culture)</span>
    </a>
    <a asp-action="Index" asp-route-tenantId="@tenantId" asp-route-scope="@Model.Scope" asp-route-kind="@Model.Kind" asp-route-urgency="DueToday" asp-route-viewId="@currentViewId">
        <strong>@Model.Page.DueToday</strong><span>@L.T("inbox.summary_today", _culture)</span>
    </a>
    <a asp-action="Index" asp-route-tenantId="@tenantId" asp-route-scope="@Model.Scope" asp-route-kind="@Model.Kind" asp-route-urgency="DueThisWeek" asp-route-viewId="@currentViewId">
        <strong>@Model.Page.DueThisWeek</strong><span>@L.T("inbox.summary_week", _culture)</span>
    </a>
    <span><strong>@Model.Page.Total</strong><span>@L.T("inbox.summary_visible", _culture)</span></span>
</section>

<!-- VISTAS PESSOAIS -->
@if (Model.Views.Count > 0)
{
    <div class="active-filters" aria-label="@L.T("inbox.views_aria", _culture)">
        <span><strong>@L.T("inbox.my_views", _culture)</strong></span>
        @foreach (var view in Model.Views)
        {
            var isCurrent = Model.CurrentView?.Id == view.Id;
            <a class="filter-chip @(isCurrent ? "active" : null)" asp-action="OpenView" asp-route-tenantId="@tenantId" asp-route-viewId="@view.Id">
                @view.Name @(view.IsDefault ? L.T("inbox.view_default", _culture) : null)
            </a>
        }
        @if (Model.CurrentView is not null)
        {
            <div class="form-actions-row">
                @if (!Model.CurrentView.IsDefault)
                {
                    <form method="post" asp-action="SetDefaultView" asp-route-tenantId="@tenantId" asp-route-viewId="@Model.CurrentView.Id">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="version" value="@Model.CurrentView.Version" />
                        <button type="submit" class="button button-quiet">@L.T("inbox.set_default", _culture)</button>
                    </form>
                }
                <form method="post" asp-action="DeactivateView" asp-route-tenantId="@tenantId" asp-route-viewId="@Model.CurrentView.Id">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="clear-button-link">@L.T("inbox.delete_view", _culture)</button>
                </form>
            </div>
        }
    </div>
}

<details class="filter-panel" open>
    <summary>@L.T("inbox.filters", _culture)</summary>
    <form method="get" class="renewal-filters">
        @if (currentViewId.HasValue)
        {
            <input type="hidden" name="viewId" value="@currentViewId.Value" />
        }
        <label>@L.T("inbox.scope", _culture)
            <select name="scope">
                <option value="mine" selected="@(Model.Scope=="mine")">@L.T("inbox.scope_mine", _culture)</option>
                <option value="organization" selected="@(Model.Scope=="organization")">@L.T("inbox.scope_org", _culture)</option>
            </select>
        </label>
        <label>@L.T("inbox.type", _culture)
            <select name="kind">
                <option value="">@L.T("inbox.type_all", _culture)</option>
                <option value="Obligation" selected="@(Model.Kind=="Obligation")">@L.T("inbox.kind_obligation", _culture)</option>
                <option value="Review" selected="@(Model.Kind=="Review")">@L.T("inbox.kind_review", _culture)</option>
                <option value="Renewal" selected="@(Model.Kind=="Renewal")">@L.T("inbox.kind_renewal", _culture)</option>
                <option value="Solicitation" selected="@(Model.Kind=="Solicitation")">@L.T("inbox.kind_solicitation", _culture)</option>
                <option value="Signature" selected="@(Model.Kind=="Signature")">@L.T("inbox.kind_signature", _culture)</option>
                <option value="Exception" selected="@(Model.Kind=="Exception")">@L.T("inbox.kind_exception", _culture)</option>
            </select>
        </label>
        <label>@L.T("inbox.urgency", _culture)
            <select name="urgency">
                <option value="">@L.T("inbox.urgency_all", _culture)</option>
                <option value="Overdue" selected="@(Model.Urgency=="Overdue")">@L.T("inbox.urgency_overdue", _culture)</option>
                <option value="DueToday" selected="@(Model.Urgency=="DueToday")">@L.T("inbox.urgency_today", _culture)</option>
                <option value="DueThisWeek" selected="@(Model.Urgency=="DueThisWeek")">@L.T("inbox.urgency_week", _culture)</option>
                <option value="Upcoming" selected="@(Model.Urgency=="Upcoming")">@L.T("inbox.urgency_upcoming", _culture)</option>
            </select>
        </label>
        <button class="button button-primary" type="submit">@L.T("inbox.apply", _culture)</button>
        <a class="button button-quiet" asp-action="Index" asp-route-tenantId="@tenantId">@L.T("inbox.clear", _culture)</a>
    </form>

    <!-- FORMULÁRIO PARA SALVAR VISTA -->
    <details class="details-subpanel">
        <summary>@L.T("inbox.save_view_summary", _culture)</summary>
        <form method="post" asp-action="SaveView" asp-route-tenantId="@tenantId" class="form-actions-row">
            @Html.AntiForgeryToken()
            <input type="hidden" name="scope" value="@Model.Scope" />
            <input type="hidden" name="kind" value="@Model.Kind" />
            <input type="hidden" name="urgency" value="@Model.Urgency" />
            <input type="text" name="name" required placeholder="@L.T("inbox.view_name_ph", _culture)" maxlength="80" />
            <button class="button button-quiet" type="submit">@L.T("inbox.save_view_btn", _culture)</button>
        </form>
    </details>
</details>

<section class="renewal-list" aria-live="polite">
    @if (Model.Page.Items.Count == 0)
    {
        <div class="empty-state">
            <strong>@L.T("inbox.empty_title", _culture)</strong>
            <p>@L.T("inbox.empty_body", _culture)</p>
        </div>
    }
    else
    {
        foreach (var item in Model.Page.Items)
        {
            var kindLabel = L.T(item.Kind switch
            {
                "Obligation" => "inbox.kind_obligation",
                "Review" => "inbox.kind_review",
                "Renewal" => "inbox.kind_renewal",
                "Solicitation" => "inbox.kind_solicitation",
                "Signature" => "inbox.kind_signature",
                "Exception" => "inbox.kind_exception",
                _ => "inbox.kind_unknown"
            }, _culture);
            var urgencyLabel = L.T(item.Urgency switch
            {
                "Overdue" => "inbox.urgency_overdue",
                "DueToday" => "inbox.urgency_today_label",
                "DueThisWeek" => "inbox.urgency_week_label",
                "Upcoming" => "inbox.urgency_upcoming_label",
                _ => "inbox.no_deadline"
            }, _culture);
            var actionLabel = L.T(item.Kind switch
            {
                "Obligation" => "inbox.action_obligation",
                "Review" => "inbox.action_review",
                "Renewal" => "inbox.action_renewal",
                "Solicitation" => "inbox.action_solicitation",
                "Signature" => "inbox.action_signature",
                "Exception" => "inbox.action_exception",
                _ => "inbox.action_default"
            }, _culture);
            <article class="renewal-row">
                <div>
                    <span class="status-label">@kindLabel · @urgencyLabel</span>
                    <h3>@item.Title</h3>
                    <p>@item.ContractTitle · @(item.OwnerName ?? L.T("inbox.no_owner", _culture))</p>
                </div>
                <dl>
                    <div><dt>@L.T("inbox.due", _culture)</dt><dd>@(item.DueOn is null ? L.T("inbox.no_date", _culture) : CulturedTime.Date(item.DueOn.Value, _culture))</dd></div>
                    <div><dt>@L.T("inbox.status", _culture)</dt><dd>@item.Status</dd></div>
                </dl>
                <div class="next-action"><a class="button button-quiet" href="@item.OpenUrl">@actionLabel</a></div>
            </article>
        }
    }
</section>

<nav class="pagination" aria-label="@L.T("inbox.pagination", _culture)">
    @if (Model.Page.Page > 1)
    {
        <a asp-action="Index" asp-route-tenantId="@tenantId" asp-route-page="@(Model.Page.Page-1)" asp-route-scope="@Model.Scope" asp-route-kind="@Model.Kind" asp-route-urgency="@Model.Urgency" asp-route-viewId="@currentViewId">@L.T("inbox.prev", _culture)</a>
    }
    <span>@L.T("inbox.page", _culture) @Model.Page.Page</span>
    @if (Model.Page.Page * Model.Page.PageSize < Model.Page.Total)
    {
        <a asp-action="Index" asp-route-tenantId="@tenantId" asp-route-page="@(Model.Page.Page+1)" asp-route-scope="@Model.Scope" asp-route-kind="@Model.Kind" asp-route-urgency="@Model.Urgency" asp-route-viewId="@currentViewId">@L.T("inbox.next", _culture)</a>
    }
</nav>

<details class="filter-panel">
    <summary>@L.T("inbox.how_to_use", _culture)</summary>
    <div class="details-content">
        <p>@L.T("inbox.help_body1", _culture)</p>
        <p>@L.T("inbox.help_body2", _culture)</p>
    </div>
</details>
