@model Odca.Web.Models.InboxWorkspaceViewModel
@{
    var tenantId = ViewData["TenantId"];
    var notice = TempData["SavedViewNotice"] as string;
    var error = TempData["SavedViewError"] as string ?? Model.Error;
    var currentViewId = Model.CurrentView?.Id;
}
<header class="renewal-heading">
    <div>
        <p class="eyebrow">Central operacional</p>
        <h1>Central de pendências</h1>
        <p class="muted">Encontre a próxima atividade e abra o contexto na fonte oficial para tratá-la com segurança.</p>
    </div>
    <div class="form-actions-row">
        <a class="button button-quiet" asp-controller="Agenda" asp-action="Index" asp-route-tenantId="@tenantId">Abrir agenda</a>
    </div>
</header>

@if (!string.IsNullOrWhiteSpace(notice))
{
    <div class="banner-notice-success" role="status">
        @notice
    </div>
}

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="validation-summary" role="alert">
        @error
    </div>
}

@if (Model.Page.Overdue > 0)
{
    <div class="banner-notice-warning" role="status">
        <strong>⚠ @Model.Page.Overdue item(ns) atrasado(s)</strong>
        <a class="button button-quiet"
           asp-action="Index" asp-route-tenantId="@tenantId"
           asp-route-scope="@Model.Scope" asp-route-kind="@Model.Kind"
           asp-route-urgency="Overdue" asp-route-viewId="@currentViewId">Ver atrasadas</a>
    </div>
}

<section class="inbox-summary-cards" aria-label="Resumo">
    <a asp-action="Index" asp-route-tenantId="@tenantId" asp-route-scope="@Model.Scope" asp-route-kind="@Model.Kind" asp-route-urgency="Overdue" asp-route-viewId="@currentViewId">
        <strong>@Model.Page.Overdue</strong><span>Atrasadas</span>
    </a>
    <a asp-action="Index" asp-route-tenantId="@tenantId" asp-route-scope="@Model.Scope" asp-route-kind="@Model.Kind" asp-route-urgency="DueToday" asp-route-viewId="@currentViewId">
        <strong>@Model.Page.DueToday</strong><span>Vencem hoje</span>
    </a>
    <a asp-action="Index" asp-route-tenantId="@tenantId" asp-route-scope="@Model.Scope" asp-route-kind="@Model.Kind" asp-route-urgency="DueThisWeek" asp-route-viewId="@currentViewId">
        <strong>@Model.Page.DueThisWeek</strong><span>Nesta semana</span>
    </a>
    <span><strong>@Model.Page.Total</strong><span>Itens visíveis</span></span>
</section>

<!-- VISTAS PESSOAIS -->
@if (Model.Views.Count > 0)
{
    <div class="active-filters" aria-label="Vistas salvas">
        <span><strong>Minhas vistas:</strong></span>
        @foreach (var view in Model.Views)
        {
            var isCurrent = Model.CurrentView?.Id == view.Id;
            <a class="filter-chip @(isCurrent ? "active" : null)" asp-action="OpenView" asp-route-tenantId="@tenantId" asp-route-viewId="@view.Id">
                @view.Name @(view.IsDefault ? "(Padrão)" : null)
            </a>
        }
        @if (Model.CurrentView is not null)
        {
            <div class="form-actions-row">
                @if (!Model.CurrentView.IsDefault)
                {
                    <form method="post" asp-action="SetDefaultView" asp-route-tenantId="@tenantId" asp-route-viewId="@Model.CurrentView.Id">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="version" value="@Model.CurrentView.Version" />
                        <button type="submit" class="button button-quiet">Tornar padrão</button>
                    </form>
                }
                <form method="post" asp-action="DeactivateView" asp-route-tenantId="@tenantId" asp-route-viewId="@Model.CurrentView.Id">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="clear-button-link">Excluir vista</button>
                </form>
            </div>
        }
    </div>
}

<details class="filter-panel" open>
    <summary>Filtros da caixa</summary>
    <form method="get" class="renewal-filters">
        @if (currentViewId.HasValue)
        {
            <input type="hidden" name="viewId" value="@currentViewId.Value" />
        }
        <label>Escopo
            <select name="scope">
                <option value="mine" selected="@(Model.Scope=="mine")">Minhas pendências</option>
                <option value="organization" selected="@(Model.Scope=="organization")">Organização</option>
            </select>
        </label>
        <label>Tipo
            <select name="kind">
                <option value="">Todos</option>
                <option value="Obligation" selected="@(Model.Kind=="Obligation")">Obrigação</option>
                <option value="Review" selected="@(Model.Kind=="Review")">Revisão</option>
                <option value="Renewal" selected="@(Model.Kind=="Renewal")">Renovação</option>
            </select>
        </label>
        <label>Urgência
            <select name="urgency">
                <option value="">Todas</option>
                <option value="Overdue" selected="@(Model.Urgency=="Overdue")">Atrasada</option>
                <option value="DueToday" selected="@(Model.Urgency=="DueToday")">Hoje</option>
                <option value="DueThisWeek" selected="@(Model.Urgency=="DueThisWeek")">Semana</option>
                <option value="Upcoming" selected="@(Model.Urgency=="Upcoming")">Próximas</option>
            </select>
        </label>
        <button class="button button-primary" type="submit">Aplicar</button>
        <a class="button button-quiet" asp-action="Index" asp-route-tenantId="@tenantId">Limpar</a>
    </form>

    <!-- FORMULÁRIO PARA SALVAR VISTA -->
    <details class="details-subpanel">
        <summary>Salvar estes filtros como vista pessoal</summary>
        <form method="post" asp-action="SaveView" asp-route-tenantId="@tenantId" class="form-actions-row">
            @Html.AntiForgeryToken()
            <input type="hidden" name="scope" value="@Model.Scope" />
            <input type="hidden" name="kind" value="@Model.Kind" />
            <input type="hidden" name="urgency" value="@Model.Urgency" />
            <input type="text" name="name" required placeholder="Nome da vista (ex: Críticas da Semana)" maxlength="80" />
            <button class="button button-quiet" type="submit">Salvar vista</button>
        </form>
    </details>
</details>

<section class="renewal-list" aria-live="polite">
    @if (Model.Page.Items.Count == 0)
    {
        <div class="empty-state">
            <strong>Nada pendente neste recorte</strong>
            <p>Ajuste o escopo ou o tipo. A caixa reflete as pendências vigentes sem inventar tarefas.</p>
        </div>
    }
    else
    {
        foreach (var item in Model.Page.Items)
        {
            var kindLabel = item.Kind switch
            {
                "Obligation" => "Obrigação",
                "Review" => "Revisão",
                "Renewal" => "Renovação",
                _ => item.Kind
            };
            var urgencyLabel = item.Urgency switch
            {
                "Overdue" => "Atrasada",
                "DueToday" => "Prazo hoje",
                "DueThisWeek" => "Prazo nesta semana",
                "Upcoming" => "Próxima",
                _ => "Sem prazo"
            };
            var actionLabel = item.Kind switch
            {
                "Obligation" => "Abrir obrigação",
                "Review" => "Abrir revisão",
                "Renewal" => "Abrir decisão de renovação",
                _ => "Abrir origem"
            };
            <article class="renewal-row">
                <div>
                    <span class="status-label">@kindLabel · @urgencyLabel</span>
                    <h3>@item.Title</h3>
                    <p>@item.ContractTitle · @(item.OwnerName ?? "Sem responsável")</p>
                </div>
                <dl>
                    <div><dt>Prazo</dt><dd>@(item.DueOn?.ToString("dd/MM/yyyy") ?? "Sem data")</dd></div>
                    <div><dt>Situação</dt><dd>@item.Status</dd></div>
                </dl>
                <div class="next-action"><a class="button button-quiet" href="@item.OpenUrl">@actionLabel</a></div>
            </article>
        }
    }
</section>

<nav class="pagination" aria-label="Paginação">
    @if (Model.Page.Page > 1)
    {
        <a asp-action="Index" asp-route-tenantId="@tenantId" asp-route-page="@(Model.Page.Page-1)" asp-route-scope="@Model.Scope" asp-route-kind="@Model.Kind" asp-route-urgency="@Model.Urgency" asp-route-viewId="@currentViewId">Anterior</a>
    }
    <span>Página @Model.Page.Page</span>
    @if (Model.Page.Page * Model.Page.PageSize < Model.Page.Total)
    {
        <a asp-action="Index" asp-route-tenantId="@tenantId" asp-route-page="@(Model.Page.Page+1)" asp-route-scope="@Model.Scope" asp-route-kind="@Model.Kind" asp-route-urgency="@Model.Urgency" asp-route-viewId="@currentViewId">Próxima</a>
    }
</nav>

<details class="filter-panel">
    <summary>Como usar</summary>
    <div class="details-content">
        <p>A central reúne pendências das fontes oficiais. Use os filtros para priorizar seu trabalho e abra o item para consultar todo o contexto antes de agir.</p>
        <p>Uma ação confirmada no módulo de origem atualiza a pendência. Se outra pessoa alterar o registro enquanto ele estiver aberto, atualize a página e confira o novo estado antes de confirmar novamente.</p>
    </div>
</details>
