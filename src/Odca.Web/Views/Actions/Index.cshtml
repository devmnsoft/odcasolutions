@model Odca.Web.Controllers.ActionCenterViewModel
@{
    var _culture = (string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey];
    var tenantId = ViewData["TenantId"];
    var ac = Model.Data;
}
<header class="renewal-heading">
    <div>
        <p class="eyebrow">@L.T("common.operations", _culture)</p>
        <h1>@L.T("actions.title", _culture)</h1>
        <p class="muted">@L.T("actions.subtitle", _culture)</p>
    </div>
</header>
<details class="help-card"><summary>@L.T("common.how_to_use", _culture)</summary><ol><li>@L.T("actions.manual_1", _culture)</li><li>@L.T("actions.manual_2", _culture)</li><li>@L.T("actions.manual_3", _culture)</li></ol></details>

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="validation-summary" role="alert">@Model.Error</div>
}

@if (ac is not null)
{
    <!-- Summary cards -->
    <section class="inbox-summary-cards" aria-label="@L.T("actions.aria_summary", _culture)">
        <a asp-action="Index" asp-route-tenantId="@tenantId" asp-route-scope="@Model.Scope" class="@(Model.Source is null ? "" : "")">
            <strong>@ac.Overdue.Count</strong><span>@L.T("actions.overdue", _culture)</span>
        </a>
        <span><strong>@ac.MyAction.Count</strong><span>@L.T("actions.my_action", _culture)</span></span>
        <span><strong>@ac.WaitingOther.Count</strong><span>@L.T("actions.waiting", _culture)</span></span>
        <span><strong>@ac.UpcomingDeadlines.Count</strong><span>@L.T("actions.upcoming", _culture)</span></span>
        <span><strong>@ac.ConflictsAndFailures.Count</strong><span>@L.T("actions.conflicts", _culture)</span></span>
        <span><strong>@ac.Total</strong><span>@L.T("actions.total", _culture)</span></span>
    </section>

    <!-- Filters -->
    <details class="filter-panel" open>
        <summary>@L.T("common.filters", _culture)</summary>
        <form method="get" class="renewal-filters">
            <label>@L.T("inbox.scope", _culture)
                <select name="scope">
                    <option value="mine" selected="@(Model.Scope=="mine")">@L.T("inbox.scope_mine", _culture)</option>
                    <option value="organization" selected="@(Model.Scope=="organization")">@L.T("inbox.scope_org", _culture)</option>
                </select>
            </label>
            <label>@L.T("actions.source_label", _culture)
                <select name="source">
                    <option value="">@L.T("common.all", _culture)</option>
                    <option value="obligation" selected="@(Model.Source=="obligation")">@L.T("actions.src_obligations", _culture)</option>
                    <option value="renewal" selected="@(Model.Source=="renewal")">@L.T("actions.src_renewals", _culture)</option>
                    <option value="solicitation" selected="@(Model.Source=="solicitation")">@L.T("actions.src_solicitations", _culture)</option>
                    <option value="signature" selected="@(Model.Source=="signature")">@L.T("actions.src_signatures", _culture)</option>
                    <option value="contract" selected="@(Model.Source=="contract")">@L.T("actions.src_contracts", _culture)</option>
                </select>
            </label>
            <button class="button button-primary" type="submit">@L.T("common.apply", _culture)</button>
            <a class="button button-quiet" asp-action="Index" asp-route-tenantId="@tenantId">@L.T("common.clear", _culture)</a>
        </form>
    </details>

    <!-- Items -->
    <section class="renewal-list" aria-live="polite">
        @if (ac.Total == 0)
        {
            <div class="empty-state">
                <strong>@L.T("actions.empty_title", _culture)</strong>
                <p>@L.T("actions.empty_body", _culture)</p>
            </div>
        }
        else
        {
            var allItems = new List<(string Category, Odca.Contracts.Operations.ActionItemDto Item)>();
            foreach (var i in ac.Overdue) allItems.Add(("overdue", i));
            foreach (var i in ac.MyAction) allItems.Add(("my_action", i));
            foreach (var i in ac.UpcomingDeadlines) allItems.Add(("upcoming", i));
            foreach (var i in ac.ConflictsAndFailures) allItems.Add(("conflict", i));
            foreach (var i in ac.WaitingOther) allItems.Add(("waiting", i));
            foreach (var i in ac.Info) allItems.Add(("info", i));

            foreach (var (cat, item) in allItems)
            {
                var catLabel = cat switch
                {
                    "overdue" => L.T("actions.cat_overdue", _culture),
                    "my_action" => L.T("actions.cat_my_action", _culture),
                    "upcoming" => L.T("actions.cat_upcoming", _culture),
                    "conflict" => L.T("actions.cat_conflict", _culture),
                    "waiting" => L.T("actions.cat_waiting", _culture),
                    "info" => L.T("actions.cat_info", _culture),
                    _ => cat
                };
                var sourceLabel = item.SourceType switch
                {
                    "obligation" => L.T("common.obligation", _culture),
                    "renewal" => L.T("actions.srct_renewal", _culture),
                    "solicitation" => L.T("actions.srct_solicitation", _culture),
                    "signature" => L.T("actions.srct_signature", _culture),
                    "contract" => L.T("common.contract", _culture),
                    _ => item.SourceType
                };
                <article class="renewal-row">
                    <div>
                        <span class="status-label">@sourceLabel · @catLabel @(item.Priority == "critical" ? "⚠" : "")</span>
                        <h3>@item.Context</h3>
                        <p>@(item.Reason ?? "") @(item.Responsible != null ? L.T("actions.responsible_inline", _culture, item.Responsible) : "")</p>
                    </div>
                    <dl>
                        <div><dt>@L.T("common.due_date", _culture)</dt><dd>@(item.Deadline.HasValue ? CulturedTime.Date(item.Deadline.Value, _culture) : "—")</dd></div>
                        <div><dt>@L.T("actions.item_action", _culture)</dt><dd>@item.NextAction</dd></div>
                    </dl>
                </article>
            }
        }
    </section>

    <!-- Pagination -->
    @if (Model.Page * 25 < ac.Total)
    {
        <nav class="pagination" aria-label="@L.T("common.pagination_aria", _culture)">
            <a asp-action="Index" asp-route-tenantId="@tenantId" asp-route-scope="@Model.Scope" asp-route-source="@Model.Source" asp-route-page="@(Model.Page + 1)">@L.T("common.next", _culture) →</a>
            <span>@L.T("common.page_of", _culture, Model.Page.ToString(), ((int)Math.Ceiling(ac.Total / 25.0)).ToString())</span>
        </nav>
    }
}
