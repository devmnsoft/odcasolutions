@using Odca.Contracts.Solicitations
@model SolicitationListItem[]
@{
    Guid? filterTenant=ViewData["TenantId"] as Guid?; var service=ViewData["Service"] as string; var status=ViewData["Status"] as string; var search=ViewData["Search"] as string;
    string ServiceLabel(string value)=>value switch { "revisao"=>"Revisão","adaptacao"=>"Adaptação","esclarecimento"=>"Esclarecimento","suporte_tecnico"=>"Suporte técnico",_=>value };
    string StatusLabel(string value)=>value switch { "aberta"=>"Aberta","triagem"=>"Em triagem","em_atendimento"=>"Em atendimento","aguardando_cliente"=>"Aguardando cliente","resolvida"=>"Resolvida","encerrada"=>"Encerrada","cancelada"=>"Cancelada",_=>value };
    string PriorityLabel(string value)=>value switch { "baixa"=>"Baixa","normal"=>"Normal","alta"=>"Alta","critica"=>"Crítica",_=>value };
    string Fmt(DateTime? value)=>value?.ToString("dd/MM/yyyy HH:mm")??"—";
}
<nav class="breadcrumb" aria-label="Navegação estrutural"><a asp-controller="Home" asp-action="Index">Visão global</a><span>/</span><span aria-current="page">Atendimento ODCA</span></nav>
<header class="page-heading"><div><p class="eyebrow">Plataforma MNSOFT</p><h1>Fila de solicitações ODCA</h1><p>Atenda as solicitações dos clientes dentro dos prazos de SLA do plano de cada organização.</p></div><a class="button button-quiet" asp-action="Aprovacoes">Aprovação de modelos</a></header>
@if(ViewData["LoadError"] is string loadError){<div class="alert alert-error" role="alert">@loadError</div>}
@if(TempData["SolNotice"] is string notice){<div class="alert alert-success" role="status">@notice</div>}
<section class="help-card" aria-labelledby="fila-help"><h2 id="fila-help">Fluxo de atendimento</h2><p>Abra a solicitação, faça a <strong>triagem</strong> (a primeira resposta do SLA zera ao responder ou iniciar o atendimento), resolva com um resumo da solução e aguarde o cliente encerrar. Pausas e esperas justificadas param o relógio; violações ficam registradas no histórico.</p></section>
<form method="get" class="review-filters" aria-label="Filtros da fila">
 <label>Organização (ID)<input type="text" name="tenantId" value="@filterTenant" placeholder="opcional" /></label>
 <label>Serviço<select name="service"><option value="">Todos</option>@foreach(var option in new[]{("revisao","Revisão"),("adaptacao","Adaptação"),("esclarecimento","Esclarecimento"),("suporte_tecnico","Suporte técnico")}){<option value="@option.Item1" selected="@(service==option.Item1)">@option.Item2</option>}</select></label>
 <label>Situação<select name="status"><option value="">Todas</option>@foreach(var option in new[]{("aberta","Aberta"),("triagem","Em triagem"),("em_atendimento","Em atendimento"),("aguardando_cliente","Aguardando cliente"),("resolvida","Resolvida"),("encerrada","Encerrada"),("cancelada","Cancelada")}){<option value="@option.Item1" selected="@(status==option.Item1)">@option.Item2</option>}</select></label>
 <label>Buscar<input type="search" name="search" value="@search" placeholder="Protocolo, assunto ou organização" /></label>
 <button class="button button-quiet" type="submit">Aplicar filtros</button>
</form>
<section aria-label="Fila de solicitações">
 @if(Model.Length==0){<div class="empty-state"><p>Nenhuma solicitação na fila com estes filtros.</p></div>}
 else
 {
  <div class="table-scroll"><table><thead><tr><th>Protocolo</th><th>Organização</th><th>Assunto</th><th>Prioridade</th><th>Situação</th><th>Responsável</th><th>Primeira resposta</th><th>Resolução</th><th>Abertura</th></tr></thead><tbody>
  @foreach(var item in Model)
  {
   <tr>
    <td><a asp-action="Detalhes" asp-route-solicitationId="@item.Id"><strong>@item.Protocol</strong></a><small>@ServiceLabel(item.Service)</small></td>
    <td>@item.OrganizationName</td>
    <td>@item.Subject</td>
    <td>@PriorityLabel(item.Priority)</td>
    <td><span class="status-badge status-@item.Status">@StatusLabel(item.Status)</span>@if(item.Paused){<span class="status-badge">SLA pausado</span>}@if(item.FirstResponseBreachAt is not null||item.ResolutionBreachAt is not null){<span class="status-badge status-cancelled">Violação</span>}</td>
    <td>@(item.AssigneeName??"—")</td>
    <td>@if(item.FirstResponseBreachAt is not null){<strong>Violada @Fmt(item.FirstResponseBreachAt)</strong>}else if(item.FirstResponseDueAt is not null && item.ResolvedAt is null && item.ClosedAt is null && item.CancelledAt is null && item.FirstResponseDueAt < DateTime.UtcNow){<strong>Vencida — @Fmt(item.FirstResponseDueAt)</strong>}else{@Fmt(item.FirstResponseDueAt)}</td>
    <td>@if(item.ResolutionBreachAt is not null){<strong>Violada @Fmt(item.ResolutionBreachAt)</strong>}else{@Fmt(item.ResolutionDueAt)}</td>
    <td>@Fmt(item.OpenedAt)</td>
   </tr>
  }
  </tbody></table></div>
 }
</section>
