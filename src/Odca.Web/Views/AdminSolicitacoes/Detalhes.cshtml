@model System.Text.Json.JsonElement
@{
    var _c = (string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey];
    ViewData["Title"] = L.T("admin.queue_crumb", _c);
    var p=Model;
    string Str(string n)=>p.TryGetProperty(n,out var v)&&v.ValueKind==JsonValueKind.String?v.GetString()??"" : "";
    long Version=p.TryGetProperty("rowVersion",out var rv)&&rv.ValueKind==JsonValueKind.Number?rv.GetInt64():0;
    DateTime? When(string n)=>p.TryGetProperty(n,out var v)&&v.ValueKind==JsonValueKind.String&&DateTime.TryParse(v.GetString(),out var d)?d:null;
    var slaEl=p.TryGetProperty("sla",out var sl)?sl:default;
    DateTime? SlaWhen(string n)=>slaEl.ValueKind==JsonValueKind.Object&&slaEl.TryGetProperty(n,out var v)&&v.ValueKind==JsonValueKind.String&&DateTime.TryParse(v.GetString(),out var d)?d:null;
    string Fmt(DateTime? value)=>value?.ToString("dd/MM/yyyy HH:mm")??"—";
    var solicitationId=Str("id"); var tenantOrg=Str("tenantId");
    var status=Str("status"); var paused=p.TryGetProperty("paused",out var pv)&&pv.ValueKind==JsonValueKind.True;
    var ativa=status is not ("encerrada" or "cancelada");
    var emAnalise=status is "triagem" or "em_atendimento" or "aguardando_cliente";
    var calendar=slaEl.ValueKind==JsonValueKind.Object&&slaEl.TryGetProperty("calendar",out var cal)?cal.GetString()??"" : "";
    var timezone=slaEl.ValueKind==JsonValueKind.Object&&slaEl.TryGetProperty("timezone",out var tz)?tz.GetString()??"" : "";
    var businessWindow=slaEl.ValueKind==JsonValueKind.Object&&slaEl.TryGetProperty("businessStart",out var bs)&&slaEl.TryGetProperty("businessEnd",out var be)?$"{bs.GetString()}–{be.GetString()}" : "";
    string ServiceLabel(string value)=>value switch { "revisao"=>L.T("admin.svc_review",_c),"adaptacao"=>L.T("admin.svc_adaptation",_c),"esclarecimento"=>L.T("admin.svc_clarification",_c),"suporte_tecnico"=>L.T("admin.svc_tech_support",_c),_=>value };
    string StatusLabel(string value)=>value switch { "aberta"=>L.T("admin.st_open",_c),"triagem"=>L.T("admin.st_triage",_c),"em_atendimento"=>L.T("admin.st_in_service",_c),"aguardando_cliente"=>L.T("admin.st_waiting_customer",_c),"resolvida"=>L.T("admin.st_resolved",_c),"encerrada"=>L.T("admin.st_closed",_c),"cancelada"=>L.T("admin.st_cancelled",_c),_=>value };
    string PriorityLabel(string value)=>value switch { "baixa"=>L.T("sol.priority.baixa",_c),"normal"=>L.T("sol.priority.normal",_c),"alta"=>L.T("sol.priority.alta",_c),"critica"=>L.T("sol.priority.critica",_c),_=>value };
    string EventLabel(string value)=>value switch { "abertura"=>L.T("admin.ev_open",_c),"triagem"=>L.T("admin.ev_triage",_c),"atendimento_inicio"=>L.T("admin.ev_start",_c),"aguardando_cliente"=>L.T("admin.ev_wait",_c),"pausa_sl"=>L.T("admin.ev_pause",_c),"retomada_sl"=>L.T("admin.ev_resume",_c),"retorno_cliente"=>L.T("admin.ev_customer_reply",_c),"resolucao"=>L.T("admin.ev_resolution",_c),"reatribuicao"=>L.T("admin.ev_reassign",_c),"encerramento"=>L.T("admin.ev_closed",_c),"cancelamento"=>L.T("admin.ev_cancelled",_c),"mensagem_cliente"=>L.T("admin.ev_msg_client",_c),"mensagem_odca"=>L.T("admin.ev_msg_odca",_c),"violacao_primeira_resposta"=>L.T("admin.ev_breach_fr",_c),"violacao_resolucao"=>L.T("admin.ev_breach_res",_c),_=>value };
    string JStr(System.Text.Json.JsonElement e,string n)=>e.TryGetProperty(n,out var v)&&v.ValueKind==JsonValueKind.String?v.GetString()??"" : "";
}
<nav class="breadcrumb" aria-label="@L.T("common.breadcrumb_aria",_c)"><a asp-action="Index">@L.T("admin.queue_crumb",_c)</a><span>/</span><span aria-current="page">@Str("protocol")</span></nav>
<header class="page-heading"><div><p class="eyebrow">@Str("organizationName") · @ServiceLabel(Str("service")) · @L.T("admin.eyebrow_protocol",_c,Str("protocol"))</p><h1>@Str("subject")</h1><p>@L.T("admin.opened_by",_c,Str("openedByName"),Fmt(When("openedAt")))</p></div><span class="status-badge status-@status">@StatusLabel(status)</span>@if(paused){<span class="status-badge">@L.T("admin.sla_paused_badge",_c)</span>}</header>
@if(TempData["SolNotice"] is string notice){<div class="alert alert-success" role="status">@notice</div>}@if(TempData["SolError"] is string error){<div class="alert alert-error" role="alert">@error</div>}
@if(SlaWhen("firstResponseBreachAt") is not null||SlaWhen("resolutionBreachAt") is not null){<div class="alert alert-error" role="alert">@L.T("admin.sla_breach_alert",_c)</div>}
<section class="summary-grid" aria-label="@L.T("admin.summary_aria",_c)">
 <article><span>@L.T("common.org",_c)</span><strong>@Str("organizationName")</strong></article>
 <article><span>@L.T("common.priority",_c)</span><strong>@PriorityLabel(Str("priority"))</strong></article>
 <article><span>@L.T("common.responsible",_c)</span><strong>@(string.IsNullOrWhiteSpace(Str("assigneeName"))?L.T("admin.no_assignee",_c):Str("assigneeName"))</strong></article>
 <article><span>@L.T("admin.sla_calendar",_c)</span><strong>@(calendar=="continuo"?L.T("admin.sla_24x7",_c):L.T("admin.sla_business_days",_c))</strong><small>@L.T("admin.fuso",_c) @timezone@if(!string.IsNullOrWhiteSpace(businessWindow)){<text> · @L.T("admin.janela",_c) @businessWindow</text>}</small></article>
 <article><span>@L.T("admin.fr_until",_c)</span><strong>@Fmt(SlaWhen("firstResponseDueAt"))</strong>@if(SlaWhen("firstResponseBreachAt") is not null){<small>@L.T("admin.breached_at",_c,Fmt(SlaWhen("firstResponseBreachAt")))</small>}else if(When("firstResponseAt") is DateTime fr){<small>@L.T("admin.met_at",_c,Fmt(fr))</small>}</article>
 <article><span>@L.T("admin.resolution_until",_c)</span><strong>@Fmt(SlaWhen("resolutionDueAt"))</strong>@if(SlaWhen("resolutionBreachAt") is not null){<small>@L.T("admin.breached_at",_c,Fmt(SlaWhen("resolutionBreachAt")))</small>}else if(When("resolvedAt") is DateTime res){<small>@L.T("admin.resolved_at",_c,Fmt(res))</small>}</article>
 @if(paused){<article><span>@L.T("admin.sla_paused_since",_c)</span><strong>@Fmt(When("pausedAt"))</strong><small>@Str("pauseReason")</small></article>}
 @if(!string.IsNullOrWhiteSpace(Str("cancellationReason"))){<article><span>@L.T("admin.cancellation_reason_label",_c)</span><strong>@Str("cancellationReason")</strong></article>}
</section>
<div class="workspace-grid">
 <section>
  <h2>@L.T("admin.submitted_description",_c)</h2>
  <article class="comment-card"><header><strong>@Str("openedByName")</strong><span>@Str("organizationName")</span></header><p>@Str("body")</p><small>@Fmt(When("openedAt"))</small></article>
  <h2>@L.T("admin.conversation",_c)</h2>
  @if(p.TryGetProperty("messages",out var msgs)&&msgs.ValueKind==System.Text.Json.JsonValueKind.Array){
   @foreach(var m in msgs.EnumerateArray()){
    <article class="comment-card @(JStr(m,"authorKind")=="odca"?"internal-note":null)"><header><strong>@JStr(m,"authorName")</strong><span>@(JStr(m,"authorKind")=="odca"?L.T("admin.odca_team",_c):L.T("admin.client",_c))</span></header><p>@JStr(m,"body")</p><small>@(DateTime.TryParse(JStr(m,"createdAt"),out var mc)?mc.ToString("dd/MM/yyyy HH:mm"):"")</small></article>
   }
  }
  @if(ativa){
   @if(status=="aberta"){<p><small>@L.T("admin.triage_hint",_c)</small></p>}
   else{
    <form method="post" asp-action="AddMessage" asp-route-solicitationId="@solicitationId" data-prevent-double-submit>
     @Html.AntiForgeryToken()
     <input type="hidden" name="tenantId" value="@tenantOrg" />
     <input type="hidden" name="expectedVersion" value="@Version" />
     <label for="body">@L.T("admin.reply_label",_c) <span aria-hidden="true">*</span></label>
     <textarea id="body" name="body" required maxlength="8000"></textarea>
     <button class="button button-primary" type="submit">@L.T("admin.send_reply",_c)</button>
    </form>
   }
  }
 </section>
 <aside>
  <h2>@L.T("admin.timeline",_c)</h2>
  <ol class="timeline">
   @if(p.TryGetProperty("events",out var evts)&&evts.ValueKind==System.Text.Json.JsonValueKind.Array){
    @foreach(var e in evts.EnumerateArray()){
     var details=e.TryGetProperty("details",out var d)?d:default;
     var note=!string.IsNullOrWhiteSpace(JStr(details,"justificativa"))?JStr(details,"justificativa"):!string.IsNullOrWhiteSpace(JStr(details,"solucao"))?JStr(details,"solucao"):!string.IsNullOrWhiteSpace(JStr(details,"motivo"))?JStr(details,"motivo"):"";
     var actor=JStr(e,"actorName");
     <li><strong>@EventLabel(JStr(e,"eventType"))</strong>@if(!string.IsNullOrWhiteSpace(note)){<p>@note</p>}<span>@(string.IsNullOrWhiteSpace(actor)?L.T("admin.system_odca",_c):actor) · @(DateTime.TryParse(JStr(e,"occurredAt"),out var oc)?oc.ToString("dd/MM/yyyy HH:mm"):"")</span></li>
    }
   }
  </ol>
 </aside>
</div>
@if(ativa){
 <section class="help-card" aria-labelledby="odca-actions-title">
  <h2 id="odca-actions-title">@L.T("admin.actions_title",_c)</h2>
  <p>@L.T("admin.actions_body",_c)</p>
  @if(status=="aberta"){
   <form method="post" asp-action="Act" asp-route-solicitationId="@solicitationId" data-prevent-double-submit>
    @Html.AntiForgeryToken()<input type="hidden" name="tenantId" value="@tenantOrg" /><input type="hidden" name="expectedVersion" value="@Version" /><input type="hidden" name="action" value="triar" />
    <label for="triagePriority">@L.T("admin.triage_priority",_c) <span aria-hidden="true">*</span></label>
    <select id="triagePriority" name="priority" required>
     <option value="baixa">@L.T("sol.priority.baixa",_c)</option><option value="normal" selected>@L.T("sol.priority.normal",_c)</option><option value="alta">@L.T("sol.priority.alta",_c)</option><option value="critica">@L.T("sol.priority.critica",_c)</option>
    </select>
    <button class="button button-primary" type="submit">@L.T("admin.take_triage",_c)</button>
   </form>
  }
  @if(status=="triagem"){
   <form method="post" asp-action="Act" asp-route-solicitationId="@solicitationId" data-prevent-double-submit>
    @Html.AntiForgeryToken()<input type="hidden" name="tenantId" value="@tenantOrg" /><input type="hidden" name="expectedVersion" value="@Version" /><input type="hidden" name="action" value="iniciar" />
    <button class="button button-primary" type="submit">@L.T("admin.start_service",_c)</button>
   </form>
  }
  @if(emAnalise&&!paused){
   <form method="post" asp-action="Act" asp-route-solicitationId="@solicitationId" data-prevent-double-submit>
    @Html.AntiForgeryToken()<input type="hidden" name="tenantId" value="@tenantOrg" /><input type="hidden" name="expectedVersion" value="@Version" /><input type="hidden" name="action" value="aguardar" />
    <label for="waitText">@L.T("admin.wait_label",_c) <span aria-hidden="true">*</span></label>
    <textarea id="waitText" name="text" required minlength="5" maxlength="2000"></textarea>
    <button class="button button-quiet" type="submit">@L.T("admin.wait_btn",_c)</button>
   </form>
   <form method="post" asp-action="Act" asp-route-solicitationId="@solicitationId" data-prevent-double-submit>
    @Html.AntiForgeryToken()<input type="hidden" name="tenantId" value="@tenantOrg" /><input type="hidden" name="expectedVersion" value="@Version" /><input type="hidden" name="action" value="pausar" />
    <label for="pauseText">@L.T("admin.pause_label",_c) <span aria-hidden="true">*</span></label>
    <textarea id="pauseText" name="text" required minlength="5" maxlength="2000"></textarea>
    <button class="button button-quiet" type="submit">@L.T("admin.pause_btn",_c)</button>
   </form>
   <form method="post" asp-action="Act" asp-route-solicitationId="@solicitationId" data-prevent-double-submit>
    @Html.AntiForgeryToken()<input type="hidden" name="tenantId" value="@tenantOrg" /><input type="hidden" name="expectedVersion" value="@Version" /><input type="hidden" name="action" value="resolver" />
    <label for="resolveText">@L.T("admin.resolve_label",_c) <span aria-hidden="true">*</span></label>
    <textarea id="resolveText" name="text" required minlength="5" maxlength="4000"></textarea>
    <button class="button button-primary" type="submit">@L.T("admin.resolve_btn",_c)</button>
   </form>
   <form method="post" asp-action="Act" asp-route-solicitationId="@solicitationId" data-prevent-double-submit>
    @Html.AntiForgeryToken()<input type="hidden" name="tenantId" value="@tenantOrg" /><input type="hidden" name="expectedVersion" value="@Version" /><input type="hidden" name="action" value="reatribuir" />
    <label for="assigneeInput">@L.T("admin.reassign_label",_c) <span aria-hidden="true">*</span></label>
    <input id="assigneeInput" name="assigneeUserId" required maxlength="36" placeholder="00000000-0000-0000-0000-000000000000" />
    <button class="button button-quiet" type="submit">@L.T("admin.reassign_btn",_c)</button>
   </form>
  }
  @if(paused){
   <form method="post" asp-action="Act" asp-route-solicitationId="@solicitationId" data-prevent-double-submit>
    @Html.AntiForgeryToken()<input type="hidden" name="tenantId" value="@tenantOrg" /><input type="hidden" name="expectedVersion" value="@Version" /><input type="hidden" name="action" value="retomar" />
    <button class="button button-primary" type="submit">@L.T("admin.resume_btn",_c)</button>
   </form>
  }
  <form method="post" asp-action="Act" asp-route-solicitationId="@solicitationId" data-prevent-double-submit>
   @Html.AntiForgeryToken()<input type="hidden" name="tenantId" value="@tenantOrg" /><input type="hidden" name="expectedVersion" value="@Version" /><input type="hidden" name="action" value="cancelar" />
   <label for="cancelText">@L.T("admin.cancel_label",_c) <span aria-hidden="true">*</span></label>
   <textarea id="cancelText" name="text" required minlength="5" maxlength="2000"></textarea>
   <button class="button button-danger" type="submit">@L.T("admin.cancel_btn",_c)</button>
  </form>
 </section>
}
