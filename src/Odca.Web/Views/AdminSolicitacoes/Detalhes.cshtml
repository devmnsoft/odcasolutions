@model System.Text.Json.JsonElement
@{
    var p=Model;
    string Str(string n)=>p.TryGetProperty(n,out var v)&&v.ValueKind==JsonValueKind.String?v.GetString()??"" : "";
    long Version=p.TryGetProperty("rowVersion",out var rv)&&rv.ValueKind==JsonValueKind.Number?rv.GetInt64():0;
    DateTime? When(string n)=>p.TryGetProperty(n,out var v)&&v.ValueKind==JsonValueKind.String&&DateTime.TryParse(v.GetString(),out var d)?d:null;
    var slaEl=p.TryGetProperty("sla",out var sl)?sl:default;
    DateTime? SlaWhen(string n)=>slaEl.ValueKind==JsonValueKind.Object&&slaEl.TryGetProperty(n,out var v)&&v.ValueKind==JsonValueKind.String&&DateTime.TryParse(v.GetString(),out var d)?d:null;
    string Fmt(DateTime? value)=>value?.ToString("dd/MM/yyyy HH:mm")??"—";
    var solicitationId=Str("id"); var tenantOrg=Str("tenantId");
    var status=Str("status"); var paused=p.TryGetProperty("paused",out var pv)&&pv.ValueKind==JsonValueKind.True;
    var ativa=status is not ("encerrada" or "cancelada");
    var emAnalise=status is "triagem" or "em_atendimento" or "aguardando_cliente";
    var calendar=slaEl.ValueKind==JsonValueKind.Object&&slaEl.TryGetProperty("calendar",out var cal)?cal.GetString()??"" : "";
    var timezone=slaEl.ValueKind==JsonValueKind.Object&&slaEl.TryGetProperty("timezone",out var tz)?tz.GetString()??"" : "";
    var businessWindow=slaEl.ValueKind==JsonValueKind.Object&&slaEl.TryGetProperty("businessStart",out var bs)&&slaEl.TryGetProperty("businessEnd",out var be)?$"{bs.GetString()}–{be.GetString()}" : "";
    string ServiceLabel(string value)=>value switch { "revisao"=>"Revisão","adaptacao"=>"Adaptação","esclarecimento"=>"Esclarecimento","suporte_tecnico"=>"Suporte técnico",_=>value };
    string StatusLabel(string value)=>value switch { "aberta"=>"Aberta","triagem"=>"Em triagem","em_atendimento"=>"Em atendimento","aguardando_cliente"=>"Aguardando cliente","resolvida"=>"Resolvida","encerrada"=>"Encerrada","cancelada"=>"Cancelada",_=>value };
    string PriorityLabel(string value)=>value switch { "baixa"=>"Baixa","normal"=>"Normal","alta"=>"Alta","critica"=>"Crítica",_=>value };
    string EventLabel(string value)=>value switch { "abertura"=>"Solicitação aberta","triagem"=>"Triagem realizada","atendimento_inicio"=>"Atendimento iniciado","aguardando_cliente"=>"Aguardando cliente","pausa_sl"=>"SLA pausado","retomada_sl"=>"SLA retomado","retorno_cliente"=>"Cliente respondeu e o SLA retomou","resolucao"=>"Resolução registrada","reatribuicao"=>"Atendimento reatribuído","encerramento"=>"Solicitação encerrada pelo cliente","cancelamento"=>"Solicitação cancelada","mensagem_cliente"=>"Mensagem do cliente","mensagem_odca"=>"Resposta da ODCA","violacao_primeira_resposta"=>"Violação do prazo de primeira resposta","violacao_resolucao"=>"Violação do prazo de resolução",_=>value };
    string JStr(System.Text.Json.JsonElement e,string n)=>e.TryGetProperty(n,out var v)&&v.ValueKind==JsonValueKind.String?v.GetString()??"" : "";
}
<nav class="breadcrumb" aria-label="Navegação estrutural"><a asp-action="Index">Atendimento ODCA</a><span>/</span><span aria-current="page">@Str("protocol")</span></nav>
<header class="page-heading"><div><p class="eyebrow">@Str("organizationName") · @ServiceLabel(Str("service")) · Protocolo @Str("protocol")</p><h1>@Str("subject")</h1><p>Aberta por @Str("openedByName") em @Fmt(When("openedAt")).</p></div><span class="status-badge status-@status">@StatusLabel(status)</span>@if(paused){<span class="status-badge">SLA pausado</span>}</header>
@if(TempData["SolNotice"] is string notice){<div class="alert alert-success" role="status">@notice</div>}@if(TempData["SolError"] is string error){<div class="alert alert-error" role="alert">@error</div>}
@if(SlaWhen("firstResponseBreachAt") is not null||SlaWhen("resolutionBreachAt") is not null){<div class="alert alert-error" role="alert">Prazo de SLA violado nesta solicitação.</div>}
<section class="summary-grid" aria-label="Resumo da solicitação">
 <article><span>Organização</span><strong>@Str("organizationName")</strong></article>
 <article><span>Prioridade</span><strong>@PriorityLabel(Str("priority"))</strong></article>
 <article><span>Responsável</span><strong>@(string.IsNullOrWhiteSpace(Str("assigneeName"))?"Sem responsável":Str("assigneeName"))</strong></article>
 <article><span>Calendário de SLA</span><strong>@(calendar=="continuo"?"24×7 contínuo":"Dias úteis")</strong><small>Fuso @timezone@if(!string.IsNullOrWhiteSpace(businessWindow)){<text> · Janela @businessWindow</text>}</small></article>
 <article><span>Primeira resposta até</span><strong>@Fmt(SlaWhen("firstResponseDueAt"))</strong>@if(SlaWhen("firstResponseBreachAt") is not null){<small>Violada em @Fmt(SlaWhen("firstResponseBreachAt"))</small>}else if(When("firstResponseAt") is DateTime fr){<small>Cumprida em @Fmt(fr)</small>}</article>
 <article><span>Resolução até</span><strong>@Fmt(SlaWhen("resolutionDueAt"))</strong>@if(SlaWhen("resolutionBreachAt") is not null){<small>Violada em @Fmt(SlaWhen("resolutionBreachAt"))</small>}else if(When("resolvedAt") is DateTime res){<small>Resolvida em @Fmt(res)</small>}</article>
 @if(paused){<article><span>SLA pausado desde</span><strong>@Fmt(When("pausedAt"))</strong><small>@Str("pauseReason")</small></article>}
 @if(!string.IsNullOrWhiteSpace(Str("cancellationReason"))){<article><span>Motivo do cancelamento</span><strong>@Str("cancellationReason")</strong></article>}
</section>
<div class="workspace-grid">
 <section>
  <h2>Descrição enviada</h2>
  <article class="comment-card"><header><strong>@Str("openedByName")</strong><span>@Str("organizationName")</span></header><p>@Str("body")</p><small>@Fmt(When("openedAt"))</small></article>
  <h2>Conversa</h2>
  @if(p.TryGetProperty("messages",out var msgs)&&msgs.ValueKind==System.Text.Json.JsonValueKind.Array){
   @foreach(var m in msgs.EnumerateArray()){
    <article class="comment-card @(JStr(m,"authorKind")=="odca"?"internal-note":null)"><header><strong>@JStr(m,"authorName")</strong><span>@(JStr(m,"authorKind")=="odca"?"Equipe ODCA":"Cliente")</span></header><p>@JStr(m,"body")</p><small>@(DateTime.TryParse(JStr(m,"createdAt"),out var mc)?mc.ToString("dd/MM/yyyy HH:mm"):"")</small></article>
   }
  }
  @if(ativa){
   @if(status=="aberta"){<p><small>Faça a triagem antes de responder ao cliente — a primeira resposta do SLA é registrada na resposta.</small></p>}
   else{
    <form method="post" asp-action="AddMessage" asp-route-solicitationId="@solicitationId" data-prevent-double-submit>
     @Html.AntiForgeryToken()
     <input type="hidden" name="tenantId" value="@tenantOrg" />
     <input type="hidden" name="expectedVersion" value="@Version" />
     <label for="body">Resposta ao cliente <span aria-hidden="true">*</span></label>
     <textarea id="body" name="body" required maxlength="8000"></textarea>
     <button class="button button-primary" type="submit">Enviar resposta</button>
    </form>
   }
  }
 </section>
 <aside>
  <h2>Linha do tempo</h2>
  <ol class="timeline">
   @if(p.TryGetProperty("events",out var evts)&&evts.ValueKind==System.Text.Json.JsonValueKind.Array){
    @foreach(var e in evts.EnumerateArray()){
     var details=e.TryGetProperty("details",out var d)?d:default;
     var note=!string.IsNullOrWhiteSpace(JStr(details,"justificativa"))?JStr(details,"justificativa"):!string.IsNullOrWhiteSpace(JStr(details,"solucao"))?JStr(details,"solucao"):!string.IsNullOrWhiteSpace(JStr(details,"motivo"))?JStr(details,"motivo"):"";
     var actor=JStr(e,"actorName");
     <li><strong>@EventLabel(JStr(e,"eventType"))</strong>@if(!string.IsNullOrWhiteSpace(note)){<p>@note</p>}<span>@(string.IsNullOrWhiteSpace(actor)?"Sistema ODCA":actor) · @(DateTime.TryParse(JStr(e,"occurredAt"),out var oc)?oc.ToString("dd/MM/yyyy HH:mm"):"")</span></li>
    }
   }
  </ol>
 </aside>
</div>
@if(ativa){
 <section class="help-card" aria-labelledby="odca-actions-title">
  <h2 id="odca-actions-title">Ações de atendimento</h2>
  <p>Pausas e esperas exigem justificativa e param o relógio de SLA; a retomada desloca os vencimentos pelo tempo pausado. Reatribuir não reinicia o relógio.</p>
  @if(status=="aberta"){
   <form method="post" asp-action="Act" asp-route-solicitationId="@solicitationId" data-prevent-double-submit>
    @Html.AntiForgeryToken()<input type="hidden" name="tenantId" value="@tenantOrg" /><input type="hidden" name="expectedVersion" value="@Version" /><input type="hidden" name="action" value="triar" />
    <label for="triagePriority">Prioridade na triagem <span aria-hidden="true">*</span></label>
    <select id="triagePriority" name="priority" required>
     <option value="baixa">Baixa</option><option value="normal" selected>Normal</option><option value="alta">Alta</option><option value="critica">Crítica</option>
    </select>
    <button class="button button-primary" type="submit">Assumir triagem</button>
   </form>
  }
  @if(status=="triagem"){
   <form method="post" asp-action="Act" asp-route-solicitationId="@solicitationId" data-prevent-double-submit>
    @Html.AntiForgeryToken()<input type="hidden" name="tenantId" value="@tenantOrg" /><input type="hidden" name="expectedVersion" value="@Version" /><input type="hidden" name="action" value="iniciar" />
    <button class="button button-primary" type="submit">Iniciar atendimento</button>
   </form>
  }
  @if(emAnalise&&!paused){
   <form method="post" asp-action="Act" asp-route-solicitationId="@solicitationId" data-prevent-double-submit>
    @Html.AntiForgeryToken()<input type="hidden" name="tenantId" value="@tenantOrg" /><input type="hidden" name="expectedVersion" value="@Version" /><input type="hidden" name="action" value="aguardar" />
    <label for="waitText">O que falta do cliente? <span aria-hidden="true">*</span></label>
    <textarea id="waitText" name="text" required minlength="5" maxlength="2000"></textarea>
    <button class="button button-quiet" type="submit">Aguardar cliente (pausa o SLA)</button>
   </form>
   <form method="post" asp-action="Act" asp-route-solicitationId="@solicitationId" data-prevent-double-submit>
    @Html.AntiForgeryToken()<input type="hidden" name="tenantId" value="@tenantOrg" /><input type="hidden" name="expectedVersion" value="@Version" /><input type="hidden" name="action" value="pausar" />
    <label for="pauseText">Justificativa da pausa <span aria-hidden="true">*</span></label>
    <textarea id="pauseText" name="text" required minlength="5" maxlength="2000"></textarea>
    <button class="button button-quiet" type="submit">Pausar SLA</button>
   </form>
   <form method="post" asp-action="Act" asp-route-solicitationId="@solicitationId" data-prevent-double-submit>
    @Html.AntiForgeryToken()<input type="hidden" name="tenantId" value="@tenantOrg" /><input type="hidden" name="expectedVersion" value="@Version" /><input type="hidden" name="action" value="resolver" />
    <label for="resolveText">Resumo da solução enviado ao cliente <span aria-hidden="true">*</span></label>
    <textarea id="resolveText" name="text" required minlength="5" maxlength="4000"></textarea>
    <button class="button button-primary" type="submit">Marcar como resolvida</button>
   </form>
   <form method="post" asp-action="Act" asp-route-solicitationId="@solicitationId" data-prevent-double-submit>
    @Html.AntiForgeryToken()<input type="hidden" name="tenantId" value="@tenantOrg" /><input type="hidden" name="expectedVersion" value="@Version" /><input type="hidden" name="action" value="reatribuir" />
    <label for="assigneeInput">Novo responsável (ID de usuário da plataforma) <span aria-hidden="true">*</span></label>
    <input id="assigneeInput" name="assigneeUserId" required maxlength="36" placeholder="00000000-0000-0000-0000-000000000000" />
    <button class="button button-quiet" type="submit">Reatribuir atendimento</button>
   </form>
  }
  @if(paused){
   <form method="post" asp-action="Act" asp-route-solicitationId="@solicitationId" data-prevent-double-submit>
    @Html.AntiForgeryToken()<input type="hidden" name="tenantId" value="@tenantOrg" /><input type="hidden" name="expectedVersion" value="@Version" /><input type="hidden" name="action" value="retomar" />
    <button class="button button-primary" type="submit">Retomar SLA</button>
   </form>
  }
  <form method="post" asp-action="Act" asp-route-solicitationId="@solicitationId" data-prevent-double-submit>
   @Html.AntiForgeryToken()<input type="hidden" name="tenantId" value="@tenantOrg" /><input type="hidden" name="expectedVersion" value="@Version" /><input type="hidden" name="action" value="cancelar" />
   <label for="cancelText">Motivo do cancelamento pela ODCA <span aria-hidden="true">*</span></label>
   <textarea id="cancelText" name="text" required minlength="5" maxlength="2000"></textarea>
   <button class="button button-danger" type="submit">Cancelar solicitação</button>
  </form>
 </section>
}
