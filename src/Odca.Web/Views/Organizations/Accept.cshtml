@model Odca.Contracts.Tenancy.AcceptInvitationRequest
@{ViewData["Title"]="Aceitar convite";}
<section class="auth-card"><span class="eyebrow">Acesso à organização</span><h1>Confirmar convite</h1><p>A conta autenticada deve ter o mesmo e-mail verificado do destinatário. Depois da confirmação, encerraremos esta sessão e você deverá entrar novamente para carregar o novo acesso.</p><div asp-validation-summary="All" class="validation-summary" role="alert"></div><form method="post" data-processing><input type="hidden" asp-for="InvitationId"/><input type="hidden" asp-for="Token"/><button class="button button-primary button-block" type="submit" data-processing-label="Confirmando…">Confirmar e encerrar sessão</button></form></section>
