@model AcceptInvitationViewModel
@{
    ViewData["Title"] = L.T("org.accept_title", (string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey]);
    var _c = (string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey];
    var hasToken = !string.IsNullOrWhiteSpace(Model.Token) && Model.InvitationId != Guid.Empty;
}
<section class="auth-card card narrow">
    <span class="eyebrow">@L.T("org.accept_eyebrow", _c)</span>
    <h1>@L.T("org.accept_title", _c)</h1>
    <details class="help-card"><summary>@L.T("common.how_to_use", _c)</summary><ol><li>@L.T("org.accept_manual_1", _c)</li><li>@L.T("org.accept_manual_2", _c)</li></ol></details>

    @if (Model.Preview is not null)
    {
        <p>@L.T("org.accept_invited_1", _c)<strong>@Model.Preview.OrganizationName</strong>@L.T("org.accept_invited_2", _c)<strong>@Model.Preview.RoleName</strong>.</p>
        <p class="muted">@L.T("org.accept_destination", _c, Model.Preview.RecipientEmail, CulturedTime.DateTime(Model.Preview.ExpiresAt.ToLocalTime(), _c))</p>
    }
    else if (hasToken)
    {
        <p>@L.T("org.accept_preview_unavailable", _c)</p>
    }
    else
    {
        <p>@L.T("org.accept_link_incomplete", _c)</p>
    }

    <div asp-validation-summary="All" class="validation-summary" role="alert"></div>

    @if (!Model.IsAuthenticated)
    {
        <div class="empty-state">
            <h2>@L.T("org.accept_login_title", _c)</h2>
            <p>@L.T("org.accept_login_body", _c)</p>
            <div class="toolbar">
                <a class="button button-primary" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">@L.T("support.imp_enter", _c)</a>
                <a class="button" asp-controller="Catalog" asp-action="Plans">@L.T("org.view_plans_optional", _c)</a>
            </div>
        </div>
    }
    else if (hasToken)
    {
        <p class="muted">@L.T("org.accept_signout_note", _c)</p>
        <form asp-action="Accept" method="post" data-processing>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="InvitationId" />
            <input type="hidden" asp-for="Token" />
            <button class="button button-primary button-block" type="submit" data-processing-label="@L.T("org.accepting", _c)">@L.T("org.accept_title", _c)</button>
        </form>
    }
</section>
