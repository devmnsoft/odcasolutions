@model Odca.Contracts.Tenancy.OrganizationSummary[]
@{
    ViewData["Title"] = "Escolher organização";
}
<section class="page-heading">
    <div>
        <span class="eyebrow">Contexto de trabalho</span>
        <h1>Escolha uma organização</h1>
        <p>Cada página mantém a organização no endereço para evitar ações no contexto errado. Busque pelo nome — não é necessário informar identificadores técnicos.</p>
    </div>
</section>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success" role="status">@success</div>
}

@if (Model.Length > 0)
{
    <div class="toolbar">
        <label class="form-inline">
            <span class="sr-only">Filtrar organizações</span>
            <input type="search" data-org-filter placeholder="Filtrar por nome" autocomplete="off" />
        </label>
    </div>
    <div class="card-grid" data-org-list>
        @foreach (var item in Model)
        {
            <article class="card" data-org-name="@item.Name.ToLowerInvariant()">
                <h2>@item.Name</h2>
                <p>Estado: <span class="badge">@TenancyDisplay.OrganizationStatus(item.Status)</span></p>
                <div class="toolbar">
                    <a class="button button-primary" asp-action="Team" asp-route-tenantId="@item.Id">Abrir equipe</a>
                    @if (item.Permissions.Contains("tenant.organization.manage"))
                    {
                        <a class="button" asp-action="Edit" asp-route-tenantId="@item.Id">Editar cadastro</a>
                    }
                </div>
            </article>
        }
    </div>
    <div class="empty-state" data-org-empty hidden>
        <h2>Nenhuma organização correspondente</h2>
        <p>Ajuste o filtro ou limpe a busca para ver todas as organizações disponíveis.</p>
    </div>
}
else
{
    <div class="empty-state card">
        <h2>Nenhum acesso ativo</h2>
        <p>Seu vínculo pode ter sido suspenso, bloqueado ou revogado. Se você recebeu um convite, aceite-o com a conta do e-mail convidado.</p>
    </div>
}
