@model Odca.Contracts.Tenancy.OrganizationSummary[]
@{
    ViewData["Title"] = L.T("org.pick_title", (string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey]);
    var _c = (string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey];
}
<section class="card help-card">
    <h2>@L.T("common.how_to_use", _c)</h2>
    <p>@L.T("org.pick_help", _c)</p>
</section>
<section class="page-heading">
    <div>
        <span class="eyebrow">@L.T("org.context_eyebrow", _c)</span>
        <h1>@L.T("org.pick_h1", _c)</h1>
        <p>@L.T("org.pick_subtitle", _c)</p>
    </div>
</section>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success" role="status">@success</div>
}

@if (Model.Length > 0)
{
    <div class="toolbar">
        <label class="form-inline">
            <span class="sr-only">@L.T("org.filter_aria", _c)</span>
            <input type="search" data-org-filter placeholder="@L.T("org.filter_by_name", _c)" autocomplete="off" />
        </label>
    </div>
    <div class="card-grid" data-org-list>
        @foreach (var item in Model)
        {
            <article class="card" data-org-name="@item.Name.ToLowerInvariant()">
                <h2>@item.Name</h2>
                <p>@L.T("org.state_prefix", _c)<span class="badge">@TenancyDisplay.OrganizationStatus(item.Status, k => L.T(k, _c))</span></p>
                <div class="toolbar">
                    <a class="button button-primary" asp-action="Team" asp-route-tenantId="@item.Id">@L.T("org.open_team", _c)</a>
                    @if (item.Permissions.Contains("tenant.organization.manage"))
                    {
                        <a class="button" asp-action="Edit" asp-route-tenantId="@item.Id">@L.T("org.open_record", _c)</a>
                    }
                </div>
            </article>
        }
    </div>
    <div class="empty-state" data-org-empty hidden>
        <h2>@L.T("org.empty_match_title", _c)</h2>
        <p>@L.T("org.empty_match_body", _c)</p>
    </div>
}
else
{
    <div class="empty-state card">
        <h2>@L.T("org.empty_access_title", _c)</h2>
        <p>@L.T("org.empty_access_body", _c)</p>
    </div>
}
