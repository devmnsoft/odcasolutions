@model EditOrganizationViewModel
@{
    ViewData["Title"] = L.T("org.edit_title", (string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey]);
    var _c = (string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey];
}
<section class="page-heading">
    <div>
        <span class="eyebrow">@L.T("org.edit_eyebrow", _c)</span>
        <h1>@L.T("org.edit_title", _c)</h1>
        <p>@L.T("org.edit_subtitle", _c)</p>
    </div>
    <a class="button" asp-action="Team" asp-route-tenantId="@Model.TenantId">@L.T("org.back_to_team", _c)</a>
</section>
<details class="help-card"><summary>@L.T("common.how_to_use", _c)</summary><ol><li>@L.T("org.manual_1", _c)</li><li>@L.T("org.manual_2", _c)</li><li>@L.T("org.manual_3", _c)</li></ol></details>

@if (Model.VersionConflict)
{
    <div class="alert alert-error" role="alert">
        @L.T("org.version_conflict_alert", _c)
        <a asp-action="Edit" asp-route-tenantId="@Model.TenantId">@L.T("org.reload_record", _c)</a>
    </div>
}

<section class="card" data-dirty-form>
    <form asp-action="Edit" asp-route-tenantId="@Model.TenantId" method="post" novalidate data-processing>
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="validation-summary" role="alert"></div>
        <input type="hidden" asp-for="TenantId" />
        <input type="hidden" asp-for="Version" />
        <input type="hidden" asp-for="Status" />
        <div class="form-grid">
            <label asp-for="Name">
                @L.T("org.th_name", _c)
                <input asp-for="Name" maxlength="160" autocomplete="organization" />
                <span asp-validation-for="Name" class="validation"></span>
            </label>
            <label asp-for="Timezone">
                @L.T("org.f_timezone", _c)
                <input asp-for="Timezone" maxlength="80" list="timezone-suggestions" />
                <span asp-validation-for="Timezone" class="validation"></span>
            </label>
            <label asp-for="ActivityProfile">
                @L.T("org.f_activity_profile", _c)
                <select asp-for="ActivityProfile">
                    <option value="general">@L.T("org.ap_general", _c)</option>
                    <option value="therapy_clinic">@L.T("org.ap_therapy_clinic", _c)</option>
                    <option value="plastic_surgery">@L.T("org.ap_plastic_surgery", _c)</option>
                </select>
                <span asp-validation-for="ActivityProfile" class="validation"></span>
            </label>
        </div>
        <datalist id="timezone-suggestions">
            <option value="America/Sao_Paulo"></option>
            <option value="America/Manaus"></option>
            <option value="America/Belem"></option>
            <option value="America/Fortaleza"></option>
            <option value="America/Recife"></option>
            <option value="America/Cuiaba"></option>
            <option value="UTC"></option>
        </datalist>
        <p class="muted">@L.T("org.current_state", _c)@TenancyDisplay.OrganizationStatus(Model.Status, k => L.T(k, _c))</p>
        <div class="toolbar">
            <button class="button button-primary" type="submit" data-processing-label="@L.T("org.saving", _c)">@L.T("action.save", _c)</button>
            <a class="button" asp-action="Team" asp-route-tenantId="@Model.TenantId">@L.T("action.cancel", _c)</a>
        </div>
    </form>
</section>
