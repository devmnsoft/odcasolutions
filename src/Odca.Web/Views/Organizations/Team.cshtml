@model Odca.Web.Models.TeamPageViewModel
@{ViewData["Title"]="Equipe e perfis";}
<section class="page-heading"><div><span class="eyebrow">@Model.Organization.Name</span><h1>Equipe e perfis</h1><p>Vínculos e permissões válidos somente nesta organização.</p></div></section>
@if(TempData["Success"] is string success){<div class="alert alert-success" role="status">@success</div>}
@if(TempData["Error"] is string error){<div class="alert alert-error" role="alert">@error</div>}
<nav class="tabs" aria-label="Áreas da equipe"><a class="active" href="#pessoas" aria-current="page">Pessoas</a><a href="#convites">Convites</a><a href="#perfis">Perfis</a></nav>
<div class="card-grid">
<section class="card" id="convites"><h2>Convidar pessoa</h2><p class="muted">O convite reserva uma vaga. Enfileirado não significa entregue.</p><form asp-action="Invite" asp-route-tenantId="@Model.Organization.Id" method="post" data-processing><input type="hidden" name="TenantId" value="@Model.Organization.Id"/><input type="hidden" name="IdempotencyKey" value="@Model.IdempotencyKey"/><div class="form-grid"><label>E-mail<input name="Email" value="@Model.InviteEmail" type="email" required autocomplete="email"/></label><label>Perfil<select name="RoleId" required><option value="">Selecione</option>@foreach(var role in Model.Roles){<option value="@role.Id" selected="@(Model.InviteRoleId==role.Id)">@role.Name</option>}</select></label></div><button class="button button-primary" type="submit" data-processing-label="Enfileirando…">Enviar convite</button></form></section>
<section class="card" id="perfis"><h2>Novo perfil</h2><form asp-action="CreateRole" asp-route-tenantId="@Model.Organization.Id" method="post" data-processing><label>Nome<input name="name" required maxlength="100"/></label><fieldset><legend>Permissões</legend><label class="checkbox-line"><input type="checkbox" name="permissions" value="tenant.organization.read"/> <span>Consultar organização</span></label><label class="checkbox-line"><input type="checkbox" name="permissions" value="tenant.team.read"/> <span>Consultar equipe</span></label></fieldset><button class="button" type="submit">Criar perfil</button></form></section>
</div>
<section class="card" id="pessoas"><form method="get" class="filter-toolbar"><label>Buscar<input name="search" value="@Model.Search"/></label><label>Estado<select name="status"><option value="">Todos</option><option value="active" selected="@(Model.Status=="active")">Ativo</option><option value="blocked" selected="@(Model.Status=="blocked")">Bloqueado</option><option value="inactive" selected="@(Model.Status=="inactive")">Inativo</option></select></label><div class="filter-actions"><button class="button button-primary" type="submit">Filtrar</button><a class="button button-link" asp-action="Team" asp-route-tenantId="@Model.Organization.Id">Limpar</a></div></form><div class="table-wrap"><table><thead><tr><th>Nome</th><th>E-mail</th><th>Estado</th><th>Perfis</th></tr></thead><tbody>@if(Model.Members.Length==0){<tr><td colspan="4" class="empty-cell">Nenhuma pessoa encontrada para os filtros informados.</td></tr>}@foreach(var member in Model.Members){var statusLabel=member.Status switch{"active"=>"Ativo","blocked"=>"Bloqueado","inactive"=>"Inativo",_=>member.Status};<tr><td data-label="Nome">@member.Name</td><td data-label="E-mail">@member.Email</td><td data-label="Estado"><span class="status-badge status-@member.Status">@statusLabel</span></td><td data-label="Perfis">@string.Join(", ",member.Roles)</td></tr>}</tbody></table></div></section>
