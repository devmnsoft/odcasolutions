@model Odca.Web.Models.TeamPageViewModel
@{ViewData["Title"]="Equipe e perfis";}
<section class="page-heading"><div><span class="eyebrow">@Model.Organization.Name</span><h1>Equipe e perfis</h1><p>Vínculos e permissões válidos somente nesta organização.</p></div></section>
@if(TempData["Success"] is string success){<div class="alert alert-success" role="status">@success</div>}
@if(TempData["Error"] is string error){<div class="alert alert-error" role="alert">@error</div>}
<section class="card"><h2>Convidar pessoa</h2><form asp-action="Invite" asp-route-tenantId="@Model.Organization.Id" method="post" data-processing><input type="hidden" name="TenantId" value="@Model.Organization.Id"/><div class="form-grid"><label>E-mail<input name="Email" type="email" required autocomplete="email"/></label><label>Perfil<select name="RoleId" required><option value="">Selecione</option>@foreach(var role in Model.Roles){<option value="@role.Id">@role.Name</option>}</select></label></div><button class="button button-primary" type="submit" data-processing-label="Enfileirando…">Enviar convite</button></form></section>
<section class="card"><h2>Novo perfil</h2><form asp-action="CreateRole" asp-route-tenantId="@Model.Organization.Id" method="post" data-processing><label>Nome<input name="name" required maxlength="100"/></label><fieldset><legend>Permissões</legend><label><input type="checkbox" name="permissions" value="tenant.organization.read"/> Consultar organização</label><label><input type="checkbox" name="permissions" value="tenant.team.read"/> Consultar equipe</label></fieldset><button class="button" type="submit">Criar perfil</button></form></section>
<section class="card"><form method="get"><label>Buscar<input name="search" value="@Model.Search"/></label><label>Estado<select name="status"><option value="">Todos</option><option value="active">Ativo</option><option value="blocked">Bloqueado</option><option value="inactive">Inativo</option></select></label><button class="button" type="submit">Filtrar</button></form><div class="table-wrap"><table><thead><tr><th>Nome</th><th>E-mail</th><th>Estado</th><th>Perfis</th></tr></thead><tbody>@foreach(var member in Model.Members){<tr><td>@member.Name</td><td>@member.Email</td><td>@member.Status</td><td>@string.Join(", ",member.Roles)</td></tr>}</tbody></table></div></section>
