@model System.Text.Json.JsonElement
@{
    var _culture=(string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey];
    var tenantId=(Guid)ViewData["TenantId"]!; var canManage=ViewData["CanManage"] as bool?==true;
    var p=Model;
    string Str(string n)=>p.TryGetProperty(n,out var v)&&v.ValueKind==JsonValueKind.String?v.GetString()??"" : "";
    long Version=p.TryGetProperty("rowVersion",out var rv)&&rv.ValueKind==JsonValueKind.Number?rv.GetInt64():0;
    DateTime? When(string n)=>p.TryGetProperty(n,out var v)&&v.ValueKind==JsonValueKind.String&&DateTime.TryParse(v.GetString(),out var d)?d:null;
    var slaEl=p.TryGetProperty("sla",out var sl)?sl:default;
    DateTime? SlaWhen(string n)=>slaEl.ValueKind==JsonValueKind.Object&&slaEl.TryGetProperty(n,out var v)&&v.ValueKind==JsonValueKind.String&&DateTime.TryParse(v.GetString(),out var d)?d:null;
    string Fmt(DateTime? value)=>value is null?"—":Odca.Web.Common.CulturedTime.DateTime(value.Value,_culture);
    var status=Str("status"); var paused=p.TryGetProperty("paused",out var pv)&&pv.ValueKind==JsonValueKind.True;
    string ServiceLabel(string value)=>value is "revisao" or "adaptacao" or "esclarecimento" or "suporte_tecnico"?L.T($"sol.service.{value}",_culture):value;
    string StatusLabel(string value)=>value is "aberta" or "triagem" or "em_atendimento" or "aguardando_cliente" or "resolvida" or "encerrada" or "cancelada"?L.T($"sol.status.{value}",_culture):value;
    string PriorityLabel(string value)=>value is "baixa" or "normal" or "alta" or "critica"?L.T($"sol.priority.{value}",_culture):value;
    var eventNames=new[]{"abertura","triagem","atendimento_inicio","aguardando_cliente","pausa_sl","retomada_sl","retorno_cliente","resolucao","reatribuicao","encerramento","cancelamento","mensagem_cliente","mensagem_odca","violacao_primeira_resposta","violacao_resolucao"};
    string EventLabel(string value)=>eventNames.Contains(value)?L.T($"sol.event.{value}",_culture):value;
    string JStr(System.Text.Json.JsonElement e,string n)=>e.TryGetProperty(n,out var v)&&v.ValueKind==JsonValueKind.String?v.GetString()??"" : "";
    var aberta=status is not ("encerrada" or "cancelada");
}
<nav class="breadcrumb" aria-label="@L.T("common.breadcrumb_aria",_culture)"><a asp-action="Index" asp-route-tenantId="@tenantId">@L.T("sol.center",_culture)</a><span>/</span><span aria-current="page">@Str("protocol")</span></nav>
<header class="page-heading"><div><p class="eyebrow">@L.T("sol.detail_eyebrow",_culture,ServiceLabel(Str("service")),Str("protocol"))</p><h1>@Str("subject")</h1><p>@L.T("sol.opened_by_line",_culture,Str("openedByName"),Fmt(When("openedAt")))</p></div><span class="status-badge status-@status">@StatusLabel(status)</span>@if(paused){<span class="status-badge">@L.T("sol.sla_paused",_culture)</span>}</header>
@if(TempData["SolNotice"] is string notice){<div class="alert alert-success" role="status">@notice</div>}@if(TempData["SolError"] is string error){<div class="alert alert-error" role="alert">@error</div>}
@if(p.TryGetProperty("sla",out _)&&(SlaWhen("firstResponseBreachAt") is not null||SlaWhen("resolutionBreachAt") is not null)){<div class="alert alert-error" role="alert">@L.T("sol.sla_breach_alert",_culture)</div>}
<section class="summary-grid" aria-label="@L.T("admin.summary_aria",_culture)">
 <article><span>@L.T("sol.col_priority",_culture)</span><strong>@PriorityLabel(Str("priority"))</strong></article>
 <article><span>@L.T("sol.assignee",_culture)</span><strong>@(string.IsNullOrWhiteSpace(Str("assigneeName"))?L.T("sol.status.triagem",_culture):Str("assigneeName"))</strong></article>
 <article><span>@L.T("sol.first_response_due",_culture)</span><strong>@Fmt(SlaWhen("firstResponseDueAt"))</strong>@if(SlaWhen("firstResponseBreachAt") is not null){<small>@L.T("sol.first_response_breached",_culture,Fmt(SlaWhen("firstResponseBreachAt")))</small>}else if(When("firstResponseAt") is DateTime fr){<small>@L.T("sol.first_response_met",_culture,Fmt(fr))</small>}</article>
 <article><span>@L.T("sol.resolution_due",_culture)</span><strong>@Fmt(SlaWhen("resolutionDueAt"))</strong>@if(SlaWhen("resolutionBreachAt") is not null){<small>@L.T("sol.first_response_breached",_culture,Fmt(SlaWhen("resolutionBreachAt")))</small>}else if(When("resolvedAt") is DateTime res){<small>@L.T("sol.resolution_done",_culture,Fmt(res))</small>}</article>
 @if(paused){<article><span>@L.T("sol.sla_paused",_culture)</span><strong>@Fmt(When("pausedAt"))</strong><small>@Str("pauseReason")</small></article>}
 @if(!string.IsNullOrWhiteSpace(Str("cancellationReason"))){<article><span>@L.T("sol.cancellation_reason_label",_culture)</span><strong>@Str("cancellationReason")</strong></article>}
</section>
<div class="workspace-grid">
 <section>
  <h2>@L.T("sol.description_sent",_culture)</h2>
  <article class="comment-card"><header><strong>@Str("openedByName")</strong><span>@L.T("sol.opening_label",_culture)</span></header><p>@Str("body")</p><small>@Fmt(When("openedAt"))</small></article>
  <h2>@L.T("sol.conversation",_culture)</h2>
  @if(p.TryGetProperty("messages",out var msgs)&&msgs.ValueKind==System.Text.Json.JsonValueKind.Array){
   @foreach(var m in msgs.EnumerateArray()){
    <article class="comment-card @(JStr(m,"authorKind")=="odca"?"internal-note":null)"><header><strong>@JStr(m,"authorName")</strong><span>@(JStr(m,"authorKind")=="odca"?L.T("sol.odca_team",_culture):L.T("sol.you",_culture))</span></header><p>@JStr(m,"body")</p><small>@(DateTime.TryParse(JStr(m,"createdAt"),out var mc)?Odca.Web.Common.CulturedTime.DateTime(mc,_culture):"")</small></article>
   }
  }
  @if(canManage&&aberta){
   <form method="post" asp-action="AddMessage" asp-route-tenantId="@tenantId" asp-route-solicitationId="@Str("id")" data-prevent-double-submit>
    @Html.AntiForgeryToken()
    <input type="hidden" name="expectedVersion" value="@Version" />
    <label for="body">@L.T("sol.message_label",_culture)</label>
    <textarea id="body" name="body" required maxlength="8000"></textarea>
    <button class="button button-primary" type="submit">@L.T("sol.send_message_btn",_culture)</button>
   </form>
  }
 </section>
 <aside>
  <h2>@L.T("sol.timeline",_culture)</h2>
  <ol class="timeline">
   @if(p.TryGetProperty("events",out var evts)&&evts.ValueKind==System.Text.Json.JsonValueKind.Array){
    @foreach(var e in evts.EnumerateArray()){
     var details=e.TryGetProperty("details",out var d)?d:default;
     var note=!string.IsNullOrWhiteSpace(JStr(details,"justificativa"))?JStr(details,"justificativa"):!string.IsNullOrWhiteSpace(JStr(details,"solucao"))?JStr(details,"solucao"):!string.IsNullOrWhiteSpace(JStr(details,"motivo"))?JStr(details,"motivo"):"";
     var actor=JStr(e,"actorName");
     <li><strong>@EventLabel(JStr(e,"eventType"))</strong>@if(!string.IsNullOrWhiteSpace(note)){<p>@note</p>}<span>@(string.IsNullOrWhiteSpace(actor)?L.T("sol.system_actor",_culture):actor) · @(DateTime.TryParse(JStr(e,"occurredAt"),out var oc)?Odca.Web.Common.CulturedTime.DateTime(oc,_culture):"")</span></li>
    }
   }
  </ol>
 </aside>
</div>
@if(canManage&&aberta){
 <section class="help-card" aria-labelledby="sol-close-title">
  <h2 id="sol-close-title">@L.T("sol.close_section_title",_culture)</h2>
  <p>@L.T("sol.close_section_body",_culture)</p>
  @if(status=="resolvida"){
   <form method="post" asp-action="Act" asp-route-tenantId="@tenantId" asp-route-solicitationId="@Str("id")" data-prevent-double-submit>
    @Html.AntiForgeryToken()<input type="hidden" name="expectedVersion" value="@Version" /><input type="hidden" name="action" value="encerrar" />
    <button class="button button-primary" type="submit">@L.T("sol.close_btn",_culture)</button>
   </form>
  }
  <form method="post" asp-action="Act" asp-route-tenantId="@tenantId" asp-route-solicitationId="@Str("id")" data-prevent-double-submit>
   @Html.AntiForgeryToken()<input type="hidden" name="expectedVersion" value="@Version" /><input type="hidden" name="action" value="cancelar" />
   <label for="cancelReason">@L.T("sol.cancel_reason_label",_culture)</label>
   <textarea id="cancelReason" name="text" required minlength="5" maxlength="2000"></textarea>
   <button class="button button-danger" type="submit">@L.T("sol.cancel_btn",_culture)</button>
  </form>
 </section>
}
