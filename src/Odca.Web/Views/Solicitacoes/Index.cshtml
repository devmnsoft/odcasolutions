@using Odca.Contracts.Solicitations
@model SolicitationListItem[]
@{
    var tenantId=(Guid)ViewData["TenantId"]!; var service=ViewData["Service"] as string; var status=ViewData["Status"] as string;
    var search=ViewData["Search"] as string; var canManage=ViewData["CanManage"] as bool?==true;
    string ServiceLabel(string value)=>value switch { "revisao"=>"Revisão","adaptacao"=>"Adaptação","esclarecimento"=>"Esclarecimento",_=>value };
    string StatusLabel(string value)=>value switch { "aberta"=>"Aberta","triagem"=>"Em triagem","em_atendimento"=>"Em atendimento","aguardando_cliente"=>"Aguardando você","resolvida"=>"Resolvida","encerrada"=>"Encerrada","cancelada"=>"Cancelada",_=>value };
    string PriorityLabel(string value)=>value switch { "baixa"=>"Baixa","normal"=>"Normal","alta"=>"Alta","critica"=>"Crítica",_=>value };
    string Fmt(DateTime? value)=>value?.ToString("dd/MM/yyyy HH:mm")??"—";
}
<nav class="breadcrumb" aria-label="Navegação estrutural"><a asp-controller="Onboarding" asp-action="CustomerHome">Visão geral</a><span>/</span><span aria-current="page">Central de solicitações</span></nav>
<header class="page-heading"><div><p class="eyebrow">Atendimento ODCA</p><h1>Central de solicitações</h1><p>Fale com a equipe ODCA para revisar, adaptar ou esclarecer documentos. Prazos de resposta são monitorados por SLA.</p></div>@if(canManage){<a class="button button-primary" asp-action="Nova" asp-route-tenantId="@tenantId">Nova solicitação</a>}</header>
@if(ViewData["LoadError"] is string loadError){<div class="alert alert-error" role="alert">@loadError</div>}
@if(TempData["SolNotice"] is string notice){<div class="alert alert-success" role="status">@notice</div>}
<section class="help-card" aria-labelledby="sol-help"><h2 id="sol-help">Como funciona</h2><p>Descreva a demanda e acompanhe as respostas em uma única conversa. A ODCA responde dentro dos prazos do seu plano; quando a solicitação fica <strong>aguardando você</strong>, o relógio do SLA é pausado até a sua resposta.</p></section>
<form method="get" class="review-filters" aria-label="Filtros da central">
 <label>Serviço<select name="service"><option value="">Todos</option>@foreach(var option in new[]{("revisao","Revisão"),("adaptacao","Adaptação"),("esclarecimento","Esclarecimento")}){<option value="@option.Item1" selected="@(service==option.Item1)">@option.Item2</option>}</select></label>
 <label>Situação<select name="status"><option value="">Todas</option>@foreach(var option in new[]{("aberta","Aberta"),("triagem","Em triagem"),("em_atendimento","Em atendimento"),("aguardando_cliente","Aguardando você"),("resolvida","Resolvida"),("encerrada","Encerrada"),("cancelada","Cancelada")}){<option value="@option.Item1" selected="@(status==option.Item1)">@option.Item2</option>}</select></label>
 <label>Buscar<input type="search" name="search" value="@search" placeholder="Protocolo ou assunto" /></label>
 <button class="button button-quiet" type="submit">Aplicar filtros</button>
</form>
<section aria-label="Lista de solicitações">
 @if(Model.Length==0){<div class="empty-state"><p>Nenhuma solicitação encontrada. Abra a primeira com o botão acima.</p></div>}
 else
 {
  <div class="table-scroll"><table><thead><tr><th>Protocolo</th><th>Assunto</th><th>Serviço</th><th>Prioridade</th><th>Situação</th><th>Resposta até</th><th>Resolução até</th><th>Atualizada</th></tr></thead><tbody>
  @foreach(var item in Model)
  {
   <tr>
    <td><a asp-action="Detalhes" asp-route-tenantId="@tenantId" asp-route-solicitationId="@item.Id"><strong>@item.Protocol</strong></a></td>
    <td>@item.Subject</td>
    <td>@ServiceLabel(item.Service)</td>
    <td>@PriorityLabel(item.Priority)</td>
    <td><span class="status-badge status-@item.Status">@StatusLabel(item.Status)</span>@if(item.Paused){<span class="status-badge">SLA pausado</span>}@if(item.FirstResponseBreachAt is not null || item.ResolutionBreachAt is not null){<span class="status-badge status-cancelled">Violação de SLA</span>}</td>
    <td>@if(item.FirstResponseBreachAt is not null){<strong>Violado em @Fmt(item.FirstResponseBreachAt)</strong>}else{@Fmt(item.FirstResponseDueAt)}</td>
    <td>@if(item.ResolutionBreachAt is not null){<strong>Violado em @Fmt(item.ResolutionBreachAt)</strong>}else{@Fmt(item.ResolutionDueAt)}</td>
    <td>@Fmt(item.UpdatedAt)</td>
   </tr>
  }
  </tbody></table></div>
 }
</section>
