@model Odca.Contracts.Identity.DashboardResponse
@{
    ViewData["Title"] = L.T("visao-global", (string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey]);
    var _c = (string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey];
}
<section class="dashboard-heading">
    <div>
        <p class="eyebrow">@L.T("visao-global", _c)</p>
        <h1>@L.T("dash.greeting", _c, Model.DisplayName)</h1>
        <p class="muted">@L.T("dash.subtitle", _c)</p>
    </div>
</section>
@if (TempData["Success"] is string success)
{
    <div class="success" role="status">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="error" role="alert">@error</div>
}
<section class="metrics" aria-label="@L.T("dash.metrics_aria", _c)">
    <article class="metric"><span>@L.T("dash.m_total_clients", _c)</span><strong>@Model.TotalTenants</strong></article>
    <article class="metric"><span>@L.T("dash.m_active_clients", _c)</span><strong>@Model.ActiveTenants</strong></article>
    <article class="metric"><span>@L.T("dash.m_blocked_clients", _c)</span><strong>@Model.BlockedTenants</strong></article>
    <article class="metric"><span>@L.T("dash.m_inactive_clients", _c)</span><strong>@Model.InactiveTenants</strong></article>
    <article class="metric"><span>@L.T("dash.m_users", _c)</span><strong>@Model.ActiveUsers</strong></article>
    <article class="metric"><span>@L.T("dash.m_contracts", _c)</span><strong>@Model.Contracts</strong></article>
    <article class="metric"><span>@L.T("dash.m_contracts_expiring", _c)</span><strong>@Model.ContractsExpiring</strong></article>
    <article class="metric"><span>@L.T("dash.m_open_obligations", _c)</span><strong>@Model.OpenObligations</strong></article>
    <article class="metric"><span>@L.T("dash.m_overdue_obligations", _c)</span><strong>@Model.OverdueObligations</strong></article>
    <article class="metric"><span>@L.T("dash.m_upcoming_renewals", _c)</span><strong>@Model.UpcomingRenewals</strong></article>
    <article class="metric"><span>@L.T("dash.m_pending_invoices", _c)</span><strong>@Model.PendingInvoices</strong></article>
    <article class="metric"><span>@L.T("dash.m_overdue_invoices", _c)</span><strong>@Model.OverdueInvoices</strong></article>
    <article class="metric"><span>@L.T("dash.m_storage_used", _c)</span><strong>@((Model.StorageBytes / 1_048_576d).ToString("N1")) MB</strong></article>
    <article class="metric"><span>@L.T("dash.m_privacy_pending", _c)</span><strong>@Model.PendingPrivacyItems</strong></article>
</section>
<section class="card">
    <div class="section-heading"><div><p class="eyebrow">@L.T("dash.shortcuts_eyebrow", _c)</p><h2>@L.T("dash.actions_quick", _c)</h2></div></div>
    <div class="button-row">
        <a class="button button-primary" asp-controller="Onboarding" asp-action="Register">@L.T("dash.act_new_client", _c)</a>
        <a class="button button-link" asp-controller="Organizations" asp-action="Index">@L.T("organizacoes", _c)</a>
        <a class="button button-link" asp-controller="Customers" asp-action="Index">@L.T("dash.btn_clients_modules", _c)</a>
        <a class="button button-link" asp-controller="PlatformDiagnostics" asp-action="Index">@L.T("dash.btn_diagnostics", _c)</a>
        <a class="button button-link" asp-controller="PlatformAudit" asp-action="Index">@L.T("dash.btn_audit", _c)</a>
        <a class="button button-link" asp-controller="Plans" asp-action="Index">@L.T("dash.btn_plans", _c)</a>
    </div>
</section>
<section class="card">
    <div class="section-heading"><div><p class="eyebrow">@L.T("dash.audit_eyebrow", _c)</p><h2>@L.T("dash.audit_title", _c)</h2></div></div>
    @if (Model.RecentAuditEvents.Length == 0)
    {
        <div class="empty-state"><h3>@L.T("dash.audit_empty_title", _c)</h3><p>@L.T("dash.audit_empty_body", _c)</p></div>
    }
    else
    {
        <div class="table-wrap"><table><thead><tr><th>@L.T("dash.th_date", _c)</th><th>@L.T("dash.th_user", _c)</th><th>@L.T("dash.th_client", _c)</th><th>@L.T("dash.th_action", _c)</th><th>@L.T("dash.th_entity", _c)</th><th>@L.T("dash.th_result", _c)</th></tr></thead><tbody>
        @foreach (var item in Model.RecentAuditEvents)
        {
            <tr><td>@CulturedTime.DateTime(item.OccurredAt.ToLocalTime(), _c)</td><td>@(item.ActorName ?? L.T("common.system", _c))</td><td>@(item.TenantName ?? L.T("layout.platform", _c))</td><td>@item.Action</td><td>@item.EntityType</td><td><span class="badge">@item.Result</span></td></tr>
        }
        </tbody></table></div>
    }
</section>
<section class="card empty-state">
    <h2>@L.T("common.how_to_use", _c)</h2>
    <p>@L.T("dash.howto", _c)</p>
</section>
