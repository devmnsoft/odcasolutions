@model ContractTypeListPageViewModel
@{
    ViewData["Title"] = "Tipos de contrato";
    var org = Model.Organization;
}
<section class="page-heading">
    <div>
        <span class="eyebrow">@org.Name</span>
        <h1>Tipos de contrato</h1>
        <p>Tipos inativos permanecem no histórico, mas não podem ser escolhidos em novos contratos.</p>
    </div>
    <div class="toolbar">
        @if (Model.CanManage)
        {
            <a class="button button-primary" asp-action="Create" asp-route-tenantId="@org.Id">Novo tipo</a>
        }
        <a class="button" asp-controller="Contracts" asp-action="Index" asp-route-tenantId="@org.Id">Contratos</a>
    </div>
</section>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success" role="status">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-error" role="alert">@error</div>
}

<section class="card">
    <form method="get" class="form-inline toolbar" action="@Url.Action("Index", new { tenantId = org.Id })">
        <label>Estado
            <select name="status">
                <option value="">Todos</option>
                <option value="active" selected="@(Model.Status == "active")">Ativo</option>
                <option value="inactive" selected="@(Model.Status == "inactive")">Inativo</option>
            </select>
        </label>
        <button class="button" type="submit">Filtrar</button>
    </form>

    @if (Model.LoadError)
    {
        <div class="empty-state">
            <h2>Não foi possível carregar os tipos</h2>
            <p>Tente novamente em instantes.</p>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead><tr><th>Código</th><th>Nome</th><th>Estado</th><th>Ações</th></tr></thead>
                <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="4"><div class="empty-state"><h2>Nenhum tipo cadastrado</h2><p>Crie tipos para organizar a classificação dos contratos.</p></div></td></tr>
                }
                else
                {
                    foreach (var item in Model.Items)
                    {
                        <tr>
                            <td><code>@item.Code</code></td>
                            <td>
                                <strong>@item.Name</strong>
                                @if (!string.IsNullOrWhiteSpace(item.Description))
                                {
                                    <div class="muted">@item.Description</div>
                                }
                            </td>
                            <td><span class="@ContractsDisplay.ContractTypeStatusClass(item.Status)">@ContractsDisplay.ContractTypeStatus(item.Status)</span></td>
                            <td>
                                <a class="button button-small" asp-action="Edit" asp-route-tenantId="@org.Id" asp-route-id="@item.Id">Abrir</a>
                                @if (Model.CanManage)
                                {
                                    var next = item.Status == "active" ? "inactive" : "active";
                                    var label = item.Status == "active" ? "Inativar" : "Reativar";
                                    <form class="inline-form" asp-action="SetStatus" asp-route-tenantId="@org.Id" asp-route-id="@item.Id" method="post">
                                        <input type="hidden" name="version" value="@item.Version" />
                                        <input type="hidden" name="status" value="@next" />
                                        <button class="button button-small" type="submit">@label</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    }
</section>
