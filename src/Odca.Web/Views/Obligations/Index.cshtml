@model Odca.Web.Models.ObligationWorkspaceViewModel
@{ViewData["Title"]=L.T("obl.view_title",(string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey]);var _c=(string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey];var tenantId=(Guid)ViewData["TenantId"]!;var scope=(string)ViewData["Scope"]!;var routes=Context.Request.Query.ToDictionary(x=>x.Key,x=>x.Value.ToString());var results=Model.Results;string OblStatus(string s)=>s switch{"open"=>L.T("obl.status_open",_c),"in_progress"=>L.T("obl.status_in_progress",_c),"fulfilled"=>L.T("obl.status_fulfilled",_c),"cancelled"=>L.T("obl.status_cancelled",_c),_=>s};string OblCategory(string s)=>s switch{"delivery"=>L.T("obl.category_delivery",_c),"document"=>L.T("obl.category_document",_c),"renewal"=>L.T("obl.category_renewal",_c),"communication"=>L.T("obl.category_communication",_c),"financial"=>L.T("obl.category_financial",_c),"other"=>L.T("obl.category_other",_c),_=>s};}
<nav class="breadcrumb" aria-label="@L.T("common.breadcrumb_aria",_c)"><a asp-controller="Organizations" asp-action="Index">@L.T("organizacoes",_c)</a><span aria-hidden="true">/</span><span>@L.T("obrigacoes",_c)</span></nav>
<header class="obligation-heading"><div><p class="eyebrow">@L.T("common.ops_center",_c) · @L.T("common.org_selected",_c)</p><h1>@L.T("obrigacoes",_c)</h1><p class="current-view">@L.T("obl.current_view_prefix",_c)<strong>@(Model.CurrentView?.Name ?? L.T("obl.general_view",_c))</strong>@if(Model.IsCurrentViewModified){<span class="unsaved-badge" role="status">@L.T("obl.unsaved_badge",_c)</span>}</p><p class="muted">@L.T("obl.subtitle",_c)</p></div><div class="heading-actions"><a class="button button-primary" asp-action="Nova" asp-route-tenantId="@tenantId">@L.T("obl.new",_c)</a><a class="button button-quiet" href="#como-usar">@L.T("common.how_to_use",_c)</a></div></header>
<div class="scope-switch" role="group" aria-label="@L.T("obl.scope_aria",_c)"><a class="button @(scope=="mine"?"button-primary":"button-quiet")" asp-route-scope="mine">@L.T("obl.scope_mine",_c)</a><a class="button @(scope=="organization"?"button-primary":"button-quiet")" asp-route-scope="organization">@L.T("obl.scope_org",_c)</a></div>
@if(TempData["SavedViewNotice"] is string notice){<p class="status-message" role="status">@notice</p>}@if(TempData["SavedViewError"] is string savedError){<p class="validation-summary" role="alert">@savedError</p>}@if(TempData["ObligationNotice"] is string obligationNotice){<p class="status-message" role="status">@obligationNotice</p>}@if(TempData["ObligationError"] is string obligationError){<p class="validation-summary" role="alert">@obligationError</p>}
<section class="saved-views" id="saved-views" aria-labelledby="saved-views-title"><div><p class="eyebrow">@L.T("obl.shortcuts_eyebrow",_c)</p><h2 id="saved-views-title">@L.T("obl.working_views",_c)</h2><p class="muted">@L.T("obl.views_manage_hint",_c)</p></div><div class="saved-view-list">@if(Model.SavedViews.Count==0){<span class="muted">@L.T("obl.no_saved_views",_c)</span>}else{@foreach(var view in Model.SavedViews){<details class="saved-view-item"><summary>@(view.IsDefault?"★ ":"")@view.Name</summary><a class="button button-primary" asp-action="OpenView" asp-route-tenantId="@tenantId" asp-route-viewId="@view.Id">@L.T("common.open",_c)</a><form asp-action="UpdateView" asp-route-tenantId="@tenantId" asp-route-viewId="@view.Id" method="post">@Html.AntiForgeryToken()<label>@L.T("common.rename",_c)<input name="name" value="@view.Name" maxlength="80" required/></label><input type="hidden" name="version" value="@view.Version"/><label><input type="checkbox" name="isDefault" value="true" checked="@view.IsDefault"/> @L.T("obl.default_view",_c)</label>@if(Model.CurrentView?.Id==view.Id){@foreach(var filter in Context.Request.Query.Where(x=>x.Key!="page" && x.Key!="viewId")){<input type="hidden" name="@filter.Key" value="@filter.Value"/>}<button class="button button-quiet" name="replaceFilters" value="true">@L.T("obl.update_with_filters",_c)</button>}<button class="button button-quiet">@L.T("obl.save_name_default",_c)</button></form><form asp-action="DeactivateView" asp-route-tenantId="@tenantId" asp-route-viewId="@view.Id" method="post">@Html.AntiForgeryToken()<button class="button button-quiet">@L.T("common.deactivate",_c)</button></form></details>}}</div></section>
<details class="filter-panel" open><summary>@L.T("obl.filters_summary",_c)</summary><div asp-validation-summary="All" class="validation-summary" role="alert"></div><form method="get" class="obligation-filters"><input type="hidden" name="scope" value="@scope"/><label for="pendency-search">@L.T("common.search_by_name",_c)</label><input id="pendency-search" name="search" value="@Context.Request.Query["search"]" placeholder="@L.T("obl.search_ph",_c)"/><label for="pendency-category">@L.T("common.type",_c)</label><select id="pendency-category" name="category"><option value="">@L.T("obl.category_all",_c)</option><option value="delivery" selected="@(Context.Request.Query["category"] == "delivery")">@L.T("obl.category_delivery",_c)</option><option value="document" selected="@(Context.Request.Query["category"] == "document")">@L.T("obl.category_document",_c)</option><option value="renewal" selected="@(Context.Request.Query["category"] == "renewal")">@L.T("obl.category_renewal",_c)</option><option value="communication" selected="@(Context.Request.Query["category"] == "communication")">@L.T("obl.category_communication",_c)</option><option value="financial" selected="@(Context.Request.Query["category"] == "financial")">@L.T("obl.category_financial",_c)</option><option value="other" selected="@(Context.Request.Query["category"] == "other")">@L.T("obl.category_other",_c)</option></select><label for="pendency-status">@L.T("common.state",_c)</label><select id="pendency-status" name="status"><option value="">@L.T("obl.status_all",_c)</option><option value="open" selected="@(Context.Request.Query["status"] == "open")">@L.T("obl.status_open",_c)</option><option value="in_progress" selected="@(Context.Request.Query["status"] == "in_progress")">@L.T("obl.status_in_progress",_c)</option><option value="fulfilled" selected="@(Context.Request.Query["status"] == "fulfilled")">@L.T("obl.status_fulfilled",_c)</option><option value="cancelled" selected="@(Context.Request.Query["status"] == "cancelled")">@L.T("obl.status_cancelled",_c)</option></select><label for="pendency-from">@L.T("obl.due_from",_c)</label><input id="pendency-from" type="date" name="from" value="@Context.Request.Query["from"]"/><label for="pendency-to">@L.T("obl.due_to",_c)</label><input id="pendency-to" type="date" name="to" value="@Context.Request.Query["to"]"/><button class="button button-primary">@L.T("common.apply_filters",_c)</button></form><div class="active-filters" aria-label="@L.T("common.active_filters_aria",_c)">@foreach(var filter in Context.Request.Query.Where(x=>Odca.Contracts.SavedViews.SavedViewFilterPolicy.IsAllowedRouteKey("obligations",x.Key))){<span class="filter-chip"><strong>@filter.Key:</strong> @filter.Value</span>}@if(Context.Request.Query.Any(x=>Odca.Contracts.SavedViews.SavedViewFilterPolicy.IsAllowedRouteKey("obligations",x.Key))){<a asp-action="Index" asp-route-tenantId="@tenantId" class="clear-filters">@L.T("common.clear_filters",_c)</a>}</div></details>
<details class="save-view-panel"><summary>@L.T("obl.save_view_summary",_c)</summary><form asp-action="SaveView" asp-route-tenantId="@tenantId" method="post" class="save-view-form">@Html.AntiForgeryToken()<label for="saved-view-name">@L.T("obl.view_name",_c)<input id="saved-view-name" name="name" maxlength="80" required placeholder="@L.T("obl.view_name_ph",_c)"/></label>@foreach(var filter in Context.Request.Query.Where(x=>x.Key!="page" && x.Key!="scope")){<input type="hidden" name="@filter.Key" value="@filter.Value"/>}<input type="hidden" name="scope" value="@scope"/><button class="button button-primary" type="submit">@L.T("obl.save_view",_c)</button></form><p class="muted">@L.T("obl.save_view_note",_c)</p></details>
<div class="obligation-layout"><main class="obligation-list" aria-live="polite"><div class="list-toolbar"><strong>@L.T("obl.total_count",_c,results.Total.ToString(System.Globalization.CultureInfo.InvariantCulture))</strong><div role="group" aria-label="@L.T("common.view_mode",_c)"><button class="button button-quiet" aria-pressed="true">@L.T("common.list",_c)</button><button class="button button-quiet" disabled title="@L.T("obl.agenda_same_filters",_c)">@L.T("common.monthly_agenda",_c)</button></div></div>
@if(results.Items.Count==0){<section class="card empty-state"><h2>@L.T("obl.none_found",_c)</h2><p>@L.T("obl.none_found_hint",_c)</p></section>}
else{<div class="table-scroll"><table><thead><tr><th>@L.T("common.obligation",_c)</th><th>@L.T("common.contract",_c)</th><th>@L.T("common.responsible",_c)</th><th>@L.T("common.due_date",_c)</th><th>@L.T("common.situation",_c)</th><th>@L.T("common.next_action",_c)</th></tr></thead><tbody>@foreach(var item in results.Items){<tr><td><strong>@item.Title</strong><small>@OblCategory(item.Category)</small></td><td>@item.Contract</td><td>@item.Owner @if(item.OwnerBlocked){<span class="status status-warning">@L.T("obl.reassign_needed",_c)</span>}</td><td><time datetime="@item.DueDate.ToString("yyyy-MM-dd")">@item.DueDate.ToString("dd/MM/yyyy")</time></td><td><span class="status @(item.Overdue?"status-danger":"")">@(item.Overdue?L.T("obl.overdue_prefix",_c):"")@OblStatus(item.Status)</span></td><td><button class="button button-quiet obligation-detail" data-title="@item.Title" data-contract="@item.Contract" data-owner="@item.Owner" data-due="@item.DueDate.ToString("dd/MM/yyyy")" data-history-url="@Url.Action("History",new{tenantId,id=item.Id})">@item.NextAction</button> <a class="button button-quiet" asp-action="Actions" asp-route-tenantId="@tenantId" asp-route-id="@item.Id" title="@L.T("obl.actions_hint",_c)">@L.T("common.actions",_c)</a></td></tr>}</tbody></table></div>}
<nav class="pagination" aria-label="@L.T("common.pagination_aria",_c)">@if(results.Page>1){routes["page"]=(results.Page-1).ToString();<a asp-all-route-data="routes">@L.T("common.prev",_c)</a>}<span>@L.T("common.page_number",_c,results.Page.ToString(System.Globalization.CultureInfo.InvariantCulture))</span>@if(results.Page*results.PageSize<results.Total){routes["page"]=(results.Page+1).ToString();<a asp-all-route-data="routes">@L.T("common.next",_c)</a>}</nav></main>
<aside class="obligation-detail-panel" aria-labelledby="detail-title" tabindex="-1"><p class="eyebrow">@L.T("common.details",_c)</p><h2 id="detail-title">@L.T("obl.select_obligation",_c)</h2><p id="detail-copy">@L.T("obl.select_hint",_c)</p><h3>@L.T("common.history",_c)</h3><div id="detail-history" aria-live="polite"><p class="muted">@L.T("obl.history_empty",_c)</p></div></aside></div>
<section id="como-usar" class="card compact-guide"><h2>@L.T("common.how_to_use",_c)</h2><ol><li>@L.T("obl.how_1",_c)</li><li>@L.T("obl.how_2",_c)</li><li>@L.T("obl.how_3",_c)</li><li>@L.T("obl.how_4",_c)</li></ol></section>
@section Scripts{<script type="module" src="~/js/obligations.js" asp-append-version="true"></script>}
