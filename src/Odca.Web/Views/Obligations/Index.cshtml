@model Odca.Web.Models.ObligationWorkspaceViewModel
@{ViewData["Title"]="Minhas pendências";var tenantId=(Guid)ViewData["TenantId"]!;var scope=(string)ViewData["Scope"]!;var routes=Context.Request.Query.ToDictionary(x=>x.Key,x=>x.Value.ToString());var results=Model.Results;}
<nav class="breadcrumb" aria-label="Navegação estrutural"><a asp-controller="Organizations" asp-action="Index">Organizações</a><span aria-hidden="true">/</span><span>Obrigações</span></nav>
<header class="obligation-heading"><div><p class="eyebrow">Central operacional</p><h1>Minhas pendências</h1><p class="muted">Acompanhe obrigações e prazos na fonte original. Revisões e renovações mantêm seus próprios ciclos e históricos.</p></div><a class="button button-primary" href="#como-usar">Como usar</a></header>
<div class="scope-switch" role="group" aria-label="Escopo"><a class="button @(scope=="mine"?"button-primary":"button-quiet")" asp-route-scope="mine">Minhas</a><a class="button @(scope=="organization"?"button-primary":"button-quiet")" asp-route-scope="organization">Da organização</a></div>
@if(TempData["SavedViewNotice"] is string notice){<p class="status-message" role="status">@notice</p>}@if(TempData["SavedViewError"] is string savedError){<p class="validation-summary" role="alert">@savedError</p>}
<section class="saved-views" aria-labelledby="saved-views-title"><div><p class="eyebrow">Atalhos pessoais</p><h2 id="saved-views-title">Vistas de trabalho</h2></div><div class="saved-view-list">@if(Model.SavedViews.Count==0){<span class="muted">Nenhuma vista salva.</span>}else{@foreach(var view in Model.SavedViews){<details class="saved-view-item"><summary>@(view.IsDefault?"★ ":"")@view.Name</summary><a class="button button-primary" asp-action="OpenView" asp-route-tenantId="@tenantId" asp-route-viewId="@view.Id">Abrir</a><form asp-action="UpdateView" asp-route-tenantId="@tenantId" asp-route-viewId="@view.Id" method="post"><label>Renomear<input name="name" value="@view.Name" maxlength="80" required/></label><input type="hidden" name="version" value="@view.Version"/><label><input type="checkbox" name="isDefault" value="true" checked="@view.IsDefault"/> Vista padrão</label><button class="button button-quiet">Atualizar</button></form><form asp-action="DeactivateView" asp-route-tenantId="@tenantId" asp-route-viewId="@view.Id" method="post"><button class="button button-quiet">Inativar</button></form></details>}}</div></section>
<details class="filter-panel" open><summary>Filtros e busca</summary><div asp-validation-summary="All" class="validation-summary" role="alert"></div><form method="get" class="obligation-filters"><input type="hidden" name="scope" value="@scope"/><label for="pendency-search">Buscar por nome</label><input id="pendency-search" name="search" value="@Context.Request.Query["search"]" placeholder="Obrigação ou contrato"/><label for="pendency-category">Tipo</label><select id="pendency-category" name="category"><option value="">Todos os tipos</option><option value="delivery" selected="@(Context.Request.Query["category"] == "delivery")">Entrega</option><option value="document" selected="@(Context.Request.Query["category"] == "document")">Documento</option><option value="renewal" selected="@(Context.Request.Query["category"] == "renewal")">Renovação</option><option value="communication" selected="@(Context.Request.Query["category"] == "communication")">Comunicação</option><option value="financial" selected="@(Context.Request.Query["category"] == "financial")">Obrigação financeira</option><option value="other" selected="@(Context.Request.Query["category"] == "other")">Outra</option></select><label for="pendency-status">Estado</label><select id="pendency-status" name="status"><option value="">Todos</option><option value="open" selected="@(Context.Request.Query["status"] == "open")">Aberta</option><option value="in_progress" selected="@(Context.Request.Query["status"] == "in_progress")">Em andamento</option><option value="fulfilled" selected="@(Context.Request.Query["status"] == "fulfilled")">Cumprida</option><option value="cancelled" selected="@(Context.Request.Query["status"] == "cancelled")">Cancelada</option></select><label for="pendency-from">Prazo inicial</label><input id="pendency-from" type="date" name="from" value="@Context.Request.Query["from"]"/><label for="pendency-to">Prazo final</label><input id="pendency-to" type="date" name="to" value="@Context.Request.Query["to"]"/><button class="button button-primary">Aplicar filtros</button></form></details>
<details class="save-view-panel"><summary>Salvar filtros como vista pessoal</summary><form asp-action="SaveView" asp-route-tenantId="@tenantId" method="post" class="save-view-form"><label for="saved-view-name">Nome da vista<input id="saved-view-name" name="name" maxlength="80" required placeholder="Ex.: Minhas obrigações desta semana"/></label>@foreach(var filter in Context.Request.Query.Where(x=>x.Key!="page" && x.Key!="scope")){<input type="hidden" name="@filter.Key" value="@filter.Value"/>}<input type="hidden" name="scope" value="@scope"/><button class="button button-primary" type="submit">Salvar vista</button></form><p class="muted">Somente os filtros são salvos; os dados e permissões são verificados novamente ao abrir.</p></details>
<div class="obligation-layout"><main class="obligation-list" aria-live="polite"><div class="list-toolbar"><strong>@results.Total obrigação(ões)</strong><div role="group" aria-label="Modo de visualização"><button class="button button-quiet" aria-pressed="true">Lista</button><button class="button button-quiet" disabled title="A agenda mensal usa os mesmos filtros">Agenda mensal</button></div></div>
@if(results.Items.Count==0){<section class="card empty-state"><h2>Nenhuma obrigação encontrada</h2><p>Ajuste os filtros ou abra um contrato para registrar o primeiro prazo.</p></section>}
else{<div class="table-scroll"><table><thead><tr><th>Obrigação</th><th>Contrato</th><th>Responsável</th><th>Prazo</th><th>Situação</th><th>Próxima ação</th></tr></thead><tbody>@foreach(var item in results.Items){<tr><td><strong>@item.Title</strong><small>@item.Category</small></td><td>@item.Contract</td><td>@item.Owner @if(item.OwnerBlocked){<span class="status status-warning">Reatribuição necessária</span>}</td><td><time datetime="@item.DueDate.ToString("yyyy-MM-dd")">@item.DueDate.ToString("dd/MM/yyyy")</time></td><td><span class="status @(item.Overdue?"status-danger":"")">@(item.Overdue?"Atrasada — ":"")@item.Status</span></td><td><button class="button button-quiet obligation-detail" data-title="@item.Title" data-contract="@item.Contract" data-owner="@item.Owner" data-due="@item.DueDate.ToString("dd/MM/yyyy")" data-history-url="@Url.Action("History",new{tenantId,id=item.Id})">@item.NextAction</button></td></tr>}</tbody></table></div>}
<nav class="pagination" aria-label="Paginação">@if(results.Page>1){routes["page"]=(results.Page-1).ToString();<a asp-all-route-data="routes">Anterior</a>}<span>Página @results.Page</span>@if(results.Page*results.PageSize<results.Total){routes["page"]=(results.Page+1).ToString();<a asp-all-route-data="routes">Próxima</a>}</nav></main>
<aside class="obligation-detail-panel" aria-labelledby="detail-title" tabindex="-1"><p class="eyebrow">Detalhes</p><h2 id="detail-title">Selecione uma obrigação</h2><p id="detail-copy">Consulte os dados e o histórico autorizado da obrigação.</p><h3>Histórico</h3><div id="detail-history" aria-live="polite"><p class="muted">Selecione uma obrigação para carregar as alterações.</p></div></aside></div>
<section id="como-usar" class="card compact-guide"><h2>Como usar</h2><ol><li>Abra o contrato e registre o que deve ser cumprido.</li><li>Separe a parte obrigada do usuário que acompanha.</li><li>Use o documento já armazenado como evidência; o vínculo não amplia permissão de download.</li><li>Concluir registra cumprimento informado, não pagamento nem assinatura.</li></ol></section>
@section Scripts{<script type="module" src="~/js/obligations.js" asp-append-version="true"></script>}
