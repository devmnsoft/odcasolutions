@model Odca.Contracts.Obligations.ObligationPage
@{ViewData["Title"]="Central de obrigações";var tenantId=(Guid)ViewData["TenantId"]!;var scope=(string)ViewData["Scope"]!;}
<nav class="breadcrumb" aria-label="Navegação estrutural"><a asp-controller="Organizations" asp-action="Index">Organizações</a><span aria-hidden="true">/</span><span>Obrigações</span></nav>
<header class="obligation-heading"><div><p class="eyebrow">Operação contratual</p><h1>Central de obrigações</h1><p class="muted">Acompanhe prazos, responsáveis, evidências e renovações sem confundir cumprimento com pagamento.</p></div><a class="button button-primary" href="#como-usar">Como usar</a></header>
<div class="scope-switch" role="group" aria-label="Escopo"><a class="button @(scope=="mine"?"button-primary":"button-quiet")" asp-route-scope="mine">Minhas</a><a class="button @(scope=="organization"?"button-primary":"button-quiet")" asp-route-scope="organization">Da organização</a></div>
<details class="filter-panel" open><summary>Filtros e busca</summary><form method="get" class="obligation-filters"><input type="hidden" name="scope" value="@scope"/><label>Buscar<input name="search" value="@Context.Request.Query["search"]" placeholder="Obrigação ou contrato"/></label><label>Categoria<select name="category"><option value="">Todas</option><option value="delivery">Entrega</option><option value="document">Documento</option><option value="renewal">Renovação</option><option value="communication">Comunicação</option><option value="financial">Obrigação financeira</option><option value="other">Outra</option></select></label><label>Estado<select name="status"><option value="">Todos</option><option value="open">Aberta</option><option value="in_progress">Em andamento</option><option value="fulfilled">Cumprida</option><option value="cancelled">Cancelada</option></select></label><label>De<input type="date" name="from" value="@Context.Request.Query["from"]"/></label><label>Até<input type="date" name="to" value="@Context.Request.Query["to"]"/></label><button class="button button-primary">Aplicar</button></form></details>
<div class="obligation-layout"><main class="obligation-list" aria-live="polite"><div class="list-toolbar"><strong>@Model.Total obrigação(ões)</strong><div role="group" aria-label="Modo de visualização"><button class="button button-quiet" aria-pressed="true">Lista</button><button class="button button-quiet" disabled title="A agenda mensal usa os mesmos filtros">Agenda mensal</button></div></div>
@if(Model.Items.Count==0){<section class="card empty-state"><h2>Nenhuma obrigação encontrada</h2><p>Ajuste os filtros ou abra um contrato para registrar o primeiro prazo.</p></section>}
else{<div class="table-scroll"><table><thead><tr><th>Obrigação</th><th>Contrato</th><th>Responsável</th><th>Prazo</th><th>Situação</th><th>Próxima ação</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td><strong>@item.Title</strong><small>@item.Category</small></td><td>@item.Contract</td><td>@item.Owner @if(item.OwnerBlocked){<span class="status status-warning">Reatribuição necessária</span>}</td><td><time datetime="@item.DueDate.ToString("yyyy-MM-dd")">@item.DueDate.ToString("dd/MM/yyyy")</time></td><td><span class="status @(item.Overdue?"status-danger":"")">@(item.Overdue?"Atrasada — ":"")@item.Status</span></td><td><button class="button button-quiet obligation-detail" data-title="@item.Title" data-contract="@item.Contract" data-owner="@item.Owner" data-due="@item.DueDate.ToString("dd/MM/yyyy")">@item.NextAction</button></td></tr>}</tbody></table></div>}
<nav class="pagination" aria-label="Paginação">@if(Model.Page>1){<a asp-route-page="@(Model.Page-1)" asp-route-scope="@scope">Anterior</a>}<span>Página @Model.Page</span>@if(Model.Page*Model.PageSize<Model.Total){<a asp-route-page="@(Model.Page+1)" asp-route-scope="@scope">Próxima</a>}</nav></main>
<aside class="obligation-detail-panel" aria-labelledby="detail-title" tabindex="-1"><p class="eyebrow">Detalhes</p><h2 id="detail-title">Selecione uma obrigação</h2><p id="detail-copy">Os detalhes autorizados aparecerão aqui sem carregar todo o histórico.</p></aside></div>
<section id="como-usar" class="card compact-guide"><h2>Como usar</h2><ol><li>Abra o contrato e registre o que deve ser cumprido.</li><li>Separe a parte obrigada do usuário que acompanha.</li><li>Use o documento já armazenado como evidência; o vínculo não amplia permissão de download.</li><li>Concluir registra cumprimento informado, não pagamento nem assinatura.</li></ol></section>
@section Scripts{<script type="module" src="~/js/obligations.js" asp-append-version="true"></script>}
