@model PatientDetailsViewModel
@{ var tenantId=(Guid)ViewData["TenantId"]!; var p=Model.Patient; var _culture=(string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey]; }
<nav class="breadcrumb" aria-label="@L.T("common.breadcrumb_aria",_culture)"><a href="@Model.ReturnUrl">@L.T("pacientes",_culture)</a><span>›</span><span aria-current="page">@L.T("patient.sheet_breadcrumb",_culture)</span></nav>
<section class="page-heading"><div><p class="eyebrow">@L.T("patient.sheet_eyebrow",_culture)</p><h1>@p.FullName</h1><p>@(p.PreferredName is null?L.T("patient.sheet_subtitle_default",_culture):L.T("patient.preferred_name_line",_culture,p.PreferredName))</p></div><div class="button-row"><a class="button button-link" asp-action="Edit" asp-route-tenantId="@tenantId" asp-route-patientId="@p.Id">@L.T("patient.edit_cta",_culture)</a>@if(p.Active){<a class="button button-primary" asp-controller="Documents" asp-action="NewDocument" asp-route-tenantId="@tenantId" asp-route-patientId="@p.Id">@L.T("patient.new_document_cta",_culture)</a>}else{<p class="muted">@L.T("patient.inactive_note",_culture)</p>}</div></section>
@if(TempData["PatientSuccess"] is string success){<div class="alert alert-success" role="status">@success</div>}@if(TempData["PatientError"] is string error){<div class="alert alert-error" role="alert">@error</div>}
<nav class="sheet-subnav" aria-label="@L.T("patient.sheet_eyebrow",_culture)"><a href="#resumo">@L.T("patient.subnav_summary",_culture)</a><a href="#cadastro">@L.T("patient.subnav_registration",_culture)</a><a href="#representante">@L.T("patient.subnav_representative",_culture)</a><a href="#documentos">@L.T("patient.subnav_documents",_culture)</a><a href="#historico">@L.T("patient.subnav_history",_culture)</a></nav>
<section id="resumo" class="summary-grid"><article><span>@L.T("patient.col_status",_culture)</span><strong>@L.T(p.Active?"patient.status_active":"patient.status_inactive",_culture)</strong></article><article><span>@L.T("patient.summary_version",_culture)</span><strong>@p.Version</strong></article><article><span>@L.T("patient.summary_updated",_culture)</span><strong>@CulturedTime.DateTime(p.UpdatedAt,_culture)</strong></article></section>
<section id="cadastro" class="card patient-details"><h2>@L.T("patient.subnav_registration",_culture)</h2><dl><div><dt>@L.T("patient.full_name",_culture)</dt><dd>@p.FullName</dd></div><div><dt>@L.T("patient.dl_birth",_culture)</dt><dd>@(p.BirthDate is { } bd?CulturedTime.Date(bd,_culture):L.T("patient.not_informed",_culture))</dd></div><div><dt>@L.T("patient.col_identifier",_culture)</dt><dd>@(p.IdentifierValue??L.T("patient.not_informed",_culture))</dd></div><div><dt>@L.T("patient.email",_culture)</dt><dd>@(p.Email??L.T("patient.not_informed",_culture))</dd></div><div><dt>@L.T("patient.phone",_culture)</dt><dd>@(p.Phone??L.T("patient.not_informed",_culture))</dd></div><div><dt>@L.T("patient.address",_culture)</dt><dd>@(p.Address??L.T("patient.not_informed",_culture))</dd></div></dl></section>
<section id="representante" class="card"><h2>@L.T("patient.subnav_representative",_culture)</h2><p class="muted">@L.T("patient.rep_note",_culture)</p>@if(p.Representative is null){<p class="muted">@L.T("patient.rep_none",_culture)</p>}else{<dl><dt>@L.T("patient.rep_dl_name",_culture)</dt><dd>@p.Representative.FullName</dd><dt>@L.T("patient.rep_dl_relationship",_culture)</dt><dd>@p.Representative.Relationship</dd><dt>@L.T("patient.col_identifier",_culture)</dt><dd>@(p.Representative.IdentifierValue??L.T("patient.not_informed",_culture))</dd></dl>}</section>
<section id="documentos" class="card"><div class="section-heading"><div><h2>@L.T("patient.archive_title",_culture)</h2><p>@L.T("patient.archive_subtitle",_culture)</p></div></div>@if(ViewData["ArchiveError"] is string archiveError){<div class="alert alert-error" role="alert">@archiveError</div>}else if(Model.Archive.Items.Count==0){<div class="empty-state"><h3>@L.T("patient.archive_empty_title",_culture)</h3><p>@L.T("patient.archive_empty_body",_culture)</p></div>}else{<div class="responsive-table"><table><thead><tr><th>@L.T("patient.arch_title",_culture)</th><th>@L.T("patient.arch_type_version",_culture)</th><th>@L.T("patient.arch_author_date",_culture)</th><th>@L.T("patient.arch_document",_culture)</th><th>@L.T("patient.arch_review",_culture)</th><th>@L.T("patient.arch_signature",_culture)</th><th>@L.T("patient.arch_next_action",_culture)</th></tr></thead><tbody>@foreach(var d in Model.Archive.Items){<tr><td data-label="@L.T("patient.arch_title",_culture)">@d.Title</td><td data-label="@L.T("patient.arch_type_version",_culture)">@d.Type · v@d.Version</td><td data-label="@L.T("patient.arch_author_date",_culture)">@d.Author<small>@CulturedTime.DateTime(d.CreatedAt,_culture)</small></td><td data-label="@L.T("patient.arch_document",_culture)"><span class="status-badge">@d.DocumentStatus</span></td><td data-label="@L.T("patient.arch_review",_culture)"><span class="status-badge">@d.ReviewStatus</span></td><td data-label="@L.T("patient.arch_signature",_culture)">@(d.SignatureStatus=="not_available"?L.T("patient.signature_not_integrated",_culture):d.SignatureStatus)</td><td data-label="@L.T("patient.arch_next_action",_culture)"><div class="form-actions-row"><a class="button button-quiet" asp-controller="Studio" asp-action="Version" asp-route-tenantId="@tenantId" asp-route-versionId="@d.Id">@L.T("patient.view_version",_culture)</a>@if(d.ReviewId is Guid reviewId){<a class="button button-link" asp-controller="Reviews" asp-action="Detail" asp-route-tenantId="@tenantId" asp-route-reviewId="@reviewId">@L.T("patient.follow_review",_culture)</a>}else if(d.NextAction=="request_review"){<a class="button button-primary" asp-controller="Studio" asp-action="Version" asp-route-tenantId="@tenantId" asp-route-versionId="@d.Id" asp-fragment="solicitar-revisao">@L.T("patient.request_review",_culture)</a>}else{<small>@L.T("patient.review_unavailable",_culture)</small>}</div></td></tr>}</tbody></table></div>}<details class="help"><summary>@L.T("common.how_to_use",_culture)</summary><p>@L.T("patient.help_open_version",_culture)</p></details></section>
<section id="historico" class="card"><h2>@L.T("patient.subnav_history",_culture)</h2><p class="muted">@L.T("patient.history_note",_culture,p.Version.ToString(),CulturedTime.DateTime(p.UpdatedAt,_culture))</p></section>
<section class="card controlled-state"><h2>@L.T(p.Active?"patient.deactivate_title":"patient.restore_title",_culture)</h2><p>@L.T(p.Active?"patient.deactivate_note":"patient.restore_note",_culture)</p><form method="post" asp-action="SetActive" asp-route-tenantId="@tenantId" asp-route-patientId="@p.Id" onsubmit="return confirm('@L.T(p.Active?"patient.deactivate_confirm":"patient.restore_confirm",_culture)')">@Html.AntiForgeryToken()<input type="hidden" name="active" value="@((!p.Active).ToString().ToLowerInvariant())"/><input type="hidden" name="expectedVersion" value="@p.Version"/><button class="button @(p.Active?"button-danger":"button-primary")" type="submit">@L.T(p.Active?"patient.deactivate_btn":"patient.restore_btn",_culture)</button></form></section>
