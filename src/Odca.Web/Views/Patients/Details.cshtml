@model PatientDetailsViewModel
@{ var tenantId=(Guid)ViewData["TenantId"]!; var p=Model.Patient; }
<nav class="breadcrumb" aria-label="Trilha"><a href="@Model.ReturnUrl">Pacientes</a><span>›</span><span aria-current="page">Ficha</span></nav>
<section class="page-heading"><div><p class="eyebrow">Ficha do paciente</p><h1>@p.FullName</h1><p>@(p.PreferredName is null?"Cadastro e jornada documental":$"Nome de preferência: {p.PreferredName}")</p></div><div class="button-row"><a class="button button-link" asp-action="Edit" asp-route-tenantId="@tenantId" asp-route-patientId="@p.Id">Editar</a>@if(p.Active){<a class="button button-primary" asp-controller="Studio" asp-action="Index" asp-route-tenantId="@tenantId" asp-route-patientId="@p.Id">Gerar documentos</a>}</div></section>
@if(TempData["PatientSuccess"] is string success){<div class="alert alert-success" role="status">@success</div>}@if(TempData["PatientError"] is string error){<div class="alert alert-error" role="alert">@error</div>}
<nav class="sheet-subnav" aria-label="Seções da ficha"><a href="#resumo">Resumo</a><a href="#cadastro">Dados cadastrais</a><a href="#representante">Representante</a><a href="#documentos">Documentos</a><a href="#historico">Histórico</a></nav>
<section id="resumo" class="summary-grid"><article><span>Situação</span><strong>@(p.Active?"Ativo":"Inativo")</strong></article><article><span>Versão cadastral</span><strong>@p.Version</strong></article><article><span>Última atualização</span><strong>@p.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</strong></article></section>
<section id="cadastro" class="card patient-details"><h2>Dados cadastrais</h2><dl><div><dt>Nome completo</dt><dd>@p.FullName</dd></div><div><dt>Nascimento</dt><dd>@(p.BirthDate?.ToString("dd/MM/yyyy")??"Não informado")</dd></div><div><dt>Identificador</dt><dd>@(p.IdentifierValue??"Não informado")</dd></div><div><dt>E-mail</dt><dd>@(p.Email??"Não informado")</dd></div><div><dt>Telefone</dt><dd>@(p.Phone??"Não informado")</dd></div><div><dt>Endereço</dt><dd>@(p.Address??"Não informado")</dd></div></dl></section>
<section id="representante" class="card"><h2>Representante</h2>@if(p.Representative is null){<p class="muted">Nenhum representante informado.</p>}else{<dl><dt>Nome</dt><dd>@p.Representative.FullName</dd><dt>Relação</dt><dd>@p.Representative.Relationship</dd><dt>Identificador</dt><dd>@(p.Representative.IdentifierValue??"Não informado")</dd></dl>}</section>
<section id="documentos" class="card"><div class="section-heading"><div><h2>Acervo documental</h2><p>Versões imutáveis vinculadas ao paciente.</p></div></div>@if(ViewData["ArchiveError"] is string archiveError){<div class="alert alert-error" role="alert">@archiveError</div>}else if(Model.Archive.Items.Count==0){<div class="empty-state"><h3>Nenhum documento gerado</h3><p>Escolha um modelo publicado para iniciar uma minuta vinculada.</p></div>}else{<div class="responsive-table"><table><thead><tr><th>Título</th><th>Tipo / versão</th><th>Autor / data</th><th>Documento</th><th>Revisão</th><th>Assinatura</th><th>Próxima ação</th></tr></thead><tbody>@foreach(var d in Model.Archive.Items){<tr><td data-label="Título">@d.Title</td><td data-label="Tipo / versão">@d.Type · v@d.Version</td><td data-label="Autor / data">@d.Author<small>@d.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small></td><td data-label="Documento"><span class="status-badge">@d.DocumentStatus</span></td><td data-label="Revisão"><span class="status-badge">@d.ReviewStatus</span></td><td data-label="Assinatura">@(d.SignatureStatus=="not_available"?"Não integrada":d.SignatureStatus)</td><td data-label="Próxima ação"><div class="form-actions-row"><a class="button button-quiet" asp-controller="Studio" asp-action="Version" asp-route-tenantId="@tenantId" asp-route-versionId="@d.Id">Visualizar versão</a>@if(d.ReviewId is Guid reviewId){<a class="button button-link" asp-controller="Reviews" asp-action="Detail" asp-route-tenantId="@tenantId" asp-route-reviewId="@reviewId">Acompanhar revisão</a>}else if(d.NextAction=="request_review"){<a class="button button-primary" asp-controller="Studio" asp-action="Version" asp-route-tenantId="@tenantId" asp-route-versionId="@d.Id" asp-fragment="solicitar-revisao">Solicitar revisão</a>}else{<small>A revisão não está disponível para seu perfil.</small>}</div></td></tr>}</tbody></table></div>}<details class="help"><summary>Como usar</summary><p>Abra uma versão para conferir o retrato gerado. Quando autorizado, solicite ou acompanhe a revisão sem copiar identificadores.</p></details></section>
<section id="historico" class="card"><h2>Histórico</h2><p class="muted">Versão @p.Version · atualizado em @p.UpdatedAt.ToString("dd/MM/yyyy HH:mm"). Eventos críticos são mantidos na auditoria da organização sem repetir dados pessoais.</p></section>
<section class="card controlled-state"><h2>@(p.Active?"Inativar cadastro":"Restaurar cadastro")</h2><p>@(p.Active?"A inativação impede novas emissões, mas preserva documentos, snapshots e histórico.":"A restauração será bloqueada se outro cadastro ativo utilizar o mesmo identificador.")</p><form method="post" asp-action="SetActive" asp-route-tenantId="@tenantId" asp-route-patientId="@p.Id" onsubmit="return confirm('@(p.Active?"Inativar este paciente e preservar seu acervo?":"Restaurar este paciente?")')"><input type="hidden" name="active" value="@((!p.Active).ToString().ToLowerInvariant())"/><input type="hidden" name="expectedVersion" value="@p.Version"/><button class="button @(p.Active?"button-danger":"button-primary")" type="submit">@(p.Active?"Inativar":"Restaurar")</button></form></section>
