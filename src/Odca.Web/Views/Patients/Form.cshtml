@model PatientFormViewModel
@{ var tenantId=(Guid)ViewData["TenantId"]!; var editing=Model.Id.HasValue; var _culture=(string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey]; }
<section class="page-heading"><div><p class="eyebrow">@L.T("patient.eyebrow",_culture)</p><h1>@L.T(editing?"patient.edit_title":"patient.new_cta",_culture)</h1><p>@L.T("patient.form_subtitle",_culture)</p></div><details class="help"><summary>@L.T("common.how_to_use",_culture)</summary><p>@L.T("patient.form_help",_culture)</p></details></section>
<form method="post" class="patient-form" data-submit-once>
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="alert alert-error" role="alert"></div>
    <input asp-for="ExpectedVersion" type="hidden" />
    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
    <section class="card"><h2>@L.T("patient.section_identification",_culture)</h2><div class="form-grid"><label>@L.T("patient.full_name",_culture)<input asp-for="FullName" autocomplete="name" /><span asp-validation-for="FullName" class="validation"></span></label><label>@L.T("patient.preferred_name",_culture)<input asp-for="PreferredName" /><span asp-validation-for="PreferredName" class="validation"></span></label><label>@L.T("patient.birth_date",_culture)<input asp-for="BirthDate" type="date" /><span asp-validation-for="BirthDate" class="validation"></span></label><label>@L.T("patient.identifier_type",_culture)<select asp-for="IdentifierType"><option value="">@L.T("patient.not_informed",_culture)</option><option value="cpf">@L.T("patient.id_cpf",_culture)</option><option value="cnpj">@L.T("patient.id_cnpj",_culture)</option><option value="passport">@L.T("patient.id_passport",_culture)</option><option value="other">@L.T("patient.id_other",_culture)</option></select></label><label>@L.T("patient.identifier_value",_culture)<input asp-for="IdentifierValue" autocomplete="off" /><span asp-validation-for="IdentifierValue" class="validation"></span></label></div></section>
    <section class="card"><h2>@L.T("patient.section_contacts",_culture)</h2><div class="form-grid"><label>@L.T("patient.email",_culture)<input asp-for="Email" type="email" autocomplete="email" /><span asp-validation-for="Email" class="validation"></span></label><label>@L.T("patient.phone",_culture)<input asp-for="Phone" autocomplete="tel" /><span asp-validation-for="Phone" class="validation"></span></label><label class="form-grid-full">@L.T("patient.address",_culture)<textarea asp-for="Address" rows="3"></textarea><span asp-validation-for="Address" class="validation"></span></label></div></section>
<section class="card"><h2>@L.T("patient.section_representative",_culture)</h2><label class="check-label"><input asp-for="HasRepresentative" data-representative-toggle /> @L.T("patient.has_representative",_culture)</label><div class="form-grid" data-representative-fields hidden="@(!Model.HasRepresentative)"><label>@L.T("patient.rep_name",_culture)<input asp-for="RepresentativeFullName" /><span asp-validation-for="RepresentativeFullName" class="validation"></span></label><label>@L.T("patient.rep_relationship",_culture)<input asp-for="RepresentativeRelationship" /><span asp-validation-for="RepresentativeRelationship" class="validation"></span></label><label>@L.T("patient.identifier_type",_culture)<select asp-for="RepresentativeIdentifierType"><option value="">@L.T("patient.not_informed",_culture)</option><option value="cpf">@L.T("patient.id_cpf",_culture)</option><option value="cnpj">@L.T("patient.id_cnpj",_culture)</option><option value="passport">@L.T("patient.id_passport",_culture)</option><option value="other">@L.T("patient.id_other",_culture)</option></select></label><label>@L.T("patient.identifier_value",_culture)<input asp-for="RepresentativeIdentifierValue" /><span asp-validation-for="RepresentativeIdentifierValue" class="validation"></span></label></div><p class="muted">@L.T("patient.representative_note",_culture)</p></section>
    <div class="form-actions-row"><button class="button button-primary" type="submit">@L.T(editing?"patient.save_changes":"patient.new_cta",_culture)</button><a class="button button-link" href="@(ViewData["ReturnUrl"] is string returnUrl && !string.IsNullOrWhiteSpace(returnUrl) ? returnUrl : Url.Action(editing ? "Details" : "Index", new { tenantId, patientId = Model.Id }))">@L.T("action.cancel",_culture)</a></div>
</form>
<script src="~/js/patients.js" asp-append-version="true"></script>
