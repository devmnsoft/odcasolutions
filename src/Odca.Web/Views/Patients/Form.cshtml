@model PatientFormViewModel
@{ var tenantId=(Guid)ViewData["TenantId"]!; var editing=Model.Id.HasValue; }
<section class="page-heading"><div><p class="eyebrow">Central de pacientes</p><h1>@(editing?"Editar paciente":"Cadastrar paciente")</h1><p>Informe apenas os dados necessários. Dados adicionais podem ser exigidos pelo modelo escolhido.</p></div><details class="help"><summary>Como usar</summary><p>Tipo e valor do identificador devem ser preenchidos juntos. Marque representante somente quando houver uma relação informada; isso não concede poderes nem cria login.</p></details></section>
<form method="post" class="patient-form" data-submit-once>
    <div asp-validation-summary="ModelOnly" class="alert alert-error" role="alert"></div>
    <input asp-for="ExpectedVersion" type="hidden" />
    <section class="card"><h2>Identificação</h2><div class="form-grid"><label>Nome completo<input asp-for="FullName" autocomplete="name" /><span asp-validation-for="FullName" class="validation"></span></label><label>Nome de preferência<input asp-for="PreferredName" /><span asp-validation-for="PreferredName" class="validation"></span></label><label>Data de nascimento<input asp-for="BirthDate" type="date" /><span asp-validation-for="BirthDate" class="validation"></span></label><label>Tipo do identificador<select asp-for="IdentifierType"><option value="">Não informado</option><option value="cpf">CPF</option><option value="passport">Passaporte</option><option value="other">Outro</option></select></label><label>Valor do identificador<input asp-for="IdentifierValue" autocomplete="off" /><span asp-validation-for="IdentifierValue" class="validation"></span></label></div></section>
    <section class="card"><h2>Contatos</h2><div class="form-grid"><label>E-mail<input asp-for="Email" type="email" autocomplete="email" /><span asp-validation-for="Email" class="validation"></span></label><label>Telefone<input asp-for="Phone" autocomplete="tel" /><span asp-validation-for="Phone" class="validation"></span></label><label class="form-grid-full">Endereço<textarea asp-for="Address" rows="3"></textarea><span asp-validation-for="Address" class="validation"></span></label></div></section>
    <section class="card"><h2>Representação</h2><label class="check-label"><input asp-for="HasRepresentative" data-representative-toggle /> Este paciente possui representante</label><div class="form-grid" data-representative-fields hidden="@(!Model.HasRepresentative)"><label>Nome do representante<input asp-for="RepresentativeFullName" /></label><label>Relação com o paciente<input asp-for="RepresentativeRelationship" /></label><label>Tipo do identificador<select asp-for="RepresentativeIdentifierType"><option value="">Não informado</option><option value="cpf">CPF</option><option value="passport">Passaporte</option><option value="other">Outro</option></select></label><label>Valor do identificador<input asp-for="RepresentativeIdentifierValue" /></label></div><p class="muted">O cadastro registra a relação informada; poderes de representação e signatários dependem do documento aprovado.</p></section>
    <div class="form-actions-row"><button class="button button-primary" type="submit">@(editing?"Salvar alterações":"Cadastrar paciente")</button><a class="button button-link" asp-action="@(editing?"Details":"Index")" asp-route-tenantId="@tenantId" asp-route-patientId="@Model.Id">Cancelar</a></div>
</form>
<script src="~/js/patients.js" asp-append-version="true"></script>
