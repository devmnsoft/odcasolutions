@model Odca.Contracts.Patients.PatientPage
@{ var tenantId=(Guid)ViewData["TenantId"]!; var search=ViewData["Search"] as string; var inactive=ViewData["IncludeInactive"] as bool? == true; var filtered=!string.IsNullOrWhiteSpace(search)||inactive; }
<section class="page-heading"><div><p class="eyebrow">Central de pacientes</p><h1>Pacientes</h1><p>Cadastre, confira e conecte cada paciente às minutas e ao acervo documental.</p></div><a class="button button-primary" asp-action="Create" asp-route-tenantId="@tenantId">Cadastrar paciente</a></section>
<details class="help-card"><summary>Como usar</summary><p>Pesquise pelo nome ou identificador permitido, abra a ficha e escolha <strong>Gerar documentos</strong>. O cadastro mínimo exige somente o nome; cada modelo informa suas próprias pendências.</p></details>
@if(TempData["PatientSuccess"] is string success){<div class="alert alert-success" role="status">@success</div>}
@if(ViewData["LoadError"] is string error){<div class="alert alert-error" role="alert"><strong>Falha ao carregar.</strong> @error <a asp-action="Index" asp-route-tenantId="@tenantId" asp-route-search="@search" asp-route-includeInactive="@inactive">Tentar novamente</a></div>}
<form method="get" class="patient-filters"><label>Buscar<input name="search" value="@search" placeholder="Nome ou identificador" /></label><label class="check-label"><input type="checkbox" name="includeInactive" value="true" checked="@inactive" /> Incluir inativos</label><button class="button button-primary" type="submit">Aplicar filtros</button></form>
@if(Model.Items.Count>0){<div class="responsive-table patient-table"><table><thead><tr><th>Paciente</th><th>Identificador</th><th>Situação</th><th>Atualização</th><th></th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td data-label="Paciente"><strong>@item.FullName</strong>@if(!string.IsNullOrWhiteSpace(item.PreferredName)){<small>Nome de preferência: @item.PreferredName</small>}</td><td data-label="Identificador">@(item.MaskedIdentifier??"Não informado")</td><td data-label="Situação"><span class="status-badge @(item.Active?"status-approved":"status-rejected")">@(item.Active?"Ativo":"Inativo")</span></td><td data-label="Atualização">@item.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</td><td data-label="Ações"><a asp-action="Details" asp-route-tenantId="@tenantId" asp-route-patientId="@item.Id" asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString">Abrir ficha</a></td></tr>}</tbody></table></div>}
else if(ViewData["LoadError"] is null){<div class="empty-state"><h2>@(filtered?"Nenhum resultado para estes filtros":"Nenhum paciente cadastrado")</h2><p>@(filtered?"Ajuste a busca ou remova o filtro de situação.":"Cadastre o primeiro paciente para iniciar a jornada documental.")</p>@if(filtered){<a class="button button-link" asp-action="Index" asp-route-tenantId="@tenantId">Limpar filtros</a>}</div>}
@if(Model.Total>Model.PageSize){<nav class="pagination" aria-label="Paginação">@if(Model.Page>1){<a class="button button-link" asp-route-search="@search" asp-route-includeInactive="@inactive" asp-route-page="@(Model.Page-1)">Anterior</a>}<span>Página @Model.Page de @((Model.Total+Model.PageSize-1)/Model.PageSize)</span>@if(Model.Page*Model.PageSize<Model.Total){<a class="button button-link" asp-route-search="@search" asp-route-includeInactive="@inactive" asp-route-page="@(Model.Page+1)">Próxima</a>}</nav>}
