@model Odca.Contracts.Patients.PatientPage
@{ var tenantId=(Guid)ViewData["TenantId"]!; var search=ViewData["Search"] as string; var inactive=ViewData["IncludeInactive"] as bool? == true; var filtered=!string.IsNullOrWhiteSpace(search)||inactive; var _culture=(string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey]; }
<section class="page-heading"><div><p class="eyebrow">@L.T("patient.eyebrow",_culture)</p><h1>@L.T("pacientes",_culture)</h1><p>@L.T("patient.subtitle",_culture)</p></div><a class="button button-primary" asp-action="Create" asp-route-tenantId="@tenantId">@L.T("patient.new_cta",_culture)</a></section>
<details class="help-card"><summary>@L.T("common.how_to_use",_culture)</summary><p>@L.T("patient.help_body",_culture)</p></details>
@if(TempData["PatientSuccess"] is string success){<div class="alert alert-success" role="status">@success</div>}
@if(ViewData["Denied"] is true){<div class="alert alert-error" role="alert"><strong>@L.T("patient.deny_title",_culture)</strong> @L.T("patient.deny_body",_culture)</div>}else if(ViewData["LoadError"] is string error){<div class="alert alert-error" role="alert"><strong>@L.T("patient.load_error_title",_culture)</strong> @error <a asp-action="Index" asp-route-tenantId="@tenantId" asp-route-search="@search" asp-route-includeInactive="@inactive">@L.T("patient.retry",_culture)</a></div>}
<form method="get" class="patient-filters"><label>@L.T("patient.search_label",_culture)<input name="search" value="@search" placeholder="@L.T("patient.search_placeholder",_culture)" /></label><label class="check-label"><input type="checkbox" name="includeInactive" value="true" checked="@inactive" /> @L.T("patient.include_inactive",_culture)</label><button class="button button-primary" type="submit">@L.T("patient.apply_filters",_culture)</button></form>
@if(Model.Items.Count>0){<div class="responsive-table patient-table"><table><thead><tr><th>@L.T("patient.col_patient",_culture)</th><th>@L.T("patient.col_identifier",_culture)</th><th>@L.T("patient.col_status",_culture)</th><th>@L.T("patient.col_updated",_culture)</th><th></th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td data-label="@L.T("patient.col_patient",_culture)"><strong>@item.FullName</strong>@if(!string.IsNullOrWhiteSpace(item.PreferredName)){<small>@L.T("patient.preferred_name_small",_culture) @item.PreferredName</small>}</td><td data-label="@L.T("patient.col_identifier",_culture)">@(item.MaskedIdentifier??L.T("patient.not_informed",_culture))</td><td data-label="@L.T("patient.col_status",_culture)"><span class="status-badge @(item.Active?"status-approved":"status-rejected")">@L.T(item.Active?"patient.status_active":"patient.status_inactive",_culture)</span></td><td data-label="@L.T("patient.col_updated",_culture)">@CulturedTime.DateTime(item.UpdatedAt,_culture)</td><td data-label="@L.T("patient.col_actions",_culture)"><a asp-action="Details" asp-route-tenantId="@tenantId" asp-route-patientId="@item.Id" asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString">@L.T("patient.open_sheet",_culture)</a></td></tr>}</tbody></table></div>}
else if(ViewData["LoadError"] is null && ViewData["Denied"] is not true){<div class="empty-state"><h2>@L.T(filtered?"patient.empty_filtered_title":"patient.empty_title",_culture)</h2><p>@L.T(filtered?"patient.empty_filtered_body":"patient.empty_body",_culture)</p>@if(filtered){<a class="button button-link" asp-action="Index" asp-route-tenantId="@tenantId">@L.T("patient.clear_filters",_culture)</a>}</div>}
@if(Model.Total>Model.PageSize){<nav class="pagination" aria-label="@L.T("patient.pagination_aria",_culture)">@if(Model.Page>1){<a class="button button-link" asp-route-search="@search" asp-route-includeInactive="@inactive" asp-route-page="@(Model.Page-1)">@L.T("inbox.prev",_culture)</a>}<span>@L.T("patient.page_of",_culture,Model.Page.ToString(),((Model.Total+Model.PageSize-1)/Model.PageSize).ToString())</span>@if(Model.Page*Model.PageSize<Model.Total){<a class="button button-link" asp-route-search="@search" asp-route-includeInactive="@inactive" asp-route-page="@(Model.Page+1)">@L.T("inbox.next",_culture)</a>}</nav>}
