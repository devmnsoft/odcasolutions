@model CustomerRegistrationViewModel
@{
    ViewData["Title"] = "Contratar";
}
<section class="narrow">
    <div class="card">
        <p class="eyebrow">Cadastro do cliente</p>
        <h1>Comece pelo plano escolhido</h1>
        <p class="muted">O acesso à organização só é liberado após confirmação do e-mail. A contratação fica pendente até validação comercial.</p>
        <form method="post" novalidate data-processing>
            <div asp-validation-summary="ModelOnly" class="validation" role="alert"></div>
            <label asp-for="PlanCode"></label>
            <select asp-for="PlanCode" autofocus>
                <option value="">Selecione</option>
                <option value="basic">Basic</option>
                <option value="intermediate">Intermediário</option>
                <option value="enterprise">Enterprise</option>
            </select>
            <span asp-validation-for="PlanCode" class="validation"></span>
            <label asp-for="Document"></label>
            <input asp-for="Document" autocomplete="off" />
            <span asp-validation-for="Document" class="validation"></span>
            <label asp-for="ResponsibleName"></label>
            <input asp-for="ResponsibleName" autocomplete="name" />
            <span asp-validation-for="ResponsibleName" class="validation"></span>
            <label asp-for="Email"></label>
            <input asp-for="Email" autocomplete="email" />
            <span asp-validation-for="Email" class="validation"></span>
            <label asp-for="Password"></label>
            <div class="field-with-action"><input asp-for="Password" autocomplete="new-password" /><button class="field-action" type="button" data-password-toggle aria-pressed="false">Mostrar</button></div>
            <span asp-validation-for="Password" class="validation"></span>
            <label asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="validation"></span>
            <label class="checkbox-line">
                <input asp-for="AcceptedTerms" />
                <span>@Html.DisplayNameFor(model => model.AcceptedTerms)</span>
            </label>
            <span asp-validation-for="AcceptedTerms" class="validation"></span>
            <label class="checkbox-line">
                <input asp-for="AcknowledgedPrivacyNotice" />
                <span>@Html.DisplayNameFor(model => model.AcknowledgedPrivacyNotice)</span>
            </label>
            <span asp-validation-for="AcknowledgedPrivacyNotice" class="validation"></span>
            <label class="checkbox-line">
                <input asp-for="MarketingConsent" />
                <span>@Html.DisplayNameFor(model => model.MarketingConsent)</span>
            </label>
            <button class="button button-primary button-block" type="submit" data-processing-label="Enviando cadastro…">Criar cadastro</button>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
