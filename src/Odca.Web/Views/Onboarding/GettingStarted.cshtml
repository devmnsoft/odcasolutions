@model GettingStartedPageViewModel
@{
    ViewData["Title"] = L.T("gs.title", (string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey]);
    var _c = (string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey];
    var percent = Model.Steps.Count == 0 ? 0 : Model.CompletedSteps * 100 / Model.Steps.Count;
}
<section class="getting-started">
    <header class="page-heading">
        <div>
            <p class="eyebrow">@L.T("gs.eyebrow", _c)</p>
            <h1>@L.T("gs.title", _c)</h1>
            <p class="muted">@L.T("gs.intro_1", _c)<strong>@Model.Home.OrganizationName</strong>. @L.T("gs.intro_2", _c)</p>
        </div>
        <a class="button button-quiet" asp-action="CustomerHome">@L.T("gs.back_to_home", _c)</a>
    </header>

    <section class="card onboarding-progress" aria-labelledby="progress-title">
        <div>
            <h2 id="progress-title">@L.T("gs.progress_title", _c)</h2>
            <p>@L.T("gs.progress_text", _c, Model.CompletedSteps.ToString(System.Globalization.CultureInfo.InvariantCulture), Model.Steps.Count.ToString(System.Globalization.CultureInfo.InvariantCulture))</p>
        </div>
        <div class="progress-track" role="progressbar" aria-label="@L.T("gs.progress_aria", _c)" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@percent">
            <span style="width:@percent%"></span>
        </div>
    </section>

    <ol class="onboarding-steps">
        @for (var index = 0; index < Model.Steps.Count; index++)
        {
            var step = Model.Steps[index];
            <li class="card onboarding-step @(step.Completed ? "completed" : null)">
                <span class="step-number" aria-hidden="true">@(step.Completed ? "✓" : (index + 1).ToString())</span>
                <div class="step-content">
                    <div class="step-title-row">
                        <h2>@step.Title</h2>
                        @if (step.Optional) { <span class="badge">@L.T("gs.optional", _c)</span> }
                        <span class="step-state">@(step.Completed ? L.T("gs.done", _c) : step.Available ? L.T("gs.pending", _c) : L.T("gs.needs_permission", _c))</span>
                    </div>
                    <p>@step.Description</p>
                    <p class="muted"><strong>@L.T("gs.responsible_label", _c)</strong>@step.Responsible.</p>
                    @if (step.Available)
                    {
                        <a class="button @(step.Completed ? "button-quiet" : "button-primary")"
                           asp-controller="@step.Controller" asp-action="@step.Action" asp-route-tenantId="@Model.Home.TenantId">@step.ActionLabel</a>
                    }
                    else
                    {
                        <p class="permission-note" role="note">@L.T("gs.permission_note", _c)</p>
                    }
                </div>
            </li>
        }
    </ol>

    <details class="card how-to">
        <summary>@L.T("common.how_to_use", _c)</summary>
        <p>@L.T("gs.howto_1", _c)</p>
        <p>@L.T("gs.howto_2", _c)</p>
    </details>
</section>
