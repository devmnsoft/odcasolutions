@model CustomerHomePageViewModel
@{
    ViewData["Title"] = L.T("onb.home_title", (string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey]);
    var _c = (string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey];
    var home = Model.Home;
    var overview = Model.Overview;
    var isSuspended = home.TenantStatus == "suspended";
    var isCommercialActive = home.CommercialState == "active";
    var tzId = string.IsNullOrWhiteSpace(home.Timezone) ? "America/Sao_Paulo" : home.Timezone.Trim();
    TimeZoneInfo timeZone;
    try
    {
        timeZone = TimeZoneInfo.FindSystemTimeZoneById(tzId);
    }
    catch
    {
        try { timeZone = TimeZoneInfo.FindSystemTimeZoneById("America/Sao_Paulo"); }
        catch { timeZone = TimeZoneInfo.Utc; }
    }
}

<section>
    <div class="dashboard-heading page-heading">
        <div>
            <p class="eyebrow">@L.T("onb.home_eyebrow", _c)</p>
            <h1>@home.OrganizationName</h1>
            @if (isSuspended)
            {
                <div class="error" role="alert" style="margin-top: 0.5rem;">
                    <strong>@L.T("onb.suspended", _c)</strong> @L.T("onb.suspended_body", _c)
                </div>
            }
            else if (isCommercialActive)
            {
                <p class="muted">@L.T("onb.commercial_state", _c)<strong style="color: var(--success);">@L.T("onb.commercial_active", _c)</strong>. @L.T("onb.commercial_active_body", _c)</p>
            }
            else
            {
                <p class="muted">@L.T("onb.commercial_state", _c)<strong>@home.CommercialState</strong>. @L.T("onb.commercial_note", _c)</p>
            }
        </div>
        <div class="button-row">
            @if (Model.CanCreateDocument && !isSuspended)
            {
                <a class="button button-primary" asp-controller="Documents" asp-action="NewDocument" asp-route-tenantId="@home.TenantId">
                    <span aria-hidden="true">+</span> @L.T("documents.new_document", _c)
                </a>
            }
            @if (Model.CanManagePatients && !isSuspended)
            {
                <a class="button" asp-controller="Patients" asp-action="Create" asp-route-tenantId="@home.TenantId">
                    <span aria-hidden="true">♙</span> @L.T("patient.new_cta", _c)
                </a>
            }
            @if (overview?.Pendencies is { Count: > 0 } || !isCommercialActive)
            {
                <a class="button button-quiet" asp-controller="Onboarding" asp-action="GettingStarted" asp-route-tenantId="@home.TenantId">
                    @L.T("onb.pending_settings", _c)
                </a>
            }
            <a class="button" asp-controller="Organizations" asp-action="Team" asp-route-tenantId="@home.TenantId">@L.T("org.open_team", _c)</a>
        </div>
    </div>

    @* Documentos Recentes *@
    <section class="card" style="margin-bottom: 2rem;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 1rem;">
            <h2 style="margin:0;">@L.T("onb.recent_documents", _c)</h2>
            <a class="button button-small" asp-controller="Documents" asp-action="Index" asp-route-tenantId="@home.TenantId">
                @L.T("onb.all_documents", _c) <span aria-hidden="true">→</span>
            </a>
        </div>

        @if (Model.DocumentsError is not null)
        {
            <div class="error" role="alert">
                <strong>@L.T("onb.doc_error", _c)</strong> @Model.DocumentsError
            </div>
        }
        else if (Model.RecentDocuments.Count > 0)
        {
            <div class="table-scroll">
                <table class="table" aria-label="@L.T("onb.recent_documents", _c)">
                    <thead>
                        <tr>
                            <th>@L.T("onb.th_title", _c)</th>
                            <th>@L.T("common.type", _c)</th>
                            <th>@L.T("onb.th_patient", _c)</th>
                            <th>@L.T("onb.th_status", _c)</th>
                            <th>@L.T("onb.th_updated", _c)</th>
                            <th>@L.T("actions.item_action", _c)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var doc in Model.RecentDocuments)
                        {
                            <tr>
                                <td>
                                    <strong>@doc.Title</strong>
                                    @if (!string.IsNullOrWhiteSpace(doc.Reference))
                                    {
                                        <br /><small class="muted">Ref: @doc.Reference</small>
                                    }
                                </td>
                                <td>
                                    <span class="badge badge-muted">
                                        @(doc.DocumentType switch {
                                            "service" => L.T("onb.dt_service", _c),
                                            "consent" => L.T("onb.dt_consent", _c),
                                            "nda" => L.T("onb.dt_nda", _c),
                                            "amendment" => L.T("onb.dt_amendment", _c),
                                            _ => doc.DocumentType
                                        })
                                    </span>
                                </td>
                                <td>@(doc.PatientName ?? "—")</td>
                                <td>
                                    <small>
                                        @(doc.DraftStatus == "draft" ? L.T("onb.draft_editing", _c) :
                                          doc.ReviewStatus == "submitted" ? L.T("common.status_in_review", _c) :
                                          doc.ReviewStatus == "internally_approved" ? L.T("onb.approved", _c) :
                                          doc.PdfStatus == "completed" ? L.T("onb.pdf_done", _c) : L.T("onb.registered", _c))
                                    </small>
                                </td>
                                <td>
                                    <time datetime="@doc.UpdatedAt.ToString("o")">
                                        @CulturedTime.DateTime(TimeZoneInfo.ConvertTime(doc.UpdatedAt, timeZone), _c)
                                    </time>
                                </td>
                                <td>
                                    @if (doc.DraftId.HasValue && !isSuspended)
                                    {
                                        <a class="button button-small button-primary"
                                           asp-controller="Studio"
                                           asp-action="Edit"
                                           asp-route-tenantId="@home.TenantId"
                                           asp-route-draftId="@doc.DraftId.Value">
                                            @L.T("documents.btn_continue", _c)
                                        </a>
                                    }
                                    else
                                    {
                                        <a class="button button-small"
                                           asp-controller="Contracts"
                                           asp-action="Sheet"
                                           asp-route-tenantId="@home.TenantId"
                                           asp-route-contractId="@doc.ContractId">
                                            @L.T("common.open", _c)
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state" style="padding: 1.5rem 0;">
                <p class="muted">@L.T("onb.empty_documents", _c)</p>
                @if (Model.CanCreateDocument && !isSuspended)
                {
                    <a class="button button-small button-primary" asp-controller="Documents" asp-action="NewDocument" asp-route-tenantId="@home.TenantId">
                        @L.T("onb.create_first_document", _c)
                    </a>
                }
            </div>
        }
    </section>

    @* Revisões atribuídas ao usuário *@
    @if (Model.CanReadReviews)
    {
        <section class="card" style="margin-bottom: 2rem;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 1rem;">
                <h2 style="margin:0;">@L.T("onb.my_reviews", _c)</h2>
                <a class="button button-small" asp-controller="Reviews" asp-action="Index" asp-route-tenantId="@home.TenantId">
                    @L.T("onb.all_reviews", _c) <span aria-hidden="true">→</span>
                </a>
            </div>

            @if (Model.ReviewsError is not null)
            {
                <div class="error" role="alert">
                    <strong>@L.T("onb.reviews_error", _c)</strong> @Model.ReviewsError
                </div>
            }
            else if (Model.AssignedReviews.Count > 0)
            {
                <div class="table-scroll">
                    <table class="table" aria-label="@L.T("onb.my_reviews", _c)">
                        <thead>
                            <tr>
                                <th>@L.T("onb.th_contract_doc", _c)</th>
                                <th>@L.T("onb.th_deadline", _c)</th>
                                <th>@L.T("onb.th_status", _c)</th>
                                <th>@L.T("actions.item_action", _c)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var review in Model.AssignedReviews)
                            {
                                <tr>
                                    <td>
                                        <strong>@review.Contract</strong>
                                        <br />
                                        <small class="muted">
                                            @(review.DocumentVersionNumber.HasValue ? L.T("onb.version_of", _c, review.DocumentVersionNumber.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)) : L.T("onb.no_version", _c)) · @L.T("onb.by_requester", _c, review.Requester)
                                        </small>
                                    </td>
                                    <td>
                                        @(review.DueAt.HasValue ? CulturedTime.DateTime(TimeZoneInfo.ConvertTime(review.DueAt.Value, timeZone), _c) : L.T("onb.no_deadline", _c))
                                    </td>
                                    <td>
                                        <span class="badge badge-muted">@review.Status switch
                                        {
                                            "in_review" => L.T("common.status_in_review", _c),
                                            "changes_requested" => L.T("rev.st_changes_requested", _c),
                                            "internally_approved" => L.T("common.status_internally_approved", _c),
                                            "cancelled" => L.T("rev.st_cancelled", _c),
                                            "superseded" => L.T("rev.st_superseded", _c),
                                            _ => review.Status
                                        }</span>
                                    </td>
                                    <td>
                                        <a class="button button-small button-primary"
                                           asp-controller="Reviews"
                                           asp-action="Detail"
                                           asp-route-tenantId="@home.TenantId"
                                           asp-route-reviewId="@review.Id">
                                            @L.T("onb.assess_review", _c)
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="muted">@L.T("onb.empty_reviews", _c)</p>
            }
        </section>
    }

    <div class="metrics">
        <a class="metric" asp-controller="Organizations" asp-action="Team" asp-route-tenantId="@home.TenantId" asp-route-tab="pessoas" asp-route-status="active">
            <span>@L.T("org.m_active_members", _c)</span>
            <strong>@(overview?.ActiveMembers.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "—")</strong>
        </a>
        <a class="metric" asp-controller="Organizations" asp-action="Team" asp-route-tenantId="@home.TenantId" asp-route-tab="convites" asp-route-invitationStatus="pending">
            <span>@L.T("org.m_valid_invitations", _c)</span>
            <strong>@(overview?.ValidInvitations.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "—")</strong>
        </a>
        <a class="metric" asp-controller="Organizations" asp-action="Team" asp-route-tenantId="@home.TenantId" asp-route-tab="pessoas">
            <span>@L.T("onb.available_seats", _c)</span>
            <strong>@(overview?.AvailableSeats.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "—")</strong>
        </a>
    </div>

    <div class="metrics">
        <div class="metric">
            <span>@L.T("onb.contracted_plan", _c)</span>
            <strong>@home.PlanName</strong>
        </div>
        <div class="metric">
            <span>@L.T("onb.user_limit", _c)</span>
            <strong>@(overview?.SeatLimit ?? home.ActiveSeats)</strong>
        </div>
        <div class="metric">
            <span>@L.T("onb.storage_capacity", _c)</span>
            <strong>@(home.StorageBytes / 1_000_000_000) GB</strong>
        </div>
    </div>

    @if (Model.OverviewError is not null)
    {
        <div class="error" role="alert" style="margin-top: 1.5rem;">
            <strong>@L.T("onb.org_notice", _c)</strong> @Model.OverviewError
        </div>
    }

    @if (overview?.Pendencies is { Count: > 0 })
    {
        <section class="card">
            <h2>@L.T("onb.actionable_pendencies", _c)</h2>
            <ul class="pendency-list">
                @foreach (var item in overview.Pendencies)
                {
                    <li>
                        <span>@item.Message</span>
                        <a class="button button-small"
                           asp-controller="Organizations"
                           asp-action="Team"
                           asp-route-tenantId="@home.TenantId"
                           asp-route-tab="@(item.Tab ?? "pessoas")"
                           asp-route-status="@item.StatusFilter">@L.T("common.open", _c)</a>
                    </li>
                }
            </ul>
        </section>
    }
</section>
