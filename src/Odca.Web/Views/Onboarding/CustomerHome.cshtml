@model Odca.Contracts.Onboarding.CustomerHomeResponse
@{
    ViewData["Title"] = "Cliente";
}
<section>
    <div class="dashboard-heading">
        <p class="eyebrow">Organização</p>
        <h1>@Model.OrganizationName</h1>
        <p class="muted">Estado comercial: @Model.CommercialState. O uso operacional permanece limitado até ativação comercial validada.</p>
    </div>
    <div class="metrics">
        <div class="metric">
            <span>Plano</span>
            <strong>@Model.PlanName</strong>
        </div>
        <div class="metric">
            <span>Usuários incluídos</span>
            <strong>@Model.ActiveSeats</strong>
        </div>
        <div class="metric">
            <span>Armazenamento</span>
            <strong>@(Model.StorageBytes / 1_000_000_000) GB</strong>
        </div>
    </div>
</section>
