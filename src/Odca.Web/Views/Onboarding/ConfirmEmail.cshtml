@model ConfirmEmailViewModel
@{
    ViewData["Title"] = "Confirmar e-mail";
}
<section class="narrow">
    <div class="card">
        <p class="eyebrow">Confirmação</p>
        <h1>Confirme seu e-mail</h1>
        <form method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="validation" role="alert"></div>
            <input asp-for="RegistrationId" type="hidden" />
            <label asp-for="Token"></label>
            <input asp-for="Token" autocomplete="one-time-code" autofocus />
            <span asp-validation-for="Token" class="validation"></span>
            <button class="button button-primary" type="submit">Confirmar</button>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
