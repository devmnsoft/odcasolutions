@{
    var _culture = (string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey];
    var name = ViewBag.name as string ?? "";
    var description = ViewBag.description as string ?? "";
    var contractType = ViewBag.contractType as string ?? "services";
    var documentPurpose = ViewBag.documentPurpose as string ?? "";
}
<header class="renewal-heading">
    <div>
        <p class="eyebrow">@L.T("layout.platform", _culture)</p>
        <h1>@L.T("platform.template_create_title", _culture)</h1>
        <p class="muted">@L.T("platform.template_create_subtitle", _culture)</p>
    </div>
</header>
<details class="help-card"><summary>@L.T("common.how_to_use", _culture)</summary><ol><li>@L.T("platform.tplnew_manual_1", _culture)</li><li>@L.T("platform.tplnew_manual_2", _culture)</li><li>@L.T("platform.tplnew_manual_3", _culture)</li></ol></details>

@if (TempData["Error"] is string errMsg && !string.IsNullOrWhiteSpace(errMsg))
{
    <div class="validation-summary" role="alert">@errMsg</div>
}

<form method="post" asp-action="CreatePost" class="form-stack" id="create-template-form">
    @Html.AntiForgeryToken()

    <label>@L.T("platform.tpl_name", _culture)
        <input type="text" name="name" value="@name" required minlength="3" maxlength="200"
               placeholder="@L.T("platform.tpl_name_ph", _culture)" />
    </label>

    <label>@L.T("platform.tpl_description", _culture)
        <textarea name="description" rows="3" maxlength="1000"
                  placeholder="@L.T("platform.tpl_description_ph", _culture)">@description</textarea>
    </label>

    <label>@L.T("platform.tpl_type", _culture)
        <select name="contractType" required>
            <option value="services" selected="@(contractType=="services")">@L.T("platform.lib_type_services", _culture)</option>
            <option value="service" selected="@(contractType=="service")">@L.T("platform.lib_type_service", _culture)</option>
            <option value="services-multiple-therapies" selected="@(contractType=="services-multiple-therapies")">@L.T("platform.lib_type_multi", _culture)</option>
            <option value="nda" selected="@(contractType=="nda")">@L.T("platform.lib_type_nda", _culture)</option>
            <option value="supply" selected="@(contractType=="supply")">@L.T("platform.lib_type_supply", _culture)</option>
            <option value="lease" selected="@(contractType=="lease")">@L.T("platform.lib_type_lease", _culture)</option>
            <option value="consent" selected="@(contractType=="consent")">@L.T("studio.purpose_consent", _culture)</option>
            <option value="amendment" selected="@(contractType=="amendment")">@L.T("platform.lib_type_amendment", _culture)</option>
        </select>
    </label>

    <label>@L.T("platform.tpl_purpose", _culture)
        <input type="text" name="documentPurpose" value="@documentPurpose" maxlength="100"
               placeholder="@L.T("platform.tpl_purpose_ph", _culture)" />
        <small class="muted">@L.T("platform.tpl_purpose_hint", _culture)</small>
    </label>

    <div class="form-actions-row">
        <button type="submit" class="button button-primary">@L.T("platform.tpl_create_btn", _culture)</button>
        <a class="button button-quiet" asp-action="Index">@L.T("platform.tpl_cancel", _culture)</a>
    </div>
</form>

<div class="muted" style="margin-top:2rem;">
    <h3>@L.T("platform.tpl_create_info_title", _culture)</h3>
    <ul>
        <li>@L.T("platform.tpl_create_info_1", _culture)</li>
        <li>@L.T("platform.tpl_create_info_2", _culture)</li>
        <li>@L.T("platform.tpl_create_info_3", _culture)</li>
        <li>@L.T("platform.tpl_create_info_4", _culture)</li>
    </ul>
</div>
