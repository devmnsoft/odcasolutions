@inject Odca.Web.Services.IUserTenantContext TenantContext
@{
    var _culture = (string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey];
    ViewData["Title"] = L.T("unavailable.title", _culture);
    var routeTenant = ViewContext.RouteData.Values["tenantId"]?.ToString();
    var viewDataTenant = ViewData["TenantId"]?.ToString();
    var queryTenant = Context.Request.Query["tenantId"].ToString();
    var tenantStr = !string.IsNullOrWhiteSpace(routeTenant)
        ? routeTenant
        : (!string.IsNullOrWhiteSpace(viewDataTenant) ? viewDataTenant : queryTenant);

    Guid? resolvedTenantId = null;
    if (Guid.TryParse(tenantStr, out var parsed))
    {
        resolvedTenantId = parsed;
    }
    else if (User.Identity?.IsAuthenticated == true)
    {
        var active = await TenantContext.GetCurrentOrFirstActiveAsync();
        resolvedTenantId = active?.TenantId;
    }
}

<dialog id="unavailable-dialog" class="unavailable-dialog" role="alertdialog" open aria-labelledby="dialog-title" aria-describedby="dialog-desc">
    <div class="dialog-content card">
        <h2 id="dialog-title">@L.T("unavailable.title", _culture)</h2>
        <p id="dialog-desc">@L.T("unavailable.desc", _culture)</p>
        <div class="dialog-actions">
            <form method="dialog" style="display:inline;">
                <button type="submit" class="button button-quiet" id="btn-close-dialog">@L.T("unavailable.close", _culture)</button>
            </form>
            @if (resolvedTenantId.HasValue)
            {
                <a class="button button-primary" id="btn-back-to-inbox" href="/organizacoes/@resolvedTenantId.Value/caixa">@L.T("unavailable.back_inbox", _culture)</a>
            }
        </div>
    </div>
</dialog>
