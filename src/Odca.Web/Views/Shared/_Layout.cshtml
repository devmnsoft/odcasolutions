@using Microsoft.AspNetCore.Authentication
@using Odca.Web.Services
@inject Odca.Web.Services.IUserTenantContext TenantContext
@inject Odca.Web.Services.OdcaApiClient ApiClient
@{
    var authenticated = User.Identity?.IsAuthenticated == true;
    var pendingAccess = authenticated &&
        (User.FindFirst("must_change_password")?.Value == "true" ||
         User.FindFirst("requires_mfa_enrollment")?.Value == "true" ||
         User.FindFirst("requires_mfa_challenge")?.Value == "true");
    var showApplication = authenticated && !pendingAccess;
    var isPlatform = User.IsInRole("SuperAdministrator");
    var organizationName = ViewData["OrganizationName"] as string;
    var displayName = User.Identity?.Name;
    var avatarText = string.IsNullOrWhiteSpace(displayName) ? "?" : displayName.Trim()[0].ToString().ToUpperInvariant();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var activeTenantId = ViewContext.RouteData.Values["tenantId"]?.ToString();
    var activeContractId = ViewContext.RouteData.Values["contractId"]?.ToString();

    Guid? parsedTenantId = Guid.TryParse(activeTenantId, out var parsedGuid) ? parsedGuid : null;
    Odca.Web.Services.UserTenantAccess? activeAccess = null;
    if (authenticated)
    {
        activeAccess = await TenantContext.GetCurrentOrFirstActiveAsync(parsedTenantId);
    }
    var hasActiveMembership = activeAccess?.IsActiveMembership == true;
    var tenantIdForLinks = activeAccess?.TenantId.ToString() ?? activeTenantId;
    if (organizationName is null && activeAccess is not null)
    {
        organizationName = activeAccess.OrganizationName;
    }

    var canReadObligations = activeAccess?.HasAnyPermission("tenant.obligations.read", "tenant.obligations.read_all") == true || isPlatform;
    var canReadRenewals = activeAccess?.HasPermission("tenant.renewals.read") == true || isPlatform;
    var canReadStudio = activeAccess?.HasAnyPermission("tenant.templates.read", "tenant.templates.manage", "tenant.contract_drafts.read", "tenant.contract_drafts.manage") == true || isPlatform;
    var canManageTemplates = activeAccess?.HasPermission("tenant.templates.manage") == true || isPlatform;
    var canReadDrafts = activeAccess?.HasAnyPermission("tenant.contract_drafts.read", "tenant.contract_drafts.manage") == true || isPlatform;
    var canCreateDocument = activeAccess?.HasAnyPermission("tenant.contract_drafts.manage", "tenant.documents.manage") == true || isPlatform;
    var canReadPatients = activeAccess?.HasAnyPermission("tenant.patients.read", "tenant.patients.manage") == true || isPlatform;
    var canReadImports = activeAccess?.HasPermission("tenant.imports.read") == true || isPlatform;
    var canReadReviews = activeAccess?.HasPermission("tenant.reviews.read") == true || isPlatform;
    var canReadOrganization = activeAccess?.HasAnyPermission("tenant.organization.read", "tenant.organization.manage") == true || isPlatform;
    var canAccessWorkspace = canReadObligations || canReadRenewals || canReadReviews;
    var canReadDocuments = canReadStudio || activeAccess?.HasAnyPermission("tenant.documents.download", "tenant.documents.manage", "tenant.patients.documents.read") == true || isPlatform;
    var featureStates = new Dictionary<string, string>(StringComparer.Ordinal);
    string? featureLoadError = null;
    string? featureErrorCode = null;
    string? organizationStatus = null;
    ApiCallStatus featureCallStatus = ApiCallStatus.Success;
    var organizationSuspended = false;
    if (showApplication && Guid.TryParse(tenantIdForLinks, out var featureTenantId))
    {
        var accessToken = await Context.GetTokenAsync("access_token");
        if (!string.IsNullOrWhiteSpace(accessToken))
        {
            var featureCatalog = await ApiClient.GetOrganizationFeaturesAsync(accessToken, featureTenantId, Context.RequestAborted);
            featureCallStatus = featureCatalog.Status;
            featureErrorCode = featureCatalog.ErrorCode;
            if (!featureCatalog.Succeeded || featureCatalog.Value is null || featureCatalog.Value.Features.Count == 0)
            {
                featureLoadError = featureCatalog.UserMessage("Não foi possível consultar as funcionalidades da organização.");
            }
            else
            {
                organizationStatus = featureCatalog.Value.TenantStatus;
                organizationSuspended = organizationStatus == "suspended";
                foreach (var feature in featureCatalog.Value.Features)
                {
                    featureStates[feature.FeatureCode] = feature.State;
                }
            }
        }
        else
        {
            featureLoadError = "A sessão local não possui credencial para consultar a organização.";
            featureCallStatus = ApiCallStatus.Unauthorized;
        }
    }
    var situationUnconfirmed = featureLoadError is not null || (showApplication && !string.IsNullOrWhiteSpace(tenantIdForLinks) && organizationStatus is null);
    string ContextLabel()
    {
        if (isPlatform && string.IsNullOrWhiteSpace(activeTenantId)) return "PLATAFORMA";
        if (organizationSuspended || featureErrorCode == "organization_suspended") return "ORGANIZAÇÃO SUSPENSA";
        if (string.IsNullOrWhiteSpace(activeTenantId)) return "SEM ORGANIZAÇÃO";
        if (featureCallStatus is ApiCallStatus.Unavailable or ApiCallStatus.Timeout) return "SITUAÇÃO NÃO CONFIRMADA";
        if (featureCallStatus == ApiCallStatus.Unauthorized) return "SESSÃO NÃO ACEITA";
        if (featureCallStatus == ApiCallStatus.Forbidden) return "ACESSO NÃO CONFIRMADO";
        if (situationUnconfirmed) return "SITUAÇÃO NÃO CONFIRMADA";
        if (organizationStatus == "active") return "ORGANIZAÇÃO ATIVA";
        return "ORGANIZAÇÃO";
    }
    string MenuFeature(string code, string label)
    {
        if (situationUnconfirmed)
            return $"{label} (situação não confirmada)";
        if (!featureStates.TryGetValue(code, out var state) || state == "allowed")
            return label;
        if (state == "plan_restricted") return $"{label} (fora do plano)";
        if (state == "administratively_blocked") return $"{label} (bloqueada)";
        return label;
    }
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — ODCA Solutions</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(showApplication ? "application" : "public")">
    @if (showApplication)
    {
        <a class="skip-link" href="#main-content">Pular para o conteúdo</a>
        <div class="app-shell" data-app-shell>
            <div class="drawer-scrim" data-drawer-close></div>
            <aside class="sidebar" id="application-navigation" aria-label="Navegação principal">
                <div class="sidebar-brand">
                    <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark" aria-hidden="true">O</span><span class="brand-name">ODCA Solutions</span></a>
                    <button class="icon-button sidebar-collapse" type="button" data-sidebar-collapse aria-label="Recolher menu" aria-expanded="true"><span aria-hidden="true">‹</span></button>
                </div>
                <div class="context-card">
                    <span class="context-label">@ContextLabel()</span>
                    <strong>@(isPlatform && string.IsNullOrWhiteSpace(activeTenantId) ? "Administração ODCA" : organizationName ?? "Escolha uma organização")</strong>
                </div>
                <nav class="side-nav">
                    @if (isPlatform)
                    {
                        <a class="nav-item @(controller == "Home" ? "active" : null)" aria-label="Visão global" aria-current="@(controller == "Home" ? "page" : null)" asp-controller="Home" asp-action="Index"><span aria-hidden="true">⌂</span><span>Visão global</span></a>
                        <a class="nav-item @(controller == "Customers" ? "active" : null)" asp-controller="Customers" asp-action="Index"><span aria-hidden="true">▣</span><span>Clientes</span></a>
                        <a class="nav-item @(controller == "Organizations" && string.IsNullOrWhiteSpace(activeTenantId) ? "active" : null)" asp-controller="Organizations" asp-action="Index"><span aria-hidden="true">◎</span><span>Organizações</span></a>
                        <a class="nav-item @(controller == "Plans" ? "active" : null)" aria-label="Catálogo de planos" aria-current="@(controller == "Plans" ? "page" : null)" asp-controller="Plans" asp-action="Index"><span aria-hidden="true">▦</span><span>Catálogo de planos</span></a>
                        <a class="nav-item @(controller == "PlatformAudit" ? "active" : null)" aria-label="Auditoria da plataforma" aria-current="@(controller == "PlatformAudit" ? "page" : null)" asp-controller="PlatformAudit" asp-action="Index"><span aria-hidden="true">☰</span><span>Auditoria</span></a>
                        @if (!string.IsNullOrWhiteSpace(tenantIdForLinks) && (hasActiveMembership || isPlatform))
                        {
                            @if (canAccessWorkspace)
                            {
                                <a class="nav-item @(controller == "Inbox" ? "active" : null)" aria-label="Caixa operacional" aria-current="@(controller == "Inbox" ? "page" : null)" asp-controller="Inbox" asp-action="Index" asp-route-tenantId="@tenantIdForLinks"><span aria-hidden="true">◫</span><span>Caixa</span></a>
                                <a class="nav-item @(controller == "Agenda" ? "active" : null)" aria-label="Agenda mensal" aria-current="@(controller == "Agenda" ? "page" : null)" asp-controller="Agenda" asp-action="Index" asp-route-tenantId="@tenantIdForLinks"><span aria-hidden="true">▦</span><span>Agenda</span></a>
                            }
                            @if (canReadObligations)
                            {
                                <a class="nav-item @(controller == "Obligations" ? "active" : null)" aria-label="Central de obrigações" aria-current="@(controller == "Obligations" ? "page" : null)" asp-controller="Obligations" asp-action="Index" asp-route-tenantId="@tenantIdForLinks"><span aria-hidden="true">✓</span><span>Obrigações</span></a>
                            }
                            @if (canReadRenewals)
                            {
                                <a class="nav-item @(controller == "Renewals" ? "active" : null)" aria-label="Central de renovações e aditivos" aria-current="@(controller == "Renewals" ? "page" : null)" asp-controller="Renewals" asp-action="Index" asp-route-tenantId="@tenantIdForLinks"><span aria-hidden="true">↻</span><span>Renovações e aditivos</span></a>
                            }
                            @if (canReadDocuments)
                            {
                                <a class="nav-item @(controller == "Documents" && ViewContext.RouteData.Values["action"]?.ToString() != "NewDocument" && Context.Request.Query["stage"] != "draft" ? "active" : null)" aria-label="Acervo de documentos" asp-controller="Documents" asp-action="Index" asp-route-tenantId="@tenantIdForLinks"><span aria-hidden="true">🗂</span><span>@MenuFeature("documents", "Acervo")</span></a>
                            }
                            @if (canReadStudio)
                            {
                                <a class="nav-item @(controller == "Studio" ? "active" : null)" aria-label="Modelos de documento" aria-current="@(controller == "Studio" ? "page" : null)" asp-controller="Studio" asp-action="Index" asp-route-tenantId="@tenantIdForLinks"><span aria-hidden="true">▤</span><span>@MenuFeature("templates", "Modelos")</span></a>
                                <a class="nav-item @(controller == "Documents" && Context.Request.Query["stage"] == "draft" ? "active" : null)" aria-label="Minhas minutas" asp-controller="Documents" asp-action="Index" asp-route-tenantId="@tenantIdForLinks" asp-route-stage="draft"><span aria-hidden="true">✎</span><span>@MenuFeature("contract_drafts", "Minhas minutas")</span></a>
                                @if (canCreateDocument)
                                {
                                    <a class="nav-item @(controller == "Documents" && ViewContext.RouteData.Values["action"]?.ToString() == "NewDocument" ? "active" : null)" aria-label="Criar documento" asp-controller="Documents" asp-action="NewDocument" asp-route-tenantId="@tenantIdForLinks"><span aria-hidden="true">+</span><span>@MenuFeature("contract_drafts", "Criar documento")</span></a>
                                }
                            }
                            @if (canReadPatients)
                            {
                                <a class="nav-item @(controller == "Patients" ? "active" : null)" asp-controller="Patients" asp-action="Index" asp-route-tenantId="@tenantIdForLinks"><span aria-hidden="true">♙</span><span>@MenuFeature("patients", "Pacientes")</span></a>
                            }
                            @if (canReadReviews)
                            {
                                <a class="nav-item @(controller == "Reviews" ? "active" : null)" asp-controller="Reviews" asp-action="Index" asp-route-tenantId="@tenantIdForLinks"><span aria-hidden="true">☵</span><span>@MenuFeature("reviews", "Solicitações")</span></a>
                            }
                            @if (canReadImports)
                            {
                                <a class="nav-item @(controller == "Imports" ? "active" : null)" aria-label="Central de importações" aria-current="@(controller == "Imports" ? "page" : null)" asp-controller="Imports" asp-action="Index" asp-route-tenantId="@tenantIdForLinks"><span aria-hidden="true">⇧</span><span>@MenuFeature("imports", "Importações")</span></a>
                            }
                            @if (!string.IsNullOrWhiteSpace(activeContractId))
                            {
                                <a class="nav-item @(controller == "Contracts" ? "active" : null)" aria-label="Ficha do contrato" aria-current="@(controller == "Contracts" ? "page" : null)" asp-controller="Contracts" asp-action="Sheet" asp-route-tenantId="@tenantIdForLinks" asp-route-contractId="@activeContractId"><span aria-hidden="true">📄</span><span>Ficha</span></a>
                            }
                            @if (canReadOrganization)
                            {
                                <a class="nav-item @(controller == "Organizations" && ViewContext.RouteData.Values["action"]?.ToString() == "Team" ? "active" : null)" aria-label="Equipe e perfis" asp-controller="Organizations" asp-action="Team" asp-route-tenantId="@tenantIdForLinks"><span aria-hidden="true">◎</span><span>Equipe e perfis</span></a>
                                <a class="nav-item @(controller == "Organizations" && ViewContext.RouteData.Values["action"]?.ToString() == "Edit" ? "active" : null)" aria-label="Configurações da organização" asp-controller="Organizations" asp-action="Edit" asp-route-tenantId="@tenantIdForLinks"><span aria-hidden="true">⚙</span><span>Configurações</span></a>
                                <a class="nav-item @(controller == "Consumption" ? "active" : null)" asp-controller="Consumption" asp-action="Index" asp-route-tenantId="@tenantIdForLinks"><span aria-hidden="true">◫</span><span>Plano e consumo</span></a>
                            }
                        }
                    }
                    else
                    {
                        <span class="menu-caption" style="margin-top: .5rem; text-transform: uppercase;">Início</span>
                        <a class="nav-item @(controller == "Onboarding" && ViewContext.RouteData.Values["action"]?.ToString() == "CustomerHome" ? "active" : null)" aria-label="Visão geral" aria-current="@(controller == "Onboarding" ? "page" : null)" asp-controller="Onboarding" asp-action="CustomerHome"><span aria-hidden="true">⌂</span><span>Visão geral</span></a>
                        @if (!string.IsNullOrWhiteSpace(tenantIdForLinks) && hasActiveMembership)
                        {
                            <a class="nav-item @(controller == "Onboarding" && ViewContext.RouteData.Values["action"]?.ToString() == "GettingStarted" ? "active" : null)" asp-controller="Onboarding" asp-action="GettingStarted" asp-route-tenantId="@tenantIdForLinks"><span aria-hidden="true">→</span><span>Primeiros passos</span></a>
                            @if (canReadPatients)
                            {
                                <span class="menu-caption" style="margin-top: .75rem; text-transform: uppercase;">Pacientes</span>
                                <a class="nav-item @(controller == "Patients" ? "active" : null)" asp-controller="Patients" asp-action="Index" asp-route-tenantId="@tenantIdForLinks"><span aria-hidden="true">♙</span><span>@MenuFeature("patients", "Pacientes")</span></a>
                            }
                            @if (canReadDocuments || canReadStudio || canReadImports || !string.IsNullOrWhiteSpace(activeContractId))
                            {
                                <span class="menu-caption" style="margin-top: .75rem; text-transform: uppercase;">Documentos</span>
                                @if (canReadDocuments)
                                {
                                    <a class="nav-item @(controller == "Documents" && ViewContext.RouteData.Values["action"]?.ToString() != "NewDocument" && Context.Request.Query["stage"] != "draft" ? "active" : null)" aria-label="Central de documentos" asp-controller="Documents" asp-action="Index" asp-route-tenantId="@tenantIdForLinks"><span aria-hidden="true">🗂</span><span>@MenuFeature("documents", "Acervo de documentos")</span></a>
                                }
                                @if (canReadStudio)
                                {
                                    <span class="menu-caption" style="margin-top: .5rem; font-size: 0.75rem; text-transform: uppercase;">Estúdio de documentos</span>
                                    <a class="nav-item @(controller == "Studio" ? "active" : null)" aria-label="Modelos de documento" aria-current="@(controller == "Studio" ? "page" : null)" asp-controller="Studio" asp-action="Index" asp-route-tenantId="@tenantIdForLinks"><span aria-hidden="true">▤</span><span>@MenuFeature("templates", "Modelos")</span></a>
                                    <a class="nav-item @(controller == "Documents" && Context.Request.Query["stage"] == "draft" ? "active" : null)" aria-label="Minhas minutas" asp-controller="Documents" asp-action="Index" asp-route-tenantId="@tenantIdForLinks" asp-route-stage="draft"><span aria-hidden="true">✎</span><span>@MenuFeature("contract_drafts", "Minhas minutas")</span></a>
                                    @if (canCreateDocument)
                                    {
                                        <a class="nav-item @(controller == "Documents" && ViewContext.RouteData.Values["action"]?.ToString() == "NewDocument" ? "active" : null)" aria-label="Criar documento" asp-controller="Documents" asp-action="NewDocument" asp-route-tenantId="@tenantIdForLinks"><span aria-hidden="true">+</span><span>@MenuFeature("contract_drafts", "Criar documento")</span></a>
                                    }
                                }
                                @if (canReadImports)
                                {
                                    <a class="nav-item @(controller == "Imports" ? "active" : null)" aria-label="Central de importações" aria-current="@(controller == "Imports" ? "page" : null)" asp-controller="Imports" asp-action="Index" asp-route-tenantId="@tenantIdForLinks"><span aria-hidden="true">⇧</span><span>@MenuFeature("imports", "Importações")</span></a>
                                }
                                @if (!string.IsNullOrWhiteSpace(activeContractId))
                                {
                                    <a class="nav-item @(controller == "Contracts" ? "active" : null)" aria-label="Ficha do contrato" aria-current="@(controller == "Contracts" ? "page" : null)" asp-controller="Contracts" asp-action="Sheet" asp-route-tenantId="@tenantIdForLinks" asp-route-contractId="@activeContractId"><span aria-hidden="true">📄</span><span>Ficha</span></a>
                                }
                            }
                            @if (canAccessWorkspace || canReadReviews || canReadObligations || canReadRenewals)
                            {
                                <span class="menu-caption" style="margin-top: .75rem; text-transform: uppercase;">Operações e Revisões</span>
                                @if (canReadReviews)
                                {
                                    <a class="nav-item @(controller == "Reviews" ? "active" : null)" asp-controller="Reviews" asp-action="Index" asp-route-tenantId="@tenantIdForLinks"><span aria-hidden="true">☵</span><span>@MenuFeature("reviews", "Solicitações")</span></a>
                                }
                                @if (canAccessWorkspace)
                                {
                                    <a class="nav-item @(controller == "Inbox" ? "active" : null)" aria-label="Caixa operacional" aria-current="@(controller == "Inbox" ? "page" : null)" asp-controller="Inbox" asp-action="Index" asp-route-tenantId="@tenantIdForLinks"><span aria-hidden="true">◫</span><span>Caixa</span></a>
                                    <a class="nav-item @(controller == "Agenda" ? "active" : null)" aria-label="Agenda mensal" aria-current="@(controller == "Agenda" ? "page" : null)" asp-controller="Agenda" asp-action="Index" asp-route-tenantId="@tenantIdForLinks"><span aria-hidden="true">▦</span><span>Agenda</span></a>
                                }
                                @if (canReadObligations)
                                {
                                    <a class="nav-item @(controller == "Obligations" ? "active" : null)" aria-label="Central de obrigações" aria-current="@(controller == "Obligations" ? "page" : null)" asp-controller="Obligations" asp-action="Index" asp-route-tenantId="@tenantIdForLinks"><span aria-hidden="true">✓</span><span>Obrigações</span></a>
                                    <a class="nav-item" asp-controller="Obligations" asp-action="Index" asp-route-tenantId="@tenantIdForLinks" asp-fragment="saved-views"><span aria-hidden="true">☆</span><span>Filtros salvos</span></a>
                                }
                                @if (canReadRenewals)
                                {
                                    <a class="nav-item @(controller == "Renewals" ? "active" : null)" aria-label="Central de renovações e aditivos" aria-current="@(controller == "Renewals" ? "page" : null)" asp-controller="Renewals" asp-action="Index" asp-route-tenantId="@tenantIdForLinks"><span aria-hidden="true">↻</span><span>Renovações e aditivos</span></a>
                                }
                            }
                            @if (canReadOrganization)
                            {
                                <span class="menu-caption" style="margin-top: .75rem; text-transform: uppercase;">Organização</span>
                                <a class="nav-item @(controller == "Organizations" && ViewContext.RouteData.Values["action"]?.ToString() == "Team" ? "active" : null)" aria-label="Equipe e perfis" asp-controller="Organizations" asp-action="Team" asp-route-tenantId="@tenantIdForLinks"><span aria-hidden="true">◎</span><span>Equipe e perfis</span></a>
                                <a class="nav-item @(controller == "Organizations" && ViewContext.RouteData.Values["action"]?.ToString() == "Edit" ? "active" : null)" aria-label="Configurações da organização" asp-controller="Organizations" asp-action="Edit" asp-route-tenantId="@tenantIdForLinks"><span aria-hidden="true">⚙</span><span>Configurações</span></a>
                                <a class="nav-item @(controller == "Consumption" ? "active" : null)" asp-controller="Consumption" asp-action="Index" asp-route-tenantId="@tenantIdForLinks"><span aria-hidden="true">◫</span><span>Plano e consumo</span></a>
                            }
                        }
                        <span class="menu-caption" style="margin-top: .75rem; text-transform: uppercase;">Suporte</span>
                        <a class="nav-item" asp-controller="Modules" asp-action="Index" asp-route-module="ajuda"><span aria-hidden="true">?</span><span>Ajuda e como usar</span></a>
                    }
                    <a class="nav-item" aria-label="Privacidade" asp-controller="Privacy" asp-action="Index"><span aria-hidden="true">◇</span><span>Privacidade</span></a>
                </nav>
                <div class="sidebar-footer"><span class="status-dot" aria-hidden="true"></span><span>Sessão autenticada</span></div>
            </aside>
            <div class="app-content">
                <header class="app-topbar">
                    <button class="icon-button mobile-menu" type="button" data-drawer-open aria-controls="application-navigation" aria-expanded="false"><span aria-hidden="true">☰</span><span class="sr-only">Abrir menu</span></button>
                    <div class="topbar-context"><span>@(isPlatform ? "Plataforma" : "Organização")</span><strong>@ViewData["Title"]</strong></div>
                    <details class="user-menu">
                        <summary><span class="avatar" aria-hidden="true">@avatarText</span><span class="user-name">@(string.IsNullOrWhiteSpace(displayName) ? "Usuário" : displayName)</span></summary>
                        <div class="user-menu-panel">
                            <span class="menu-caption">Conta autenticada</span>
                            <form asp-controller="Account" asp-action="Logout" method="post">@Html.AntiForgeryToken()<button class="menu-action" type="submit">Sair com segurança</button></form>
                        </div>
                    </details>
                </header>
                <main class="page-shell" id="main-content" tabindex="-1">
                    @if (organizationSuspended || featureErrorCode == "organization_suspended")
                    {
                        <div class="alert alert-error" role="status">Esta organização está suspensa. Cadastros e documentos permanecem armazenados. As operações desta organização ficam indisponíveis até o superadministrador restaurar o acesso. Outra organização ativa do mesmo usuário não é afetada. Isto não é falha de comunicação, bloqueio de módulo nem restrição de plano.</div>
                    }
                    else if (featureCallStatus is ApiCallStatus.Unavailable or ApiCallStatus.Timeout)
                    {
                        <div class="alert alert-error" role="alert"><strong>Falha de comunicação.</strong> Não foi possível consultar a situação da organização. Ela não foi confirmada como ativa e nenhum bloqueio foi descartado.</div>
                    }
                    else if (featureCallStatus == ApiCallStatus.Unauthorized)
                    {
                        <div class="alert alert-error" role="alert"><strong>Sessão não aceita.</strong> A consulta não identificou uma sessão operacional válida. Isso pode ocorrer com usuário bloqueado ou sessão encerrada. Não é falha de comunicação e não confirma a organização como ativa.</div>
                    }
                    else if (featureCallStatus == ApiCallStatus.Forbidden)
                    {
                        <div class="alert alert-error" role="alert"><strong>Acesso não confirmado.</strong> O vínculo com esta organização pode estar bloqueado ou a permissão é insuficiente. Outra organização do mesmo usuário permanece independente. Liberar um módulo não remove suspensão nem restrição de plano.</div>
                    }
                    else if (!string.IsNullOrWhiteSpace(featureLoadError))
                    {
                        <div class="alert alert-error" role="alert"><strong>Situação não confirmada.</strong> @featureLoadError A organização não foi marcada como ativa.</div>
                    }
                    else if (featureStates.Values.Any(state => state == "administratively_blocked"))
                    {
                        <div class="alert" role="status">Há módulo bloqueado pela administração. Os dados permanecem. Liberar o módulo não remove suspensão nem restrição de plano.</div>
                    }
                    else if (featureStates.Values.Any(state => state == "plan_restricted"))
                    {
                        <div class="alert" role="status">Há funcionalidade fora do plano atual. Isso é diferente de bloqueio administrativo e de falta de permissão.</div>
                    }
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        <header class="public-topbar">
            <a class="brand" asp-controller="Home" asp-action="Index" aria-label="ODCA Solutions — início"><span class="brand-mark" aria-hidden="true">O</span><span>ODCA Solutions</span></a>
            @if (!authenticated)
            {
                <nav class="public-actions" aria-label="Navegação pública"><a asp-controller="Catalog" asp-action="Plans">Planos</a><a asp-controller="Privacy" asp-action="Index">Privacidade</a></nav>
            }
            else
            {
                <form asp-controller="Account" asp-action="Logout" method="post">@Html.AntiForgeryToken()<button class="button button-quiet" type="submit">Sair</button></form>
            }
        </header>
        <main class="page-shell" id="main-content">@RenderBody()</main>
    }
    <partial name="_Toasts" />
    <partial name="_ConfirmDialog" />
    <script src="~/js/navigation.js" asp-append-version="true"></script>
    <script src="~/js/forms.js" asp-append-version="true"></script>
    <script src="~/js/dialogs.js" asp-append-version="true"></script>
    <script src="~/js/team.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
