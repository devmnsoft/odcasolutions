@using Microsoft.AspNetCore.Authentication
@using Odca.Web.Navigation
@using Odca.Web.Services
@inject Odca.Web.Services.IUserTenantContext TenantContext
@inject Odca.Web.Services.OdcaApiClient ApiClient
@{
    var authenticated = User.Identity?.IsAuthenticated == true;
    var pendingAccess = authenticated &&
        (User.FindFirst("must_change_password")?.Value == "true" ||
         User.FindFirst("requires_mfa_enrollment")?.Value == "true" ||
         User.FindFirst("requires_mfa_challenge")?.Value == "true");
    var showApplication = authenticated && !pendingAccess;
    var isPlatform = User.IsInRole("SuperAdministrator");
    var organizationName = ViewData["OrganizationName"] as string;
    var displayName = User.Identity?.Name;
    var avatarText = string.IsNullOrWhiteSpace(displayName) ? "?" : displayName.Trim()[0].ToString().ToUpperInvariant();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var activeTenantId = ViewContext.RouteData.Values["tenantId"]?.ToString();
    var activeContractId = ViewContext.RouteData.Values["contractId"]?.ToString();

    Guid? parsedTenantId = Guid.TryParse(activeTenantId, out var parsedGuid) ? parsedGuid : null;
    Odca.Web.Services.UserTenantAccess? activeAccess = null;
    if (authenticated)
    {
        activeAccess = await TenantContext.GetCurrentOrFirstActiveAsync(parsedTenantId);
    }
    var hasActiveMembership = activeAccess?.IsActiveMembership == true;
    var tenantIdForLinks = activeAccess?.TenantId.ToString() ?? activeTenantId;
    if (organizationName is null && activeAccess is not null)
    {
        organizationName = activeAccess.OrganizationName;
    }

    var canReadObligations = activeAccess?.HasAnyPermission("tenant.obligations.read", "tenant.obligations.read_all") == true || isPlatform;
    var canReadRenewals = activeAccess?.HasPermission("tenant.renewals.read") == true || isPlatform;
    var canReadStudio = activeAccess?.HasAnyPermission("tenant.templates.read", "tenant.templates.manage", "tenant.contract_drafts.read", "tenant.contract_drafts.manage") == true || isPlatform;
    var canManageTemplates = activeAccess?.HasPermission("tenant.templates.manage") == true || isPlatform;
    var canReadDrafts = activeAccess?.HasAnyPermission("tenant.contract_drafts.read", "tenant.contract_drafts.manage") == true || isPlatform;
    var canCreateDocument = activeAccess?.HasAnyPermission("tenant.contract_drafts.manage", "tenant.documents.manage") == true || isPlatform;
    var canReadPatients = activeAccess?.HasAnyPermission("tenant.patients.read", "tenant.patients.manage") == true || isPlatform;
    var canReadImports = activeAccess?.HasPermission("tenant.imports.read") == true || isPlatform;
    var canReadReviews = activeAccess?.HasPermission("tenant.reviews.read") == true || isPlatform;
    var canReadSolicitations = activeAccess?.HasPermission("tenant.solicitations.read") == true || isPlatform;
    var canReadContracts = activeAccess?.HasAnyPermission("tenant.contracts.read", "tenant.contract_drafts.read") == true || isPlatform;
    var canManageContracts = activeAccess?.HasPermission("tenant.contracts.manage") == true || isPlatform;
    var canReadOrganization = activeAccess?.HasAnyPermission("tenant.organization.read", "tenant.organization.manage") == true || isPlatform;
    var canAccessWorkspace = canReadObligations || canReadRenewals || canReadReviews;
    var canReadDocuments = canReadStudio || activeAccess?.HasAnyPermission("tenant.documents.download", "tenant.documents.manage", "tenant.patients.documents.read") == true || isPlatform;
    var featureStates = new Dictionary<string, string>(StringComparer.Ordinal);
    string? featureLoadError = null;
    string? featureErrorCode = null;
    string? organizationStatus = null;
    ApiCallStatus featureCallStatus = ApiCallStatus.Success;
    var organizationSuspended = false;
    if (showApplication && Guid.TryParse(tenantIdForLinks, out var featureTenantId))
    {
        var accessToken = await Context.GetTokenAsync("access_token");
        if (!string.IsNullOrWhiteSpace(accessToken))
        {
            var featureCatalog = await ApiClient.GetOrganizationFeaturesAsync(accessToken, featureTenantId, Context.RequestAborted);
            featureCallStatus = featureCatalog.Status;
            featureErrorCode = featureCatalog.ErrorCode;
            if (!featureCatalog.Succeeded || featureCatalog.Value is null || featureCatalog.Value.Features.Count == 0)
            {
                featureLoadError = featureCatalog.UserMessage(L.T("layout.features_load_fail", (string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey]));
            }
            else
            {
                organizationStatus = featureCatalog.Value.TenantStatus;
                organizationSuspended = organizationStatus == "suspended";
                foreach (var feature in featureCatalog.Value.Features)
                {
                    featureStates[feature.FeatureCode] = feature.State;
                }
            }
        }
        else
        {
            featureLoadError = L.T("layout.session_no_credential", (string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey]);
            featureCallStatus = ApiCallStatus.Unauthorized;
        }
    }
    var situationUnconfirmed = featureLoadError is not null || (showApplication && !string.IsNullOrWhiteSpace(tenantIdForLinks) && organizationStatus is null);
    var reviewsPlanRestricted = featureStates.TryGetValue("reviews", out var reviewsFeatureState) && reviewsFeatureState == "plan_restricted";
    var navContext = new Odca.Web.Navigation.NavContext
    {
        Controller = controller,
        Action = ViewContext.RouteData.Values["action"]?.ToString(),
        Query = Context.Request.Query.ToDictionary(kv => kv.Key, kv => kv.ToString()),
        ActiveTenantId = activeTenantId,
        TenantId = tenantIdForLinks,
        ContractId = activeContractId,
        IsPlatform = isPlatform,
        HasActiveMembership = hasActiveMembership,
        CanReadObligations = canReadObligations,
        CanReadRenewals = canReadRenewals,
        CanReadStudio = canReadStudio,
        CanReadDrafts = canReadDrafts,
        CanCreateDocument = canCreateDocument,
        CanReadPatients = canReadPatients,
        CanReadReviews = canReadReviews,
        CanReadSolicitations = canReadSolicitations,
        CanReadContracts = canReadContracts,
        CanReadOrganization = canReadOrganization,
        CanAccessWorkspace = canAccessWorkspace,
        CanReadDocuments = canReadDocuments,
        SituationUnconfirmed = situationUnconfirmed,
        ReviewsPlanRestricted = reviewsPlanRestricted,
        Localizer = key => L.T(key, (string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey])
    };
    string ContextLabel()
    {
        var culture = (string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey];
        if (isPlatform && string.IsNullOrWhiteSpace(activeTenantId)) return L.T("layout.platform", culture).ToUpper();
        if (organizationSuspended || featureErrorCode == "organization_suspended") return L.T("layout.org_suspended", culture);
        if (string.IsNullOrWhiteSpace(activeTenantId)) return L.T("layout.no_org", culture);
        if (featureCallStatus is ApiCallStatus.Unavailable or ApiCallStatus.Timeout) return L.T("layout.not_confirmed", culture);
        if (featureCallStatus == ApiCallStatus.Unauthorized) return L.T("layout.session_not_accepted", culture);
        if (featureCallStatus == ApiCallStatus.Forbidden) return L.T("layout.access_not_confirmed", culture);
        if (situationUnconfirmed) return L.T("layout.not_confirmed", culture);
        if (organizationStatus == "active") return L.T("layout.org_active", culture);
        return L.T("layout.org", culture);
    }
    var _culture = (string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey];
    string MenuFeature(string code, string label)
    {
        if (situationUnconfirmed)
            return $"{label} {L.T("layout.feature_unconfirmed", _culture)}";
        if (!featureStates.TryGetValue(code, out var state) || state == "allowed")
            return label;
        if (state == "plan_restricted") return $"{label} {L.T("layout.feature_off_plan", _culture)}";
        if (state == "administratively_blocked") return $"{label} {L.T("layout.feature_blocked", _culture)}";
        if (state == "quota_exhausted") return $"{label} {L.T("layout.feature_quota", _culture)}";
        return label;
    }
}
<!DOCTYPE html>
<html lang="@_culture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — ODCA Solutions</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(showApplication ? "application" : "public")">
    @if (showApplication)
    {
        <a class="skip-link" href="#main-content">@L.T("layout.skip_content", _culture)</a>
        <div class="app-shell" data-app-shell>
            <div class="drawer-scrim" data-drawer-close></div>
            <aside class="sidebar" id="application-navigation" aria-label="@L.T("layout.main_nav", _culture)">
                <div class="sidebar-brand">
                    <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark" aria-hidden="true">O</span><span class="brand-name">ODCA Solutions</span></a>
                    <button class="icon-button sidebar-collapse" type="button" data-sidebar-collapse aria-label="@L.T("layout.collapse_menu", _culture)" aria-expanded="true"><span aria-hidden="true">‹</span></button>
                </div>
                <div class="context-card">
                    <span class="context-label">@ContextLabel()</span>
                    <strong>@(isPlatform && string.IsNullOrWhiteSpace(activeTenantId) ? L.T("layout.odca_administration", _culture) : organizationName ?? L.T("layout.choose_organization", _culture))</strong>
                </div>
                <nav class="side-nav">
                    @{
                        var navItems = isPlatform ? NavigationRegistry.Platform(navContext) : NavigationRegistry.Client(navContext);
                        foreach (var navChunk in NavigationRenderer.Render(navItems, navContext, Url, MenuFeature))
                        {
                            @navChunk
                        }
                    }
                </nav>
                <div class="sidebar-footer"><span class="status-dot" aria-hidden="true"></span><span>@L.T("layout.session_active", _culture)</span></div>
            </aside>
            <div class="app-content">
                <header class="app-topbar">
                    <button class="icon-button mobile-menu" type="button" data-drawer-open aria-controls="application-navigation" aria-expanded="false"><span aria-hidden="true">☰</span><span class="sr-only">@L.T("layout.expand_menu", _culture)</span></button>
                    <div class="topbar-context"><span>@(isPlatform ? L.T("layout.platform", _culture) : L.T("layout.org", _culture))</span><strong>@ViewData["Title"]</strong></div>
                    <details class="user-menu">
                        <summary><span class="avatar" aria-hidden="true">@avatarText</span><span class="user-name">@(string.IsNullOrWhiteSpace(displayName) ? L.T("layout.user_default", _culture) : displayName)</span></summary>
                        <div class="user-menu-panel">
                            <span class="menu-caption">@L.T("layout.session_active", _culture)</span>
                            <form asp-controller="Account" asp-action="SetLanguage" method="post" class="lang-form">@Html.AntiForgeryToken()
                                <label for="lang-select" class="menu-action-label">@L.T("account.language", _culture)</label>
                                <select name="lang" id="lang-select" onchange="this.form.submit()">
                                    <option value="pt-BR" selected="@(_culture == "pt-BR")">Português (BR)</option>
                                    <option value="en-US" selected="@(_culture == "en-US")">English (US)</option>
                                    <option value="fr-FR" selected="@(_culture == "fr-FR")">Français</option>
                                    <option value="es-ES" selected="@(_culture == "es-ES")">Español</option>
                                </select>
                            </form>
                            <form asp-controller="Account" asp-action="Logout" method="post">@Html.AntiForgeryToken()<button class="menu-action" type="submit">@L.T("layout.logout", _culture)</button></form>
                        </div>
                    </details>
                </header>
                <main class="page-shell" id="main-content" tabindex="-1">
                    @if (organizationSuspended || featureErrorCode == "organization_suspended")
                    {
                        <div class="alert alert-error" role="status">@L.T("alert.suspended", _culture)</div>
                    }
                    else if (featureCallStatus is ApiCallStatus.Unavailable or ApiCallStatus.Timeout)
                    {
                        <div class="alert alert-error" role="alert"><strong>@L.T("alert.comm_failure", _culture)</strong> @L.T("alert.comm_detail", _culture)</div>
                    }
                    else if (featureCallStatus == ApiCallStatus.Unauthorized)
                    {
                        <div class="alert alert-error" role="alert"><strong>@L.T("alert.session_rejected", _culture)</strong> @L.T("alert.session_detail", _culture)</div>
                    }
                    else if (featureCallStatus == ApiCallStatus.Forbidden)
                    {
                        <div class="alert alert-error" role="alert"><strong>@L.T("alert.access_not_confirmed", _culture)</strong> @L.T("alert.access_detail", _culture)</div>
                    }
                    else if (!string.IsNullOrWhiteSpace(featureLoadError))
                    {
                        <div class="alert alert-error" role="alert"><strong>@L.T("alert.situation_unconfirmed", _culture)</strong> @featureLoadError</div>
                    }
                    else if (featureStates.Values.Any(state => state == "administratively_blocked"))
                    {
                        <div class="alert" role="status">@L.T("alert.module_blocked", _culture)</div>
                    }
                    else if (featureStates.Values.Any(state => state == "plan_restricted"))
                    {
                        <div class="alert" role="status">@L.T("alert.plan_restricted", _culture)</div>
                    }
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        <header class="public-topbar">
            <a class="brand" asp-controller="Home" asp-action="Index" aria-label="ODCA Solutions"><span class="brand-mark" aria-hidden="true">O</span><span>ODCA Solutions</span></a>
            @if (!authenticated)
            {
                <nav class="public-actions"><a asp-controller="Catalog" asp-action="Plans">Planos</a><a asp-controller="Privacy" asp-action="Index">@L.T("privacidade", _culture)</a></nav>
            }
            else
            {
                <form asp-controller="Account" asp-action="Logout" method="post">@Html.AntiForgeryToken()<button class="button button-quiet" type="submit">@L.T("account.logout", _culture)</button></form>
            }
        </header>
        <main class="page-shell" id="main-content">@RenderBody()</main>
    }
    <partial name="_Toasts" />
    <partial name="_ConfirmDialog" />
    @{
        var _navBagJson = System.Text.Json.JsonSerializer.Serialize(
            new { expand = L.T("nav.expand_menu", _culture), collapse = L.T("nav.collapse_menu", _culture) },
            new System.Text.Json.JsonSerializerOptions { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping });
    }
    <script>window.odcaNav=@Html.Raw(_navBagJson);</script>
    <script src="~/js/navigation.js" asp-append-version="true"></script>
    <script src="~/js/forms.js" asp-append-version="true"></script>
    <script src="~/js/dialogs.js" asp-append-version="true"></script>
    <script src="~/js/team.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
