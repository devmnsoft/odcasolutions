@{
    var _culture = (string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey];
    ViewData["Title"] = L.T("accessdenied.title", _culture);
}
<dialog class="unavailable-dialog" role="alertdialog" open aria-labelledby="dialog-title" aria-describedby="dialog-desc">
    <div class="dialog-content card">
        <h2 id="dialog-title">@L.T("accessdenied.title", _culture)</h2>
        <p id="dialog-desc">@L.T("accessdenied.desc", _culture)</p>
        <div class="dialog-actions">
            <form method="dialog" style="display:inline;">
                <button type="submit" class="button button-quiet">@L.T("accessdenied.close", _culture)</button>
            </form>
            <a class="button button-primary" href="/" id="btn-back-to-home">@L.T("accessdenied.home", _culture)</a>
        </div>
    </div>
</dialog>
