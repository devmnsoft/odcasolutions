@model ErrorViewModel
@{
    var _culture = (string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey];
    ViewData["Title"] = L.T("error.title", _culture);
}

<h1 class="text-danger">@L.T("error.title", _culture)</h1>
<h2 class="text-danger">@L.T("error.heading", _culture)</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>@L.T("error.request_id_label", _culture)</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>@L.T("error.development_mode", _culture)</h3>
<p>
    @L.T("error.dev_p1", _culture)
</p>
<p>
    @L.T("error.dev_p2", _culture)
</p>
