@model Odca.Web.Models.ConsumptionViewModel
@functions { static string Bytes(long value){string[] u=["B","KB","MB","GB","TB"];double n=value;var i=0;while(n>=1024&&i<u.Length-1){n/=1024;i++;}return $"{n:0.##} {u[i]}";} }
@{ViewData["Title"]="Plano e consumo";var s=Model.Summary;var total=s.ContractedStorageBytes+s.AdditionalStorageBytes;var percent=total==0?0:Math.Min(100,(int)Math.Round(100d*(s.UsedStorageBytes+s.ReservedStorageBytes)/total));var state=percent>=100?"limit":percent>=80?"near":"ok";}
<nav class="breadcrumb" aria-label="Navegação estrutural"><a asp-controller="Onboarding" asp-action="CustomerHome">Início</a><span>/</span><span>Plano e consumo</span></nav>
<header class="page-heading"><div><p class="eyebrow">Central do cliente</p><h1>Plano e consumo</h1><p>Acompanhe os limites aplicados pelo servidor e solicite capacidade sem cobrança simulada.</p></div><a class="button button-primary" href="#solicitar">Solicitar adicional</a></header>
@if(TempData["Success"] is string success){<div class="alert alert-success" role="status">✓ @success</div>}@if(TempData["Error"] is string error){<div class="alert alert-error" role="alert">! @error</div>}
<section class="metric-grid" aria-label="Resumo do plano">
<article class="metric-card"><span>Plano atual</span><strong>@s.PlanName</strong><small>Versão @s.PlanVersion · <span class="status-badge">@s.SubscriptionStatus</span></small></article>
<article class="metric-card"><span>Usuários</span><strong>@s.ActiveUsers de @s.ContractedSeats</strong><small>@s.ReservedInvitations convite(s) reservam vaga · @s.AvailableSeats disponível(is)</small></article>
<article class="metric-card"><span>Armazenamento disponível</span><strong>@Bytes(s.AvailableStorageBytes)</strong><small>Máximo por arquivo: @Bytes(s.MaximumFileBytes)</small></article>
<article class="metric-card"><span>Período vigente</span><strong>@(s.PeriodStart?.ToString("dd/MM/yyyy")??"Não definido")</strong><small>até @(s.PeriodEnd?.ToString("dd/MM/yyyy")??"vigência sem término cadastrado")</small></article>
</section>
<section class="panel consumption-panel"><div class="section-heading"><div><h2>Armazenamento</h2><p>Exclusão lógica não libera bytes enquanto o arquivo permanecer armazenado.</p></div><span class="limit-state @state">@(state=="limit"?"! Limite atingido":state=="near"?"△ Próximo do limite":"✓ Capacidade disponível")</span></div>
<div class="usage-bar" role="progressbar" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100" aria-label="Uso total de armazenamento"><span style="width:@percent%"></span></div>
<dl class="usage-breakdown"><div><dt>Limite contratado</dt><dd>@Bytes(s.ContractedStorageBytes)</dd></div><div><dt>Adicionais concedidos</dt><dd>@Bytes(s.AdditionalStorageBytes)</dd></div><div><dt>Consumo confirmado</dt><dd>@Bytes(s.UsedStorageBytes)</dd></div><div><dt>Reservas temporárias</dt><dd>@Bytes(s.ReservedStorageBytes)</dd></div><div><dt>Disponibilidade</dt><dd>@Bytes(s.AvailableStorageBytes)</dd></div></dl></section>
<section class="two-column" id="solicitar"><div class="panel"><h2>Solicitar armazenamento adicional</h2>@if(Model.Packages.Count==0){<div class="empty-state"><strong>Nenhum pacote publicado</strong><p>As propostas comerciais estão em rascunho. Fale com a equipe ODCA; nenhum preço ou pagamento será inventado.</p></div>}else{<form asp-action="Request" method="post" class="form-stack"><input type="hidden" name="idempotencyKey" value="@Guid.NewGuid()"/><label>Pacote<select name="packageId" required>@foreach(var p in Model.Packages){<option value="@p.Id">@p.Name — @Bytes(p.QuantityBytes) @(p.UnitPrice.HasValue?$"· {p.Currency} {p.UnitPrice:0.00}":"· condição sob consulta")</option>}</select></label><label>Quantidade<input type="number" name="quantity" min="1" max="100" value="1" required/></label><div class="confirmation-box"><strong>Antes de confirmar</strong><p>O pedido preserva quantidade, condições e preço do pacote escolhido. Não aumenta o limite antes da aprovação manual.</p></div><button class="button button-primary">Revisar e solicitar</button></form>}</div>
<div class="panel"><h2>Créditos consumíveis</h2>@if(s.ConsumableCredits.Count==0){<p class="muted">Nenhum crédito consumível configurado.</p>}else{<dl class="usage-breakdown">@foreach(var c in s.ConsumableCredits){<div><dt>@c.Resource.Replace('_',' ')</dt><dd>@c.Available @c.Unit</dd></div>}</dl>}<p class="muted">Capacidade de armazenamento é um limite; não desaparece a cada upload. Créditos de assinatura e OCR são contabilizados separadamente.</p></div></section>
<section class="panel"><h2>Solicitações</h2>@if(Model.Requests.Count==0){<div class="empty-state"><strong>Nenhuma solicitação</strong><p>Novos pedidos aparecerão aqui após confirmação.</p></div>}else{<div class="responsive-table"><table><thead><tr><th>Pacote</th><th>Quantidade</th><th>Solicitada em</th><th>Situação</th><th>Decisão</th></tr></thead><tbody>@foreach(var r in Model.Requests){<tr><td data-label="Pacote">@r.PackageName v@r.PackageVersion</td><td data-label="Quantidade">@Bytes(r.TotalBytes)</td><td data-label="Solicitada em">@r.RequestedAt.ToString("dd/MM/yyyy HH:mm")</td><td data-label="Situação"><span class="status-badge status-@r.Status">@r.Status</span></td><td data-label="Decisão">@(r.DecisionReason??"—")</td></tr>}</tbody></table></div>}</section>
<section class="panel"><h2>Histórico de movimentações</h2><ol class="timeline">@foreach(var e in s.History){<li><span></span><div><strong>@e.Type.Replace('_',' ') · @e.Resource.Replace('_',' ')</strong><p>@e.Quantity @e.Unit · @e.ActorName</p><small>@e.OccurredAt.ToString("dd/MM/yyyy HH:mm") @(string.IsNullOrWhiteSpace(e.Reason)?null:$"· {e.Reason}")</small></div></li>}</ol>@if(s.History.Count==0){<p class="muted">Nenhuma movimentação registrada.</p>}</section>
<details class="help-card"><summary>Como usar</summary><ol><li>Compare contratado, adicional, consumido e reservado.</li><li>Escolha somente pacotes publicados e confira as condições.</li><li>Acompanhe a decisão; pedidos pendentes não alteram a capacidade.</li><li>Se uma consulta falhar, a tela informa indisponibilidade em vez de mostrar zero.</li></ol></details>
