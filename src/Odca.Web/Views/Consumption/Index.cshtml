@model Odca.Web.Models.ConsumptionViewModel
@functions { static string Bytes(long value){string[] u=["B","KB","MB","GB","TB"];double n=value;var i=0;while(n>=1024&&i<u.Length-1){n/=1024;i++;}return $"{n:0.##} {u[i]}";} }
@{var _c=(string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey];ViewData["Title"]=L.T("plano-consumo",_c);var s=Model.Summary;var total=s.ContractedStorageBytes+s.AdditionalStorageBytes;var percent=total==0?0:Math.Min(100,(int)Math.Round(100d*(s.UsedStorageBytes+s.ReservedStorageBytes)/total));var state=percent>=100?"limit":percent>=80?"near":"ok";}
<nav class="breadcrumb" aria-label="@L.T("common.breadcrumb_aria",_c)"><a asp-controller="Onboarding" asp-action="CustomerHome">@L.T("inicio",_c)</a><span>/</span><span aria-current="page">@L.T("plano-consumo",_c)</span></nav>
<header class="page-heading"><div><p class="eyebrow">@L.T("cons.eyebrow",_c)</p><h1>@L.T("plano-consumo",_c)</h1><p>@L.T("cons.sub",_c)</p></div><a class="button button-primary" href="#solicitar">@L.T("cons.btn_request",_c)</a></header>
@if(TempData["Success"] is string success){<div class="alert alert-success" role="status">✓ @success</div>}@if(TempData["Error"] is string error){<div class="alert alert-error" role="alert">! @error</div>}
<section class="metric-grid" aria-label="@L.T("cons.plan_summary_aria",_c)">
<article class="metric-card"><span>@L.T("cons.current_plan",_c)</span><strong>@s.PlanName</strong><small>@L.T("cons.version",_c,s.PlanVersion.ToString(System.Globalization.CultureInfo.InvariantCulture))<span class="status-badge">@StatusLabels.Status(s.SubscriptionStatus,k=>L.T(k,_c))</span></small></article>
<article class="metric-card"><span>@L.T("cust.th_users",_c)</span><strong>@s.ActiveUsers de @s.ContractedSeats</strong><small>@L.T("cons.seats_detail",_c,s.ReservedInvitations.ToString(System.Globalization.CultureInfo.InvariantCulture),s.AvailableSeats.ToString(System.Globalization.CultureInfo.InvariantCulture))</small></article>
<article class="metric-card"><span>@L.T("cons.storage_available",_c)</span><strong>@Bytes(s.AvailableStorageBytes)</strong><small>@L.T("cons.max_file",_c,Bytes(s.MaximumFileBytes))</small></article>
<article class="metric-card"><span>@L.T("cons.period",_c)</span><strong>@(s.PeriodStart is null?L.T("cons.period_undefined",_c):CulturedTime.Date(s.PeriodStart.Value,_c))</strong><small>@(s.PeriodEnd is null?L.T("cons.period_no_end",_c):L.T("cons.period_until",_c,CulturedTime.Date(s.PeriodEnd.Value,_c)))</small></article>
</section>
<section class="panel consumption-panel"><div class="section-heading"><div><h2>@L.T("cons.storage_h",_c)</h2><p>@L.T("cons.storage_p",_c)</p></div><span class="limit-state @state">@(state=="limit"?L.T("cons.state_limit",_c):state=="near"?L.T("cons.state_near",_c):L.T("cons.state_ok",_c))</span></div>
<div class="usage-bar" role="progressbar" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100" aria-label="@L.T("cons.bar_aria",_c)"><span style="width:@percent%"></span></div>
<dl class="usage-breakdown"><div><dt>@L.T("cons.bd_contracted",_c)</dt><dd>@Bytes(s.ContractedStorageBytes)</dd></div><div><dt>@L.T("cons.bd_additional",_c)</dt><dd>@Bytes(s.AdditionalStorageBytes)</dd></div><div><dt>@L.T("cons.bd_confirmed",_c)</dt><dd>@Bytes(s.UsedStorageBytes)</dd></div><div><dt>@L.T("cons.bd_reserved",_c)</dt><dd>@Bytes(s.ReservedStorageBytes)</dd></div><div><dt>@L.T("cons.bd_available",_c)</dt><dd>@Bytes(s.AvailableStorageBytes)</dd></div></dl></section>
<section class="two-column" id="solicitar"><div class="panel"><h2>@L.T("cons.req_h",_c)</h2>@if(Model.Packages.Count==0){<div class="empty-state"><strong>@L.T("cons.pkg_empty_t",_c)</strong><p>@L.T("cons.pkg_empty_b",_c)</p></div>}else{<form asp-action="CreateStorageRequest" method="post" class="form-stack" data-processing>@Html.AntiForgeryToken()<input type="hidden" name="idempotencyKey" value="@Guid.NewGuid()"/><label>@L.T("cons.step1",_c)<select name="packageId" required>@foreach(var p in Model.Packages){<option value="@p.Id">@p.Name — @Bytes(p.QuantityBytes) · @p.Currency @p.UnitPrice!.Value.ToString("0.00")</option>}</select></label><label>@L.T("cons.step2",_c)<input type="number" name="quantity" min="1" max="100" value="1" required/></label><div class="confirmation-box"><strong>@L.T("cons.step3",_c)</strong><p>@L.T("cons.step3_note",_c)</p></div><button class="button button-primary" type="submit">@L.T("cons.req_btn",_c)</button></form>}</div>
<div class="panel"><h2>@L.T("usage.credits_h",_c)</h2>@if(s.ConsumableCredits.Count==0){<p class="muted">@L.T("usage.credits_empty",_c)</p>}else{<dl class="usage-breakdown">@foreach(var c in s.ConsumableCredits){<div><dt>@(c.Resource=="ocr_pages_monthly"?L.T("usage.res_ocr",_c):L.T("usage.res_signature",_c))</dt><dd>@L.T("usage.credit_line_unit",_c,c.Contracted.ToString(System.Globalization.CultureInfo.InvariantCulture),c.Consumed.ToString(System.Globalization.CultureInfo.InvariantCulture),c.Reserved.ToString(System.Globalization.CultureInfo.InvariantCulture),c.Available.ToString(System.Globalization.CultureInfo.InvariantCulture),c.Unit=="pages"?L.T("usage.unit_pages",_c):L.T("usage.unit_envelopes",_c))</dd></div>}</dl>}<p class="muted">@L.T("usage.credits_note_client",_c)</p></div></section>
<section class="panel"><h2>@L.T("usage.requests_h",_c)</h2>@if(Model.Requests.Count==0){<div class="empty-state"><strong>@L.T("usage.requests_empty_t",_c)</strong><p>@L.T("usage.requests_empty_b",_c)</p></div>}else{<div class="responsive-table"><table><thead><tr><th>@L.T("usage.th_package",_c)</th><th>@L.T("usage.th_quantity",_c)</th><th>@L.T("usage.th_requested_at",_c)</th><th>@L.T("common.situation",_c)</th><th>@L.T("usage.th_decision",_c)</th></tr></thead><tbody>@foreach(var r in Model.Requests){<tr><td data-label="@L.T("usage.th_package",_c)">@r.PackageName v@r.PackageVersion</td><td data-label="@L.T("usage.th_quantity",_c)">@Bytes(r.TotalBytes)</td><td data-label="@L.T("usage.th_requested_at",_c)">@CulturedTime.DateTime(r.RequestedAt,_c)</td><td data-label="@L.T("common.situation",_c)"><span class="status-badge status-@r.Status">@r.Status</span></td><td data-label="@L.T("usage.th_decision",_c)">@(r.DecisionReason??"—")</td></tr>}</tbody></table></div>}</section>
<section class="panel"><h2>@L.T("cons.modules_h",_c)</h2><p>@L.T("cons.modules_p",_c)</p></section>
<section class="panel" id="historico"><h2>@L.T("cons.history_h",_c)</h2><ol class="timeline">@foreach(var e in s.History){<li><span></span><div><strong>@e.Type.Replace('_',' ') · @e.Resource.Replace('_',' ')</strong><p>@e.Quantity @e.Unit · @e.ActorName</p><small>@CulturedTime.DateTime(e.OccurredAt,_c) @(string.IsNullOrWhiteSpace(e.Reason)?null:$"· {e.Reason}")</small></div></li>}</ol>@if(s.History.Count==0){<p class="muted">@L.T("cons.history_empty",_c)</p>}</section>
<details class="help-card"><summary>@L.T("common.how_to_use",_c)</summary><ol><li>@L.T("cons.help_1",_c)</li><li>@L.T("cons.help_2",_c)</li><li>@L.T("cons.help_3",_c)</li><li>@L.T("cons.help_4",_c)</li></ol></details>
