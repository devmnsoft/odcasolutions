@model Odca.Web.Models.ModuleStatusViewModel
@{
    ViewData["Title"] = Model.Title;
}
<nav class="breadcrumb" aria-label="Navegação estrutural">
    <a asp-controller="Home" asp-action="Index">Início</a><span aria-hidden="true">/</span><span>@Model.Title</span>
</nav>
<section class="page-heading">
    <div>
        <p class="eyebrow">@(Model.IsPlatformModule ? "Administração da plataforma" : "Área da empresa")</p>
        <h1>@Model.Title</h1>
        <p>@Model.Description</p>
    </div>
    <a class="button button-primary" asp-controller="Home" asp-action="Index">Voltar ao painel</a>
</section>
<section class="panel controlled-state" role="status">
    <span class="status-badge status-pending">Em construção controlada</span>
    <h2>Esta área ainda não executa alterações</h2>
    <p>Estamos preparando este módulo sem criar integrações provisórias ou expor dados fora do seu perfil. As funcionalidades já prontas permanecem acessíveis pelo menu.</p>
</section>
<section class="panel help-card">
    <h2>Como usar agora</h2>
    <p>@Model.NextStep</p>
    <p class="muted">Se uma opção esperada não aparecer no menu, confirme seu perfil com o administrador da empresa.</p>
</section>
