@model Odca.Web.Models.ModuleStatusViewModel
@{
    var _c = (string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey];
    ViewData["Title"] = Model.Title;
}
<nav class="breadcrumb" aria-label="Navegação estrutural">
    <a asp-controller="Home" asp-action="Index">@L.T("inicio",_c)</a><span aria-hidden="true">/</span><span>@Model.Title</span>
</nav>
<section class="page-heading">
    <div>
        <p class="eyebrow">@(Model.IsPlatformModule ? L.T("module.eyebrow_platform",_c) : L.T("module.eyebrow_tenant",_c))</p>
        <h1>@Model.Title</h1>
        <p>@Model.Description</p>
    </div>
    <a class="button button-primary" asp-controller="Home" asp-action="Index">@L.T("support.back_panel",_c)</a>
</section>
<section class="panel controlled-state" role="status">
    @if (Model.OpenHref is not null)
    {
        <span class="status-badge status-approved">@L.T("module.st_available",_c)</span>
        <h2>@L.T("module.ok_h",_c)</h2>
        <p>@L.T("module.ok_p",_c)</p>
        <p><a class="button button-primary" href="@Model.OpenHref">@Model.OpenLinkText</a></p>
    }
    else
    {
        <span class="status-badge status-pending">@L.T("module.st_construction",_c)</span>
        <h2>@L.T("module.pending_h",_c)</h2>
        <p>@L.T("module.pending_p",_c)</p>
    }
</section>
<section class="panel help-card">
    <h2>@L.T("module.next_h",_c)</h2>
    <p>@Model.NextStep</p>
    <p class="muted">@L.T("module.menu_hint",_c)</p>
</section>
