@model Odca.Contracts.Studio.TemplateCatalogPage
@{ var tenantId=(Guid)ViewData["TenantId"]!; ViewData["OrganizationName"]="Organização selecionada"; }
<section class="page-heading"><div><p class="eyebrow">Biblioteca</p><h1>Modelos de contrato</h1><p class="muted">Escolha uma versão publicada. A minuta será uma cópia independente e rastreável.</p></div><details class="help"><summary>Como usar</summary><p>Pesquise, confira a origem e selecione <strong>Usar modelo</strong>. Campos obrigatórios serão revisados no estúdio.</p></details></section>
@if(TempData["StudioError"] is string error){<div class="error" role="alert">@error</div>}
@if(ViewData["LoadError"] is string loadError){<div class="error" role="alert"><strong>Não foi possível carregar o catálogo.</strong> @loadError</div>}
<form method="get" class="studio-filter"><label>Pesquisar<input name="search" value="@ViewData["Search"]" placeholder="Nome ou descrição" /></label><button class="button button-primary" type="submit">Pesquisar</button>@if(ViewData["LoadError"] is not null){<button class="button button-quiet" type="submit">Tentar novamente</button>}</form>
<div class="template-grid">
@foreach(var item in Model.Items){<article class="template-card"><div><span class="badge badge-muted">@item.ContractType</span><span class="badge">Escopo: @(item.Scope=="global"?"Global":item.Scope=="consultancy"?"Consultoria":"Particular")</span><span class="badge">Status: @item.Status</span></div><h2>@item.Name</h2><p>@item.Description</p><small>Versão @item.Version · por @item.Author</small><small>Publicado: @(item.PublishedAt?.ToString("dd/MM/yyyy HH:mm 'UTC'") ?? "Ainda não publicado")</small><form method="post" asp-action="Create" asp-route-tenantId="@tenantId"><input type="hidden" name="templateId" value="@item.Id"/><label>Título da minuta<input name="title" required maxlength="160" value="@item.Name"/></label><button class="button button-primary" type="submit">Usar modelo</button></form></article>}
</div>
@if(Model.Items.Count==0 && ViewData["LoadError"] is null){<div class="card empty-state"><h2>Nenhum modelo disponível</h2><p>Ajuste a busca ou solicite acesso a um modelo publicado.</p></div>}
@if(Model.Total>Model.PageSize){<nav class="pagination" aria-label="Paginação do catálogo">@if(Model.Page>1){<a class="button button-quiet" asp-route-tenantId="@tenantId" asp-route-search="@ViewData["Search"]" asp-route-page="@(Model.Page-1)">Anterior</a>}<span>Página @Model.Page</span>@if(Model.Page*Model.PageSize<Model.Total){<a class="button button-quiet" asp-route-tenantId="@tenantId" asp-route-search="@ViewData["Search"]" asp-route-page="@(Model.Page+1)">Próxima</a>}</nav>}
