@model Odca.Contracts.Studio.TemplateCatalogPage
@{ 
    var tenantId=(Guid)ViewData["TenantId"]!; 
    var search=ViewData["Search"] as string; 
    var type=ViewData["Type"] as string; 
    var scope=ViewData["Scope"] as string; 
    var purpose=ViewData["Purpose"] as string; 
    var patientId=ViewData["PatientId"] as Guid?; 
    var canManage=(bool)(ViewData["CanManageTemplates"] ?? false);
    var _culture=(string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey];
    var purposeLabels=new Dictionary<string,string>{
        {"service_agreement",L.T("studio.purpose_service_agreement",_culture)},
        {"care_agreement",L.T("studio.purpose_care_agreement",_culture)},
        {"consent",L.T("studio.purpose_consent",_culture)},
        {"confidentiality",L.T("studio.purpose_confidentiality",_culture)},
        {"amendment",L.T("studio.purpose_amendment",_culture)},
        {"supply",L.T("studio.purpose_supply",_culture)},
        {"lease",L.T("studio.purpose_lease",_culture)}
    };
    string PurposeLabel(string key)=>purposeLabels.TryGetValue(key,out var l)?l:key;
    ViewData["OrganizationName"]=L.T("common.org_selected",_culture); 
}
<section class="page-heading">
    <div>
        <p class="eyebrow">@L.T("studio.cat_eyebrow",_culture)</p>
        <h1>@L.T("studio.cat_title",_culture)</h1>
        <p class="muted">@L.T("studio.cat_subtitle",_culture)</p>
    </div>
    @if(canManage)
    {
        <div class="button-row" style="margin-top: 0.5rem;">
            <a class="button button-primary" asp-action="NewTemplate" asp-route-tenantId="@tenantId">@L.T("studio.cat_new_model",_culture)</a>
        </div>
    }
    <details class="help"><summary>@L.T("common.how_to_use",_culture)</summary><p>@L.T("studio.cat_help_a",_culture) <strong>@L.T("studio.cat_use_template",_culture)</strong>@L.T("studio.cat_help_b",_culture) <strong>@L.T("studio.cat_help_dup",_culture)</strong>@L.T("studio.cat_help_c",_culture)</p></details>
</section>
@if(patientId.HasValue){<div class="alert alert-success" role="status">@L.T("studio.cat_patient_bound",_culture)</div>}
@if(TempData["StudioError"] is string error){<div class="error" role="alert">@error</div>}
@if(TempData["StudioSuccess"] is string success){<div class="success" role="status">@success</div>}
@if(ViewData["LoadError"] is string loadError){<div class="error" role="alert"><strong>@L.T("studio.cat_load_error_title",_culture)</strong> @loadError</div>}
<form method="get" class="studio-filter"><input type="hidden" name="patientId" value="@patientId"/><label>@L.T("studio.cat_search_label",_culture)<input name="search" value="@search" placeholder="@L.T("studio.cat_search_placeholder",_culture)" /></label><label>@L.T("studio.cat_type_label",_culture)<select name="type"><option value="">@L.T("studio.cat_all",_culture)</option>@foreach(var item in new[]{("nda","studio.type_nda"),("services","studio.type_services"),("amendment","studio.type_amendment"),("supply","studio.type_supply"),("lease","studio.type_lease")}){<option value="@item.Item1" selected="@(type==item.Item1)">@L.T(item.Item2,_culture)</option>}</select></label><label>@L.T("studio.cat_scope_label",_culture)<select name="scope"><option value="">@L.T("studio.cat_all",_culture)</option><option value="global" selected="@(scope=="global")">@L.T("studio.scope_global",_culture)</option><option value="consultancy" selected="@(scope=="consultancy")">@L.T("studio.scope_consultancy",_culture)</option><option value="private" selected="@(scope=="private")">@L.T("studio.scope_private",_culture)</option></select></label><label>@L.T("studio.cat_purpose_label",_culture)<select name="purpose"><option value="">@L.T("studio.cat_all_purposes",_culture)</option>@foreach(var item in new[]{("service_agreement","studio.purpose_service_agreement"),("care_agreement","studio.purpose_care_agreement"),("consent","studio.purpose_consent"),("confidentiality","studio.purpose_confidentiality"),("amendment","studio.purpose_amendment"),("supply","studio.purpose_supply"),("lease","studio.purpose_lease")}){<option value="@item.Item1" selected="@(purpose==item.Item1)">@L.T(item.Item2,_culture)</option>}</select></label><button class="button button-primary" type="submit">@L.T("action.filter",_culture)</button>@if(ViewData["LoadError"] is not null){<button class="button button-quiet" type="submit">@L.T("studio.cat_retry",_culture)</button>}</form>
<p class="muted">@L.T("studio.cat_footer_a",_culture) <strong>@L.T("studio.cat_use_template",_culture)</strong> @L.T("studio.cat_footer_b",_culture) <strong>@L.T("studio.cat_duplicate",_culture)</strong> @L.T("studio.cat_footer_c",_culture)</p>
<div class="template-grid">
@foreach(var item in Model.Items){<article class="template-card"><div><span class="badge badge-muted">@item.ContractType</span>@if(!string.IsNullOrEmpty(item.DocumentPurpose)){<span class="badge badge-muted">@PurposeLabel(item.DocumentPurpose)</span>}<span class="badge">@L.T("studio.badge_scope",_culture): @(item.Scope=="global"?L.T("studio.scope_global",_culture):item.Scope=="consultancy"?L.T("studio.scope_consultancy",_culture):L.T("studio.scope_private",_culture))</span><span class="badge">@L.T("studio.badge_status",_culture): @(item.Status=="published"?L.T("studio.status_published",_culture):item.Status=="archived"?L.T("studio.status_archived",_culture):L.T("studio.status_draft",_culture))</span></div><h2>@item.Name</h2><p>@item.Description</p><small>@L.T("studio.cat_version_label",_culture) @item.Version · @L.T("studio.cat_author_by",_culture) @item.Author</small><small>@L.T("studio.cat_published_on",_culture) @(item.PublishedAt is { } publishedAt ? CulturedTime.DateTime(publishedAt,_culture)+" UTC" : L.T("studio.cat_not_published",_culture))</small>@if(item.Status=="published"){<form method="post" asp-action="Create" asp-route-tenantId="@tenantId">@Html.AntiForgeryToken()<input type="hidden" name="templateId" value="@item.Id"/><input type="hidden" name="patientId" value="@patientId"/><label>@L.T("studio.cat_draft_title_label",_culture)<input name="title" required maxlength="160" value="@item.Name"/></label><label>@L.T("studio.cat_contractor_label",_culture)<select name="contractorSource"><option value="">@L.T("studio.cat_contractor_blank",_culture)</option><option value="patient">@L.T("studio.cat_contractor_patient",_culture)</option><option value="representative">@L.T("studio.cat_contractor_representative",_culture)</option></select></label><p class="muted">@L.T("studio.cat_contractor_note",_culture)</p><button class="button button-primary" type="submit">@L.T("studio.cat_use_template",_culture)</button></form>}else{<p class="muted" style="margin-top:0.25rem;">@(item.Status=="draft"?L.T("studio.cat_draft_note",_culture):L.T("studio.cat_archived_note",_culture))</p>}<div style="display: flex; gap: 0.5rem; margin-top: 0.5rem; flex-wrap: wrap;">@if(item.Status=="published"){<form method="post" asp-action="Duplicate" asp-route-tenantId="@tenantId" asp-route-templateId="@item.Id" style="display: inline;">@Html.AntiForgeryToken()<input type="hidden" name="search" value="@search"/><input type="hidden" name="type" value="@type"/><input type="hidden" name="scope" value="@scope"/><input type="hidden" name="purpose" value="@purpose"/><button class="button button-quiet" type="submit">@L.T("studio.cat_duplicate",_culture)</button></form>}<a class="button button-quiet" asp-action="TemplatePreview" asp-route-tenantId="@tenantId" asp-route-templateId="@item.Id" style="display:inline-block">@L.T("studio.cat_view_preview",_culture)</a>}@if(canManage && (item.Status!="published" || item.Scope!="global")){<a class="button button-quiet" asp-action="EditTemplate" asp-route-tenantId="@tenantId" asp-route-templateId="@item.Id">@(item.Status=="archived"?L.T("studio.cat_view_archived",_culture):item.Status=="draft"?L.T("studio.cat_edit_draft",_culture):L.T("studio.cat_edit_model",_culture))</a>}</div></article>}
</div>
@if(Model.Items.Count==0 && ViewData["LoadError"] is null){<div class="card empty-state"><h2>@L.T("studio.cat_empty_title",_culture)</h2><p>@L.T("studio.cat_empty_body",_culture)</p></div>}
@if(Model.Total>Model.PageSize){<nav class="pagination" aria-label="@L.T("studio.cat_pagination_aria",_culture)">@if(Model.Page>1){<a class="button button-quiet" asp-route-tenantId="@tenantId" asp-route-search="@search" asp-route-type="@type" asp-route-scope="@scope" asp-route-purpose="@purpose" asp-route-patientId="@patientId" asp-route-page="@(Model.Page-1)">@L.T("inbox.prev",_culture)</a>}<span>@L.T("inbox.page",_culture) @Model.Page</span>@if(Model.Page*Model.PageSize<Model.Total){<a class="button button-quiet" asp-route-tenantId="@tenantId" asp-route-search="@search" asp-route-type="@type" asp-route-scope="@scope" asp-route-purpose="@purpose" asp-route-patientId="@patientId" asp-route-page="@(Model.Page+1)">@L.T("inbox.next",_culture)</a>}</nav>}
