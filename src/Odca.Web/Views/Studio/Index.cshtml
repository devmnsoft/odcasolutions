@model Odca.Contracts.Studio.TemplateCatalogPage
@{ var tenantId=(Guid)ViewData["TenantId"]!; var search=ViewData["Search"] as string; var type=ViewData["Type"] as string; var scope=ViewData["Scope"] as string; ViewData["OrganizationName"]="Organização selecionada"; }
<section class="page-heading"><div><p class="eyebrow">Biblioteca</p><h1>Modelos de contrato</h1><p class="muted">Escolha uma versão publicada. A minuta será uma cópia independente e rastreável. Modelos oficiais são pontos de partida operacionais, não parecer jurídico.</p></div><details class="help"><summary>Como usar</summary><p>Filtre por tipo ou escopo, instale a biblioteca oficial se o catálogo estiver vazio e selecione <strong>Usar modelo</strong>. Campos obrigatórios serão revisados no estúdio. <strong>Duplicar</strong> cria um rascunho particular para adaptação.</p></details></section>
@if(TempData["StudioError"] is string error){<div class="error" role="alert">@error</div>}
@if(TempData["StudioSuccess"] is string success){<div class="success" role="status">@success</div>}
@if(ViewData["LoadError"] is string loadError){<div class="error" role="alert"><strong>Não foi possível carregar o catálogo.</strong> @loadError</div>}
<form method="get" class="studio-filter"><label>Pesquisar<input name="search" value="@search" placeholder="Nome ou descrição" /></label><label>Tipo<select name="type"><option value="">Todos</option>@foreach(var item in new[]{("nda","Confidencialidade"),("services","Prestação de serviços"),("amendment","Aditivo"),("supply","Fornecimento"),("lease","Locação")}){<option value="@item.Item1" selected="@(type==item.Item1)">@item.Item2</option>}</select></label><label>Escopo<select name="scope"><option value="">Todos</option><option value="global" selected="@(scope=="global")">Global</option><option value="consultancy" selected="@(scope=="consultancy")">Consultoria</option><option value="private" selected="@(scope=="private")">Particular</option></select></label><button class="button button-primary" type="submit">Filtrar</button>@if(ViewData["LoadError"] is not null){<button class="button button-quiet" type="submit">Tentar novamente</button>}</form>
<form method="post" asp-action="InstallOfficial" asp-route-tenantId="@tenantId" class="studio-filter"><input type="hidden" name="search" value="@search"/><input type="hidden" name="type" value="@type"/><input type="hidden" name="scope" value="@scope"/><button class="button button-quiet" type="submit">Instalar biblioteca oficial</button><p class="muted">Publica NDA, confidencialidade recíproca, prestação de serviços e aditivo para esta organização, sem sobrescrever modelos existentes de mesmo nome.</p></form>
<div class="template-grid">
@foreach(var item in Model.Items){<article class="template-card"><div><span class="badge badge-muted">@item.ContractType</span><span class="badge">Escopo: @(item.Scope=="global"?"Global":item.Scope=="consultancy"?"Consultoria":"Particular")</span><span class="badge">Status: @item.Status</span></div><h2>@item.Name</h2><p>@item.Description</p><small>Versão @item.Version · por @item.Author</small><small>Publicado: @(item.PublishedAt?.ToString("dd/MM/yyyy HH:mm 'UTC'") ?? "Ainda não publicado")</small><form method="post" asp-action="Create" asp-route-tenantId="@tenantId"><input type="hidden" name="templateId" value="@item.Id"/><label>Título da minuta<input name="title" required maxlength="160" value="@item.Name"/></label><button class="button button-primary" type="submit">Usar modelo</button></form><form method="post" asp-action="Duplicate" asp-route-tenantId="@tenantId" asp-route-templateId="@item.Id"><input type="hidden" name="search" value="@search"/><input type="hidden" name="type" value="@type"/><input type="hidden" name="scope" value="@scope"/><button class="button button-quiet" type="submit">Duplicar como particular</button></form></article>}
</div>
@if(Model.Items.Count==0 && ViewData["LoadError"] is null){<div class="card empty-state"><h2>Nenhum modelo disponível</h2><p>Instale a biblioteca oficial ou ajuste os filtros. Modelos só aparecem depois de publicados.</p></div>}
@if(Model.Total>Model.PageSize){<nav class="pagination" aria-label="Paginação do catálogo">@if(Model.Page>1){<a class="button button-quiet" asp-route-tenantId="@tenantId" asp-route-search="@search" asp-route-type="@type" asp-route-scope="@scope" asp-route-page="@(Model.Page-1)">Anterior</a>}<span>Página @Model.Page</span>@if(Model.Page*Model.PageSize<Model.Total){<a class="button button-quiet" asp-route-tenantId="@tenantId" asp-route-search="@search" asp-route-type="@type" asp-route-scope="@scope" asp-route-page="@(Model.Page+1)">Próxima</a>}</nav>}
