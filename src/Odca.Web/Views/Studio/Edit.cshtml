@model Odca.Contracts.Studio.DraftResponse
@using System.Text.Json
@{var tenantId=(Guid)ViewData["TenantId"]!;ViewData["OrganizationName"]="Organização selecionada";}
<div class="studio" data-studio data-save-url="@Url.Action("Save",new{tenantId,draftId=Model.Id})" data-version="@Model.Version">
<header class="studio-head"><div><p class="eyebrow">Minuta</p><h1>@Model.Title</h1></div><div class="studio-actions"><span class="save-state" data-save-state role="status">Salvo</span><button class="button button-link" type="button" data-save>Salvar</button><form method="post" asp-action="Generate" asp-route-tenantId="@tenantId" asp-route-draftId="@Model.Id"><button class="button button-primary" type="submit">Gerar versão</button></form></div></header>
@if(TempData["StudioSuccess"] is string ok){<div class="success">@ok</div>}@if(TempData["StudioError"] is string err){<div class="error">@err</div>}
<div class="studio-grid"><aside class="studio-side"><h2>Navegação</h2><button class="side-link active">Documento</button><button class="side-link">Campos pendentes <strong data-pending-count>0</strong></button><button class="side-link">Versões</button><p class="muted">Origem: modelo @Model.SourceTemplateId.ToString()[..8], versão imutável.</p></aside>
<main class="studio-document"><div class="editor-toolbar" aria-label="Ferramentas"><button type="button" data-command="bold"><strong>N</strong></button><button type="button" data-command="italic"><em>I</em></button><button type="button" data-command="underline"><u>S</u></button><button type="button" data-add="paragraph">Parágrafo</button><button type="button" data-add="heading">Título</button><button type="button" data-add="pageBreak">Quebra de página</button><label>Zoom<select data-zoom><option>100</option><option>125</option><option>150</option></select></label></div><div class="paper" data-document aria-label="Documento estruturado"></div></main>
<aside class="studio-side studio-context"><h2>Campos inteligentes</h2><p class="muted">Valores confirmados são preservados como retrato e não mudam com o cadastro.</p><div data-fields></div></aside></div>
<script type="application/json" id="studio-content">@Html.Raw(Model.Content.GetRawText().Replace("</", "<\\/", StringComparison.Ordinal))</script><script type="application/json" id="studio-fields">@Html.Raw(Model.Fields.GetRawText().Replace("</", "<\\/", StringComparison.Ordinal))</script><script type="application/json" id="studio-values">@Html.Raw(Model.Values.GetRawText().Replace("</", "<\\/", StringComparison.Ordinal))</script></div>
@section Scripts{<script src="~/js/studio.js" asp-append-version="true"></script>}
