@model Odca.Contracts.Studio.GeneratedVersionDetail
@using System.Text.Json
@{
    var tenantId=(Guid)ViewData["TenantId"]!;
    var reviewers=ViewData["Reviewers"] as Odca.Contracts.Studio.StudioReviewerItem[] ?? [];
    var reviewerError=ViewData["ReviewersError"] as string;
    var selectedReviewer=TempData["ReviewReviewerId"] as string;
    var reviewInstructions=TempData["ReviewInstructions"] as string;
    var reviewDueAt=DateTimeOffset.TryParse(TempData["ReviewDueAt"] as string,out var due)?due.ToString("yyyy-MM-ddTHH:mm"):null;
    var reviewKey=Guid.TryParse(TempData["ReviewIdempotencyKey"] as string,out var priorKey)?priorKey:Guid.NewGuid();
    var patient=Model.PatientSnapshot;
    string? PatientValue(string name) => patient is JsonElement value && value.TryGetProperty(name,out var property) && property.ValueKind!=JsonValueKind.Null ? property.ToString() : null;
    string? representativeName = patient is JsonElement snapshot && snapshot.TryGetProperty("representative",out var representative) && representative.ValueKind==JsonValueKind.Object && representative.TryGetProperty("fullName",out var name) ? name.GetString() : null;
}
<nav class="breadcrumb"><a asp-controller="Patients" asp-action="Index" asp-route-tenantId="@tenantId">Pacientes</a><span>/</span><span>Versão @Model.Number</span></nav>
<header class="page-heading"><div><p class="eyebrow">Versão documental imutável</p><h1>@Model.Title</h1><p>@Model.DocumentType · versão @Model.Number</p></div><span class="status-badge">Gerada</span></header>
@if(TempData["StudioError"] is string error){<div class="alert alert-error" role="alert">@error</div>}
@if(TempData["StudioSuccess"] is string success){<div class="alert alert-success" role="status">@success</div>}
<section class="summary-grid" aria-label="Dados da versão">
 <article><span>Organização</span><strong>@Model.Organization</strong></article>
 <article><span>Paciente</span><strong>@(PatientValue("fullName")??"Não vinculado")</strong><small>Representante: @(representativeName??"Não registrado")</small></article>
 <article><span>Modelo</span><strong>@Model.Template · v@Model.TemplateVersion</strong></article>
 <article><span>Geração</span><strong>@Model.Author</strong><small>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small></article>
 <article><span>Revisão interna</span><strong>@(Model.ReviewStatus switch{"generated"=>"Ainda não solicitada","submitted"=>"Em revisão","internally_approved"=>"Aprovada internamente","changes_requested"=>"Ajustes solicitados",_=>"Estado indisponível"})</strong></article>
 <article><span>Assinatura eletrônica</span><strong>Não integrada</strong><small>A aprovação interna não equivale a assinatura.</small></article>
</section>
<section class="card document-shell"><header><p class="eyebrow">Documento emitido · versão @Model.Number</p><h2>@Model.Title</h2></header><p>Conteúdo congelado na emissão; alterações posteriores no cadastro ou modelo não o modificam.</p><div class="document-paper">@Html.Raw(Model.RenderedHtml)</div><details><summary>Dados técnicos de integridade</summary><p>Hash do conteúdo canônico: <code>@Model.Sha256</code></p><p>O JSON continua sendo a fonte canônica; esta leitura e o PDF são representações derivadas.</p></details></section>
<section class="card"><h2>PDF final</h2>@if(Model.PdfStatus=="completed"){<p>Arquivo final preservado · @Model.PdfByteSize bytes · gerado em @Model.PdfCompletedAt?.ToString("dd/MM/yyyy HH:mm").</p><a class="button button-primary" asp-action="DownloadPdf" asp-route-tenantId="@tenantId" asp-route-versionId="@Model.Id">Baixar PDF protegido</a>}else{<p>@(Model.PdfStatus=="failed"?"A tentativa anterior falhou e pode ser repetida com segurança.":"O PDF ainda não foi preparado.")</p><form method="post" asp-action="GeneratePdf" asp-route-tenantId="@tenantId" asp-route-versionId="@Model.Id">@Html.AntiForgeryToken()<button class="button button-primary" type="submit">Gerar PDF final</button></form>}</section>
<section class="help-card" id="solicitar-revisao">
 <h2>Revisão</h2>
 @if(Model.ReviewId is Guid reviewId){<p>Esta versão já possui uma revisão. Repetir a solicitação não cria outra revisão.</p><a class="button button-primary" asp-controller="Reviews" asp-action="Detail" asp-route-tenantId="@tenantId" asp-route-reviewId="@reviewId">Acompanhar revisão</a>}
 else if(Model.ReviewStatus!="generated"){<p>Esta versão não está disponível para uma nova solicitação de revisão.</p>}
 else if(reviewerError is not null){<div class="alert alert-error" role="alert">@reviewerError</div>}
 else if(reviewers.Length==0){<p>Nenhum responsável elegível está disponível.</p>}
 else {<form method="post" asp-action="RequestReview" asp-route-tenantId="@tenantId" asp-route-versionId="@Model.Id" data-prevent-double-submit>@Html.AntiForgeryToken()<input type="hidden" name="idempotencyKey" value="@reviewKey"/><label for="reviewerId">Responsável</label><select id="reviewerId" name="reviewerId" required><option value="">Selecione</option>@foreach(var reviewer in reviewers){<option value="@reviewer.Id" selected="@(selectedReviewer==reviewer.Id.ToString()?"selected":null)">@reviewer.Name</option>}</select><label for="instructions">Instruções</label><textarea id="instructions" name="instructions" maxlength="4000">@reviewInstructions</textarea><label for="dueAt">Prazo opcional</label><input id="dueAt" name="dueAt" type="datetime-local" value="@reviewDueAt"/><button class="button button-primary" type="submit">Solicitar revisão desta versão</button></form>}
 <details class="help"><summary>Como usar</summary><p>Escolha um responsável da organização e descreva o que deve ser conferido. A solicitação ficará vinculada somente a esta versão.</p></details>
</section>
<section class="help-card" id="preparacao-assinatura">
 <h2>Preparação dos participantes</h2>
 <p>Esta composição pertence somente à versão @Model.Number. Ela não cria login, não altera cadastros e não representa envio ou assinatura.</p>
 @if(Model.SignaturePreparation?.Readiness is { } readiness){<div class="summary-grid" aria-label="Conferência de prontidão"><article><span>Preparação</span><strong>@(readiness.PreparationComplete?"Completa":"Com pendências")</strong></article><article><span>Revisão interna</span><strong>@(readiness.InternallyApproved?"Aprovada":"Etapa separada")</strong></article><article><span>Integração</span><strong>Indisponível</strong></article></div>@foreach(var blocker in readiness.Blockers){<div class="alert alert-error" role="alert"><strong>@blocker.Message</strong><br/>@blocker.Reason <span>@blocker.CorrectionAction</span></div>}@foreach(var warning in readiness.Warnings){<p><strong>Aviso:</strong> @warning.Message @warning.CorrectionAction</p>}}
 @if(Model.SignaturePreparation?.Status=="confirmed"){
  <div class="alert alert-success" role="status"><strong>Preparação confirmada.</strong> A composição e o hash <code>@Model.SignaturePreparation.ConfirmedPdfSha256</code> estão congelados.</div>
  <form method="post" asp-action="ReopenParticipants" asp-route-tenantId="@tenantId" asp-route-versionId="@Model.Id" data-prevent-double-submit onsubmit="return confirm('Reabrir exigirá uma nova conferência. A confirmação anterior será preservada. Continuar?')">@Html.AntiForgeryToken()<input type="hidden" name="expectedVersion" value="@Model.SignaturePreparation.Version"/><input type="hidden" name="operationId" value="@Guid.NewGuid()"/><label for="reopen-justification">Justificativa da reabertura</label><textarea id="reopen-justification" name="justification" required minlength="5" maxlength="1000"></textarea><button class="button button-quiet" type="submit">Reabrir para edição</button></form>
 } else {
 <form method="post" asp-action="SaveParticipants" asp-route-tenantId="@tenantId" asp-route-versionId="@Model.Id" data-prevent-double-submit id="participants-form">@Html.AntiForgeryToken()<input type="hidden" name="expectedVersion" value="@(Model.SignaturePreparation?.Version??0)"/><input type="hidden" name="operationId" value="@Guid.NewGuid()"/>
 @{IReadOnlyList<Odca.Contracts.Studio.SignatureParticipantInput> participants=Model.SignaturePreparation?.Participants??(patient is JsonElement patientSnapshot&&patientSnapshot.TryGetProperty("id",out var patientIdValue)&&Guid.TryParse(patientIdValue.ToString(),out var patientId)?new[]{new Odca.Contracts.Studio.SignatureParticipantInput(Guid.NewGuid(),"patient",patientId,"Signatário",PatientValue("fullName")??"",PatientValue("email"),PatientValue("phone"),1)}:Array.Empty<Odca.Contracts.Studio.SignatureParticipantInput>());}
 <div id="participant-list">@for(var i=0;i<participants.Count;i++){var item=participants[i];<fieldset class="participant-row"><legend>Participante <span class="participant-number">@(i+1)</span></legend><input type="hidden" data-name="Id" value="@item.Id"/><input type="hidden" data-name="Position" value="@(i+1)"/><label>Tipo<select data-name="ParticipantType" class="participant-type"><option value="patient" selected="@(item.ParticipantType=="patient"?"selected":null)">Paciente do snapshot</option><option value="representative" selected="@(item.ParticipantType=="representative"?"selected":null)">Representante do snapshot</option><option value="professional" selected="@(item.ParticipantType=="professional"?"selected":null)">Profissional informado</option><option value="organization_representative" selected="@(item.ParticipantType=="organization_representative"?"selected":null)">Representante da organização</option></select></label><label>Origem<select data-name="SourceId" class="participant-source"><option value="">Informado manualmente</option>@if(patient is JsonElement ps&&ps.TryGetProperty("id",out var pid)){<option value="@pid" selected="@(item.SourceId?.ToString()==pid.ToString()?"selected":null)">Paciente: @PatientValue("fullName")</option>}@if(patient is JsonElement rs&&rs.TryGetProperty("representative",out var rep)&&rep.ValueKind==JsonValueKind.Object&&rep.TryGetProperty("id",out var rid)){<option value="@rid" selected="@(item.SourceId?.ToString()==rid.ToString()?"selected":null)">Representante: @representativeName</option>}</select></label><label>Papel<input data-name="Role" value="@item.Role" required maxlength="120"/></label><label>Nome<input data-name="Name" value="@item.Name" required maxlength="160"/></label><label>E-mail<input data-name="Email" value="@item.Email" type="email" maxlength="254"/></label><label>Telefone<input data-name="Phone" value="@item.Phone" maxlength="40"/></label><div class="form-actions-row"><button type="button" class="button button-quiet move-up" aria-label="Mover participante para cima">↑</button><button type="button" class="button button-quiet move-down" aria-label="Mover participante para baixo">↓</button><button type="button" class="button button-quiet remove-participant">Retirar</button></div></fieldset>}</div>
 <button type="button" class="button button-quiet" id="add-participant">Adicionar participante</button><div class="form-actions-row"><button class="button button-quiet" name="confirm" value="false">Salvar rascunho</button><button class="button button-primary" name="confirm" value="true" @(Model.PdfStatus=="completed"?null:"disabled")>Conferir e confirmar preparação</button></div></form>
 }
 <p><strong>Aprovação interna:</strong> processo separado. <strong>Integração, envio e assinatura:</strong> não integrados.</p><details class="help"><summary>Como usar</summary><p>Adicione, ordene e retire pessoas. Paciente e representante devem ser escolhidos pelo nome no snapshot. Ao trocar para um tipo manual, selecione “Informado manualmente”; contatos editados valem apenas nesta preparação.</p></details>
</section>
<script>
(()=>{const list=document.getElementById('participant-list');if(!list)return;const sourceOptions=list.querySelector('.participant-source')?.innerHTML??'<option value="">Informado manualmente</option>';const reindex=()=>[...list.children].forEach((row,i)=>{row.querySelector('.participant-number').textContent=i+1;row.querySelectorAll('[data-name]').forEach(x=>{x.name=`participants[${i}].${x.dataset.name}`});row.querySelector('[data-name="Position"]').value=i+1});const wire=row=>{row.querySelector('.remove-participant').onclick=()=>{if(confirm('Retirar este participante da composição ativa?')){row.remove();reindex()}};row.querySelector('.move-up').onclick=()=>{if(row.previousElementSibling)list.insertBefore(row,row.previousElementSibling);reindex()};row.querySelector('.move-down').onclick=()=>{if(row.nextElementSibling)list.insertBefore(row.nextElementSibling,row);reindex()};row.querySelector('.participant-type').onchange=e=>{const source=row.querySelector('.participant-source');source.value='';if(e.target.value==='patient'||e.target.value==='representative'){source.focus()}else source.value=''}};[...list.children].forEach(wire);document.getElementById('add-participant').onclick=()=>{if(list.children.length>=20)return;const row=document.createElement('fieldset');row.className='participant-row';row.innerHTML=`<legend>Participante <span class="participant-number"></span></legend><input type="hidden" data-name="Id" value="${crypto.randomUUID()}"/><input type="hidden" data-name="Position"/><label>Tipo<select data-name="ParticipantType" class="participant-type"><option value="professional">Profissional informado</option><option value="organization_representative">Representante da organização</option><option value="patient">Paciente do snapshot</option><option value="representative">Representante do snapshot</option></select></label><label>Origem<select data-name="SourceId" class="participant-source">${sourceOptions}</select></label><label>Papel<input data-name="Role" required maxlength="120"/></label><label>Nome<input data-name="Name" required maxlength="160"/></label><label>E-mail<input data-name="Email" type="email" maxlength="254"/></label><label>Telefone<input data-name="Phone" maxlength="40"/></label><div class="form-actions-row"><button type="button" class="button button-quiet move-up">↑</button><button type="button" class="button button-quiet move-down">↓</button><button type="button" class="button button-quiet remove-participant">Retirar</button></div>`;list.append(row);wire(row);reindex()};reindex()})();
</script>
<div class="form-actions-row"><a class="button button-quiet" asp-action="Edit" asp-route-tenantId="@tenantId" asp-route-draftId="@Model.DraftId">Continuar no Studio</a></div>
