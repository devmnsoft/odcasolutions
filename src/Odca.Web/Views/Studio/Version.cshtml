@model Odca.Contracts.Studio.GeneratedVersionDetail
@using System.Text.Json
@{
    var tenantId=(Guid)ViewData["TenantId"]!;
    var reviewers=ViewData["Reviewers"] as Odca.Contracts.Studio.StudioReviewerItem[] ?? [];
    var reviewerError=ViewData["ReviewersError"] as string;
    var selectedReviewer=TempData["ReviewReviewerId"] as string;
    var reviewInstructions=TempData["ReviewInstructions"] as string;
    var reviewDueAt=DateTimeOffset.TryParse(TempData["ReviewDueAt"] as string,out var due)?due.ToString("yyyy-MM-ddTHH:mm"):null;
    var reviewKey=Guid.TryParse(TempData["ReviewIdempotencyKey"] as string,out var priorKey)?priorKey:Guid.NewGuid();
    var preparationKey=Guid.TryParse(TempData["PreparationOperationId"] as string,out var priorPreparationKey)?priorPreparationKey:Guid.NewGuid();
    var reopenKey=Guid.TryParse(TempData["ReopenOperationId"] as string,out var priorReopenKey)?priorReopenKey:Guid.NewGuid();
    var reopenJustification=TempData["ReopenJustification"] as string;
    var preparationHistory=ViewData["PreparationHistory"] as Odca.Contracts.Studio.SignaturePreparationHistoryPage;
    var preparationComparison=ViewData["PreparationComparison"] as Odca.Contracts.Studio.SignatureCompositionComparison;
    var comparisonError=ViewData["PreparationComparisonError"] as string;
    var patient=Model.PatientSnapshot;
    var _culture=(string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey];
    string? PatientValue(string name) => patient is JsonElement value && value.TryGetProperty(name,out var property) && property.ValueKind!=JsonValueKind.Null ? property.ToString() : null;
    string? representativeName = patient is JsonElement snapshot && snapshot.TryGetProperty("representative",out var representative) && representative.ValueKind==JsonValueKind.Object && representative.TryGetProperty("fullName",out var name) ? name.GetString() : null;
}
@await Html.PartialAsync("_I18nBag")
<nav class="breadcrumb"><a asp-controller="Patients" asp-action="Index" asp-route-tenantId="@tenantId">@L.T("studio.ver_breadcrumb_patients",_culture)</a><span>/</span><span>@L.T("studio.ver_number",_culture,Model.Number.ToString())</span></nav>
<header class="page-heading"><div><p class="eyebrow">@L.T("studio.ver_eyebrow",_culture)</p><h1>@Model.Title</h1><p>@Model.DocumentType · @L.T("studio.ver_lower_version",_culture) @Model.Number</p></div><span class="status-badge">@L.T("studio.ver_generated_badge",_culture)</span></header>
@if(TempData["StudioError"] is string error){<div class="alert alert-error" role="alert">@error</div>}
@if(TempData["StudioSuccess"] is string success){<div class="alert alert-success" role="status">@success</div>}
<section class="summary-grid" aria-label="@L.T("studio.ver_summary_aria",_culture)">
 <article><span>@L.T("studio.lbl_organization",_culture)</span><strong>@Model.Organization</strong></article>
 <article><span>@L.T("studio.lbl_patient",_culture)</span><strong>@(PatientValue("fullName")??L.T("studio.conf_none_linked",_culture))</strong><small>@L.T("studio.lbl_representative",_culture): @(representativeName??L.T("studio.ver_not_registered",_culture))</small></article>
 <article><span>@L.T("studio.lbl_model",_culture)</span><strong>@Model.Template · v@(Model.TemplateVersion)</strong></article>
 <article><span>@L.T("studio.ver_generation",_culture)</span><strong>@Model.Author</strong><small>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small></article>
 <article><span>@L.T("studio.ver_ready_internal",_culture)</span><strong>@(Model.ReviewStatus switch{"generated"=>L.T("studio.ver_rs_not_requested",_culture),"submitted"=>L.T("studio.ver_rs_submitted",_culture),"internally_approved"=>L.T("studio.ver_rs_approved",_culture),"changes_requested"=>L.T("studio.ver_rs_changes",_culture),"externally_signed"=>L.T("studio.ver_rs_signed",_culture),_=>L.T("studio.ver_rs_unknown",_culture)})</strong></article>
 <article><span>@L.T("studio.ver_sig_label",_culture)</span><strong>@L.T("studio.ver_sig_not_integrated",_culture)</strong><small>@L.T("studio.ver_sig_detail",_culture)</small></article>
</section>
<section class="card document-shell"><header><p class="eyebrow">@L.T("studio.ver_docshell_eyebrow",_culture,Model.Number.ToString())</p><h2>@Model.Title</h2></header><p>@L.T("studio.ver_frozen",_culture)</p><div class="document-paper">@Html.Raw(Model.RenderedHtml)</div><details><summary>@L.T("studio.ver_integrity_title",_culture)</summary><p>@L.T("studio.ver_hash",_culture) <code>@Model.Sha256</code></p><p>@L.T("studio.ver_json_note",_culture)</p></details></section>
<section class="card"><h2>@L.T("studio.ver_pdf_h",_culture)</h2>@if(Model.PdfStatus=="completed"){<p>@L.T("studio.ver_pdf_done",_culture,(Model.PdfByteSize ?? 0L).ToString(),Model.PdfCompletedAt?.ToString("dd/MM/yyyy HH:mm") ?? "")</p><a class="button button-primary" asp-action="DownloadPdf" asp-route-tenantId="@tenantId" asp-route-versionId="@Model.Id">@L.T("studio.ver_pdf_download",_culture)</a>}else{<p>@(Model.PdfStatus=="failed"?L.T("studio.ver_pdf_failed",_culture):L.T("studio.ver_pdf_pending",_culture))</p><form method="post" asp-action="GeneratePdf" asp-route-tenantId="@tenantId" asp-route-versionId="@Model.Id" data-prevent-double-submit onsubmit="if(this.dataset.submitted)return false;this.dataset.submitted='1';const button=this.querySelector('button');if(button){button.disabled=true;button.textContent=window.OdcaI18n.t('studio.ver_pdf_generating');}">@Html.AntiForgeryToken()<button class="button button-primary" type="submit">@L.T("studio.ver_pdf_generate_btn",_culture)</button></form>}</section>
<section class="help-card" id="solicitar-revisao">
 <h2>@L.T("studio.ver_rev_h",_culture)</h2>
 @if(Model.ReviewId is Guid reviewId){<p>@L.T("studio.ver_rev_exists",_culture)</p><a class="button button-primary" asp-controller="Reviews" asp-action="Detail" asp-route-tenantId="@tenantId" asp-route-reviewId="@reviewId">@L.T("studio.ver_rev_follow",_culture)</a>}
 else if(Model.ReviewStatus!="generated"){<p>@L.T("studio.ver_rev_unavailable",_culture)</p>}
 else if(reviewerError is not null){<div class="alert alert-error" role="alert">@reviewerError</div>}
 else if(reviewers.Length==0){<p>@L.T("studio.ver_rev_no_one",_culture)</p>}
 else {<form method="post" asp-action="RequestReview" asp-route-tenantId="@tenantId" asp-route-versionId="@Model.Id" data-prevent-double-submit>@Html.AntiForgeryToken()<input type="hidden" name="idempotencyKey" value="@reviewKey"/><label for="reviewerId">@L.T("studio.ver_rev_responsible",_culture)</label><select id="reviewerId" name="reviewerId" required><option value="">@L.T("studio.ver_rev_select",_culture)</option>@foreach(var reviewer in reviewers){<option value="@reviewer.Id" selected="@(selectedReviewer==reviewer.Id.ToString()?"selected":null)">@reviewer.Name</option>}</select><label for="instructions">@L.T("studio.ver_rev_instructions",_culture)</label><textarea id="instructions" name="instructions" maxlength="4000">@reviewInstructions</textarea><label for="dueAt">@L.T("studio.ver_rev_due",_culture)</label><input id="dueAt" name="dueAt" type="datetime-local" value="@reviewDueAt"/><button class="button button-primary" type="submit">@L.T("studio.ver_rev_request_btn",_culture)</button></form>}
 <details class="help"><summary>@L.T("common.how_to_use",_culture)</summary><p>@L.T("studio.ver_rev_help",_culture)</p></details>
</section>
<section class="help-card" id="preparacao-assinatura">
 <h2>@L.T("studio.ver_prep_h",_culture)</h2>
 <p>@L.T("studio.ver_prep_ownership",_culture,Model.Number.ToString())</p>
 @if(Model.SignaturePreparation is { } summary){<div class="summary-grid" aria-label="@L.T("studio.ver_comp_summary_aria",_culture)"><article><span>@L.T("studio.ver_comp_current",_culture)</span><strong>@L.T("studio.ver_comp_revision",_culture,summary.CompositionRevision.ToString())</strong><small>@L.T("studio.ver_comp_participants",_culture,summary.Participants.Count.ToString())</small></article><article><span>@L.T("studio.ver_comp_confirmed_label",_culture)</span><strong>@(summary.ConfirmedRevision is int confirmed?L.T("studio.ver_comp_revision",_culture,confirmed.ToString()):L.T("studio.ver_comp_none",_culture))</strong></article><article><span>@L.T("studio.ver_comp_situation",_culture)</span><strong>@(summary.Status=="confirmed"?L.T("studio.ver_comp_status_confirmed",_culture):L.T("studio.ver_comp_status_preparing",_culture))</strong></article></div>}
 <div class="form-actions-row"><a class="button button-quiet" href="#historico-preparacao">@L.T("studio.ver_hist_link",_culture)</a><a class="button button-quiet" href="#comparar-composicoes">@L.T("studio.ver_compcompare_link",_culture)</a></div>
 @if(Model.SignaturePreparation?.Readiness is { } readiness){<div class="summary-grid" aria-label="@L.T("studio.ver_readiness_aria",_culture)"><article><span>@L.T("studio.ver_ready_preparation",_culture)</span><strong>@(readiness.PreparationComplete?L.T("studio.ver_ready_complete",_culture):L.T("studio.ver_ready_pending",_culture))</strong></article><article><span>@L.T("studio.ver_ready_internal",_culture)</span><strong>@(readiness.InternallyApproved?L.T("studio.ver_ready_approved",_culture):L.T("studio.ver_ready_separate_step",_culture))</strong></article><article><span>@L.T("studio.ver_ready_integration",_culture)</span><strong>@L.T("studio.ver_ready_unavailable",_culture)</strong></article></div>@foreach(var blocker in readiness.Blockers){<div class="alert alert-error" role="alert"><strong>@blocker.Message</strong><br/>@blocker.Reason <span>@blocker.CorrectionAction</span></div>}@foreach(var warning in readiness.Warnings){<p><strong>@L.T("studio.ver_warning_prefix",_culture)</strong> @warning.Message @warning.CorrectionAction</p>}}
 @if(Model.SignaturePreparation?.Status=="confirmed"){
  <div class="alert alert-success" role="status"><strong>@L.T("studio.ver_prep_confirmed_a",_culture)</strong> @L.T("studio.ver_prep_confirmed_b",_culture) <code>@Model.SignaturePreparation.ConfirmedPdfSha256</code> @L.T("studio.ver_prep_confirmed_c",_culture)</div>
  <form method="post" asp-action="ReopenParticipants" asp-route-tenantId="@tenantId" asp-route-versionId="@Model.Id" data-prevent-double-submit onsubmit="return confirm(window.OdcaI18n.t('studio.ver_reopen_confirm'))">@Html.AntiForgeryToken()<input type="hidden" name="expectedVersion" value="@Model.SignaturePreparation.Version"/><input type="hidden" name="operationId" value="@reopenKey"/><label for="reopen-justification">@L.T("studio.ver_reopen_justification",_culture)</label><textarea id="reopen-justification" name="justification" required minlength="5" maxlength="1000">@reopenJustification</textarea><button class="button button-quiet" type="submit">@L.T("studio.ver_reopen_btn",_culture)</button></form>
 } else {
 <form method="post" asp-action="SaveParticipants" asp-route-tenantId="@tenantId" asp-route-versionId="@Model.Id" data-prevent-double-submit id="participants-form">@Html.AntiForgeryToken()<input type="hidden" name="expectedVersion" value="@(Model.SignaturePreparation?.Version??0)"/><input type="hidden" name="operationId" value="@preparationKey"/>
 @{IReadOnlyList<Odca.Contracts.Studio.SignatureParticipantInput> participants=Model.SignaturePreparation?.Participants??(patient is JsonElement patientSnapshot&&patientSnapshot.TryGetProperty("id",out var patientIdValue)&&Guid.TryParse(patientIdValue.ToString(),out var patientId)?new[]{new Odca.Contracts.Studio.SignatureParticipantInput(Guid.NewGuid(),"patient",patientId,L.T("studio.ver_default_role",_culture),PatientValue("fullName")??"",PatientValue("email"),PatientValue("phone"),1)}:Array.Empty<Odca.Contracts.Studio.SignatureParticipantInput>());}
 <div id="participant-list">@for(var i=0;i<participants.Count;i++){var item=participants[i];<fieldset class="participant-row"><legend>@L.T("studio.ver_participant_title",_culture) <span class="participant-number">@(i+1)</span></legend><input type="hidden" data-name="Id" value="@item.Id"/><input type="hidden" data-name="Position" value="@(i+1)"/><label>@L.T("studio.th_type",_culture)<select data-name="ParticipantType" class="participant-type"><option value="patient" selected="@(item.ParticipantType=="patient"?"selected":null)">@L.T("studio.ver_ptype_patient",_culture)</option><option value="representative" selected="@(item.ParticipantType=="representative"?"selected":null)">@L.T("studio.ver_ptype_representative",_culture)</option><option value="professional" selected="@(item.ParticipantType=="professional"?"selected":null)">@L.T("studio.ver_ptype_professional",_culture)</option><option value="organization_representative" selected="@(item.ParticipantType=="organization_representative"?"selected":null)">@L.T("studio.ver_ptype_orgrep",_culture)</option></select></label><label>@L.T("studio.ver_p_origin",_culture)<select data-name="SourceId" class="participant-source"><option value="">@L.T("studio.ver_psource_manual",_culture)</option>@if(patient is JsonElement ps&&ps.TryGetProperty("id",out var pid)){<option value="@pid" selected="@(item.SourceId?.ToString()==pid.ToString()?"selected":null)">@L.T("studio.ver_psource_patient",_culture,PatientValue("fullName")??"")</option>}@if(patient is JsonElement rs&&rs.TryGetProperty("representative",out var rep)&&rep.ValueKind==JsonValueKind.Object&&rep.TryGetProperty("id",out var rid)){<option value="@rid" selected="@(item.SourceId?.ToString()==rid.ToString()?"selected":null)">@L.T("studio.ver_psource_representative",_culture,representativeName??"")</option>}</select></label><label>@L.T("studio.ver_p_role",_culture)<input data-name="Role" value="@item.Role" required maxlength="120"/></label><label>@L.T("studio.ver_p_name",_culture)<input data-name="Name" value="@item.Name" required maxlength="160"/></label><label>@L.T("studio.ver_p_email",_culture)<input data-name="Email" value="@item.Email" type="email" maxlength="254"/></label><label>@L.T("studio.ver_p_phone",_culture)<input data-name="Phone" value="@item.Phone" maxlength="40"/></label><div class="form-actions-row"><button type="button" class="button button-quiet move-up" aria-label="@L.T("studio.ver_move_up_aria",_culture)">↑</button><button type="button" class="button button-quiet move-down" aria-label="@L.T("studio.ver_move_down_aria",_culture)">↓</button><button type="button" class="button button-quiet remove-participant">@L.T("studio.ver_remove_btn",_culture)</button></div></fieldset>}</div>
 <button type="button" class="button button-quiet" id="add-participant">@L.T("studio.ver_add_participant",_culture)</button><div class="form-actions-row"><button class="button button-quiet" name="confirm" value="false">@L.T("studio.ver_save_draft",_culture)</button><button class="button button-primary" name="confirm" value="true" @(Model.PdfStatus=="completed"?null:"disabled")>@L.T("studio.ver_confirm_prep",_culture)</button></div></form>
 }
 <p><strong>@L.T("studio.ver_note_int1",_culture)</strong> @L.T("studio.ver_note_a",_culture) <strong>@L.T("studio.ver_note_int2",_culture)</strong> @L.T("studio.ver_note_b",_culture)</p><details class="help"><summary>@L.T("common.how_to_use",_culture)</summary><p>@L.T("studio.ver_prep_help",_culture)</p></details>
</section>
@if(preparationHistory is not null){
<section class="card" id="historico-preparacao"><h2>@L.T("studio.ver_hist_h",_culture)</h2><p>@L.T("studio.ver_hist_tz_a",_culture) <strong>@preparationHistory.TimeZone</strong>@L.T("studio.ver_hist_tz_b",_culture)</p><div class="table-scroll"><table><thead><tr><th>@L.T("studio.ver_th_datetime",_culture)</th><th>@L.T("studio.ver_th_user",_culture)</th><th>@L.T("studio.ver_th_operation",_culture)</th><th>@L.T("studio.ver_th_revision",_culture)</th><th>@L.T("studio.ver_th_evidence",_culture)</th></tr></thead><tbody>@foreach(var item in preparationHistory.Items){var label=item.Operation switch{"created"=>L.T("studio.op_created",_culture),"updated"=>L.T("studio.op_updated",_culture),"participant_added"=>L.T("studio.op_added",_culture),"participant_removed"=>L.T("studio.op_removed",_culture),"participant_changed"=>L.T("studio.op_changed",_culture),"participant_reordered"=>L.T("studio.op_reordered",_culture),"confirmed"=>L.T("studio.op_confirmed",_culture),"reopened"=>L.T("studio.op_reopened",_culture),_=>item.Operation};<tr><td>@item.OccurredAt.ToString("dd/MM/yyyy HH:mm:ss")</td><td>@item.Actor</td><td>@label@if(item.Justification is not null){<small> — @item.Justification</small>}</td><td>@item.CompositionRevision</td><td>@if(item.Confirmed){<span>@L.T("studio.ver_evidence_pdf",_culture) <code>@item.PdfSha256</code></span>}else{<span>—</span>}</td></tr>}</tbody></table></div>@if(preparationHistory.Page>1){<a class="button button-quiet" asp-action="Version" asp-route-tenantId="@tenantId" asp-route-versionId="@Model.Id" asp-route-historyPage="@(preparationHistory.Page-1)" asp-fragment="historico-preparacao">@L.T("inbox.prev",_culture)</a>}@if(preparationHistory.Page*preparationHistory.PageSize<preparationHistory.Total){<a class="button button-quiet" asp-action="Version" asp-route-tenantId="@tenantId" asp-route-versionId="@Model.Id" asp-route-historyPage="@(preparationHistory.Page+1)" asp-fragment="historico-preparacao">@L.T("inbox.next",_culture)</a>}</section>
<section class="card" id="comparar-composicoes"><h2>@L.T("studio.ver_compcompare_link",_culture)</h2>@if(Model.SignaturePreparation is {CompositionRevision: > 1} prepared){<form method="get" asp-action="Version" asp-route-tenantId="@tenantId" asp-route-versionId="@Model.Id"><div class="form-actions-row"><label>@L.T("studio.ver_cmpcomp_before",_culture)<select name="beforeRevision" required>@for(var revision=1;revision<=prepared.CompositionRevision;revision++){<option value="@revision">@L.T("studio.ver_comp_revision",_culture,revision.ToString())</option>}</select></label><label>@L.T("studio.ver_cmpcomp_after",_culture)<select name="afterRevision" required>@for(var revision=1;revision<=prepared.CompositionRevision;revision++){<option value="@revision" selected="@(revision==prepared.CompositionRevision?"selected":null)">@L.T("studio.ver_comp_revision",_culture,revision.ToString())</option>}</select></label><button class="button button-primary" type="submit">@L.T("studio.ver_compcompare_link",_culture)</button></div></form>}else{<p>@L.T("studio.ver_cmpcomp_need_two",_culture)</p>}@if(comparisonError is not null){<div class="alert alert-error" role="alert">@comparisonError</div>}@if(preparationComparison is not null){<h3>@L.T("studio.ver_cmpcomp_title",_culture,preparationComparison.BeforeRevision.ToString(),preparationComparison.AfterRevision.ToString())</h3>@if(preparationComparison.Changes.Count==0){<p>@L.T("studio.ver_cmpcomp_no_diff",_culture)</p>}else{<ul>@foreach(var change in preparationComparison.Changes){var changeLabel=change.Change switch{"included"=>L.T("studio.ch_included",_culture),"removed"=>L.T("studio.ch_removed",_culture),"role"=>L.T("studio.ch_role",_culture),"contact"=>L.T("studio.ch_contact",_culture),"origin"=>L.T("studio.ch_origin",_culture),"order"=>L.T("studio.ch_order",_culture),_=>change.Change};<li><strong>@change.Name:</strong> @changeLabel@if(change.Before is not null||change.After is not null){<span> — @(change.Before??"—") → @(change.After??"—")</span>}</li>}</ul>}}</section>}
<script>
(()=>{const list=document.getElementById('participant-list');if(!list)return;const t=(window.OdcaI18n&&window.OdcaI18n.t)||((k)=>k);const sourceOptions=list.querySelector('.participant-source')?.innerHTML??('<option value="">' + t('studio.ver_psource_manual') + '</option>');const reindex=()=>[...list.children].forEach((row,i)=>{row.querySelector('.participant-number').textContent=i+1;row.querySelectorAll('[data-name]').forEach(x=>{x.name=`participants[${i}].${x.dataset.name}`});row.querySelector('[data-name="Position"]').value=i+1});const wire=row=>{row.querySelector('.remove-participant').onclick=()=>{if(confirm(t('studio.ver_remove_confirm'))){row.remove();reindex()}};row.querySelector('.move-up').onclick=()=>{if(row.previousElementSibling)list.insertBefore(row,row.previousElementSibling);reindex()};row.querySelector('.move-down').onclick=()=>{if(row.nextElementSibling)list.insertBefore(row.nextElementSibling,row);reindex()};row.querySelector('.participant-type').onchange=e=>{const source=row.querySelector('.participant-source');source.value='';if(e.target.value==='patient'||e.target.value==='representative'){source.focus()}else source.value=''}};[...list.children].forEach(wire);document.getElementById('add-participant').onclick=()=>{if(list.children.length>=20)return;const row=document.createElement('fieldset');row.className='participant-row';row.innerHTML=`<legend>${t('studio.ver_participant_title')} <span class="participant-number"></span></legend><input type="hidden" data-name="Id" value="${crypto.randomUUID()}"/><input type="hidden" data-name="Position"/><label>${t('studio.th_type')}<select data-name="ParticipantType" class="participant-type"><option value="professional">${t('studio.ver_ptype_professional')}</option><option value="organization_representative">${t('studio.ver_ptype_orgrep')}</option><option value="patient">${t('studio.ver_ptype_patient')}</option><option value="representative">${t('studio.ver_ptype_representative')}</option></select></label><label>${t('studio.ver_p_origin')}<select data-name="SourceId" class="participant-source">${sourceOptions}</select></label><label>${t('studio.ver_p_role')}<input data-name="Role" required maxlength="120"/></label><label>${t('studio.ver_p_name')}<input data-name="Name" required maxlength="160"/></label><label>${t('studio.ver_p_email')}<input data-name="Email" type="email" maxlength="254"/></label><label>${t('studio.ver_p_phone')}<input data-name="Phone" maxlength="40"/></label><div class="form-actions-row"><button type="button" class="button button-quiet move-up">↑</button><button type="button" class="button button-quiet move-down">↓</button><button type="button" class="button button-quiet remove-participant">${t('studio.ver_remove_btn')}</button></div>`;list.append(row);wire(row);reindex()};reindex()})();
</script>
<div class="form-actions-row"><a class="button button-quiet" asp-action="Edit" asp-route-tenantId="@tenantId" asp-route-draftId="@Model.DraftId">@L.T("studio.ver_continue_studio",_culture)</a></div>
