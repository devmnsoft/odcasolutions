@model Odca.Web.Models.CompareVersionsViewModel
@{
    var tenantId = (Guid)ViewData["TenantId"]!;
    var draftId = (Guid)ViewData["DraftId"]!;
    var culture = (string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey];
}
<section class="narrow">
    <header class="page-heading">
        <div>
            <p class="eyebrow">@L.T("studio.eyebrow", culture)</p>
            <h1>@L.T("studio.cmpv_title", culture)</h1>
            <p class="muted">@L.T("studio.cmpv_subtitle", culture)</p>
        </div>
    </header>

    <div class="card">
        <form method="get" class="form-grid" action="/organizacoes/@tenantId/estudio/comparar-versoes">
            <input type="hidden" name="draftId" value="@draftId" />
            <label>@L.T("studio.cmpv_before_label", culture)
                <select name="before">
                    @foreach (var v in Model.Versions)
                    {
                        <option value="@v.Id" selected="@(v.Id == Model.BeforeId)">
                            v@v.Number · @(v.Author) · @CulturedTime.DateTime(v.CreatedAt,culture)
                        </option>
                    }
                </select>
            </label>
            <label>@L.T("studio.cmpv_after_label", culture)
                <select name="after">
                    @foreach (var v in Model.Versions)
                    {
                        <option value="@v.Id" selected="@(v.Id == Model.AfterId)">
                            v@v.Number · @(v.Author) · @CulturedTime.DateTime(v.CreatedAt,culture)
                        </option>
                    }
                </select>
            </label>
            <div class="form-actions-row">
                <button type="submit" class="button button-primary">@L.T("action.submit", culture)</button>
            </div>
        </form>
    </div>

    @if (Model.Versions.Count < 2)
    {
        <div class="empty-state">
            <strong>@L.T("studio.cmpv_nothing_title", culture)</strong>
            <p>@L.T("studio.cmpv_nothing_body", culture)</p>
        </div>
    }
    else if (Model.Comparison is null)
    {
        <div class="empty-state">
            <strong>@L.T("studio.cmpv_select_title", culture)</strong>
            <p>@L.T("studio.cmpv_select_body", culture)</p>
        </div>
    }
    else if (Model.Comparison.Changes.Count == 0)
    {
        <div class="card"><p class="success">@L.T("studio.cmpv_no_diff", culture)</p></div>
    }
    else
    {
        // Group changes by category for visual organization
        var metadata = Model.Comparison.Changes.Where(c => c.Category == "metadata").ToList();
        var fields = Model.Comparison.Changes.Where(c => c.Category == "field").ToList();
        var textAdded = Model.Comparison.Changes.Where(c => c.Category == "text-added").ToList();
        var textRemoved = Model.Comparison.Changes.Where(c => c.Category == "text-removed").ToList();
        var textChanged = Model.Comparison.Changes.Where(c => c.Category is "text" or "formatting").ToList();

        <div class="callout callout-info" role="note">
            <strong>@L.T("studio.cmpv_callout_title", culture)</strong>
            <span>@L.T("studio.cmpv_callout_body", culture)</span>
        </div>

        <div class="card compare-summary">
            <h2>@L.T("studio.cmpv_summary", culture)</h2>
            <p class="muted">@L.T("studio.cmpv_sum_between", culture) <strong>v@Model.Comparison.Before.Number</strong> (@Model.Comparison.Before.Author, @CulturedTime.Date(Model.Comparison.Before.CreatedAt,culture)) @L.T("studio.cmpv_sum_and", culture) <strong>v@Model.Comparison.After.Number</strong> (@Model.Comparison.After.Author, @CulturedTime.Date(Model.Comparison.After.CreatedAt,culture)).</p>
            <ul class="compare-counts">
                @if (metadata.Count > 0) { <li><span class="badge badge-muted">@metadata.Count</span> @L.T("studio.cnt_metadata", culture)</li> }
                @if (fields.Count > 0) { <li><span class="badge badge-info">@fields.Count</span> @L.T("studio.cnt_fields", culture)</li> }
                @if (textAdded.Count > 0) { <li><span class="badge badge-success">@textAdded.Count</span> @L.T("studio.cnt_added", culture)</li> }
                @if (textRemoved.Count > 0) { <li><span class="badge badge-danger">@textRemoved.Count</span> @L.T("studio.cnt_removed", culture)</li> }
                @if (textChanged.Count > 0) { <li><span class="badge badge-warning">@textChanged.Count</span> @L.T("studio.cnt_changed", culture)</li> }
            </ul>
        </div>

        @if (metadata.Count > 0)
        {
            <div class="card">
                <h2>@L.T("studio.cnt_metadata", culture)</h2>
                <div class="responsive-table"><table>
                    <thead><tr><th>@L.T("studio.th_field", culture)</th><th>@L.T("studio.th_previous", culture)</th><th>@L.T("studio.th_later", culture)</th></tr></thead>
                    <tbody>
                        @foreach (var ch in metadata)
                        {
                            <tr>
                                <td data-label="@L.T("studio.th_field", culture)">@ch.Reference</td>
                                <td data-label="@L.T("studio.th_previous", culture)" class="diff-before">@(ch.Before ?? "—")</td>
                                <td data-label="@L.T("studio.th_later", culture)" class="diff-after">@(ch.After ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table></div>
            </div>
        }

        @if (fields.Count > 0)
        {
            <div class="card">
                <h2>@L.T("studio.sec_fields", culture)</h2>
                <div class="responsive-table"><table>
                    <thead><tr><th>@L.T("studio.th_field", culture)</th><th>@L.T("studio.th_previous", culture)</th><th>@L.T("studio.th_later", culture)</th></tr></thead>
                    <tbody>
                        @foreach (var ch in fields)
                        {
                            <tr>
                                <td data-label="@L.T("studio.th_field", culture)">@ch.Reference</td>
                                <td data-label="@L.T("studio.th_previous", culture)" class="diff-before">@(ch.Before ?? "—")</td>
                                <td data-label="@L.T("studio.th_later", culture)" class="diff-after">@(ch.After ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table></div>
            </div>
        }

        @if (textAdded.Count > 0 || textRemoved.Count > 0 || textChanged.Count > 0)
        {
            <div class="card">
                <h2>@L.T("studio.sec_content", culture)</h2>
                <div class="responsive-table"><table>
                    <thead><tr><th>@L.T("studio.th_type", culture)</th><th>@L.T("studio.th_reference", culture)</th><th>@L.T("studio.th_previous", culture)</th><th>@L.T("studio.th_later", culture)</th></tr></thead>
                    <tbody>
                        @foreach (var ch in textAdded)
                        {
                            <tr class="row-added">
                                <td data-label="@L.T("studio.th_type", culture)"><span class="badge badge-success">@L.T("studio.badge_added", culture)</span></td>
                                <td data-label="@L.T("studio.th_reference", culture)">@ch.Reference</td>
                                <td data-label="@L.T("studio.th_previous", culture)">—</td>
                                <td data-label="@L.T("studio.th_later", culture)" class="diff-after">@ch.After</td>
                            </tr>
                        }
                        @foreach (var ch in textRemoved)
                        {
                            <tr class="row-removed">
                                <td data-label="@L.T("studio.th_type", culture)"><span class="badge badge-danger">@L.T("studio.badge_removed", culture)</span></td>
                                <td data-label="@L.T("studio.th_reference", culture)">@ch.Reference</td>
                                <td data-label="@L.T("studio.th_previous", culture)" class="diff-before">@ch.Before</td>
                                <td data-label="@L.T("studio.th_later", culture)">—</td>
                            </tr>
                        }
                        @foreach (var ch in textChanged)
                        {
                            <tr class="row-modified">
                                <td data-label="@L.T("studio.th_type", culture)"><span class="badge badge-warning">@L.T("studio.badge_modified", culture)</span></td>
                                <td data-label="@L.T("studio.th_reference", culture)">@ch.Reference</td>
                                <td data-label="@L.T("studio.th_previous", culture)" class="diff-before">@(ch.Before ?? "—")</td>
                                <td data-label="@L.T("studio.th_later", culture)" class="diff-after">@(ch.After ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table></div>
            </div>
        }
    }

    <div class="button-row">
        <a class="button button-quiet" asp-controller="Studio" asp-action="Edit"
           asp-route-tenantId="@tenantId" asp-route-draftId="@draftId">@L.T("action.back", culture)</a>
    </div>
</section>

<style>
.compare-counts { list-style: none; display: flex; flex-wrap: wrap; gap: .75rem; padding: 0; margin: .5rem 0; }
.compare-counts li { display: flex; align-items: center; gap: .35rem; font-size: .9rem; }
.diff-before { background: #FFF3F3; text-decoration: line-through; opacity: .8; }
.diff-after { background: #F0FFF4; font-weight: 500; }
.row-added td { background: #F0FFF4; }
.row-removed td { background: #FFF3F3; }
.row-modified td { background: #FFFBEB; }
.callout-info { border-left: 4px solid var(--action-600, #245bdb); padding: .75rem 1rem; margin-bottom: 1rem; }
</style>
