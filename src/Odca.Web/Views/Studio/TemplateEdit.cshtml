@model Odca.Web.Models.TemplateEditViewModel
@{
    var isNew = Model.IsNew;
    var tenantId = Model.TenantId;
    var isPublished = string.Equals(Model.Status, "published", StringComparison.OrdinalIgnoreCase);
    var isArchived = string.Equals(Model.Status, "archived", StringComparison.OrdinalIgnoreCase);
    var _culture = (string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey];
}
@await Html.PartialAsync("_I18nBag")

<ol class="journey" aria-label="@L.T("studio.e_journey_aria",_culture)">
    <li class="is-current"><span>1</span> @L.T("studio.e_journey_model",_culture)</li>
    <li><span>2</span> @L.T("studio.e_journey_parties",_culture)</li>
    <li><span>3</span> @L.T("studio.e_journey_fields",_culture)</li>
    <li><span>4</span> @L.T("studio.e_journey_conference",_culture)</li>
    <li><span>5</span> @L.T("studio.e_journey_review",_culture)</li>
</ol>
<section class="page-heading">
    <div>
        <p class="eyebrow">@L.T("studio.tpl_eyebrow",_culture)</p>
        <h1>@(isNew ? L.T("studio.tpl_title_create",_culture) : L.T("studio.tpl_title_edit",_culture,Model.Name))</h1>
        <p class="muted">@L.T("studio.tpl_subtitle",_culture)</p>
    </div>
    <div class="button-row">
        <a class="button button-quiet" asp-action="Index" asp-route-tenantId="@tenantId">
            @L.T("studio.tpl_back_catalog",_culture)
        </a>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="error" role="alert">
        <strong>@L.T("studio.tpl_attention",_culture)</strong> @Model.ErrorMessage
    </div>
}
@if (Model.ServerRowVersion > 0)
{
    <section class="card conflict-banner" aria-label="@L.T("studio.tpl_server_version_h",_culture)">
        <h2>@L.T("studio.tpl_server_version_h",_culture)</h2>
        <p>@L.T("studio.tpl_server_name",_culture): @Model.ServerName</p>
        <p>@L.T("studio.tpl_server_desc",_culture): @(string.IsNullOrWhiteSpace(Model.ServerDescription) ? L.T("studio.tpl_server_nodescription",_culture) : Model.ServerDescription)</p>
        <p>@L.T("studio.tpl_server_revision_line",_culture,Model.ServerRowVersion.ToString(),Model.RowVersion.ToString())</p>
    </section>
}
@if (TempData["StudioSuccess"] is string successMsg)
{
    <div class="success" role="status">
        @successMsg
    </div>
}
@if (TempData["StudioError"] is string errorMsg)
{
    <div class="error" role="alert">
        @errorMsg
    </div>
}

<form method="post" asp-action="@(isNew ? "CreateTemplate" : "SaveTemplate")" asp-route-tenantId="@tenantId" asp-route-templateId="@Model.TemplateId" id="templateForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="TenantId" />
    <input type="hidden" asp-for="TemplateId" />
    <input type="hidden" asp-for="Version" />
    <input type="hidden" asp-for="RowVersion" />
    <input type="hidden" asp-for="Status" />

    <div class="card" style="margin-bottom: 1.5rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <h2 style="margin: 0;">@L.T("studio.tpl_ident_h",_culture)</h2>
            <div>
                <span class="badge @(isPublished ? "badge-success" : (isArchived ? "badge-warning" : "badge-muted"))">
                    @L.T("studio.badge_status",_culture): @(isPublished ? L.T("studio.status_published",_culture) : (isArchived ? L.T("studio.status_archived",_culture) : L.T("studio.status_draft",_culture)))
                </span>
                <span class="badge">@L.T("studio.tpl_version_label",_culture): @Model.Version</span>
            </div>
        </div>

        <div class="form-grid tpl-meta">
            <label style="display: block;">
                <strong>@L.T("studio.tpl_name_label",_culture)</strong>
                <input asp-for="Name" required maxlength="160" placeholder="@L.T("studio.tpl_name_ph",_culture)" style="width: 100%;" />
            </label>
            <label style="display: block;">
                <strong>@L.T("studio.tpl_type_label",_culture)</strong>
                <select asp-for="ContractType" style="width: 100%;">
                    <option value="services">@L.T("studio.type_services",_culture)</option>
                    <option value="nda">@L.T("studio.type_nda",_culture)</option>
                    <option value="amendment">@L.T("studio.type_amendment",_culture)</option>
                    <option value="supply">@L.T("studio.type_supply",_culture)</option>
                    <option value="lease">@L.T("studio.type_lease",_culture)</option>
                </select>
            </label>
            <label style="display: block;">
                <strong>@L.T("studio.tpl_scope_label",_culture)</strong>
                <select asp-for="Scope" style="width: 100%;">
                    <option value="private">@L.T("studio.tpl_scope_private_full",_culture)</option>
                    <option value="consultancy">@L.T("studio.scope_consultancy",_culture)</option>
                </select>
            </label>
        </div>

        <label style="display: block; margin-top: 1rem;">
            <strong>@L.T("studio.tpl_desc_label",_culture)</strong>
            <textarea asp-for="Description" rows="2" placeholder="@L.T("studio.tpl_desc_ph",_culture)" style="width: 100%;"></textarea>
        </label>
    </div>

    @* Painel de Campos Variáveis e Conteúdo *@
    <div class="template-editor-grid">
        @* Coluna da Esquerda: Assistente de Campos Variáveis *@
        <div class="card">
            <h3>@L.T("studio.tpl_fields_h",_culture)</h3>
            <p class="muted" style="font-size: 0.875rem;">
                @L.T("studio.tpl_fields_p",_culture)
            </p>

            <div style="background: #f8fafc; padding: 1rem; border-radius: 6px; border: 1px solid #e2e8f0; margin-bottom: 1rem;">
                <h4 style="margin-top: 0; font-size: 0.95rem;">@L.T("studio.tpl_add_field_h",_culture)</h4>
                <div class="tpl-pair">
                    <div>
                        <label style="font-size: 0.8rem; font-weight: 600;">@L.T("studio.tpl_field_id_label",_culture)</label>
                        <input type="text" id="newFieldId" placeholder="identificador_unico" style="width: 100%; font-size: 0.85rem;" />
                    </div>
                    <div>
                        <label style="font-size: 0.8rem; font-weight: 600;">@L.T("studio.tpl_field_label_label",_culture)</label>
                        <input type="text" id="newFieldLabel" placeholder="@L.T("studio.tpl_label_ph",_culture)" style="width: 100%; font-size: 0.85rem;" />
                    </div>
                </div>
                <div class="tpl-pair">
                    <div>
                        <label style="font-size: 0.8rem; font-weight: 600;">@L.T("studio.tpl_field_type_label",_culture)</label>
                        <select id="newFieldType" style="width: 100%; font-size: 0.85rem;">
                            <option value="ShortText">@L.T("studio.ft_short",_culture)</option>
                            <option value="LongText">@L.T("studio.ft_long",_culture)</option>
                            <option value="BrazilianDocument">@L.T("studio.ft_brdoc",_culture)</option>
                            <option value="Currency">@L.T("studio.ft_currency",_culture)</option>
                            <option value="Date">@L.T("studio.ft_date",_culture)</option>
                            <option value="Number">@L.T("studio.ft_number",_culture)</option>
                            <option value="Choice">@L.T("studio.ft_choice",_culture)</option>
                        </select>
                    </div>
                    <div>
                        <label style="font-size: 0.8rem; font-weight: 600;">@L.T("studio.tpl_choices_label",_culture)</label>
                        <input type="text" id="newFieldChoices" placeholder="@L.T("studio.tpl_choices_ph",_culture)" style="width: 100%; font-size: 0.85rem;" />
                    </div>
                </div>
                <label style="font-size: 0.8rem; font-weight: 600; display: block; margin-bottom: 0.5rem;">
                    @L.T("studio.tpl_help_label",_culture)
                    <input type="text" id="newFieldHelp" maxlength="200" placeholder="@L.T("studio.tpl_help_ph",_culture)" style="width: 100%; font-size: 0.85rem; font-weight: 400; margin-top: 0.25rem;" />
                </label>
                <div class="template-field-options">
                    <label>@L.T("studio.tpl_origin_label",_culture)
                        <select id="newFieldOrigin">
                            <option value="manual">@L.T("studio.origin_manual",_culture)</option>
                            <option value="organization">@L.T("studio.origin_organization",_culture)</option>
                            <option value="patient">@L.T("studio.origin_patient",_culture)</option>
                            <option value="contractor">@L.T("studio.origin_contractor",_culture)</option>
                            <option value="representative">@L.T("studio.origin_representative",_culture)</option>
                        </select>
                    </label>
                    <label>@L.T("studio.tpl_property_label",_culture)
                        <select id="newFieldProperty">
                            <option value="">@L.T("studio.tpl_unmap",_culture)</option>
                        </select>
                    </label>
                    <label>@L.T("studio.tpl_ctrl_label",_culture)
                        <select id="newFieldController">
                            <option value="">@L.T("studio.tpl_ctrl_always",_culture)</option>
                        </select>
                    </label>
                    <label>@L.T("studio.tpl_when_label",_culture)
                        <input type="text" id="newFieldWhenValues" placeholder="@L.T("studio.tpl_when_ph",_culture)" />
                    </label>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 0.5rem;">
                    <label style="font-size: 0.85rem;">
                        <input type="checkbox" id="newFieldRequired" checked /> @L.T("studio.tpl_required_check",_culture)
                    </label>
                    <button type="button" id="addFieldBtn" class="button button-quiet" style="font-size: 0.85rem;">
                        @L.T("studio.tpl_include_btn",_culture)
                    </button>
                </div>
            </div>

            <h4>@L.T("studio.tpl_registered_h",_culture)</h4>
            <div id="fieldsList" style="display: flex; flex-direction: column; gap: 0.5rem; max-height: 250px; overflow-y: auto; padding-right: 0.25rem;">
                <!-- Preenchido via script -->
            </div>

            <textarea asp-for="FieldsJson" id="fieldsJsonInput" style="display: none;"></textarea>
        </div>

        @* Coluna da Direita: Conteúdo Estruturado / Editor *@
        <div class="card" style="display: flex; flex-direction: column;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                <h3 style="margin: 0;">@L.T("studio.tpl_content_h",_culture)</h3>
                <span class="badge badge-muted">@L.T("studio.tpl_legal_design",_culture)</span>
            </div>
            <p class="muted" style="font-size: 0.875rem;">
                @L.T("studio.tpl_content_p",_culture)
            </p>
            <div id="editorLossBanner" class="error" role="alert" style="display:none; font-size: 0.85rem; margin-bottom: 0.75rem;"></div>

            <label style="font-weight: 600; font-size: 0.85rem; margin-bottom: 0.25rem;">
                @L.T("studio.tpl_texteditor_label",_culture)
            </label>
            <textarea id="textEditor" rows="14" style="width: 100%; font-family: monospace; font-size: 0.9rem; line-height: 1.4; padding: 0.75rem; border-radius: 4px; border: 1px solid #cbd5e1;"></textarea>

            <textarea asp-for="ContentJson" id="contentJsonInput" style="display: none;"></textarea>
        </div>
    </div>

    @* Barra de Ações *@
    <div class="button-row" style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #e2e8f0; padding-top: 1rem;">
        <a class="button button-quiet" asp-action="Index" asp-route-tenantId="@tenantId">
            @L.T("action.cancel",_culture)
        </a>

        <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
            <button type="submit" class="button button-quiet" id="copyEditable" formaction="@Url.Action("CopyEditableTemplate", "Studio", new { tenantId })">@L.T("studio.tpl_copy_editable",_culture)</button>
            @if (!isNew && !isPublished && !isArchived)
            {
                <button type="submit" class="button button-primary">
                    @L.T("studio.tpl_save_draft",_culture)
                </button>
            }
            else if (isNew)
            {
                <button type="submit" class="button button-primary">
                    @L.T("studio.tpl_create_draft",_culture)
                </button>
            }

            @if (!isNew && !isPublished && !isArchived)
            {
                <button type="submit" formaction="@Url.Action("PublishTemplate", "Studio", new { tenantId, templateId = Model.TemplateId })" class="button" style="background: #059669; color: #fff;" onclick="return confirm(window.OdcaI18n.t('studio.tpl_publish_confirm'));">
                    @L.T("studio.tpl_publish",_culture)
                </button>
            }
            @if (!isNew && isPublished)
            {
                <label class="field-label" for="archiveReason" style="display:inline-flex;align-items:center;gap:0.4rem;">@L.T("studio.tpl_archive_reason",_culture)<input id="archiveReason" name="reason" required minlength="5" maxlength="500" placeholder="@L.T("studio.tpl_archive_reason_placeholder",_culture)" /></label>
                <button type="submit" formaction="@Url.Action("ArchiveTemplate", "Studio", new { tenantId, templateId = Model.TemplateId })" class="button button-quiet" style="color: #dc2626;" onclick="return confirm(window.OdcaI18n.t('studio.tpl_archive_confirm'));">
                    @L.T("studio.tpl_archive",_culture)
                </button>
            }
            @if (!isNew && isArchived)
            {
                <span class="muted" style="font-size: 0.85rem;">@L.T("studio.tpl_archived_note",_culture)</span>
            }
        </div>
    </div>
</form>

<script type="module">
    import { collectEditorLosses, convertTextToStructuredJson, structuredJsonToText } from '@Url.Content("~/js/template-editor-document.js")';
    const t = window.OdcaI18n ? window.OdcaI18n.t : ((k) => k);
    let fieldsData = [];
    try {
        const raw = document.getElementById('fieldsJsonInput').value;
        fieldsData = JSON.parse(raw || '[]');
    } catch(e) {
        fieldsData = [];
    }

    function renderFieldsList() {
        const list = document.getElementById('fieldsList');
        list.replaceChildren();
        if (fieldsData.length === 0) {
            const p = document.createElement('p');
            p.className = 'muted';
            p.style.fontSize = '0.85rem';
            p.textContent = t('studio.tpl_no_fields');
            list.appendChild(p);
            return;
        }

        fieldsData.forEach((f, idx) => {
            const item = document.createElement('div');
            item.style.cssText = 'display: flex; justify-content: space-between; align-items: center; background: #fff; padding: 0.5rem 0.75rem; border: 1px solid #e2e8f0; border-radius: 4px;';
            
            const infoDiv = document.createElement('div');
            const strong = document.createElement('strong');
            strong.textContent = f.label || f.id;
            infoDiv.appendChild(strong);

            infoDiv.appendChild(document.createTextNode(' '));

            const code = document.createElement('code');
            code.style.cssText = 'font-size: 0.75rem; background: #e0f2fe; padding: 2px 4px; border-radius: 3px; color: #0369a1;';
            code.textContent = `{{${f.id}}}`;
            infoDiv.appendChild(code);

            const span = document.createElement('span');
            span.style.cssText = 'font-size: 0.75rem; color: #64748b; margin-left: 0.5rem;';
            const originLabel = { organization: t('studio.tpl_chip_org'), patient: t('studio.origin_patient'), contractor: t('studio.tpl_chip_con'), representative: t('studio.origin_representative'), manual: t('studio.tpl_chip_manual') };
            const origin = f.origin || f.Origin || "manual";
            const property = f.sourceProperty || f.SourceProperty;
            const controller = f.requiredWhenFieldId || f.RequiredWhenFieldId;
            const whenValues = f.requiredWhenAnyOf || f.RequiredWhenAnyOf || [];
            const condition = controller ? t('studio.tpl_condition', controller, whenValues.join(t('studio.tpl_or_separator').trim())) : "";
            const help = f.help || f.Help || "";
            span.textContent = `[${f.type}${f.required ? t('studio.tpl_required_tag') : ""}, ${originLabel[origin] || origin}${property ? " · " + property : ""}${condition}${help ? t('studio.tpl_help_prefix') + help : ""}]`;
            infoDiv.appendChild(span);

            item.appendChild(infoDiv);

            const btnDiv = document.createElement('div');
            btnDiv.style.cssText = 'display: flex; gap: 0.25rem;';

            const insertBtn = document.createElement('button');
            insertBtn.type = 'button';
            insertBtn.className = 'button button-quiet';
            insertBtn.style.cssText = 'padding: 2px 6px; font-size: 0.75rem;';
            insertBtn.textContent = t('studio.tpl_insert_btn');
            insertBtn.title = t('studio.tpl_insert_title');
            insertBtn.addEventListener('click', () => insertFieldToken(f.id));
            btnDiv.appendChild(insertBtn);

            const removeBtn = document.createElement('button');
            removeBtn.type = 'button';
            removeBtn.className = 'button button-quiet';
            removeBtn.style.cssText = 'padding: 2px 6px; font-size: 0.75rem; color: #ef4444;';
            removeBtn.textContent = '×';
            removeBtn.title = t('studio.tpl_remove_title');
            removeBtn.addEventListener('click', () => removeField(idx));
            btnDiv.appendChild(removeBtn);

            item.appendChild(btnDiv);
            list.appendChild(item);
        });

        document.getElementById('fieldsJsonInput').value = JSON.stringify(fieldsData);
        if (typeof refreshControllers === "function") refreshControllers();
    }

    function slugify(text) {
        return text
            .normalize("NFD").replace(/[\u0300-\u036f]/g, "")
            .toLowerCase()
            .replace(/[^a-z0-9_.-]/g, "_")
            .replace(/^_+|_+$/g, "")
            .replace(/__+/g, "_")
            .substring(0, 50);
    }

    const labelInput = document.getElementById('newFieldLabel');
    const idInput = document.getElementById('newFieldId');
    let idManuallyEdited = false;
    idInput.addEventListener('input', () => { idManuallyEdited = Boolean(idInput.value.trim()); });
    labelInput.addEventListener('input', () => {
        if (!idManuallyEdited) {
            let slug = slugify(labelInput.value);
            if (slug && !/^[a-zA-Z]/.test(slug)) slug = 'f_' + slug;
            idInput.value = slug;
        }
    });

    const propertyCatalog = {
        patient: [["fullName", t('studio.fl_full_name')], ["preferredName", t('studio.fl_preferred_name')], ["birthDate", t('studio.fl_birth_date')], ["identifierValue", t('studio.fl_id_value')], ["identifierType", t('studio.fl_id_type')], ["email", t('studio.fl_email')], ["phone", t('studio.fl_phone')], ["address", t('studio.fl_address')]],
        organization: [["displayName", t('studio.fl_full_name')], ["businessCode", t('studio.fl_id_value')]],
        representative: [["fullName", t('studio.fl_full_name')], ["identifierValue", t('studio.fl_id_value')], ["relationship", t('studio.tpl_relacao')]],
        contractor: [["fullName", t('studio.fl_full_name')], ["identifierValue", t('studio.fl_id_value')], ["email", t('studio.fl_email')], ["phone", t('studio.fl_phone')], ["address", t('studio.fl_address')]]
    };
    const originInput = document.getElementById('newFieldOrigin');
    const propertyInput = document.getElementById('newFieldProperty');
    const controllerInput = document.getElementById('newFieldController');
    const refreshPropertyChoices = () => {
        const origin = originInput.value;
        propertyInput.replaceChildren(new Option(origin === "manual" ? t('studio.tpl_manual_no_property') : t('studio.tpl_select_property'), ""));
        for (const [value, label] of propertyCatalog[origin] || []) propertyInput.append(new Option(label, value));
        propertyInput.disabled = origin === "manual";
    };
    const refreshControllers = () => {
        const current = controllerInput.value;
        controllerInput.replaceChildren(new Option(t('studio.tpl_ctrl_always'), ""));
        for (const field of fieldsData) controllerInput.append(new Option(field.label || field.id, field.id));
        if ([...controllerInput.options].some(option => option.value === current)) controllerInput.value = current;
    };
    originInput.addEventListener("change", refreshPropertyChoices);
    refreshPropertyChoices();

    const addFieldBtn = document.getElementById('addFieldBtn');
    if (addFieldBtn) addFieldBtn.addEventListener('click', addNewField);

    function addNewField() {
        const typeInput = document.getElementById('newFieldType');
        const choicesInput = document.getElementById('newFieldChoices');
        const reqInput = document.getElementById('newFieldRequired');

        const rawId = (idInput.value || '').trim();
        const label = (labelInput.value || '').trim() || rawId;
        let id = rawId || slugify(label);
        if (id && !/^[a-zA-Z]/.test(id)) id = 'f_' + id;

        const type = typeInput.value;
        const required = reqInput.checked;
        const rawChoices = (choicesInput.value || '').split(',').map(s => s.trim()).filter(Boolean);

        if (!id) {
            alert(t('studio.tpl_alert_no_id'));
            return;
        }

        if (fieldsData.some(f => f.id === id)) {
            alert(t('studio.tpl_alert_dup_id'));
            return;
        }

        const origin = document.getElementById('newFieldOrigin').value || 'manual';
        const property = document.getElementById('newFieldProperty').value;
        const controller = document.getElementById('newFieldController').value;
        const whenValues = (document.getElementById('newFieldWhenValues').value || '').split(',').map(item => item.trim()).filter(Boolean);
        if (origin !== 'manual' && !property) {
            alert(t('studio.tpl_alert_property'));
            return;
        }
        if (controller === id) {
            alert(t('studio.tpl_alert_self'));
            return;
        }
        if (controller && whenValues.length === 0) {
            alert(t('studio.tpl_alert_when_values'));
            return;
        }
        const helpInput = document.getElementById('newFieldHelp');
        const help = (helpInput.value || '').trim();
        const newF = {
            id: id,
            label: label,
            type: type,
            required: required,
            origin: origin
        };
        if (property) newF.sourceProperty = property;
        if (controller) {
            newF.requiredWhenFieldId = controller;
            newF.requiredWhenAnyOf = whenValues;
        }
        if (type === 'Choice' && rawChoices.length > 0) {
            newF.choices = rawChoices;
        }
        if (help) newF.help = help;

        fieldsData.push(newF);
        fieldsDirty = true;
        idInput.value = '';
        labelInput.value = '';
        choicesInput.value = '';
        helpInput.value = '';
        idManuallyEdited = false;
        renderFieldsList();
    }

    function removeField(index) {
        fieldsData.splice(index, 1);
        fieldsDirty = true;
        renderFieldsList();
    }

    function insertFieldToken(fieldId) {
        const editor = document.getElementById('textEditor');
        const token = `{{${fieldId}}}`;
        const startPos = editor.selectionStart;
        const endPos = editor.selectionEnd;
        editor.value = editor.value.substring(0, startPos) + token + editor.value.substring(endPos, editor.value.length);
        editor.selectionStart = startPos + token.length;
        editor.selectionEnd = startPos + token.length;
        editor.focus();
    }

    let baselineText = '';
    let originalContentRaw = '';
    let originalFieldsRaw = '';
    let fieldsDirty = false;
    (function initEditor() {
        originalContentRaw = document.getElementById('contentJsonInput').value;
        originalFieldsRaw = document.getElementById('fieldsJsonInput').value;
        renderFieldsList();
        try {
            const parsed = JSON.parse(originalContentRaw || '{}');
            if (parsed.content && Array.isArray(parsed.content)) {
                document.getElementById('textEditor').value = structuredJsonToText(parsed);
            }
            const issues = collectEditorLosses(parsed);
            if (issues.length > 0) {
                const banner = document.getElementById('editorLossBanner');
                banner.innerHTML = '<strong>' + t('studio.tpl_editor_limited_title') + '</strong> ' + t('studio.tpl_editor_limited_mid') + '<ul style="margin:0.25rem 0 0 1.1rem; padding:0;">' +
                    issues.map(i => `<li>${i}</li>`).join('') +
                    '</ul> ' + t('studio.tpl_editor_limited_close');
                banner.style.display = 'block';
            }
        } catch(e) {
            console.error('Erro ao inicializar texto do modelo:', e);
        }
        baselineText = document.getElementById('textEditor').value;

        document.getElementById('templateForm').addEventListener('submit', function(e) {
            refreshControllers();
            const text = document.getElementById('textEditor').value;
            const copying = e.submitter && e.submitter.id === "copyEditable";
            let originalOk = false;
            let issues = [];
            try {
                const parsed = JSON.parse(originalContentRaw || '{}');
                originalOk = Boolean(parsed) && Array.isArray(parsed.content);
                issues = collectEditorLosses(parsed);
            } catch (_) { /* conteúdo original inválido: a cópia ou a conversão compatível segue */ }

            if ((text === baselineText && originalOk) || (!copying && issues.length > 0 && text !== baselineText && originalOk)) {
                if (!copying && issues.length > 0 && text !== baselineText) {
                    e.preventDefault();
                    const banner = document.getElementById('editorLossBanner');
                    banner.style.display = 'block';
                    banner.textContent = t('studio.tpl_blocked_submit');
                    return;
                }
                document.getElementById('contentJsonInput').value = originalContentRaw;
            } else {
                document.getElementById('contentJsonInput').value = JSON.stringify(convertTextToStructuredJson(text));
            }

            document.getElementById('fieldsJsonInput').value = fieldsDirty ? JSON.stringify(fieldsData) : originalFieldsRaw;
        });
    })();
</script>
