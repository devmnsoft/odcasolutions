@model Odca.Web.Models.TemplateEditViewModel
@{
    var isNew = Model.IsNew;
    var tenantId = Model.TenantId;
    var isPublished = string.Equals(Model.Status, "published", StringComparison.OrdinalIgnoreCase);
}

<section class="page-heading">
    <div>
        <p class="eyebrow">Estúdio de Documentos · Gestão de Modelos</p>
        <h1>@(isNew ? "Criar Novo Modelo" : $"Editar Modelo: {Model.Name}")</h1>
        <p class="muted">
            Configure o conteúdo estruturado, insira campos variáveis assistidos e publique para disponibilização na organização.
        </p>
    </div>
    <div class="button-row">
        <a class="button button-quiet" asp-action="Index" asp-route-tenantId="@tenantId">
            ← Voltar ao Catálogo
        </a>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="error" role="alert">
        <strong>Atenção:</strong> @Model.ErrorMessage
    </div>
}
@if (TempData["StudioSuccess"] is string successMsg)
{
    <div class="success" role="status">
        @successMsg
    </div>
}
@if (TempData["StudioError"] is string errorMsg)
{
    <div class="error" role="alert">
        @errorMsg
    </div>
}

<form method="post" asp-action="@(isNew ? "CreateTemplate" : "SaveTemplate")" asp-route-tenantId="@tenantId" asp-route-templateId="@Model.TemplateId" id="templateForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="TenantId" />
    <input type="hidden" asp-for="TemplateId" />
    <input type="hidden" asp-for="Version" />
    <input type="hidden" asp-for="RowVersion" />
    <input type="hidden" asp-for="Status" />

    <div class="card" style="margin-bottom: 1.5rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <h2 style="margin: 0;">Identificação do Modelo</h2>
            <div>
                <span class="badge @(isPublished ? "badge-success" : "badge-muted")">
                    Status: @(isPublished ? "Publicado" : "Rascunho")
                </span>
                <span class="badge">Versão: @Model.Version</span>
            </div>
        </div>

        <div class="form-grid" style="grid-template-columns: 2fr 1fr 1fr; gap: 1rem;">
            <label style="display: block;">
                <strong>Nome do Modelo *</strong>
                <input asp-for="Name" required maxlength="160" placeholder="Ex: Contrato de Múltiplas Terapias" style="width: 100%;" />
            </label>
            <label style="display: block;">
                <strong>Tipo Contratual</strong>
                <select asp-for="ContractType" style="width: 100%;">
                    <option value="services">Prestação de serviços</option>
                    <option value="nda">Confidencialidade (NDA)</option>
                    <option value="amendment">Aditivo</option>
                    <option value="supply">Fornecimento</option>
                    <option value="lease">Locação</option>
                </select>
            </label>
            <label style="display: block;">
                <strong>Escopo</strong>
                <select asp-for="Scope" style="width: 100%;">
                    <option value="private">Particular (exclusivo desta org)</option>
                    <option value="consultancy">Consultoria</option>
                </select>
            </label>
        </div>

        <label style="display: block; margin-top: 1rem;">
            <strong>Descrição e Finalidade</strong>
            <textarea asp-for="Description" rows="2" placeholder="Resumo do escopo deste modelo para orientação da equipe..." style="width: 100%;"></textarea>
        </label>
    </div>

    @* Painel de Campos Variáveis e Conteúdo *@
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
        @* Coluna da Esquerda: Assistente de Campos Variáveis *@
        <div class="card">
            <h3>Campos Variáveis do Modelo</h3>
            <p class="muted" style="font-size: 0.875rem;">
                Defina os campos dinâmicos (paciente, valores, terapias, datas) que serão preenchidos pelo operador.
            </p>

            <div style="background: #f8fafc; padding: 1rem; border-radius: 6px; border: 1px solid #e2e8f0; margin-bottom: 1rem;">
                <h4 style="margin-top: 0; font-size: 0.95rem;">+ Adicionar Novo Campo</h4>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; margin-bottom: 0.5rem;">
                    <div>
                        <label style="font-size: 0.8rem; font-weight: 600;">Identificador (ex: contractor_name):</label>
                        <input type="text" id="newFieldId" placeholder="identificador_unico" style="width: 100%; font-size: 0.85rem;" />
                    </div>
                    <div>
                        <label style="font-size: 0.8rem; font-weight: 600;">Rótulo exibido:</label>
                        <input type="text" id="newFieldLabel" placeholder="Nome Completo" style="width: 100%; font-size: 0.85rem;" />
                    </div>
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; margin-bottom: 0.5rem;">
                    <div>
                        <label style="font-size: 0.8rem; font-weight: 600;">Tipo de Dado:</label>
                        <select id="newFieldType" style="width: 100%; font-size: 0.85rem;">
                            <option value="ShortText">Texto Curto</option>
                            <option value="LongText">Texto Longo</option>
                            <option value="BrazilianDocument">CPF ou CNPJ</option>
                            <option value="Currency">Moeda (R$)</option>
                            <option value="Date">Data</option>
                            <option value="Number">Número</option>
                            <option value="Choice">Seleção de Opções</option>
                        </select>
                    </div>
                    <div>
                        <label style="font-size: 0.8rem; font-weight: 600;">Opções (separadas por vírgula):</label>
                        <input type="text" id="newFieldChoices" placeholder="Opção 1, Opção 2" style="width: 100%; font-size: 0.85rem;" />
                    </div>
                </div>
                <div style="margin-bottom: 0.5rem;">
                    <label style="font-size: 0.8rem; font-weight: 600;">Origem do preenchimento:</label>
                    <select id="newFieldOrigin" style="width: 100%; font-size: 0.85rem;">
                        <option value="manual">Entrada manual</option>
                        <option value="organization">Organização/clínica</option>
                        <option value="patient">Paciente</option>
                        <option value="contractor">Contratante/responsável financeiro</option>
                        <option value="representative">Representante</option>
                    </select>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 0.5rem;">
                    <label style="font-size: 0.85rem;">
                        <input type="checkbox" id="newFieldRequired" checked /> Campo Obrigatório
                    </label>
                    <button type="button" class="button button-quiet" style="font-size: 0.85rem;" onclick="addNewField()">
                        + Incluir Campo
                    </button>
                </div>
            </div>

            <h4>Campos Cadastrados:</h4>
            <div id="fieldsList" style="display: flex; flex-direction: column; gap: 0.5rem; max-height: 250px; overflow-y: auto; padding-right: 0.25rem;">
                <!-- Preenchido via script -->
            </div>

            <textarea asp-for="FieldsJson" id="fieldsJsonInput" style="display: none;"></textarea>
        </div>

        @* Coluna da Direita: Conteúdo Estruturado / Editor *@
        <div class="card" style="display: flex; flex-direction: column;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                <h3 style="margin: 0;">Conteúdo Estruturado do Modelo</h3>
                <span class="badge badge-muted">Legal Design</span>
            </div>
            <p class="muted" style="font-size: 0.875rem;">
                Texto das cláusulas e termos do documento. Clique em um campo à esquerda para inseri-lo no texto.
            </p>
            <div id="editorLossBanner" class="error" role="alert" style="display:none; font-size: 0.85rem; margin-bottom: 0.75rem;"></div>

            <label style="font-weight: 600; font-size: 0.85rem; margin-bottom: 0.25rem;">
                Texto Simples com Marcadores (ex: Use {{identificador_do_campo}} para variáveis):
            </label>
            <textarea id="textEditor" rows="14" style="width: 100%; font-family: monospace; font-size: 0.9rem; line-height: 1.4; padding: 0.75rem; border-radius: 4px; border: 1px solid #cbd5e1;"></textarea>

            <textarea asp-for="ContentJson" id="contentJsonInput" style="display: none;"></textarea>
        </div>
    </div>

    @* Barra de Ações *@
    <div class="button-row" style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #e2e8f0; padding-top: 1rem;">
        <a class="button button-quiet" asp-action="Index" asp-route-tenantId="@tenantId">
            Cancelar
        </a>

        <div style="display: flex; gap: 0.75rem;">
            @if (!isNew && !isPublished)
            {
                <button type="submit" class="button button-primary">
                    💾 Salvar Rascunho
                </button>
            }
            else if (isNew)
            {
                <button type="submit" class="button button-primary">
                    Criar Modelo como Rascunho →
                </button>
            }

            @if (!isNew && !isPublished)
            {
                <button type="submit" formaction="@Url.Action("PublishTemplate", "Studio", new { tenantId, templateId = Model.TemplateId })" class="button" style="background: #059669; color: #fff;" onclick="return confirm('Deseja publicar este modelo? Modelos publicados ficam imediatamente disponíveis para a equipe gerar documentos.');">
                    ✓ Publicar Modelo
                </button>
            }
            @if (!isNew && isPublished)
            {
                <button type="submit" formaction="@Url.Action("ArchiveTemplate", "Studio", new { tenantId, templateId = Model.TemplateId })" class="button button-quiet" style="color: #dc2626;" onclick="return confirm('Deseja arquivar este modelo?');">
                    Arquivar Modelo
                </button>
            }
        </div>
    </div>
</form>

<script>
    let fieldsData = [];
    try {
        const raw = document.getElementById('fieldsJsonInput').value;
        fieldsData = JSON.parse(raw || '[]');
    } catch(e) {
        fieldsData = [];
    }

    function renderFieldsList() {
        const list = document.getElementById('fieldsList');
        list.replaceChildren();
        if (fieldsData.length === 0) {
            const p = document.createElement('p');
            p.className = 'muted';
            p.style.fontSize = '0.85rem';
            p.textContent = 'Nenhum campo variável configurado.';
            list.appendChild(p);
            return;
        }

        fieldsData.forEach((f, idx) => {
            const item = document.createElement('div');
            item.style.cssText = 'display: flex; justify-content: space-between; align-items: center; background: #fff; padding: 0.5rem 0.75rem; border: 1px solid #e2e8f0; border-radius: 4px;';
            
            const infoDiv = document.createElement('div');
            const strong = document.createElement('strong');
            strong.textContent = f.label || f.id;
            infoDiv.appendChild(strong);

            infoDiv.appendChild(document.createTextNode(' '));

            const code = document.createElement('code');
            code.style.cssText = 'font-size: 0.75rem; background: #e0f2fe; padding: 2px 4px; border-radius: 3px; color: #0369a1;';
            code.textContent = `{{${f.id}}}`;
            infoDiv.appendChild(code);

            const span = document.createElement('span');
            span.style.cssText = 'font-size: 0.75rem; color: #64748b; margin-left: 0.5rem;';
            const originLabel = { organization: "Organização", patient: "Paciente", contractor: "Contratante", representative: "Representante", manual: "Manual" };
            const origin = f.origin || f.Origin;
            span.textContent = `[${f.type}${f.required ? ", Obrigatório" : ""}${origin ? ", " + (originLabel[origin] || origin) : ""}]`;
            infoDiv.appendChild(span);

            item.appendChild(infoDiv);

            const btnDiv = document.createElement('div');
            btnDiv.style.cssText = 'display: flex; gap: 0.25rem;';

            const insertBtn = document.createElement('button');
            insertBtn.type = 'button';
            insertBtn.className = 'button button-quiet';
            insertBtn.style.cssText = 'padding: 2px 6px; font-size: 0.75rem;';
            insertBtn.textContent = 'Inserir';
            insertBtn.title = 'Inserir no cursor do texto';
            insertBtn.addEventListener('click', () => insertFieldToken(f.id));
            btnDiv.appendChild(insertBtn);

            const removeBtn = document.createElement('button');
            removeBtn.type = 'button';
            removeBtn.className = 'button button-quiet';
            removeBtn.style.cssText = 'padding: 2px 6px; font-size: 0.75rem; color: #ef4444;';
            removeBtn.textContent = '×';
            removeBtn.title = 'Remover campo';
            removeBtn.addEventListener('click', () => removeField(idx));
            btnDiv.appendChild(removeBtn);

            item.appendChild(btnDiv);
            list.appendChild(item);
        });

        document.getElementById('fieldsJsonInput').value = JSON.stringify(fieldsData);
    }

    function slugify(text) {
        return text
            .normalize("NFD").replace(/[\u0300-\u036f]/g, "")
            .toLowerCase()
            .replace(/[^a-z0-9_.-]/g, "_")
            .replace(/^_+|_+$/g, "")
            .replace(/__+/g, "_")
            .substring(0, 50);
    }

    const labelInput = document.getElementById('newFieldLabel');
    const idInput = document.getElementById('newFieldId');
    let idManuallyEdited = false;
    idInput.addEventListener('input', () => { idManuallyEdited = Boolean(idInput.value.trim()); });
    labelInput.addEventListener('input', () => {
        if (!idManuallyEdited) {
            let slug = slugify(labelInput.value);
            if (slug && !/^[a-zA-Z]/.test(slug)) slug = 'f_' + slug;
            idInput.value = slug;
        }
    });

    function addNewField() {
        const typeInput = document.getElementById('newFieldType');
        const choicesInput = document.getElementById('newFieldChoices');
        const reqInput = document.getElementById('newFieldRequired');

        const rawId = (idInput.value || '').trim();
        const label = (labelInput.value || '').trim() || rawId;
        let id = rawId || slugify(label);
        if (id && !/^[a-zA-Z]/.test(id)) id = 'f_' + id;

        const type = typeInput.value;
        const required = reqInput.checked;
        const rawChoices = (choicesInput.value || '').split(',').map(s => s.trim()).filter(Boolean);

        if (!id) {
            alert('Informe o identificador ou rótulo do campo.');
            return;
        }

        if (fieldsData.some(f => f.id === id)) {
            alert('Já existe um campo com este identificador.');
            return;
        }

        const newF = {
            id: id,
            label: label,
            type: type,
            required: required,
            origin: document.getElementById('newFieldOrigin').value || 'manual'
        };
        if (type === 'Choice' && rawChoices.length > 0) {
            newF.choices = rawChoices;
        }

        fieldsData.push(newF);
        fieldsDirty = true;
        idInput.value = '';
        labelInput.value = '';
        choicesInput.value = '';
        idManuallyEdited = false;
        renderFieldsList();
    }

    function removeField(index) {
        fieldsData.splice(index, 1);
        fieldsDirty = true;
        renderFieldsList();
    }

    function insertFieldToken(fieldId) {
        const editor = document.getElementById('textEditor');
        const token = `{{${fieldId}}}`;
        const startPos = editor.selectionStart;
        const endPos = editor.selectionEnd;
        editor.value = editor.value.substring(0, startPos) + token + editor.value.substring(endPos, editor.value.length);
        editor.selectionStart = startPos + token.length;
        editor.selectionEnd = startPos + token.length;
        editor.focus();
    }

    function extractInlineText(node) {
        if (!node) return '';
        if (node.type === 'text') {
            let txt = node.text || '';
            const marks = node.marks || [];
            if (marks.includes('bold')) txt = `**${txt}**`;
            if (marks.includes('italic')) txt = `*${txt}*`;
            if (marks.includes('underline')) txt = `<u>${txt}</u>`;
            return txt;
        }
        if (node.type === 'field') {
            return `{{${node.fieldId}}}`;
        }
        if (node.content && Array.isArray(node.content)) {
            return node.content.map(extractInlineText).join('');
        }
        return '';
    }

    function structuredJsonToText(doc) {
        if (!doc || !doc.content || !Array.isArray(doc.content)) return '';
        const blocks = [];
        for (const node of doc.content) {
            if (node.type === 'heading') {
                const prefix = '#'.repeat(node.level || 1);
                blocks.push(`${prefix} ${extractInlineText(node)}`);
            } else if (node.type === 'pageBreak') {
                blocks.push('---');
            } else if (node.type === 'bulletList') {
                const items = (node.content || []).map(item => `- ${extractInlineText(item)}`);
                blocks.push(items.join('\n'));
            } else if (node.type === 'orderedList') {
                const items = (node.content || []).map((item, idx) => `${idx + 1}. ${extractInlineText(item)}`);
                blocks.push(items.join('\n'));
            } else if (node.type === 'table') {
                const rows = [];
                for (const row of (node.content || [])) {
                    if (row.type === 'tableRow') {
                        const cells = (row.content || []).map(cell => extractInlineText(cell).trim());
                        rows.push(`| ${cells.join(' | ')} |`);
                    }
                }
                blocks.push(rows.join('\n'));
            } else if (node.type === 'paragraph') {
                blocks.push(extractInlineText(node));
            } else {
                blocks.push(extractInlineText(node));
            }
        }
        return blocks.join('\n\n');
    }

    function parseInlineContent(text) {
        const result = [];
        const regex = /\{\{([a-zA-Z0-9_.-]+)\}\}|\*\*([^*]+)\*\*|\*([^*]+)\*|<u>(.*?)<\/u>/g;
        let lastIndex = 0;
        let match;

        while ((match = regex.exec(text)) !== null) {
            if (match.index > lastIndex) {
                result.push({ type: "text", text: text.substring(lastIndex, match.index) });
            }
            if (match[1] !== undefined) {
                result.push({ type: "field", fieldId: match[1] });
            } else if (match[2] !== undefined) {
                result.push({ type: "text", text: match[2], marks: ["bold"] });
            } else if (match[3] !== undefined) {
                result.push({ type: "text", text: match[3], marks: ["italic"] });
            } else if (match[4] !== undefined) {
                result.push({ type: "text", text: match[4], marks: ["underline"] });
            }
            lastIndex = regex.lastIndex;
        }

        if (lastIndex < text.length) {
            result.push({ type: "text", text: text.substring(lastIndex) });
        }

        if (result.length === 0) {
            result.push({ type: "text", text: "" });
        }

        return result;
    }

    function convertTextToStructuredJson(text) {
        const rawBlocks = text.split(/\n\s*\n/).map(b => b.trim()).filter(Boolean);
        const contentNodes = [];

        for (const block of rawBlocks) {
            if (block === '---' || block === '===' || block === '[QUEBRA_DE_PAGINA]') {
                contentNodes.push({ type: "pageBreak" });
                continue;
            }

            const lines = block.split('\n').map(l => l.trim()).filter(Boolean);

            if (lines.length > 0 && lines.every(l => l.startsWith('|') && l.endsWith('|'))) {
                const tableRows = [];
                for (const line of lines) {
                    if (/^\|[\s\-:|]+\|$/.test(line)) continue;
                    const cellTexts = line.slice(1, -1).split('|').map(c => c.trim());
                    const cells = cellTexts.map(cText => ({
                        type: "tableCell",
                        content: [{ type: "paragraph", alignment: "justify", content: parseInlineContent(cText) }]
                    }));
                    tableRows.push({ type: "tableRow", content: cells });
                }
                if (tableRows.length > 0) {
                    contentNodes.push({ type: "table", content: tableRows });
                    continue;
                }
            }

            if (lines.length > 0 && lines.every(l => l.startsWith('- ') || l.startsWith('* '))) {
                const listItems = lines.map(line => ({
                    type: "listItem",
                    content: [{ type: "paragraph", alignment: "justify", content: parseInlineContent(line.replace(/^[-*]\s+/, '')) }]
                }));
                contentNodes.push({ type: "bulletList", content: listItems });
                continue;
            }

            if (lines.length > 0 && lines.every(l => /^\d+\.\s+/.test(l))) {
                const listItems = lines.map(line => ({
                    type: "listItem",
                    content: [{ type: "paragraph", alignment: "justify", content: parseInlineContent(line.replace(/^\d+\.\s+/, '')) }]
                }));
                contentNodes.push({ type: "orderedList", content: listItems });
                continue;
            }

            const headingMatch = block.match(/^(#{1,3})\s+(.*)$/s);
            if (headingMatch) {
                const level = headingMatch[1].length;
                const hText = headingMatch[2].trim();
                contentNodes.push({
                    type: "heading",
                    level: level,
                    content: parseInlineContent(hText)
                });
                continue;
            }

            contentNodes.push({
                type: "paragraph",
                alignment: "justify",
                content: parseInlineContent(lines.join(' '))
            });
        }

        return {
            type: "document",
            content: contentNodes
        };
    }

    function findEditorLosses(doc, issues) {
        if (!doc || !Array.isArray(doc.content)) return;
        const scanInline = (nodes) => {
            for (const node of (nodes || [])) {
                if (!node) continue;
                if (node.type === 'text') {
                    const txt = node.text || '';
                    if (txt.includes('*')) issues.add('texto contém "*" que o editor pode reinterpretar como negrito/itálico');
                    if (txt.includes('<u>')) issues.add('texto contém "<u>" que o editor reinterpretará como sublinhado');
                }
                if (Array.isArray(node.content)) scanInline(node.content);
            }
        };
        const checkBlock = (node) => {
            if (!node || !['paragraph', 'tableCell', 'listItem', 'heading'].includes(node.type)) return;
            if (node.alignment !== 'justify') issues.add('alinhamentos diferentes de "justificado" serão substituídos por justificado');
            if (node.type === 'tableCell' && Array.isArray(node.content) && node.content.length > 1)
                issues.add('células de tabela com mais de um bloco interno');
            scanInline(node.content);
        };
        for (const node of doc.content) {
            if (!node) continue;
            checkBlock(node);
            if (node.type === 'bulletList' || node.type === 'orderedList') {
                for (const item of (node.content || [])) checkBlock(item);
            }
        }
    }

    let baselineText = '';
    let originalContentRaw = '';
    let originalFieldsRaw = '';
    let fieldsDirty = false;
    let acknowledgedLossy = false;

    (function initEditor() {
        originalContentRaw = document.getElementById('contentJsonInput').value;
        originalFieldsRaw = document.getElementById('fieldsJsonInput').value;
        renderFieldsList();
        try {
            const parsed = JSON.parse(originalContentRaw || '{}');
            if (parsed.content && Array.isArray(parsed.content)) {
                document.getElementById('textEditor').value = structuredJsonToText(parsed);
            }
            const issues = new Set();
            findEditorLosses(parsed, issues);
            if (issues.size > 0) {
                const banner = document.getElementById('editorLossBanner');
                banner.innerHTML = '<strong>Editor limitado:</strong> este modelo usa recursos que o editor de texto simples não preserva exatamente: <ul style="margin:0.25rem 0 0 1.1rem; padding:0;">' +
                    [...issues].map(i => `<li>${i}</li>`).join('') +
                    '</ul> Sem alterações no texto, o conteúdo original é mantido intacto; ao editar, será pedido seu aceite antes de normalizar.';
                banner.style.display = 'block';
            }
        } catch(e) {
            console.error('Erro ao inicializar texto do modelo:', e);
        }
        baselineText = document.getElementById('textEditor').value;

        document.getElementById('templateForm').addEventListener('submit', function(e) {
            const text = document.getElementById('textEditor').value;
            let originalOk = false;
            try {
                const parsed = JSON.parse(originalContentRaw || '{}');
                originalOk = Boolean(parsed) && Array.isArray(parsed.content);
            } catch (_) { /* conteúdo original inválido: segue pela conversão do editor */ }

            if (text === baselineText && originalOk) {
                // Texto inalterado: preserva o conteúdo persistido sem reprocessamento destrutivo.
                document.getElementById('contentJsonInput').value = originalContentRaw;
            } else {
                let issues = [];
                try {
                    const issuesSet = new Set();
                    findEditorLosses(JSON.parse(originalContentRaw || '{}'), issuesSet);
                    issues = [...issuesSet];
                } catch (_) { }
                if (issues.length > 0 && !acknowledgedLossy) {
                    const message = ['O editor de texto simples não preserva exatamente os recursos deste modelo:', ...issues.map(i => '• ' + i), '', 'Ao continuar, o conteúdo será normalizado pelo editor. Deseja continuar?'].join('\n');
                    if (!window.confirm(message)) { e.preventDefault(); return; }
                    acknowledgedLossy = true;
                }
                const structuredDoc = convertTextToStructuredJson(text);
                document.getElementById('contentJsonInput').value = JSON.stringify(structuredDoc);
            }

            document.getElementById('fieldsJsonInput').value = fieldsDirty ? JSON.stringify(fieldsData) : originalFieldsRaw;
        });
    })();
</script>
