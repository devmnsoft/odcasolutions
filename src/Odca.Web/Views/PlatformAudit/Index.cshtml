@model Odca.Web.Models.PlatformAuditListViewModel
@using System.Globalization
@using System.Text.Json
@functions {
    static string ResultLabel(string result) => result switch
    {
        "success" => "Sucesso",
        "denied" => "Negado",
        "failed" => "Falhou",
        _ => result
    };

    static string ResultClass(string result) => result switch
    {
        "success" => "status-badge status-approved",
        "denied" => "status-badge status-pending",
        "failed" => "status-badge status-rejected",
        _ => "status-badge"
    };

    static string FormatMetadata(JsonElement metadata)
    {
        if (metadata.ValueKind != JsonValueKind.Object && metadata.ValueKind != JsonValueKind.Array)
        {
            return string.Empty;
        }
        string text = metadata.GetRawText();
        return text.Trim() == "{}" ? string.Empty : JsonSerializer.Serialize(metadata, new JsonSerializerOptions { WriteIndented = true });
    }
}
@{
    ViewData["Title"] = "Auditoria da plataforma";
    var ptBr = CultureInfo.GetCultureInfo("pt-BR");
    var current = Model.Page.Page;
    var pageSize = Model.PageSize;
    var total = Model.Page.Total;
    var totalPages = total == 0 ? 1 : (total + pageSize - 1) / pageSize;
    var firstItem = total == 0 ? 0 : (current - 1) * pageSize + 1;
    var lastItem = Math.Min(current * pageSize, total);
}
<nav class="breadcrumb" aria-label="Navegação estrutural">
    <a asp-controller="Home" asp-action="Index">Visão global</a><span aria-hidden="true">/</span><span>Auditoria da plataforma</span>
</nav>
<header class="page-heading">
    <div>
        <p class="eyebrow">Administração global</p>
        <h1>Auditoria da plataforma</h1>
        <p>Eventos importantes registrados pela plataforma, com filtros, paginação e metadados preservados. Esta leitura não altera nada.</p>
    </div>
    <a class="button button-primary" asp-controller="Home" asp-action="Index">Voltar ao painel</a>
</header>
<details class="filter-panel" open>
    <summary>Filtros</summary>
    <form method="get" class="inline-filter">
        <label>Busca<input type="search" name="search" value="@Model.Search" placeholder="Ação, entidade ou nome (ex.: identity.login.succeeded)" /></label>
        <label>Organização<select name="tenantId"><option value="">Todas as organizações</option>@foreach(var tenant in Model.TenantOptions){<option value="@tenant.TenantId" selected="@(Model.TenantId == tenant.TenantId)">@tenant.Name</option>}</select></label>
        <label>Por página<select name="pageSize"><option value="10" selected="@(Model.PageSize == 10)">10</option><option value="25" selected="@(Model.PageSize == 25)">25</option><option value="50" selected="@(Model.PageSize == 50)">50</option><option value="100" selected="@(Model.PageSize == 100)">100</option></select></label>
        <button class="button button-primary">Pesquisar</button>
        <a class="button button-quiet" asp-action="Index">Limpar</a>
    </form>
</details>
@if (Model.TenantOptionsFailed)
{
    <div class="alert alert-error" role="alert">Não foi possível carregar a lista de organizações para o filtro. A tabela abaixo reflete a consulta executada.</div>
}
<div class="responsive-table panel">
    <table>
        <thead><tr><th>Data/hora</th><th>Organização</th><th>Ação</th><th>Entidade</th><th>Usuário</th><th>Resultado</th><th>Detalhes</th></tr></thead>
        <tbody>
            @foreach(var entry in Model.Page.Items)
            {
                var organization = string.IsNullOrWhiteSpace(entry.TenantName) ? "Plataforma" : entry.TenantName;
                var entity = string.IsNullOrEmpty(entry.EntityType) ? "—" : $"{entry.EntityType}{(entry.EntityId is null ? string.Empty : $" ({entry.EntityId})")}";
                var user = string.IsNullOrWhiteSpace(entry.ActorName) ? "—" : entry.ActorName;
                var metadata = FormatMetadata(entry.Metadata);
                <tr>
                    <td data-label="Data/hora" style="white-space:nowrap">@entry.OccurredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm", ptBr)</td>
                    <td data-label="Organização">@organization</td>
                    <td data-label="Ação">@entry.Action</td>
                    <td data-label="Entidade"><small>@entity</small></td>
                    <td data-label="Usuário">@user</td>
                    <td data-label="Resultado"><span class="@ResultClass(entry.Result)">@ResultLabel(entry.Result)</span></td>
                    <td data-label="Detalhes">@if(string.IsNullOrEmpty(metadata)){<span aria-hidden="true">—</span>}else{<details><summary>Metadados</summary><pre>@metadata</pre></details>}</td>
                </tr>
            }
            @if (Model.Page.Items.Count == 0)
            {
                <tr><td colspan="7"><div class="empty-state"><strong>Nenhum evento encontrado</strong><p>Ajuste a busca ou os filtros para ampliar a consulta.</p></div></td></tr>
            }
        </tbody>
    </table>
</div>
<p class="muted">Mostrando @(firstItem.ToString(ptBr))–@(lastItem.ToString(ptBr)) de @total.ToString(ptBr) eventos.</p>
@if (totalPages > 1)
{
    <nav class="pagination" aria-label="Paginação da auditoria">
        @if (current > 1)
        {
            <a class="button button-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-tenantId="@Model.TenantId" asp-route-pageSize="@pageSize" asp-route-page="@(current - 1)">Anterior</a>
        }
        <span>Página @current.ToString(ptBr) de @totalPages.ToString(ptBr)</span>
        @if (current < totalPages)
        {
            <a class="button button-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-tenantId="@Model.TenantId" asp-route-pageSize="@pageSize" asp-route-page="@(current + 1)">Próxima</a>
        }
    </nav>
}
<details class="help-card"><summary>Como usar</summary><p>A busca cobre ação, tipo de entidade, organização e usuário (sem diferenciar maiúsculas). O resultado exibe o estado registrado no momento do evento; nenhum dado é alterado por esta consulta.</p></details>
