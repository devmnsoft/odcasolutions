@model Odca.Web.Models.PlatformAuditListViewModel
@using System.Text.Json
@functions {
    static string ResultClass(string result) => result switch
    {
        "success" => "status-badge status-approved",
        "denied" => "status-badge status-pending",
        "failed" => "status-badge status-rejected",
        _ => "status-badge"
    };

    static string FormatMetadata(JsonElement metadata)
    {
        if (metadata.ValueKind != JsonValueKind.Object && metadata.ValueKind != JsonValueKind.Array)
        {
            return string.Empty;
        }
        string text = metadata.GetRawText();
        return text.Trim() == "{}" ? string.Empty : JsonSerializer.Serialize(metadata, new JsonSerializerOptions { WriteIndented = true });
    }
}
@{
    var _c = (string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey];
    ViewData["Title"] = L.T("platform.audit_title", _c);
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var current = Model.Page.Page;
    var pageSize = Model.PageSize;
    var total = Model.Page.Total;
    var totalPages = total == 0 ? 1 : (total + pageSize - 1) / pageSize;
    var firstItem = total == 0 ? 0 : (current - 1) * pageSize + 1;
    var lastItem = Math.Min(current * pageSize, total);
    string ResultLabel(string result) => result switch
    {
        "success" => L.T("platform.audit_r_success", _c),
        "denied" => L.T("platform.audit_r_denied", _c),
        "failed" => L.T("platform.audit_r_failed", _c),
        _ => result
    };
}
<nav class="breadcrumb" aria-label="Navegação estrutural">
    <a asp-controller="Home" asp-action="Index">@L.T("visao-global",_c)</a><span aria-hidden="true">/</span><span>@L.T("platform.audit_title",_c)</span>
</nav>
<header class="page-heading">
    <div>
        <p class="eyebrow">@L.T("support.eyebrow",_c)</p>
        <h1>@L.T("platform.audit_title",_c)</h1>
        <p>@L.T("platform.audit_intro",_c)</p>
    </div>
    <a class="button button-primary" asp-controller="Home" asp-action="Index">@L.T("support.back_panel",_c)</a>
</header>
<details class="filter-panel" open>
    <summary>@L.T("common.filters",_c)</summary>
    <form method="get" class="inline-filter">
        <label>@L.T("common.search",_c)<input type="search" name="search" value="@Model.Search" placeholder="@L.T("platform.audit_search_ph",_c)" /></label>
        <label>@L.T("organizacao",_c)<select name="tenantId"><option value="">@L.T("platform.audit_all_orgs",_c)</option>@foreach(var tenant in Model.TenantOptions){<option value="@tenant.TenantId" selected="@(Model.TenantId == tenant.TenantId)">@tenant.Name</option>}</select></label>
        <label>@L.T("platform.audit_per_page",_c)<select name="pageSize"><option value="10" selected="@(Model.PageSize == 10)">10</option><option value="25" selected="@(Model.PageSize == 25)">25</option><option value="50" selected="@(Model.PageSize == 50)">50</option><option value="100" selected="@(Model.PageSize == 100)">100</option></select></label>
        <button class="button button-primary">@L.T("studio.cat_search_label",_c)</button>
        <a class="button button-quiet" asp-action="Index">@L.T("common.clear",_c)</a>
    </form>
</details>
@if (Model.TenantOptionsFailed)
{
    <div class="alert alert-error" role="alert">@L.T("platform.audit_tenants_error",_c)</div>
}
<div class="responsive-table panel">
    <table>
        <thead><tr><th>@L.T("platform.audit_th_datetime",_c)</th><th>@L.T("organizacao",_c)</th><th>@L.T("dash.th_action",_c)</th><th>@L.T("dash.th_entity",_c)</th><th>@L.T("dash.th_user",_c)</th><th>@L.T("dash.th_result",_c)</th><th>@L.T("common.details",_c)</th></tr></thead>
        <tbody>
            @foreach(var entry in Model.Page.Items)
            {
                var organization = string.IsNullOrWhiteSpace(entry.TenantName) ? L.T("layout.platform",_c) : entry.TenantName;
                var entity = string.IsNullOrEmpty(entry.EntityType) ? "—" : $"{entry.EntityType}{(entry.EntityId is null ? string.Empty : $" ({entry.EntityId})")}";
                var user = string.IsNullOrWhiteSpace(entry.ActorName) ? "—" : entry.ActorName;
                var metadata = FormatMetadata(entry.Metadata);
                <tr>
                    <td data-label="@L.T("platform.audit_th_datetime",_c)" style="white-space:nowrap">@CulturedTime.DateTime(entry.OccurredAt.ToLocalTime(),_c)</td>
                    <td data-label="@L.T("organizacao",_c)">@organization</td>
                    <td data-label="@L.T("dash.th_action",_c)">@entry.Action</td>
                    <td data-label="@L.T("dash.th_entity",_c)"><small>@entity</small></td>
                    <td data-label="@L.T("dash.th_user",_c)">@user</td>
                    <td data-label="@L.T("dash.th_result",_c)"><span class="@ResultClass(entry.Result)">@ResultLabel(entry.Result)</span></td>
                    <td data-label="@L.T("common.details",_c)">@if(string.IsNullOrEmpty(metadata)){<span aria-hidden="true">—</span>}else{<details><summary>@L.T("platform.audit_metadata",_c)</summary><pre>@metadata</pre></details>}</td>
                </tr>
            }
            @if (Model.Page.Items.Count == 0)
            {
                <tr><td colspan="7"><div class="empty-state"><strong>@L.T("platform.audit_empty_t",_c)</strong><p>@L.T("platform.audit_empty_b",_c)</p></div></td></tr>
            }
        </tbody>
    </table>
</div>
<p class="muted">@L.T("platform.audit_showing",_c,firstItem.ToString(inv),lastItem.ToString(inv),total.ToString(inv))</p>
@if (totalPages > 1)
{
    <nav class="pagination" aria-label="@L.T("common.pagination_aria",_c)">
        @if (current > 1)
        {
            <a class="button button-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-tenantId="@Model.TenantId" asp-route-pageSize="@pageSize" asp-route-page="@(current - 1)">@L.T("common.prev",_c)</a>
        }
        <span>@L.T("platform.audit_page",_c,current.ToString(inv),totalPages.ToString(inv))</span>
        @if (current < totalPages)
        {
            <a class="button button-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-tenantId="@Model.TenantId" asp-route-pageSize="@pageSize" asp-route-page="@(current + 1)">@L.T("common.next",_c)</a>
        }
    </nav>
}
<details class="help-card"><summary>@L.T("common.how_to_use",_c)</summary><p>@L.T("platform.audit_help_body",_c)</p></details>
