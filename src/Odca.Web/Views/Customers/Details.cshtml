@model Odca.Contracts.Consumption.PlatformCustomerDetail
@functions { static string Bytes(long v)=>v>=1073741824?$"{v/1073741824d:0.##} GB":$"{v/1048576d:0.##} MB"; }
@{ViewData["Title"]=$"Cliente · {Model.Summary.OrganizationName}";var s=Model.Summary;}
<nav class="breadcrumb"><a asp-action="Index">Clientes</a><span>/</span><span>@s.OrganizationName</span></nav><div class="tenant-banner"><span>Cliente selecionado</span><strong>@s.OrganizationName</strong><small>As ações abaixo afetam este tenant e registram o administrador real.</small></div>
<header class="page-heading"><div><h1>@s.OrganizationName</h1><p>@s.PlanName v@s.PlanVersion · @s.SubscriptionStatus</p></div><a href="#conceder" class="button button-primary">Conceder adicional</a></header>
@if(TempData["Success"] is string ok){<div class="alert alert-success">✓ @ok</div>}@if(TempData["Error"] is string err){<div class="alert alert-error">! @err</div>}
<section class="panel" id="plano"><h2>Plano e versão contratada</h2><p>A organização permanece vinculada à versão já contratada até esta confirmação. Editar o catálogo não altera este contrato. A mudança não apaga pacientes, documentos nem histórico e não registra pagamento.</p>@if(ViewData["PlansError"] is string plansError){<div class="alert alert-error" role="alert">@plansError</div>}else if(ViewData["Plans"] is Odca.Contracts.Plans.PlanCatalogResponse[] plans){<form asp-action="PreviewPlan" asp-route-tenantId="@s.TenantId" method="post" class="form-stack">@Html.AntiForgeryToken()<label>Plano vigente<select name="planCode" required><option value="">Selecione pelo nome</option>@foreach(var plan in plans){<option value="@plan.Code" selected="@(ViewData["PlanCode"] as string==plan.Code)">@plan.DisplayName · versão @plan.Version</option>}</select></label><label>Justificativa<input name="justification" minlength="5" maxlength="500" required value="@ViewData["PlanJustification"]"/><small>O motivo fica na auditoria, entre 5 e 500 caracteres.</small></label><button class="button" type="submit">Analisar impacto</button></form>}@if(ViewData["PlanPreview"] is Odca.Contracts.Tenancy.PlanChangePreviewResponse preview){<div class="confirmation-box" role="status"><strong>Resumo de impacto</strong><p>De @preview.CurrentCode v@preview.CurrentVersion para @preview.TargetCode v@preview.TargetVersion.</p><p>Pessoas ativas: @preview.ActiveMembers. Convites que reservam vaga: @preview.ReservedInvitations. Limite atual: @preview.CurrentSeatLimit. Limite novo: @preview.TargetSeatLimit.</p><p>@(preview.SeatsOverLimit?"O consumo de vagas fica acima do novo limite. A política keep_members_and_documents preserva as pessoas e bloqueia novas vagas; ninguém é escolhido para bloqueio.":"As vagas atuais cabem no novo limite.")</p><p>Pacientes preservados: @preview.PatientCount. Documentos preservados: @preview.DocumentCount.</p><p>@preview.BillingLimitation</p><form asp-action="ApplyPlan" asp-route-tenantId="@s.TenantId" method="post" id="confirm-plan-change">@Html.AntiForgeryToken()<input type="hidden" name="planCode" value="@preview.TargetCode"/><input type="hidden" name="justification" value="@ViewData["PlanJustification"]"/><button class="button button-primary" type="button" data-confirm-open data-confirm-form="confirm-plan-change" data-confirm-title="Confirmar alteração de plano" data-confirm-body="A versão contratada será substituída. Pacientes, documentos e histórico permanecem. Nenhum pagamento será registrado." data-confirm-action="Confirmar alteração">Confirmar alteração</button></form></div>}</section>
<section class="metric-grid"><article class="metric-card"><span>Usuários</span><strong>@s.ActiveUsers / @s.ContractedSeats</strong><small>@s.ReservedInvitations convite(s)</small></article><article class="metric-card"><span>Contratado</span><strong>@Bytes(s.ContractedStorageBytes)</strong></article><article class="metric-card"><span>Adicional</span><strong>@Bytes(s.AdditionalStorageBytes)</strong></article><article class="metric-card"><span>Usado + reservado</span><strong>@Bytes(s.UsedStorageBytes+s.ReservedStorageBytes)</strong></article></section>
<section class="panel" id="funcionalidades"><h2>Funcionalidades da organização</h2><p>O bloqueio administrativo vale na interface, na API e no processamento de importações. Ele não muda o plano, não quita cobrança e não apaga documentos.</p>@if(ViewData["FeaturesError"] is string featureError){<div class="alert alert-error" role="alert"><strong>Falha na consulta.</strong> @featureError</div>}else if(ViewData["Features"] is Odca.Contracts.Administration.OrganizationFeatureCatalogResponse catalog){<p>Situação administrativa da organização: <strong>@catalog.TenantStatus</strong>.</p><div class="responsive-table"><table><thead><tr><th>Funcionalidade</th><th>Situação</th><th>Motivo</th><th>Decisão</th></tr></thead><tbody>@foreach(var feature in catalog.Features){<tr><td>@feature.DisplayName</td><td>@(feature.State switch{"administratively_blocked"=>"Bloqueada pela administração","plan_restricted"=>"Não contratado","quota_exhausted"=>"Limite atingido","allowed"=>"Disponível",_=>feature.State})</td><td>@(feature.Reason??(feature.PlanEntitlement is null?"—":$"Plano: {feature.PlanEntitlement}"))</td><td>@if(feature.State=="administratively_blocked"){<form asp-action="SetFeature" asp-route-tenantId="@s.TenantId" asp-route-featureCode="@feature.FeatureCode" method="post">@Html.AntiForgeryToken()<input type="hidden" name="blocked" value="false"/><label>Justificativa da liberação<input name="reason" minlength="5" maxlength="500" required/></label><button class="button button-primary" type="submit">Liberar</button></form>}else{<form asp-action="SetFeature" asp-route-tenantId="@s.TenantId" asp-route-featureCode="@feature.FeatureCode" method="post">@Html.AntiForgeryToken()<input type="hidden" name="blocked" value="true"/><label>Justificativa do bloqueio<input name="reason" minlength="5" maxlength="500" required/></label><button class="button button-danger" type="submit">Bloquear</button></form>}</td></tr>}</tbody></table></div>}else{<div class="empty-state"><p>Nenhuma funcionalidade foi retornada. Isso não distingue, sozinho, falha de consulta de ausência de bloqueio.</p></div>}</section>
<section class="panel controlled-state"><h2>Situação da organização</h2><p>Estado atual: <strong>@s.TenantStatus</strong>. Esta ação não altera vínculos, bloqueios individuais, situação comercial ou documentos históricos.</p><form asp-action="ChangeStatus" asp-route-tenantId="@s.TenantId" method="post" class="form-stack">@Html.AntiForgeryToken()<input type="hidden" name="restore" value="@((s.TenantStatus=="suspended").ToString().ToLowerInvariant())"/><label>Justificativa<input name="reason" minlength="5" maxlength="2000" required/></label><button class="button @(s.TenantStatus=="suspended"?"button-primary":"button-danger")" type="submit" @(s.TenantStatus is not ("active" or "suspended")?"disabled":null)>@(s.TenantStatus=="suspended"?"Restaurar organização":"Suspender organização")</button></form></section>
<section class="panel"><h2>Solicitações</h2>@foreach(var r in Model.Requests){<article class="request-review"><div><span class="status-badge status-@r.Status">@r.Status</span><h3>@r.PackageName · @Bytes(r.TotalBytes)</h3><p>@r.RequestedBy · @r.RequestedAt.ToString("dd/MM/yyyy HH:mm")</p><small>@r.Terms</small></div>@if(r.Status=="pending"){<div class="decision-actions"><form asp-action="Decide" asp-route-tenantId="@s.TenantId" asp-route-requestId="@r.Id" method="post">@Html.AntiForgeryToken()<input type="hidden" name="decision" value="approved"/><button class="button button-primary">Aprovar e conceder</button></form><form asp-action="Decide" asp-route-tenantId="@s.TenantId" asp-route-requestId="@r.Id" method="post">@Html.AntiForgeryToken()<input type="hidden" name="decision" value="rejected"/><label>Motivo da rejeição<input name="reason" maxlength="2000" required/></label><button class="button button-danger">Rejeitar</button></form></div>}</article>}</section>
<section class="panel" id="conceder"><h2>Concessão manual</h2><form asp-action="Grant" asp-route-tenantId="@s.TenantId" method="post" class="form-stack">@Html.AntiForgeryToken()<input type="hidden" name="idempotencyKey" value="@Guid.NewGuid()"/><div style="display:flex;gap:1rem;align-items:flex-end;"><label style="flex:2;">Quantidade<input type="number" name="quantity" min="1" max="1000" step="any" required placeholder="Ex.: 10"/></label><label style="flex:1;">Unidade<select name="unit" required><option value="GB" selected>GB (Gigabytes)</option><option value="MB">MB (Megabytes)</option><option value="TB">TB (Terabytes)</option></select></label></div><label>Justificativa<input name="reason" minlength="5" maxlength="2000" required/></label><div class="confirmation-box">Esta é uma concessão comercial manual, não confirmação de pagamento. A movimentação é imutável e auditada.</div><button class="button button-primary">Confirmar concessão</button></form></section>
<section class="panel"><h2>Auditoria e movimentações</h2><ol class="timeline">@foreach(var e in s.History){<li><span></span><div><strong>@e.Type · @e.Resource</strong><p>@e.Quantity @e.Unit · @e.ActorName</p><small>@e.OccurredAt.ToString("dd/MM/yyyy HH:mm") · @e.Reason</small></div></li>}</ol></section><details class="help-card"><summary>Como usar</summary><p>Aprovação é serializada no banco e concede capacidade uma única vez. Rejeições e concessões manuais exigem justificativa e preservam o ator.</p></details>
