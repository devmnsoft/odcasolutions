@model Odca.Contracts.Consumption.PlatformCustomerDetail
@functions { static string Bytes(long v)=>v>=1073741824?$"{v/1073741824d:0.##} GB":$"{v/1048576d:0.##} MB"; }
@{var _c=(string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey];ViewData["Title"]=L.T("cust.detail_title",_c,Model.Summary.OrganizationName);var s=Model.Summary;}
<nav class="breadcrumb" aria-label="@L.T("common.breadcrumb_aria",_c)"><a asp-action="Index">@L.T("cust.area",_c)</a><span>/</span><span aria-current="page">@s.OrganizationName</span></nav><div class="tenant-banner"><span>@L.T("cust.selected",_c)</span><strong>@s.OrganizationName</strong><small>@L.T("cust.selected_note",_c)</small></div>
<header class="page-heading"><div><h1>@s.OrganizationName</h1><p>@($"{s.PlanName} v{s.PlanVersion}") · @StatusLabels.Status(s.SubscriptionStatus,k=>L.T(k,_c))</p></div><a href="#conceder" class="button button-primary">@L.T("cust.btn_grant",_c)</a></header>
@if(TempData["Success"] is string ok){<div class="alert alert-success">✓ @ok</div>}@if(TempData["Error"] is string err){<div class="alert alert-error">! @err</div>}
<section class="panel" id="plano"><h2>@L.T("cust.plan_h",_c)</h2><p>@L.T("cust.plan_p",_c)</p>@if(ViewData["PlansError"] is string plansError){<div class="alert alert-error" role="alert">@plansError</div>}else if(ViewData["Plans"] is Odca.Contracts.Plans.PlanCatalogResponse[] plans){<form asp-action="PreviewPlan" asp-route-tenantId="@s.TenantId" method="post" class="form-stack">@Html.AntiForgeryToken()<label>@L.T("cust.plan_current_label",_c)<select name="planCode" required><option value="">@L.T("cust.plan_select_option",_c)</option>@foreach(var plan in plans){<option value="@plan.Code" selected="@(ViewData["PlanCode"] as string==plan.Code)">@plan.DisplayName · @L.T("studio.ver_lower_version",_c) @plan.Version</option>}</select></label><label>@L.T("cust.justification",_c)<input name="justification" minlength="5" maxlength="500" required value="@ViewData["PlanJustification"]"/><small>@L.T("cust.plan_just_note",_c)</small></label><button class="button" type="submit">@L.T("cust.btn_analyze_impact",_c)</button></form>}@if(ViewData["PlanPreview"] is Odca.Contracts.Tenancy.PlanChangePreviewResponse preview){<div class="confirmation-box" role="status"><strong>@L.T("cust.preview_title",_c)</strong><p>@L.T("cust.preview_change",_c,preview.CurrentCode,preview.CurrentVersion.ToString(System.Globalization.CultureInfo.InvariantCulture),preview.TargetCode,preview.TargetVersion.ToString(System.Globalization.CultureInfo.InvariantCulture))</p><p>@L.T("cust.preview_limits",_c,preview.ActiveMembers.ToString(System.Globalization.CultureInfo.InvariantCulture),preview.ReservedInvitations.ToString(System.Globalization.CultureInfo.InvariantCulture),preview.CurrentSeatLimit.ToString(System.Globalization.CultureInfo.InvariantCulture),preview.TargetSeatLimit.ToString(System.Globalization.CultureInfo.InvariantCulture))</p><p>@(preview.SeatsOverLimit?L.T("cust.preview_over_limit",_c):L.T("cust.preview_within_limit",_c))</p><p>@L.T("cust.preview_preserved",_c,preview.PatientCount.ToString(System.Globalization.CultureInfo.InvariantCulture),preview.DocumentCount.ToString(System.Globalization.CultureInfo.InvariantCulture))</p><p>@preview.BillingLimitation</p><form asp-action="ApplyPlan" asp-route-tenantId="@s.TenantId" method="post" id="confirm-plan-change">@Html.AntiForgeryToken()<input type="hidden" name="planCode" value="@preview.TargetCode"/><input type="hidden" name="justification" value="@ViewData["PlanJustification"]"/><button class="button button-primary" type="button" data-confirm-open data-confirm-form="confirm-plan-change" data-confirm-title="@L.T("cust.confirm_plan_title",_c)" data-confirm-body="@L.T("cust.confirm_plan_body",_c)" data-confirm-action="@L.T("cust.confirm_plan_action",_c)">@L.T("cust.confirm_plan_action",_c)</button></form></div>}</section>
<section class="metric-grid"><article class="metric-card"><span>@L.T("cust.th_users",_c)</span><strong>@s.ActiveUsers / @s.ContractedSeats</strong><small>@L.T("cust.invitations_count",_c,s.ReservedInvitations.ToString(System.Globalization.CultureInfo.InvariantCulture))</small></article><article class="metric-card"><span>@L.T("cust.m_contracted",_c)</span><strong>@Bytes(s.ContractedStorageBytes)</strong></article><article class="metric-card"><span>@L.T("cust.m_additional",_c)</span><strong>@Bytes(s.AdditionalStorageBytes)</strong></article><article class="metric-card"><span>@L.T("cust.m_used_reserved",_c)</span><strong>@Bytes(s.UsedStorageBytes+s.ReservedStorageBytes)</strong></article></section>
<section class="panel" id="funcionalidades"><h2>@L.T("cust.features_h",_c)</h2><p>@L.T("cust.features_p",_c)</p>@if(ViewData["FeaturesError"] is string featureError){<div class="alert alert-error" role="alert"><strong>@L.T("cust.features_err_prefix",_c)</strong> @featureError</div>}else if(ViewData["Features"] is Odca.Contracts.Administration.OrganizationFeatureCatalogResponse catalog){<p>@L.T("cust.features_status_intro",_c)<strong>@StatusLabels.Status(catalog.TenantStatus,k=>L.T(k,_c))</strong>.</p><div class="responsive-table"><table><thead><tr><th>@L.T("cust.feat_th_feature",_c)</th><th>@L.T("common.situation",_c)</th><th>@L.T("common.reason",_c)</th><th>@L.T("admin.decision",_c)</th></tr></thead><tbody>@foreach(var feature in catalog.Features){<tr><td>@feature.DisplayName</td><td>@(feature.State switch{"administratively_blocked"=>L.T("cust.feat_blocked",_c),"plan_restricted"=>L.T("org.ps_unsubscribed",_c),"quota_exhausted"=>L.T("org.ps_quota",_c),"allowed"=>L.T("org.ps_ready",_c),_=>feature.State})</td><td>@(feature.Reason??(feature.PlanEntitlement is null?"—":L.T("cust.feat_reason_plan",_c,feature.PlanEntitlement)))</td><td>@if(feature.State=="administratively_blocked"){<form asp-action="SetFeature" asp-route-tenantId="@s.TenantId" asp-route-featureCode="@feature.FeatureCode" method="post">@Html.AntiForgeryToken()<input type="hidden" name="blocked" value="false"/><label>@L.T("cust.feat_unlock_reason",_c)<input name="reason" minlength="5" maxlength="500" required/></label><button class="button button-primary" type="submit">@L.T("cust.feat_btn_unlock",_c)</button></form>}else{<form asp-action="SetFeature" asp-route-tenantId="@s.TenantId" asp-route-featureCode="@feature.FeatureCode" method="post">@Html.AntiForgeryToken()<input type="hidden" name="blocked" value="true"/><label>@L.T("cust.feat_block_reason",_c)<input name="reason" minlength="5" maxlength="500" required/></label><button class="button button-danger" type="submit">@L.T("cust.feat_btn_block",_c)</button></form>}</td></tr>}</tbody></table></div>}else{<div class="empty-state"><p>@L.T("cust.features_empty",_c)</p></div>}</section>
<section class="panel controlled-state"><h2>@L.T("cust.status_h",_c)</h2><p>@L.T("cust.status_admin_label",_c)<strong>@StatusLabels.Status(s.TenantStatus,k=>L.T(k,_c))</strong>. @L.T("cust.status_commercial_label",_c)<strong>@StatusLabels.Commercial(s.CommercialState,k=>L.T(k,_c))</strong>. @L.T("cust.status_note",_c)</p><form asp-action="ChangeStatus" asp-route-tenantId="@s.TenantId" method="post" class="form-stack">@Html.AntiForgeryToken()<input type="hidden" name="restore" value="@((s.TenantStatus=="suspended").ToString().ToLowerInvariant())"/><label>@L.T("cust.justification",_c)<input name="reason" minlength="5" maxlength="2000" required/></label><button class="button @(s.TenantStatus=="suspended"?"button-primary":"button-danger")" type="submit" @(s.TenantStatus is not ("active" or "suspended")?"disabled":null)>@(s.TenantStatus=="suspended"?L.T("cust.btn_restore_org",_c):L.T("cust.btn_suspend_org",_c))</button></form></section>
<section class="panel"><h2>@L.T("usage.requests_h",_c)</h2>@foreach(var r in Model.Requests){<article class="request-review"><div><span class="status-badge status-@r.Status">@r.Status</span><h3>@r.PackageName · @Bytes(r.TotalBytes)</h3><p>@r.RequestedBy · @CulturedTime.DateTime(r.RequestedAt,_c)</p><small>@r.Terms</small></div>@if(r.Status=="pending"){<div class="decision-actions"><form asp-action="Decide" asp-route-tenantId="@s.TenantId" asp-route-requestId="@r.Id" method="post">@Html.AntiForgeryToken()<input type="hidden" name="decision" value="approved"/><button class="button button-primary">@L.T("cust.btn_approve_grant",_c)</button></form><form asp-action="Decide" asp-route-tenantId="@s.TenantId" asp-route-requestId="@r.Id" method="post">@Html.AntiForgeryToken()<input type="hidden" name="decision" value="rejected"/><label>@L.T("cust.reject_reason",_c)<input name="reason" maxlength="2000" required/></label><button class="button button-danger">@L.T("cust.btn_reject",_c)</button></form></div>}</article>}</section>
<section class="panel" id="conceder"><h2>@L.T("cust.grant_h",_c)</h2><form asp-action="Grant" asp-route-tenantId="@s.TenantId" method="post" class="form-stack">@Html.AntiForgeryToken()<input type="hidden" name="idempotencyKey" value="@Guid.NewGuid()"/><div style="display:flex;gap:1rem;align-items:flex-end;"><label style="flex:2;">@L.T("cust.grant_quantity",_c)<input type="number" name="quantity" min="1" max="1000" step="any" required placeholder="@L.T("cust.grant_qty_ph",_c)"/></label><label style="flex:1;">@L.T("cust.grant_unit",_c)<select name="unit" required><option value="GB" selected>@L.T("cust.unit_gb",_c)</option><option value="MB">@L.T("cust.unit_mb",_c)</option><option value="TB">@L.T("cust.unit_tb",_c)</option></select></label></div><label>@L.T("cust.justification",_c)<input name="reason" minlength="5" maxlength="2000" required/></label><div class="confirmation-box">@L.T("cust.grant_note",_c)</div><button class="button button-primary">@L.T("cust.grant_btn",_c)</button></form></section>
<section class="panel"><h2>@L.T("usage.credits_h",_c)</h2><dl class="usage-breakdown">@foreach(var credit in s.ConsumableCredits){<div><dt>@(credit.Resource=="ocr_pages_monthly"?L.T("usage.res_ocr",_c):L.T("usage.res_signature",_c))</dt><dd>@L.T("usage.credit_line",_c,credit.Contracted.ToString(System.Globalization.CultureInfo.InvariantCulture),credit.Consumed.ToString(System.Globalization.CultureInfo.InvariantCulture),credit.Reserved.ToString(System.Globalization.CultureInfo.InvariantCulture),credit.Available.ToString(System.Globalization.CultureInfo.InvariantCulture))</dd></div>}</dl><p class="muted">@L.T("usage.credits_note_admin",_c)</p></section>
<section class="panel"><h2>@L.T("cust.history_h",_c)</h2><ol class="timeline">@foreach(var e in s.History){<li><span></span><div><strong>@e.Type · @e.Resource</strong><p>@e.Quantity @e.Unit · @e.ActorName</p><small>@CulturedTime.DateTime(e.OccurredAt,_c) · @e.Reason</small></div></li>}</ol></section><details class="help-card"><summary>@L.T("common.how_to_use",_c)</summary><p>@L.T("cust.help_detail",_c)</p></details>
