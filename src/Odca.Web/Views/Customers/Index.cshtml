@model Odca.Web.Models.CustomerListViewModel
@functions { static string Bytes(long v)=>v>=1073741824?$"{v/1073741824d:0.#} GB":$"{v/1048576d:0.#} MB"; }
@{var _c=(string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey];ViewData["Title"]=L.T("cust.title",_c);}
<nav class="breadcrumb" aria-label="@L.T("common.breadcrumb_aria",_c)"><a asp-controller="Home" asp-action="Index">@L.T("visao-global",_c)</a><span>/</span><span aria-current="page">@L.T("cust.area",_c)</span></nav><header class="page-heading"><div><p class="eyebrow">@L.T("support.eyebrow",_c)</p><h1>@L.T("cust.area",_c)</h1><p>@L.T("cust.index_sub",_c)</p></div><div class="button-row"><a class="button button-quiet" asp-action="Users">@L.T("localizar-usuarios",_c)</a><a class="button button-primary" asp-action="Create">@L.T("cust.btn_new",_c)</a></div></header>
<details class="filter-panel" open><summary>@L.T("common.filters",_c)</summary><form method="get" class="inline-filter"><label>@L.T("cust.filter_name_doc",_c)<input type="search" name="search" value="@Model.Search"/></label><label>@L.T("reg.lbl_plan",_c)<select name="plan"><option value="">@L.T("studio.cat_all",_c)</option><option value="basic" selected="@(Model.Plan=="basic")">@L.T("cust.plan_basic",_c)</option><option value="intermediate" selected="@(Model.Plan=="intermediate")">@L.T("reg.plan_intermediate",_c)</option><option value="enterprise" selected="@(Model.Plan=="enterprise")">Enterprise</option></select></label><label>@L.T("common.situation",_c)<select name="status"><option value="">@L.T("common.all",_c)</option><option value="active" selected="@(Model.Status=="active")">@L.T("org.orgst_active",_c)</option><option value="pending" selected="@(Model.Status=="pending")">@L.T("status.pending",_c)</option><option value="suspended" selected="@(Model.Status=="suspended")">@L.T("org.orgst_suspended",_c)</option></select></label><button class="button button-primary">@L.T("documents.filter_search",_c)</button></form></details>
<div class="responsive-table panel"><table><thead><tr><th>@L.T("cust.th_customer",_c)</th><th>@L.T("reg.lbl_plan",_c)</th><th>@L.T("common.situation",_c)</th><th>@L.T("cust.th_users",_c)</th><th>@L.T("cust.th_consumption",_c)</th><th>@L.T("cust.th_pending",_c)</th><th>@L.T("cust.th_activity",_c)</th><th></th></tr></thead><tbody>@foreach(var c in Model.Customers){<tr><td data-label="@L.T("cust.th_customer",_c)"><strong>@c.Name</strong><small>@c.MaskedDocument</small></td><td data-label="@L.T("reg.lbl_plan",_c)">@c.PlanName</td><td data-label="@L.T("common.situation",_c)"><span class="status-badge">@StatusLabels.Status(c.TenantStatus,k=>L.T(k,_c)) / @StatusLabels.Status(c.SubscriptionStatus,k=>L.T(k,_c))</span></td><td data-label="@L.T("cust.th_users",_c)">@c.ActiveUsers</td><td data-label="@L.T("cust.th_consumption",_c)">@Bytes(c.UsedBytes) / @Bytes(c.LimitBytes)<small>@L.T("cust.cell_usage",_c,c.OcrConsumed.ToString(System.Globalization.CultureInfo.InvariantCulture),c.OcrContracted.ToString(System.Globalization.CultureInfo.InvariantCulture),c.SignatureConsumed.ToString(System.Globalization.CultureInfo.InvariantCulture),c.SignatureContracted.ToString(System.Globalization.CultureInfo.InvariantCulture))</small></td><td data-label="@L.T("cust.th_pending",_c)">@c.PendingRequests</td><td data-label="@L.T("cust.th_activity",_c)">@(c.LastActivity is null?"—":CulturedTime.Date(c.LastActivity.Value,_c))</td><td><a class="button button-quiet" asp-action="Details" asp-route-tenantId="@c.TenantId">@L.T("cust.btn_analyze",_c)</a></td></tr>}</tbody></table></div>
<details class="help-card"><summary>@L.T("common.how_to_use",_c)</summary><p>@L.T("cust.index_help",_c)</p></details>
