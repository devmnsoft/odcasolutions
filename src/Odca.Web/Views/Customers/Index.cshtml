@model Odca.Web.Models.CustomerListViewModel
@functions { static string Bytes(long v)=>v>=1073741824?$"{v/1073741824d:0.#} GB":$"{v/1048576d:0.#} MB"; }
@{ViewData["Title"]="Administração de clientes";}
<nav class="breadcrumb"><a asp-controller="Home" asp-action="Index">Visão global</a><span>/</span><span>Clientes</span></nav><header class="page-heading"><div><p class="eyebrow">Administração global</p><h1>Clientes</h1><p>Consulte capacidade e pendências sem assumir a identidade do cliente.</p></div></header>
<details class="filter-panel" open><summary>Filtros</summary><form method="get" class="inline-filter"><label>Nome ou documento<input type="search" name="search" value="@Model.Search"/></label><button class="button button-primary">Pesquisar</button></form></details>
<div class="responsive-table panel"><table><thead><tr><th>Cliente</th><th>Plano</th><th>Situação</th><th>Usuários</th><th>Consumo</th><th>Pendências</th><th>Atividade</th><th></th></tr></thead><tbody>@foreach(var c in Model.Customers){<tr><td data-label="Cliente"><strong>@c.Name</strong><small>@c.MaskedDocument</small></td><td data-label="Plano">@c.PlanName</td><td data-label="Situação"><span class="status-badge">@c.TenantStatus / @c.SubscriptionStatus</span></td><td data-label="Usuários">@c.ActiveUsers</td><td data-label="Consumo">@Bytes(c.UsedBytes) / @Bytes(c.LimitBytes)</td><td data-label="Pendências">@c.PendingRequests</td><td data-label="Atividade">@(c.LastActivity?.ToString("dd/MM/yyyy")??"—")</td><td><a class="button button-quiet" asp-action="Details" asp-route-tenantId="@c.TenantId">Analisar</a></td></tr>}</tbody></table></div>
<details class="help-card"><summary>Como usar</summary><p>Pesquise o cliente, confirme o contexto destacado e abra os detalhes para decidir pedidos ou registrar uma concessão justificada.</p></details>
