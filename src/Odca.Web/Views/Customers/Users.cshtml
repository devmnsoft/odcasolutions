@model Odca.Web.Models.UserSearchViewModel
@{
    var _c = (string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey];
    ViewData["Title"] = L.T("localizar-usuarios", _c);
    string StatusLabel(string? value) => value switch { "active" => L.T("org.mem_active", _c), "blocked" => L.T("org.mem_blocked", _c), _ => value ?? "—" };
}
<nav class="breadcrumb" aria-label="@L.T("common.breadcrumb_aria",_c)"><a asp-action="Index">@L.T("cust.area",_c)</a><span>/</span><span aria-current="page">@L.T("localizar-usuarios",_c)</span></nav>
<header class="page-heading"><div><p class="eyebrow">@L.T("support.eyebrow",_c)</p><h1>@L.T("localizar-usuarios",_c)</h1><p>@L.T("cust.users_sub",_c)</p></div></header>
<form method="get" class="review-filters" aria-label="@L.T("common.search",_c)">
 <label>@L.T("action.search",_c)<input type="search" name="search" value="@Model.Search" placeholder="@L.T("cust.users_ph",_c)" /></label>
 <button class="button button-primary" type="submit">@L.T("documents.filter_search",_c)</button>
</form>
@if (Model.Users.Count == 0)
{
    <div class="empty-state">@if(string.IsNullOrWhiteSpace(Model.Search)){<p>@L.T("cust.users_empty_nofilter",_c)</p>;}else{<p>@L.T("cust.users_empty_nomatch",_c,Model.Search)</p>}</div>
}
else
{
    <div class="responsive-table panel"><table>
    <thead><tr><th>@L.T("cust.users_th_user",_c)</th><th>@L.T("cust.users_th_email",_c)</th><th>@L.T("cust.users_th_profile",_c)</th><th>@L.T("cust.users_th_links",_c)</th></tr></thead>
    <tbody>
    @foreach(var u in Model.Users)
    {
        <tr>
          <td data-label="@L.T("cust.users_th_user",_c)"><strong>@u.DisplayName</strong>@if(u.IsDeleted){<small style="display:block;color:var(--danger)">@L.T("cust.users_removed",_c)</small>}</td>
          <td data-label="@L.T("cust.users_th_email",_c)">@u.Email</td>
          <td data-label="@L.T("cust.users_th_profile",_c)">@(u.IsPlatformAdministrator ? L.T("cust.users_profile_platform",_c) : L.T("cust.users_profile_customer",_c))</td>
          <td data-label="@L.T("cust.users_th_links",_c)">
            @if(u.Links.Count == 0){<span>—</span>}
            else{<ul style="padding-left:1rem;margin:0">@foreach(var l in u.Links){<li>@(l.TenantName ?? L.T("common.org",_c)) — <span class="status-badge">@StatusLabel(l.MembershipStatus)</span>@if(!string.IsNullOrWhiteSpace(l.RoleCode)){<small> · @l.RoleCode</small>}</li>}</ul>}
          </td>
        </tr>
    }
    </tbody>
    </table></div>
    <p class="muted">@L.T("cust.users_footer",_c)</p>
}
