@model Odca.Web.Models.CreateCustomerViewModel
@{
    var _c = (string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey];
    ViewData["Title"] = L.T("cust.new_title", _c);
    var planItems = ViewData["PlanItems"] as System.Collections.Generic.IList<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>;
}
<nav class="breadcrumb" aria-label="@L.T("common.breadcrumb_aria",_c)">
    <a asp-controller="Home" asp-action="Index">@L.T("visao-global",_c)</a>
    <span>/</span>
    <a asp-action="Index">@L.T("cust.area",_c)</a>
    <span>/</span>
    <span aria-current="page">@L.T("cust.new_title",_c)</span>
</nav>

<header class="page-heading">
    <div>
        <p class="eyebrow">@L.T("support.eyebrow",_c)</p>
        <h1>@L.T("cust.create_h",_c)</h1>
        <p class="muted">@L.T("cust.create_sub",_c)</p>
    </div>
    <details class="help-card">
        <summary>@L.T("common.how_to_use",_c)</summary>
        <p>@L.T("cust.create_help",_c)</p>
    </details>
</header>

<form method="post" asp-action="Create" class="patient-form" data-submit-once>
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="alert alert-error" role="alert"></div>

    <section class="card">
        <h2>@L.T("cust.create_org_h",_c)</h2>
        <div class="form-grid">
            <label>
                @L.T("cust.create_name_label",_c)
                <input asp-for="OrganizationName" autocomplete="organization" required />
                <span asp-validation-for="OrganizationName" class="validation"></span>
            </label>
            <label>
                @L.T("cust.create_doc_label",_c)
                <input asp-for="Document" placeholder="00.000.000/0000-00 ou 000.000.000-00" autocomplete="off" required />
                <span asp-validation-for="Document" class="validation"></span>
            </label>
            <label>
                @L.T("cust.create_plan_label",_c)
                <select asp-for="PlanCode" asp-items="planItems" required></select>
                <small class="muted">@L.T("cust.create_plan_note",_c)</small>
                <span asp-validation-for="PlanCode" class="validation"></span>
            </label>
        </div>
    </section>

    <section class="card">
        <h2>@L.T("cust.create_admin_h",_c)</h2>
        <p class="muted" style="margin-top: 0; font-size: 0.875rem;">
            @L.T("cust.create_admin_note_pre",_c)<strong>@L.T("cust.create_admin_role",_c)</strong>@L.T("cust.create_admin_note_post",_c)
        </p>
        <div class="form-grid">
            <label>
                @L.T("cust.create_adminname_label",_c)
                <input asp-for="AdminName" autocomplete="name" required />
                <span asp-validation-for="AdminName" class="validation"></span>
            </label>
            <label>
                @L.T("cust.create_adminemail_label",_c)
                <input asp-for="AdminEmail" type="email" autocomplete="email" required />
                <span asp-validation-for="AdminEmail" class="validation"></span>
            </label>
            <label>
                @L.T("cust.create_password_label",_c)
                <input asp-for="InitialPassword" type="password" autocomplete="new-password" minlength="8" required />
                <span asp-validation-for="InitialPassword" class="validation"></span>
            </label>
        </div>
    </section>

    <section class="card">
        <h2>@L.T("cust.create_ops_h",_c)</h2>
        <label class="check-label">
            <input asp-for="ActivateDirectly" type="checkbox" />
            <strong>@L.T("cust.create_activate",_c)</strong>
        </label>
        <p class="muted" style="font-size: 0.85rem; margin-top: 0.25rem;">
            @L.T("cust.create_ops_note_pre",_c)<em>@L.T("cust.commercial_pending_term",_c)</em>@L.T("cust.create_ops_note_post",_c)
        </p>
    </section>

    <div class="form-actions-row">
        <button class="button button-primary" type="submit">@L.T("cust.create_submit",_c)</button>
        <a class="button button-link" asp-action="Index">@L.T("action.cancel",_c)</a>
    </div>
</form>
