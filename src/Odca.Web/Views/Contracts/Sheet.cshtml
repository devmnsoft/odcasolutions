@model Odca.Web.Models.ContractSheetViewModel
@{
    var _culture = (string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey];
    var tenantId = ViewData["TenantId"];
    var sheet = Model.Sheet;
    var notice = TempData["ContractSheetNotice"] as string;
    var error = TempData["ContractSheetError"] as string ?? Model.Error;
    var todayStr = (sheet?.Today ?? DateOnly.FromDateTime(DateTime.Today)).ToString("yyyy-MM-dd");
    var isAmendmentRequired = sheet?.Renewal?.InThreeMonthWindow == true;
    var returnUrl = tenantId is not null && sheet is not null
        ? Odca.Web.Controllers.ContractsController.BuildReturnUrl(
            (Guid)tenantId,
            sheet.ContractId,
            "#revisao",
            Model.FromSource,
            Model.Year,
            Model.Month,
            Model.Scope,
            Model.Kind,
            Model.Urgency,
            Model.ViewId,
            Model.SelectedObligationId)
        : string.Empty;
    var tenantIdValue = tenantId is Guid g ? g : Guid.Empty;
    var pdfBaixarQuery = Odca.Web.Controllers.ContractsController.BuildReturnUrlQuery(
        Model.FromSource, Model.Year, Model.Month, Model.Scope, Model.Kind, Model.Urgency, Model.ViewId, Model.SelectedObligationId);
}

@functions {
    // D-OC42 (S8): status de contrato pelo catálogo (antes literal pt-BR estático).
    private string StatusLabel(string? value) => value switch
    {
        "active" => L.T("sheet.status_active", SigCulture),
        "archived" => L.T("sheet.status_archived", SigCulture),
        "closed" => L.T("sheet.status_closed", SigCulture),
        "expired" => L.T("sheet.status_expired", SigCulture),
        _ => value ?? "—"
    };

    // D-OC37 (F-2): idioma atual para os helpers (mesma fonte da variável local _culture da página).
    private string? SigCulture => (string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey];

    // D-OC37 (F-2): rótulos de situação de versão e tipo de participante pelo catálogo.
    private string ReviewStatusLabel(string? value) => value switch
    {
        "generated" => L.T("sheet.review_status_generated", SigCulture),
        "submitted" => L.T("sheet.review_status_submitted", SigCulture),
        "internally_approved" => L.T("sheet.review_status_internally_approved", SigCulture),
        "changes_requested" => L.T("sheet.review_status_changes_requested", SigCulture),
        "externally_signed" => L.T("sheet.review_status_externally_signed", SigCulture),
        _ => value ?? "—"
    };

    private string ParticipantTypeLabel(string? value) => value switch
    {
        "patient" => L.T("sheet.participant_type_patient", SigCulture),
        "representative" => L.T("sheet.participant_type_representative", SigCulture),
        "professional" => L.T("sheet.participant_type_professional", SigCulture),
        "organization_representative" => L.T("sheet.participant_type_organization_representative", SigCulture),
        _ => value ?? "—"
    };

    // D-OC42 (S8): rótulos de evento pelo catálogo (antes literals pt-BR estáticos).
    private string EventLabel(string value) => value switch
    {
        "contract.updated" => L.T("sheet.ev_contract_updated", SigCulture),
        "contract.duplicated" => L.T("sheet.ev_contract_duplicated", SigCulture),
        "contract.archived" => L.T("sheet.ev_contract_archived", SigCulture),
        "contract.restored" => L.T("sheet.ev_contract_restored", SigCulture),
        "contract.closed" => L.T("sheet.ev_contract_closed", SigCulture),
        "draft.created" => L.T("sheet.ev_draft_created", SigCulture),
        "draft.saved" => L.T("sheet.ev_draft_saved", SigCulture),
        "draft.patient_associated" => L.T("sheet.ev_draft_patient_associated", SigCulture),
        "version.generated" => L.T("sheet.ev_version_generated", SigCulture),
        "signature.completed" => L.T("sheet.ev_signature_completed", SigCulture),
        "document_uploaded" => L.T("sheet.ev_document_uploaded", SigCulture),
        "extraction_review_applied" => L.T("sheet.ev_extraction_review_applied", SigCulture),
        "renewal_decision" => L.T("sheet.ev_renewal_decision", SigCulture),
        _ => value
    };

    // D-OC42 (S8): mapeia códigos de obrigação/solicitação/documento para rótulos de catálogo.
    private string ObligationUrgency(string? value) => value switch
    {
        "Overdue" => L.T("inbox.urgency_overdue", SigCulture),
        "DueToday" => L.T("inbox.urgency_today_label", SigCulture),
        "DueThisWeek" => L.T("inbox.urgency_week_label", SigCulture),
        "Upcoming" => L.T("inbox.urgency_upcoming_label", SigCulture),
        _ => value ?? ""
    };

    private string ObligationStatus(string? value) => value switch
    {
        "open" => L.T("obl.status_open", SigCulture),
        "in_progress" => L.T("obl.status_in_progress", SigCulture),
        "fulfilled" => L.T("obl.status_fulfilled", SigCulture),
        "cancelled" => L.T("obl.status_cancelled", SigCulture),
        _ => value ?? ""
    };

    private string SolStatus(string? value) => value switch
    {
        "open" => L.T("admin.st_open", SigCulture),
        "in_progress" => L.T("admin.st_in_service", SigCulture),
        "awaiting_customer" => L.T("admin.st_waiting_customer", SigCulture),
        _ => value ?? ""
    };

    private string SolService(string? value) => value switch
    {
        "revisao" => L.T("sol.service.revisao", SigCulture),
        "adaptacao" => L.T("sol.service.adaptacao", SigCulture),
        "esclarecimento" => L.T("sol.service.esclarecimento", SigCulture),
        "suporte_tecnico" => L.T("sol.service.suporte_tecnico", SigCulture),
        _ => value ?? ""
    };

    private string SolPriority(string? value) => value switch
    {
        "baixa" => L.T("sol.priority.baixa", SigCulture),
        "normal" => L.T("sol.priority.normal", SigCulture),
        "alta" => L.T("sol.priority.alta", SigCulture),
        "critica" => L.T("sol.priority.critica", SigCulture),
        _ => value ?? ""
    };

    private string DocState(string? value) => value switch
    {
        "safe" => L.T("sheet.doc_state_safe", SigCulture),
        "rejected" => L.T("sheet.doc_state_rejected", SigCulture),
        "pending" => L.T("sheet.doc_state_pending", SigCulture),
        _ => value ?? ""
    };

    private static string EventPageUrl(Guid tenantId, Guid contractId, int page, string? from, int? year, int? month, string? scope, string? kind, string? urgency, Guid? viewId, Guid? obrigacao)
    {
        var baseUrl = Odca.Web.Controllers.ContractsController.BuildReturnUrl(tenantId, contractId, "", from, year, month, scope, kind, urgency, viewId, obrigacao);
        return baseUrl + (baseUrl.Contains('?') ? "&" : "?") + "eventsPage=" + page.ToString(System.Globalization.CultureInfo.InvariantCulture);
    }
}

@if (sheet is null)
{
    <div class="empty-state">
        <strong>@L.T("sheet.unavailable_title", _culture)</strong>
        <p>@(error ?? L.T("sheet.unavailable_body", _culture))</p>
        <a class="button button-quiet" asp-controller="Inbox" asp-action="Index" asp-route-tenantId="@tenantId">@L.T("sheet.go_inbox", _culture)</a>
    </div>
    return;
}

<header class="renewal-heading">
    <div>
        <nav class="breadcrumb-trail" aria-label="@L.T("common.breadcrumb_aria", _culture)">
            @if (Model.FromSource == "agenda")
            {
                <a asp-controller="Agenda" asp-action="Index" asp-route-tenantId="@tenantId"
                   asp-route-year="@Model.Year" asp-route-month="@Model.Month" asp-route-scope="@Model.Scope">← @L.T("agenda", _culture)</a>
            }
            else
            {
                <a asp-controller="Inbox" asp-action="Index" asp-route-tenantId="@tenantId"
                   asp-route-scope="@Model.Scope" asp-route-kind="@Model.Kind" asp-route-urgency="@Model.Urgency" asp-route-viewId="@Model.ViewId">← @L.T("nav.aria_operations_inbox", _culture)</a>
            }
            <span>/ @L.T("group_contratos", _culture)</span>
        </nav>
        <div class="form-actions-row">
            <h1>@sheet.Title</h1>
            @if (sheet.Status == "closed")
            {
                <span class="status-label" title="@L.T("sheet.title_closed_tip", _culture, sheet.ClosedAt?.ToString("dd/MM/yyyy HH:mm") ?? "")">@L.T("sheet.status_closed", _culture)</span>
            }
            else if (sheet.Status == "archived")
            {
                <span class="status-label" title="@L.T("sheet.title_archived_tip", _culture, sheet.ArchivedAt?.ToString("dd/MM/yyyy HH:mm") ?? "")">@L.T("sheet.status_archived", _culture)</span>
            }
            else if (sheet.Status == "expired")
            {
                <span class="status-label" title="@L.T("sheet.title_expired_tip", _culture, sheet.EndsOn?.ToString("dd/MM/yyyy") ?? "")">@L.T("sheet.status_expired", _culture)</span>
            }
            @if (sheet.HasImportAwaitingReview)
            {
                @if (sheet.ImportId.HasValue)
                {
                    <a class="chip-warning" asp-controller="Imports" asp-action="Review" asp-route-tenantId="@tenantId" asp-route-importId="@sheet.ImportId.Value">
                        <span class="status-label">@L.T("sheet.import_badge", _culture)</span>
                        <span>@L.T("sheet.import_awaiting_review", _culture)</span>
                    </a>
                }
                else
                {
                    <a class="chip-warning" asp-controller="Imports" asp-action="Index" asp-route-tenantId="@tenantId" asp-route-awaitingReview="true">
                        <span class="status-label">@L.T("sheet.import_badge", _culture)</span>
                        <span>@L.T("sheet.import_awaiting_review", _culture)</span>
                    </a>
                }
            }
        </div>
        <p class="muted">
            @L.T("common.situation", _culture): <strong>@StatusLabel(sheet.Status)</strong> ·
            @L.T("sheet.vigencia", _culture): @(sheet.StartsOn?.ToString("dd/MM/yyyy") ?? L.T("sheet.start_unknown", _culture)) a @(sheet.EndsOn?.ToString("dd/MM/yyyy") ?? L.T("sheet.no_end", _culture)) ·
            @L.T("common.type", _culture): @(sheet.ContractType ?? L.T("sheet.type_general", _culture)) ·
            @L.T("common.responsible", _culture): @(sheet.OwnerName ?? L.T("sheet.owner_unassigned", _culture)) ·
            @(string.IsNullOrWhiteSpace(sheet.Reference) ? "" : L.T("sheet.reference_label", _culture) + ": <strong>" + sheet.Reference + "</strong> · ")
            @L.T("sheet.opt_version", _culture): @sheet.Version
        </p>
    </div>
</header>

<!-- D-OC31 B.3 — Jornada contínua: próxima ação + pendências por seção + motivo de bloqueio -->
@if (Model.Journey is { } journey)
{
    <section id="jornada" class="renewal-list" aria-label="@L.T("sheet.journey_aria", _culture)">
        <div class="list-header">
            <h2>@L.T("sheet.journey_h", _culture)</h2>
            @if (Model.CanReadHistory)
            {
                <a class="button button-link" href="#historico">@L.T("sheet.journey_history_link", _culture)</a>
            }
        </div>
        <div class="renewal-cards">
            <div>
                <strong>@L.T(journey.NextActionKey, _culture)</strong>
                <span>@L.T("sheet.journey_next", _culture)</span>
            </div>
            @foreach (var item in journey.Pending)
            {
                <div>
                    <a href="@item.Anchor"><strong>@L.T(item.LabelKey, _culture)</strong></a>
                    <span>@item.Count</span>
                </div>
            }
        </div>
        @if (journey.BlockKey is not null)
        {
            <p class="muted">@L.T(journey.BlockKey, _culture)@(string.IsNullOrWhiteSpace(journey.BlockReason) ? "" : $" — {journey.BlockReason}")</p>
        }
    </section>
}

<!-- SUBNAV STICKY COM ARIA-CURRENT -->
<nav class="sheet-subnav" aria-label="@L.T("sheet.subnav_aria", _culture)">
    <a href="#detalhes">@L.T("sheet.nav_details", _culture)</a>
    <a href="#obrigacoes">@L.T("sheet.nav_obligations", _culture)</a>
    <a href="#renovacao">@L.T("sheet.nav_renewal", _culture)</a>
    <a href="#revisao">@L.T("sheet.nav_review", _culture)</a>
    <a href="#minutas">@L.T("sheet.nav_drafts", _culture)</a>
    <a href="#assinatura">@L.T("sheet.nav_signature", _culture)</a>
    <a href="#documentos">@L.T("sheet.nav_documents", _culture)</a>
    @if (sheet.DerivedDocuments is { Count: > 0 })
    {
        <a href="#derivados">@L.T("sheet.nav_derived", _culture)</a>
    }
    @if (sheet.Solicitations is { Count: > 0 })
    {
        <a href="#solicitacoes">@L.T("sheet.nav_solicitations", _culture)</a>
    }
    @if (Model.CanReadHistory)
    {
        <a href="#historico">@L.T("sheet.nav_history", _culture)</a>
    }
    <a href="#acoes">@L.T("sheet.nav_actions", _culture)</a>
    <a asp-controller="Renewals" asp-action="Index" asp-route-tenantId="@tenantId" asp-route-counterparty="@sheet.Title">@L.T("sheet.nav_renewals_center", _culture)</a>
</nav>

@if (!string.IsNullOrWhiteSpace(notice))
{
    <div class="banner-notice-success" role="status">
        @notice
    </div>
}

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="validation-summary" role="alert">
        @error
    </div>
}

<!-- SEÇÃO DETALHES DO CONTRATO (B.3.2c) -->
<section id="detalhes" class="renewal-list" aria-label="Detalhes do contrato">
    <div class="list-header">
        <h2>@L.T("sheet.details", _culture)</h2>
        @if (Model.CanManageContracts)
        {
            <span class="muted">@L.T("sheet.details_note", _culture)</span>
        }
    </div>

    <div class="renewal-cards">
        <div>
            <strong>@(string.IsNullOrWhiteSpace(sheet.Reference) ? "—" : sheet.Reference)</strong>
            <span>@L.T("sheet.ref_internal", _culture)</span>
        </div>
        <div>
            <strong>@(sheet.ArchivedAt?.ToString("dd/MM/yyyy HH:mm") ?? "—")</strong>
            <span>@L.T("sheet.archived_at_label", _culture)</span>
        </div>
        <div>
            <strong>@(sheet.ClosedOn?.ToString("dd/MM/yyyy") ?? "—")</strong>
            <span>@L.T("sheet.close_date_label", _culture)</span>
        </div>
        <div>
            <strong>@(string.IsNullOrWhiteSpace(sheet.ClosureReason) ? "—" : L.T("sheet.closure_registered", _culture))</strong>
            <span>@L.T("sheet.closure_reason_label", _culture)</span>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(sheet.ArchiveReason))
    {
        <p class="muted"><strong>@L.T("sheet.archive_reason_label", _culture):</strong> @sheet.ArchiveReason</p>
    }
    @if (!string.IsNullOrWhiteSpace(sheet.ClosureReason))
    {
        <p class="muted"><strong>@L.T("sheet.closure_reason_label", _culture):</strong> @sheet.ClosureReason</p>
    }

    @if (Model.CanManageContracts && sheet.Status != "closed")
    {
        <details class="filter-panel">
            <summary><strong>@L.T("sheet.edit_details", _culture)</strong> (@L.T("sheet.edit_details_hint", _culture))</summary>
            <form id="details-form" method="post" asp-action="UpdateDetails" asp-route-tenantId="@tenantId" asp-route-contractId="@sheet.ContractId"
                  asp-route-from="@Model.FromSource" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
                  asp-route-scope="@Model.Scope" asp-route-kind="@Model.Kind" asp-route-urgency="@Model.Urgency" asp-route-viewId="@Model.ViewId" asp-route-obrigacao="@Model.SelectedObligationId"
                  class="form-grid" data-processing data-processing-label="@L.T("sheet.saving", _culture)">
                @Html.AntiForgeryToken()
                <input type="hidden" name="version" value="@sheet.Version" />

                <label>@L.T("sheet.contract_title_label", _culture)
                    <input type="text" name="title" maxlength="160" value="@sheet.Title" />
                </label>

                <label>@L.T("sheet.ref_internal", _culture)
                    <input type="text" name="reference" maxlength="160" value="@(sheet.Reference ?? "")" placeholder="@L.T("sheet.ref_placeholder", _culture)" />
                </label>

                <label>@L.T("sheet.internal_responsible", _culture)
                    <select name="ownerId" data-initial="@(sheet.OwnerId?.ToString() ?? "")">
                        <option value="">@L.T("sheet.select_to_change", _culture)</option>
                        @foreach (var m in Model.ActiveMembers)
                        {
                            <option value="@m.UserId" selected="@(sheet.OwnerId == m.UserId ? "selected" : null)">@m.Name (@m.Email)</option>
                        }
                    </select>
                </label>

                <label class="form-grid-full check-line">
                    <input type="checkbox" name="clearOwner" value="true" />
                    <span>@L.T("sheet.clear_owner", _culture)</span>
                </label>

                <div class="form-grid-full form-actions-row">
                    <button class="button button-primary" type="submit">@L.T("sheet.save_changes", _culture)</button>
                    <span class="muted">@L.T("sheet.save_note", _culture)</span>
                </div>
            </form>
        </details>
    }
    else if (!Model.CanManageContracts)
    {
        <p class="muted">@L.T("sheet.readonly_details", _culture)</p>
    }
</section>

<!-- SEÇÃO ALTERAÇÕES PENDENTES / CONDIÇÕES E EFEITOS (Item 10) -->
@if (sheet.PendingChanges is { Count: > 0 })
{
    <section id="alteracoes" class="renewal-list" aria-label="@L.T("sheet.alterations_aria", _culture)">
        <div class="section-heading">
            <h2>@L.T("sheet.alterations", _culture)</h2>
            <span>@sheet.PendingChanges.Count @L.T("sheet.alterations_count", _culture)</span>
        </div>
        @foreach (var chg in sheet.PendingChanges)
        {
            var badgeClass = chg.Status switch
            {
                "draft" => "badge-draft",
                "in_review" => "badge-review",
                "internally_approved" => "badge-approved",
                "awaiting_formalization" => "badge-formalize",
                "formalized" => "badge-scheduled",
                "conflict" => "badge-conflict",
                _ => "badge-info"
            };
            var statusLabel = chg.Status switch
            {
                "draft" => L.T("sheet.chg_draft", _culture),
                "in_review" => L.T("sheet.chg_review", _culture),
                "internally_approved" => L.T("sheet.chg_approved", _culture),
                "awaiting_formalization" => L.T("sheet.chg_await_formal", _culture),
                "formalized" => chg.ApplicationStatus == "scheduled" ? L.T("sheet.chg_scheduled", _culture) : L.T("sheet.chg_not_applied", _culture),
                "conflict" => L.T("sheet.chg_conflict", _culture),
                _ => chg.Status
            };
            var kindLabel = chg.Kind switch
            {
                "renewal" => L.T("sheet.chg_kind_renewal", _culture),
                "amendment" => L.T("sheet.chg_kind_amendment", _culture),
                "revision" => L.T("sheet.chg_kind_revision", _culture),
                _ => chg.Kind
            };
            <article class="renewal-row">
                <div>
                    <span class="status-label @(badgeClass)">@kindLabel · @statusLabel</span>
                    <h3>@(chg.Reason ?? "—")</h3>
                    @if (chg.EffectiveOn is not null)
                    {
                        <p>@L.T("sheet.chg_effective", _culture): <strong>@chg.EffectiveOn.Value.ToString("dd/MM/yyyy")</strong></p>
                    }
                </div>
                <dl>
                    @if (chg.ProposedStartDate is not null || chg.ProposedEndDate is not null)
                    {
                        <div>
                            <dt>@L.T("sheet.chg_new_period", _culture)</dt>
                            <dd>@(chg.ProposedStartDate?.ToString("dd/MM/yyyy") ?? "—") → @(chg.ProposedEndDate?.ToString("dd/MM/yyyy") ?? L.T("sheet.indefinite", _culture))</dd>
                        </div>
                    }
                    @if (chg.ProposedValue is not null)
                    {
                        <div>
                            <dt>@L.T("sheet.chg_new_value", _culture)</dt>
                            <dd>@chg.ProposedValue.Value.ToString("N2") @(chg.Currency ?? "")</dd>
                        </div>
                    }
                </dl>
            </article>
        }
    </section>
}

<!-- SEÇÃO RENOVAÇÃO -->
<section id="renovacao" class="renewal-cards" aria-label="@L.T("sheet.renewal_indicators_aria", _culture)">
    <div>
        <strong>@(sheet.StartsOn?.ToString("dd/MM/yyyy") ?? "—")</strong>
        <span>@L.T("sheet.vig_start", _culture)</span>
    </div>
    <div>
        <strong>@(sheet.Renewal?.EndsOn?.ToString("dd/MM/yyyy") ?? "—")</strong>
        <span>@L.T("sheet.vig_end", _culture)</span>
    </div>
    <div>
        <strong>@(sheet.Renewal?.NoticeDueOn?.ToString("dd/MM/yyyy") ?? "—")</strong>
        <span>@L.T("sheet.notice_due", _culture)</span>
    </div>
    <div>
        <strong>@(sheet.Renewal?.InThreeMonthWindow == true ? L.T("common.yes", _culture) : L.T("common.no", _culture))</strong>
        <span>@L.T("sheet.three_month_window", _culture)</span>
    </div>
</section>

<!-- PAINEL DE PROPOSTA DE RENOVAÇÃO / ADITIVO -->
<details class="filter-panel">
    <summary><strong>@L.T("sheet.propose_title", _culture)</strong> (@L.T("sheet.propose_hint", _culture))</summary>
    <form id="renewal-proposal-form" method="post" asp-action="CreateRenewalProposal" asp-route-tenantId="@tenantId" asp-route-contractId="@sheet.ContractId"
          asp-route-from="@Model.FromSource" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
          asp-route-scope="@Model.Scope" asp-route-kindFilter="@Model.Kind" asp-route-urgency="@Model.Urgency" asp-route-viewId="@Model.ViewId" asp-route-obrigacao="@Model.SelectedObligationId"
          class="form-grid">
        @Html.AntiForgeryToken()
        <input type="hidden" name="contractVersion" value="@sheet.Version" />
        
        <label>@L.T("sheet.change_type", _culture)
            <select name="kind" required>
                @if (isAmendmentRequired)
                {
                    <option value="amendment" selected>@L.T("sheet.kind_amendment_window", _culture)</option>
                }
                else
                {
                    <option value="renewal">@L.T("sheet.kind_renewal_term", _culture)</option>
                    <option value="amendment">@L.T("sheet.kind_amendment_scope", _culture)</option>
                    <option value="revision">@L.T("sheet.kind_revision_admin", _culture)</option>
                }
            </select>
        </label>

        <label>@L.T("sheet.proposal_priority", _culture)
            <select name="priority">
                <option value="low">@L.T("sol.priority.baixa", _culture)</option>
                <option value="normal" selected>@L.T("sol.priority.normal", _culture)</option>
                <option value="high">@L.T("sol.priority.alta", _culture)</option>
                <option value="critical">@L.T("sol.priority.critica", _culture)</option>
            </select>
        </label>

        <label>@L.T("sheet.effective_from", _culture)
            <input type="date" name="effectiveOn" value="@todayStr" required />
        </label>

        <label>@L.T("sheet.proposed_start", _culture)
            <input type="date" name="proposedStartDate" value="@(sheet.StartsOn?.ToString("yyyy-MM-dd"))" />
        </label>

        <label>@L.T("sheet.proposed_end", _culture)
            <input type="date" name="proposedEndDate" value="@(sheet.EndsOn?.AddYears(1).ToString("yyyy-MM-dd"))" />
        </label>

        <label>@L.T("common.responsible", _culture)
            <select name="responsibleId" required>
                <option value="">@L.T("sheet.select_member", _culture)</option>
                @foreach (var m in Model.ActiveMembers)
                {
                    <option value="@m.UserId">@m.Name (@m.Email)</option>
                }
            </select>
        </label>

        <label>@L.T("sheet.proposed_value", _culture)
            <input type="number" step="0.01" min="0" name="proposedValue" placeholder="0.00" />
        </label>

        <label>@L.T("sheet.currency", _culture)
            <input type="text" name="currency" maxlength="3" value="BRL" />
        </label>

        <label class="form-grid-full">@L.T("sheet.justification_change", _culture)
            <textarea name="reason" rows="2" required placeholder="@L.T("sheet.justification_ph", _culture)"></textarea>
        </label>

        <div class="form-grid-full form-actions-row">
            <button class="button button-primary" type="button" data-confirm-open data-confirm-form="renewal-proposal-form"
                    data-confirm-title="@L.T("sheet.confirm_propose_title", _culture)"
                    data-confirm-body="@L.T("sheet.confirm_propose_body", _culture, sheet.Title)"
                    data-confirm-action="@L.T("sheet.register_proposal", _culture)">@L.T("sheet.register_proposal", _culture)</button>
            <a class="button button-quiet" asp-controller="Renewals" asp-action="Index" asp-route-tenantId="@tenantId" asp-route-counterparty="@sheet.Title">@L.T("sheet.view_renewals_center", _culture)</a>
            <span class="muted">@L.T("sheet.propose_note", _culture)</span>
        </div>
    </form>
</details>

<!-- SEÇÃO REVISÃO E MINUTA EM ANDAMENTO -->
<section id="revisao" class="renewal-list">
    <div class="list-header">
        <h2>@L.T("sheet.review", _culture)</h2>
        @if (sheet.DraftId.HasValue)
        {
            <div class="form-actions-row">
                <a class="button button-primary" href="/organizacoes/@tenantId/estudio/minutas/@sheet.DraftId.Value?returnUrl=@Uri.EscapeDataString(returnUrl)">
                    @L.T("sheet.open_draft_studio", _culture)
                </a>
                <a class="button button-quiet" href="/organizacoes/@tenantId/estudio/minutas/@sheet.DraftId.Value/checklist?version=@sheet.Version" target="_blank">
                    @L.T("sheet.checklist_word", _culture)
                </a>
                <a class="button button-quiet" href="/organizacoes/@tenantId/estudio/comparar-versoes?draftId=@sheet.DraftId.Value">
                    @L.T("sheet.compare_versions", _culture)
                </a>
            </div>
        }
    </div>

    @if (sheet.CurrentReview is null)
    {
        <div class="empty-state">
            <strong>@L.T("sheet.review_none_title", _culture)</strong>
            <p>@L.T("sheet.review_none_body", _culture)</p>
            @if (sheet.DraftId.HasValue)
            {
                <p class="muted">@L.T("sheet.review_draft_hint", _culture)</p>
            }
        </div>
    }
    else
    {
        <div class="renewal-cards">
            <div>
                <strong>@ReviewStatusLabel(sheet.CurrentReview.Status)</strong>
                <span>@L.T("sheet.review_status_label", _culture)</span>
            </div>
            <div>
                <strong>@(sheet.CurrentReview.CurrentReviewerName ?? L.T("sheet.reviewer_none", _culture))</strong>
                <span>@L.T("sheet.current_reviewer", _culture)</span>
            </div>
            <div>
                <strong>@(sheet.CurrentReview.DueAt?.ToString("dd/MM/yyyy HH:mm") ?? L.T("sheet.due_none", _culture))</strong>
                <span>@L.T("sheet.deadline_label", _culture)</span>
            </div>
        </div>
    }

    <!-- FORMULÁRIO DE ENCAMINHAMENTO DE REVISÃO -->
    @if (sheet.DraftId.HasValue)
    {
        <details class="filter-panel" @(sheet.CurrentReview is null ? "open" : "")>
            <summary><strong>@L.T("sheet.submit_review_title", _culture)</strong></summary>
            @if (Model.Versions.Count == 0)
            {
                <div class="empty-state">
                    <p>@L.T("sheet.no_version_body", _culture)</p>
                    <a class="button button-quiet" href="/organizacoes/@tenantId/estudio/minutas/@sheet.DraftId.Value?returnUrl=@Uri.EscapeDataString(returnUrl)">
                        @L.T("sheet.generate_version_studio", _culture)
                    </a>
                </div>
            }
            else
            {
                <form method="post" asp-action="SubmitReview" asp-route-tenantId="@tenantId" asp-route-contractId="@sheet.ContractId"
                      asp-route-from="@Model.FromSource" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
                      asp-route-scope="@Model.Scope" asp-route-kind="@Model.Kind" asp-route-urgency="@Model.Urgency" asp-route-viewId="@Model.ViewId" asp-route-obrigacao="@Model.SelectedObligationId"
                      class="form-grid">
                    @Html.AntiForgeryToken()
                    <label>@L.T("sheet.version_to_review", _culture)
                        <select name="generatedVersionId" required>
                            @foreach (var v in Model.Versions)
                            {
                                <option value="@v.Id">@L.T("sheet.version_option", _culture, v.Number.ToString(), ReviewStatusLabel(v.Status)) — @v.Author</option>
                            }
                        </select>
                    </label>

                    <label>@L.T("sheet.designated_reviewer", _culture)
                        <select name="reviewerId" required>
                            @foreach (var r in Model.Reviewers)
                            {
                                <option value="@r.Id">@r.Name</option>
                            }
                        </select>
                    </label>

                    <label>@L.T("sheet.deadline_optional", _culture)
                        <input type="datetime-local" name="dueAt" />
                    </label>

                    <label class="form-grid-full">@L.T("sheet.reviewer_instructions", _culture)
                        <textarea name="instructions" rows="2" placeholder="@L.T("sheet.instructions_ph", _culture)"></textarea>
                    </label>

                    <div class="form-grid-full form-actions-row">
                        <button class="button button-primary" type="submit">@L.T("sheet.send_for_review", _culture)</button>
                    </div>
                </form>
            }
        </details>
    }

    <!-- COMENTÁRIOS NO RASCUNHO -->
    @if (sheet.DraftId.HasValue)
    {
        <details class="filter-panel" open>
            <summary><strong>@L.T("sheet.comments_title", _culture)</strong> <span class="muted">(@L.T("sheet.comments_hint", _culture))</span></summary>
            <div>
                <form method="post" asp-action="AddComment" asp-route-tenantId="@tenantId" asp-route-contractId="@sheet.ContractId"
                      asp-route-from="@Model.FromSource" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
                      asp-route-scope="@Model.Scope" asp-route-kind="@Model.Kind" asp-route-urgency="@Model.Urgency" asp-route-viewId="@Model.ViewId" asp-route-obrigacao="@Model.SelectedObligationId"
                      class="form-stack">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="draftId" value="@sheet.DraftId.Value" />
                    <input type="hidden" name="draftRevision" value="@sheet.Version" />
                    <label>@L.T("sheet.comment_reference_label", _culture)
                        <input type="text" name="reference" placeholder="@L.T("sheet.comment_reference_ph", _culture)" maxlength="100" />
                    </label>
                    <label>@L.T("sheet.comment_label", _culture)
                        <textarea name="body" rows="2" required placeholder="@L.T("sheet.comment_ph", _culture)"></textarea>
                    </label>
                    <div>
                        <button class="button button-quiet" type="submit">@L.T("sheet.add_comment", _culture)</button>
                    </div>
                </form>

                @if (Model.Comments.Count > 0)
                {
                    <div class="form-stack">
                        @foreach (var comment in Model.Comments)
                        {
                            <div class="comment-card">
                                <div class="list-header">
                                    <div>
                                        <strong>@comment.Author</strong>
                                        <span class="status-badge @(comment.Resolved ? "status-approved" : "status-pending")">
                                            @(comment.Resolved ? L.T("sheet.comment_resolved", _culture) : L.T("sheet.comment_pending", _culture))
                                        </span>
                                        <span class="muted">@L.T("sheet.comment_ref_prefix", _culture) @comment.Reference</span>
                                    </div>
                                    <small class="muted">@comment.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                                </div>
                                <p>@comment.Body</p>
                                <div class="form-actions-row">
                                    <form id="comment-state-form-@comment.Id" method="post" asp-action="ChangeCommentState" asp-route-tenantId="@tenantId" asp-route-contractId="@sheet.ContractId"
                                          asp-route-draftId="@sheet.DraftId.Value" asp-route-commentId="@comment.Id" asp-route-operation="@(comment.Resolved ? "reopen" : "resolve")"
                                          asp-route-from="@Model.FromSource" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
                                          asp-route-scope="@Model.Scope" asp-route-kind="@Model.Kind" asp-route-urgency="@Model.Urgency" asp-route-viewId="@Model.ViewId" asp-route-obrigacao="@Model.SelectedObligationId">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="currentResolved" value="@comment.Resolved.ToString().ToLowerInvariant()" />
                                        <button class="button button-quiet" type="button" data-confirm-open data-confirm-form="comment-state-form-@comment.Id"
                                                data-confirm-title="@(comment.Resolved ? L.T("sheet.comment_reopen_title", _culture) : L.T("sheet.comment_resolve_title", _culture))"
                                                data-confirm-body="@((comment.Resolved ? L.T("sheet.comment_reopen_body", _culture, comment.Reference) : L.T("sheet.comment_resolve_body", _culture, comment.Reference)))"
                                                data-confirm-action="@(comment.Resolved ? L.T("sheet.comment_reopen_action", _culture) : L.T("sheet.comment_resolve_action", _culture))">
                                            @(comment.Resolved ? L.T("sheet.comment_reopen_action", _culture) : L.T("sheet.comment_resolve_action", _culture))
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </details>
    }
</section>

<!-- SEÇÃO OBRIGAÇÕES -->
<section id="obrigacoes" class="renewal-list">
    <div class="list-header">
        <h2>@L.T("sheet.obligations", _culture)</h2>
        <div class="form-actions-row">
            <a class="button button-quiet" asp-controller="Obligations" asp-action="Index" asp-route-tenantId="@tenantId" asp-route-contractId="@sheet.ContractId">@L.T("sheet.view_obligations_center", _culture)</a>
            <span>@L.T("sheet.open_count", _culture, sheet.OpenObligations.Count.ToString(System.Globalization.CultureInfo.InvariantCulture))</span>
        </div>
    </div>

    <!-- FORMULÁRIO DE NOVA OBRIGAÇÃO -->
    <details class="filter-panel">
        <summary><strong>+ @L.T("sheet.add_obligation", _culture)</strong></summary>
        <form id="create-obligation-form" method="post" asp-action="CreateObligation" asp-route-tenantId="@tenantId" asp-route-contractId="@sheet.ContractId"
              asp-route-from="@Model.FromSource" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
              asp-route-scope="@Model.Scope" asp-route-kind="@Model.Kind" asp-route-urgency="@Model.Urgency" asp-route-viewId="@Model.ViewId" asp-route-obrigacao="@Model.SelectedObligationId"
              class="form-grid">
            @Html.AntiForgeryToken()
            <label>@L.T("sheet.oblig_title_label", _culture)
                <input type="text" name="title" required maxlength="160" placeholder="@L.T("sheet.oblig_title_ph", _culture)" />
            </label>
            <label>@L.T("sheet.oblig_party", _culture)
                <input type="text" name="obligatedParty" required maxlength="120" placeholder="@L.T("sheet.oblig_party_ph", _culture)" />
            </label>
            <label>@L.T("common.type", _culture)
                <select name="category" required>
                    <option value="delivery">@L.T("obl.category_delivery", _culture)</option>
                    <option value="document">@L.T("obl.category_document", _culture)</option>
                    <option value="renewal">@L.T("obl.category_renewal", _culture)</option>
                    <option value="communication">@L.T("obl.category_communication", _culture)</option>
                    <option value="financial">@L.T("obl.category_financial", _culture)</option>
                    <option value="other">@L.T("obl.category_other", _culture)</option>
                </select>
            </label>
            <label>@L.T("common.priority", _culture)
                <select name="priority" required>
                    <option value="low">@L.T("sol.priority.baixa", _culture)</option>
                    <option value="normal" selected>@L.T("sol.priority.normal", _culture)</option>
                    <option value="high">@L.T("sol.priority.alta", _culture)</option>
                    <option value="critical">@L.T("sol.priority.critica", _culture)</option>
                </select>
            </label>
            <label>@L.T("sheet.due_date_label", _culture)
                <input type="date" name="dueDate" required value="@todayStr" />
            </label>
            <label>@L.T("sheet.internal_responsible", _culture)
                <select name="ownerId" required>
                    <option value="">@L.T("sheet.select_responsible", _culture)</option>
                    @foreach (var m in Model.ActiveMembers)
                    {
                        <option value="@m.UserId">@m.Name (@m.Email)</option>
                    }
                </select>
            </label>
            <label>@L.T("sheet.amount_financial", _culture)
                <input type="number" step="0.01" min="0" name="amount" placeholder="0.00" />
            </label>
            <label>@L.T("sheet.currency", _culture)
                <input type="text" name="currency" maxlength="3" value="BRL" />
            </label>
            <label class="form-grid-full">@L.T("sheet.postterm_reason", _culture, sheet.EndsOn?.ToString("dd/MM/yyyy") ?? L.T("sheet.not_informed", _culture))
                <input type="text" name="postTermReason" maxlength="500" placeholder="@L.T("sheet.postterm_reason_ph", _culture)" />
            </label>
            <label class="form-grid-full check-line">
                <input type="checkbox" name="evidenceRequired" value="true" />
                <span>@L.T("sheet.evidence_required", _culture)</span>
            </label>
            <label class="form-grid-full">@L.T("sheet.instructions_or_desc", _culture)
                <textarea name="description" rows="2" placeholder="@L.T("sheet.desc_ph", _culture)"></textarea>
            </label>
            <div class="form-grid-full">
                <button class="button button-primary" type="button"
                        data-confirm-open data-confirm-form="create-obligation-form"
                        data-confirm-title="@L.T("sheet.confirm_oblig_title", _culture)"
                        data-confirm-body="@L.T("sheet.confirm_oblig_body", _culture, sheet.Title)"
                        data-confirm-action="@L.T("sheet.create_obligation", _culture)">@L.T("sheet.create_obligation", _culture)</button>
            </div>
        </form>
    </details>

    @if (sheet.OpenObligations.Count == 0)
    {
        <div class="empty-state">
            <strong>@L.T("sheet.no_open_obligations", _culture)</strong>
            <p>@L.T("sheet.no_open_obligations_body", _culture)</p>
        </div>
    }
    else
    {
        @foreach (var item in sheet.OpenObligations)
        {
            var isSelected = Model.SelectedObligationId == item.SourceId;
            <article class="renewal-row @(isSelected ? "urgent" : null)">
                <div>
                    <span class="status-label">@ObligationUrgency(item.Urgency) · @ObligationStatus(item.Status)</span>
                    <h3>@item.Title</h3>
                    <p>@L.T("common.responsible", _culture): <strong>@(item.OwnerName ?? L.T("sheet.owner_unassigned", _culture))</strong></p>
                </div>
                <dl>
                    <div>
                        <dt>@L.T("sheet.oblig_due", _culture)</dt>
                        <dd>@(item.DueOn?.ToString("dd/MM/yyyy") ?? L.T("sheet.no_date", _culture))</dd>
                    </div>
                </dl>
                <div class="form-actions-row">
                    <!-- BOTÃO HISTÓRICO (DRAWER) -->
                    <button type="button" class="button button-quiet btn-history-drawer"
                            data-id="@item.SourceId" data-title="@item.Title">
                        @L.T("sheet.view_history", _culture)
                    </button>

                    <!-- AÇÃO INICIAR -->
                    @if (item.Status == "open")
                    {
                        <form id="start-form-@item.SourceId" method="post" asp-action="PerformObligationAction" asp-route-tenantId="@tenantId" asp-route-contractId="@sheet.ContractId" asp-route-id="@item.SourceId" asp-route-operation="start"
                              asp-route-from="@Model.FromSource" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
                              asp-route-scope="@Model.Scope" asp-route-kind="@Model.Kind" asp-route-urgency="@Model.Urgency" asp-route-viewId="@Model.ViewId" asp-route-obrigacao="@Model.SelectedObligationId">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="version" value="@item.Version" />
                            <button class="button button-quiet" type="button"
                                    data-confirm-open data-confirm-form="start-form-@item.SourceId"
                                    data-confirm-title="@L.T("sheet.confirm_start_title", _culture)"
                                    data-confirm-body="@L.T("sheet.confirm_start_body", _culture, item.Title)"
                                    data-confirm-action="@L.T("sheet.action_start", _culture)">@L.T("sheet.action_start", _culture)</button>
                        </form>
                    }

                    <!-- AÇÃO CUMPRIR -->
                    <details>
                        <summary class="button button-quiet">@L.T("sheet.action_fulfill", _culture)</summary>
                        <div class="details-subpanel">
                            <form id="fulfill-form-@item.SourceId" method="post" asp-action="PerformObligationAction" asp-route-tenantId="@tenantId" asp-route-contractId="@sheet.ContractId" asp-route-id="@item.SourceId" asp-route-operation="fulfill"
                                  asp-route-from="@Model.FromSource" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
                                  asp-route-scope="@Model.Scope" asp-route-kind="@Model.Kind" asp-route-urgency="@Model.Urgency" asp-route-viewId="@Model.ViewId" asp-route-obrigacao="@Model.SelectedObligationId"
                                  class="form-stack">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="version" value="@item.Version" />
                                <label>@L.T("sheet.effective_date", _culture)
                                    <input type="date" name="effectiveAt" value="@todayStr" />
                                </label>
                                <label>@L.T("sheet.evidence_doc_label", _culture)
                                    <select name="evidenceDocumentVersionId">
                                        <option value="">@L.T("sheet.no_attachment", _culture)</option>
                                        @foreach (var doc in sheet.Documents.Where(d => d.SafetyState == "safe"))
                                        {
                                            <option value="@doc.VersionId">@doc.Name</option>
                                        }
                                    </select>
                                </label>
                                <label>@L.T("sheet.fulfill_note_label", _culture)
                                    <input type="text" name="note" placeholder="@L.T("sheet.note_ph", _culture)" />
                                </label>
                                <button class="button button-primary" type="button" data-confirm-open data-confirm-form="fulfill-form-@item.SourceId"
                                        data-confirm-title="@L.T("sheet.confirm_fulfill_title", _culture)"
                                        data-confirm-body="@L.T("sheet.confirm_fulfill_body", _culture, item.Title)"
                                        data-confirm-action="@L.T("sheet.confirm_fulfill_title", _culture)">@L.T("sheet.confirm_fulfill_title", _culture)</button>
                            </form>
                        </div>
                    </details>

                    <!-- AÇÃO REAGENDAR -->
                    <details>
                        <summary class="button button-quiet">@L.T("sheet.action_reschedule", _culture)</summary>
                        <div class="details-subpanel">
                            <form id="reschedule-form-@item.SourceId" method="post" asp-action="PerformObligationAction" asp-route-tenantId="@tenantId" asp-route-contractId="@sheet.ContractId" asp-route-id="@item.SourceId" asp-route-operation="reschedule"
                                  asp-route-from="@Model.FromSource" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
                                  asp-route-scope="@Model.Scope" asp-route-kind="@Model.Kind" asp-route-urgency="@Model.Urgency" asp-route-viewId="@Model.ViewId" asp-route-obrigacao="@Model.SelectedObligationId"
                                  class="form-stack">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="version" value="@item.Version" />
                                <label>@L.T("sheet.new_due", _culture)
                                    <input type="date" name="dueDate" required />
                                </label>
                                <label>@L.T("sheet.reschedule_reason", _culture)
                                    <input type="text" name="reason" required placeholder="@L.T("sheet.justification_short", _culture)" />
                                </label>
                                <button class="button button-primary" type="button"
                                        data-confirm-open data-confirm-form="reschedule-form-@item.SourceId"
                                        data-confirm-title="@L.T("sheet.confirm_resched_title", _culture)"
                                        data-confirm-body="@L.T("sheet.confirm_resched_body", _culture, item.Title)"
                                        data-confirm-action="@L.T("sheet.action_reschedule", _culture)">@L.T("sheet.action_reschedule", _culture)</button>
                            </form>
                        </div>
                    </details>

                    <!-- AÇÃO REATRIBUIR -->
                    <details>
                        <summary class="button button-quiet">@L.T("sheet.action_reassign", _culture)</summary>
                        <div class="details-subpanel">
                            <form id="reassign-form-@item.SourceId" method="post" asp-action="PerformObligationAction" asp-route-tenantId="@tenantId" asp-route-contractId="@sheet.ContractId" asp-route-id="@item.SourceId" asp-route-operation="reassign"
                                  asp-route-from="@Model.FromSource" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
                                  asp-route-scope="@Model.Scope" asp-route-kind="@Model.Kind" asp-route-urgency="@Model.Urgency" asp-route-viewId="@Model.ViewId" asp-route-obrigacao="@Model.SelectedObligationId"
                                  class="form-stack">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="version" value="@item.Version" />
                                <label>@L.T("sheet.new_responsible", _culture)
                                    <select name="ownerId" required>
                                        <option value="">@L.T("sheet.select_any", _culture)</option>
                                        @foreach (var m in Model.ActiveMembers.Where(m => m.UserId != item.OwnerId))
                                        {
                                            <option value="@m.UserId">@m.Name</option>
                                        }
                                    </select>
                                </label>
                                <label>@L.T("sheet.reassign_reason", _culture)
                                    <input type="text" name="reason" required placeholder="@L.T("sheet.justification_short", _culture)" />
                                </label>
                                <button class="button button-primary" type="button"
                                        data-confirm-open data-confirm-form="reassign-form-@item.SourceId"
                                        data-confirm-title="@L.T("sheet.confirm_reassign_title", _culture)"
                                        data-confirm-body="@L.T("sheet.confirm_reassign_body", _culture, item.Title)"
                                        data-confirm-action="@L.T("sheet.action_reassign", _culture)">@L.T("sheet.action_reassign", _culture)</button>
                            </form>
                        </div>
                    </details>

                    <!-- AÇÃO CANCELAR -->
                    <details>
                        <summary class="button button-quiet">@L.T("action.cancel", _culture)</summary>
                        <div class="details-subpanel">
                            <form id="cancel-form-@item.SourceId" method="post" asp-action="PerformObligationAction" asp-route-tenantId="@tenantId" asp-route-contractId="@sheet.ContractId" asp-route-id="@item.SourceId" asp-route-operation="cancel"
                                  asp-route-from="@Model.FromSource" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
                                  asp-route-scope="@Model.Scope" asp-route-kind="@Model.Kind" asp-route-urgency="@Model.Urgency" asp-route-viewId="@Model.ViewId" asp-route-obrigacao="@Model.SelectedObligationId"
                                  class="form-stack">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="version" value="@item.Version" />
                                <label>@L.T("sheet.cancel_reason_label", _culture)
                                    <input type="text" name="reason" required placeholder="@L.T("sheet.justification_short", _culture)" />
                                </label>
                                <button class="button button-danger" type="button" data-confirm-open data-confirm-form="cancel-form-@item.SourceId"
                                        data-confirm-title="@L.T("sheet.confirm_cancel_title", _culture)"
                                        data-confirm-body="@L.T("sheet.confirm_cancel_body", _culture, item.Title)"
                                        data-confirm-action="@L.T("sheet.confirm_cancel_title", _culture)">@L.T("sheet.confirm_cancel_title", _culture)</button>
                            </form>
                        </div>
                    </details>
                </div>
            </article>
        }
    }
</section>

<!-- SEÇÃO MINUTAS SUGERIDAS -->
<section id="minutas" class="renewal-list">
    <div class="list-header">
        <h2>@L.T("sheet.drafts", _culture)</h2>
    </div>
    <p class="muted">
        @L.T("sheet.templates_note", _culture)
    </p>

    @if (sheet.RecommendedTemplates is null || sheet.RecommendedTemplates.Count == 0)
    {
        <div class="empty-state">
            <strong>@L.T("sheet.no_templates_title", _culture)</strong>
            <p>@L.T("sheet.no_templates_body", _culture)</p>
        </div>
    }
    else
    {
        @foreach (var template in sheet.RecommendedTemplates)
        {
            <article class="renewal-row">
                <div>
                    <span class="status-label">@template.ContractType</span>
                    <h3>@template.Name</h3>
                    <p>@template.Reason</p>
                </div>
                <div class="form-actions-row">
                    <form id="draft-form-@template.Key" method="post" asp-action="StartOfficialDraft" asp-route-tenantId="@tenantId" asp-route-contractId="@sheet.ContractId"
                          asp-route-from="@Model.FromSource" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
                          asp-route-scope="@Model.Scope" asp-route-kind="@Model.Kind" asp-route-urgency="@Model.Urgency" asp-route-viewId="@Model.ViewId" asp-route-obrigacao="@Model.SelectedObligationId">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="officialKey" value="@template.Key" />
                        <input type="hidden" name="sheetVersion" value="@sheet.Version" />
                        <button class="button button-primary" type="button"
                                data-confirm-open data-confirm-form="draft-form-@template.Key"
                                data-confirm-title="@L.T("sheet.generate_draft_title", _culture)"
                                data-confirm-body="@L.T("sheet.confirm_draft_body", _culture, template.Name, sheet.Title)"
                                data-confirm-action="@L.T("sheet.generate_draft_action", _culture)">@L.T("sheet.generate_draft_title", _culture)</button>
                    </form>
                    <a class="button button-quiet" asp-controller="Studio" asp-action="Index" asp-route-tenantId="@tenantId" asp-route-type="@template.ContractType">@L.T("sheet.view_studio", _culture)</a>
                </div>
            </article>
        }
    }
</section>

<!-- SEÇÃO ASSINATURA (B.3.2c) -->
<section id="assinatura" class="renewal-list" aria-label="@L.T("sheet.sig_section_aria_label", _culture)">
    <div class="list-header">
        <h2>@L.T("sheet.signatures", _culture)</h2>
        @if (sheet.Signature is not null)
        {
            <span class="muted">@L.T("sheet.sig_version_number", _culture, sheet.Signature.VersionNumber.ToString()) · @ReviewStatusLabel(sheet.Signature.ReviewStatus)</span>
        }
    </div>

    @if (sheet.Signature is null)
    {
        <div class="empty-state">
            <strong>@L.T("sheet.sig_empty_title", _culture)</strong>
            <p>@L.T("sheet.sig_empty_body", _culture)</p>
            @if (sheet.DraftId.HasValue)
            {
                <a class="button button-quiet" href="/organizacoes/@tenantId/estudio/minutas/@sheet.DraftId.Value?returnUrl=@Uri.EscapeDataString(returnUrl)">@L.T("sheet.sig_open_draft_btn", _culture)</a>
            }
        </div>
    }
    else
    {
        var signature = sheet.Signature;
        var preparationConfirmed = signature.PreparationStatus == "confirmed";
        var pdfCompleted = signature.PdfStatus == "completed";

        <div class="renewal-cards">
            <div>
                <strong>@L.T("sheet.sig_version_number", _culture, signature.VersionNumber.ToString())</strong>
                <span>@L.T("sheet.sig_version_generated_label", _culture)</span>
            </div>
            <div>
                <strong>@(preparationConfirmed ? L.T("sheet.sig_status_confirmed", _culture) : L.T("sheet.sig_status_draft", _culture))</strong>
                <span>@L.T("sheet.sig_preparation_label", _culture)</span>
            </div>
            <div>
                <strong>@ReviewStatusLabel(signature.ReviewStatus)</strong>
                <span>@L.T("sheet.sig_review_situation_label", _culture)</span>
            </div>
            <div>
                <strong>@(signature.LastRemindedAt is DateTimeOffset lastReminded ? CulturedTime.DateTime(lastReminded, _culture) : L.T("sheet.sig_last_reminder_never", _culture))</strong>
                <span>@L.T("sheet.sig_last_reminder_label", _culture)</span>
            </div>
        </div>

        <p class="muted">
            @L.T("sheet.sig_how_intro", _culture) <strong>@L.T("sheet.sig_how_session_bold", _culture)</strong>
            @L.T("sheet.sig_how_session_detail", _culture)
            <strong>@L.T("sheet.sig_how_evidence_bold", _culture)</strong>
            @L.T("sheet.sig_how_evidence_detail", _culture)
            @L.T("sheet.sig_how_external_note", _culture)
        </p>

        @if (!preparationConfirmed)
        {
            <div class="banner-notice-warning" role="status">
                @L.T("sheet.sig_draft_banner", _culture)
            </div>
        }

        @if (signature.Participants.Count == 0)
        {
            <p class="muted">@L.T("sheet.sig_no_participants", _culture)</p>
        }

        @foreach (var participant in signature.Participants)
        {
            var alreadySigned = participant.SignedAt.HasValue;
            // D-A1: exibição honesta da modalidade registrada (linhas pré-v043 sem modalidade).
            var modalityLabel = participant.SignedThrough switch
            {
                "session" => L.T("sheet.sig_modality_session", _culture),
                "evidence" => L.T("sheet.sig_modality_evidence", _culture),
                _ => L.T("sheet.sig_modality_legacy", _culture)
            };
            var mySessionName = User.Identity?.Name ?? L.T("sheet.sig_your_session", _culture);
            <article class="renewal-row">
                <div>
                    <span class="status-label">@ParticipantTypeLabel(participant.ParticipantType)</span>
                    <h3>@participant.Name</h3>
                    <p class="muted">@participant.Role</p>
                </div>
                <div class="next-action">
                    @if (alreadySigned)
                    {
                        <span class="status-label">@modalityLabel @L.T("sheet.sig_signed_on", _culture, CulturedTime.DateTime(participant.SignedAt!.Value, _culture))</span>
                    }
                    else
                    {
                        <span class="muted">@L.T("sheet.sig_waiting", _culture)</span>
                        @if (Model.CanSignDocuments && preparationConfirmed)
                        {
                            <form id="sign-form-@participant.ClientId" method="post" asp-action="SignParticipant" asp-route-tenantId="@tenantId" asp-route-contractId="@sheet.ContractId"
                                  asp-route-versionId="@signature.VersionId" asp-route-preparationId="@signature.PreparationId" asp-route-participantClientId="@participant.ClientId"
                                  asp-route-from="@Model.FromSource" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
                                  asp-route-scope="@Model.Scope" asp-route-kind="@Model.Kind" asp-route-urgency="@Model.Urgency" asp-route-viewId="@Model.ViewId" asp-route-obrigacao="@Model.SelectedObligationId">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="participantName" value="@participant.Name" />
                                @if (participant.IdentityLinkedToMe)
                                {
                                    <input type="hidden" name="signMode" value="session" />
                                    <button class="button button-primary" type="button"
                                            data-confirm-open data-confirm-form="sign-form-@participant.ClientId"
                                            data-confirm-title="@L.T("sheet.sig_sign_session_confirm_title", _culture)"
                                            data-confirm-body="@L.T("sheet.sig_sign_session_confirm_body", _culture, participant.Name, mySessionName)"
                                            data-confirm-action="@L.T("sheet.sig_sign_session_confirm_action", _culture)">@L.T("sheet.sig_sign_session_btn", _culture)</button>
                                }
                                else
                                {
                                    <input type="hidden" name="signMode" value="evidence" />
                                    <details class="sign-evidence-details">
                                        <summary class="button button-quiet" style="display:inline-block">@L.T("sheet.sig_evidence_summary", _culture, participant.Name)</summary>
                                        <div class="field-stack">
                                            <label class="field-label" for="evidence-@participant.ClientId">@L.T("sheet.sig_evidence_label", _culture)</label>
                                            <textarea id="evidence-@participant.ClientId" name="evidence" rows="3" required minlength="5" maxlength="2000"
                                                      placeholder="@L.T("sheet.sig_evidence_placeholder", _culture)"></textarea>
                                            <!-- D-OC31 B.2: vínculo opcional de documento do acervo como evidência;
                                                 o hash é copiado do servidor e gravado junto com o id do documento. -->
                                            <label class="field-label" for="evidence-doc-@participant.ClientId">@L.T("sheet.sig_evidence_doc_label", _culture)</label>
                                            <select id="evidence-doc-@participant.ClientId" name="evidenceDocumentVersion">
                                                <option value="">@L.T("sheet.sig_evidence_doc_none", _culture)</option>
                                                @foreach (var doc in sheet.Documents.Where(d => d.SafetyState == "safe"))
                                                {
                                                    <option value="@doc.VersionId">@doc.Name</option>
                                                }
                                            </select>
                                            @if (!sheet.Documents.Any(d => d.SafetyState == "safe"))
                                            {
                                                <p class="permission-note">@L.T("sheet.sig_evidence_doc_empty", _culture)</p>
                                            }
                                            <button class="button button-primary" type="submit">@L.T("sheet.sig_evidence_submit", _culture)</button>
                                        </div>
                                    </details>
                                }
                            </form>
                            <form id="link-form-@participant.ClientId" method="post" asp-action="LinkParticipantIdentity" asp-route-tenantId="@tenantId" asp-route-contractId="@sheet.ContractId"
                                  asp-route-versionId="@signature.VersionId" asp-route-preparationId="@signature.PreparationId" asp-route-participantClientId="@participant.ClientId"
                                  asp-route-from="@Model.FromSource" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
                                  asp-route-scope="@Model.Scope" asp-route-kind="@Model.Kind" asp-route-urgency="@Model.Urgency" asp-route-viewId="@Model.ViewId" asp-route-obrigacao="@Model.SelectedObligationId">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="participantName" value="@participant.Name" />
                                <button class="button button-quiet" type="button"
                                        data-confirm-open data-confirm-form="link-form-@participant.ClientId"
                                        data-confirm-title="@L.T("sheet.sig_link_confirm_title", _culture)"
                                        data-confirm-body="@L.T("sheet.sig_link_confirm_body", _culture, mySessionName, participant.Name)"
                                        data-confirm-action="@L.T("sheet.sig_link_action", _culture)">@L.T("sheet.sig_link_action", _culture)</button>
                            </form>
                        }
                    }
                </div>
            </article>
        }

        <div class="form-actions-row form-stack">
            @if (Model.CanSignDocuments && preparationConfirmed)
            {
                <form id="remind-signature-form" method="post" asp-action="RemindSignature" asp-route-tenantId="@tenantId" asp-route-contractId="@sheet.ContractId"
                      asp-route-versionId="@signature.VersionId" asp-route-preparationId="@signature.PreparationId"
                      asp-route-from="@Model.FromSource" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
                      asp-route-scope="@Model.Scope" asp-route-kind="@Model.Kind" asp-route-urgency="@Model.Urgency" asp-route-viewId="@Model.ViewId" asp-route-obrigacao="@Model.SelectedObligationId">
                    @Html.AntiForgeryToken()
                    <button class="button button-quiet" type="button"
                            data-confirm-open data-confirm-form="remind-signature-form"
                            data-confirm-title="@L.T("sheet.sig_remind_confirm_title", _culture)"
                            data-confirm-body="@L.T("sheet.sig_remind_confirm_body", _culture)"
                            data-confirm-action="@L.T("sheet.sig_remind_action", _culture)">@L.T("sheet.sig_remind_action", _culture)</button>
                </form>
            }

            @if (Model.CanReadDocuments)
            {
                @if (pdfCompleted)
                {
                    <a class="button button-quiet"
                       href="/organizacoes/@tenantId/contratos/@sheet.ContractId/versoes/@signature.VersionId/pdf-baixar@pdfBaixarQuery">@L.T("sheet.sig_download_pdf", _culture)</a>
                    <a class="button button-quiet" target="_blank" rel="noopener"
                       href="/organizacoes/@tenantId/contratos/@sheet.ContractId/versoes/@signature.VersionId/imprimir">@L.T("sheet.sig_print_preview", _culture)</a>
                }
                else if (Model.CanSignDocuments)
                {
                    <form id="generate-pdf-form" method="post" asp-action="GenerateVersionPdf" asp-route-tenantId="@tenantId" asp-route-contractId="@sheet.ContractId"
                          asp-route-versionId="@signature.VersionId"
                          asp-route-from="@Model.FromSource" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
                          asp-route-scope="@Model.Scope" asp-route-kind="@Model.Kind" asp-route-urgency="@Model.Urgency" asp-route-viewId="@Model.ViewId" asp-route-obrigacao="@Model.SelectedObligationId">
                        @Html.AntiForgeryToken()
                        <button class="button button-primary" type="submit">@L.T("sheet.sig_generate_pdf", _culture)</button>
                    </form>
                }
            }
        </div>
        <p class="muted">@L.T("sheet.sig_immutability_note", _culture)</p>
    }
</section>

<!-- SEÇÃO DOCUMENTOS RECENTES -->
<section id="documentos" class="renewal-list">
    <div class="list-header">
        <h2>@L.T("sheet.documents", _culture)</h2>
        <span>@L.T("sheet.documents_count", _culture, sheet.Documents.Count.ToString(System.Globalization.CultureInfo.InvariantCulture))</span>
    </div>
    @if (sheet.Documents.Count == 0)
    {
        <p class="muted">@L.T("sheet.no_documents", _culture)</p>
    }
    else
    {
        @foreach (var document in sheet.Documents)
        {
            <article class="renewal-row">
                <div>
                    <span class="status-label">@DocState(document.SafetyState)</span>
                    @if (document.SafetyState == "safe" && document.SecurityEngine == "simulated-scanner-dev")
                    {
                        <span class="status-label badge-muted" title="Engine: simulated-scanner-dev">@L.T("sheet.doc_simulated", _culture)</span>
                    }
                    <h3>@document.Name</h3>
                </div>
                <dl>
                    <div>
                        <dt>@L.T("sheet.last_updated", _culture)</dt>
                        <dd>@document.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</dd>
                    </div>
                </dl>
                <div class="next-action">
                    @if (document.SafetyState == "safe")
                    {
                        <a class="button button-quiet"
                           asp-controller="Contracts" asp-action="DownloadDocument"
                           asp-route-tenantId="@tenantId" asp-route-contractId="@sheet.ContractId"
                           asp-route-documentId="@document.DocumentId" asp-route-versionId="@document.VersionId"
                           asp-route-from="@Model.FromSource" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
                           asp-route-scope="@Model.Scope" asp-route-kind="@Model.Kind" asp-route-urgency="@Model.Urgency" asp-route-viewId="@Model.ViewId">@L.T("action.download", _culture)</a>
                    }
                    else
                    {
                        <span class="status-label muted" title="@L.T("sheet.quarantine_tip", _culture)">@L.T("sheet.doc_quarantine", _culture)</span>
                    }
                </div>
            </article>
        }
    }
</section>

<!-- SEÇÃO SEQUÊNCIA DE DOCUMENTOS DERIVADOS (Item 12) -->
@if (sheet.DerivedDocuments is { Count: > 0 })
{
    <section id="derivados" class="renewal-list" aria-label="@L.T("sheet.derived_aria", _culture)">
        <div class="list-header">
            <h2>@L.T("sheet.derived", _culture)</h2>
            <span>@sheet.DerivedDocuments.Count @L.T("sheet.derived_count", _culture)</span>
        </div>
        @foreach (var d in sheet.DerivedDocuments)
        {
            var reviewLabel = d.ReviewStatus switch
            {
                "generated" => L.T("sheet.review_generated", _culture),
                "submitted" => L.T("sheet.chg_review", _culture),
                "internally_approved" => L.T("sheet.chg_approved", _culture),
                "externally_signed" => L.T("sheet.chg_externally_signed", _culture),
                _ => d.ReviewStatus
            };
            var kindLabel = d.DerivedFromKind switch
            {
                "renewal" => L.T("sheet.chg_kind_renewal", _culture),
                "amendment" => L.T("sheet.chg_kind_amendment", _culture),
                "revision" => L.T("sheet.chg_kind_revision", _culture),
                _ => d.DerivedFromKind ?? ""
            };
            var hasDelta = d.BeforeStart is not null || d.BeforeEnd is not null || d.BeforeValue is not null
                            || d.AfterStart is not null || d.AfterEnd is not null || d.AfterValue is not null;
            <article class="renewal-row">
                <div>
                    <span class="status-label">v@(d.VersionNumber)</span>
                    <span class="status-label badge-muted">@reviewLabel</span>
                    <h3>@(string.IsNullOrWhiteSpace(kindLabel)
                        ? L.T("sheet.derived_direct", _culture)
                        : $"{L.T("sheet.derived_from", _culture)} {kindLabel}")</h3>
                    @if (!string.IsNullOrWhiteSpace(d.Sha256Prefix))
                    {
                        <p class="muted" title="@L.T("sheet.sha_canonical", _culture)">@d.Sha256Prefix…</p>
                    }
                </div>
                <dl>
                    <div>
                        <dt>@L.T("sheet.derived_generated", _culture)</dt>
                        <dd>@d.GeneratedAt.ToString("dd/MM/yyyy HH:mm")</dd>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(kindLabel))
                    {
                        @if (!string.IsNullOrWhiteSpace(d.OriginReason))
                        {
                            <div><dt>@L.T("sheet.chg_reason", _culture)</dt><dd>@d.OriginReason</dd></div>
                        }
                        @if (d.EffectiveOn is not null)
                        {
                            <div>
                                <dt>@L.T("sheet.chg_effective", _culture)</dt>
                                <dd>@d.EffectiveOn.Value.ToString("dd/MM/yyyy")</dd>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(d.AppliedByName) && d.AppliedAt is not null)
                        {
                            <div>
                                <dt>@L.T("sheet.derived_applied_on", _culture)</dt>
                                <dd>@d.AppliedAt.Value.ToString("dd/MM/yyyy HH:mm") @L.T("sheet.derived_applied_by", _culture) <strong>@d.AppliedByName</strong></dd>
                            </div>
                        }
                        @if (hasDelta)
                        {
                            var beforePeriod = (d.BeforeStart is not null || d.BeforeEnd is not null)
                                ? $"{(d.BeforeStart?.ToString("dd/MM/yyyy") ?? "—")} → {(d.BeforeEnd?.ToString("dd/MM/yyyy") ?? L.T("sheet.indefinite", _culture))}"
                                : null;
                            var afterPeriod = (d.AfterStart is not null || d.AfterEnd is not null)
                                ? $"{(d.AfterStart?.ToString("dd/MM/yyyy") ?? "—")} → {(d.AfterEnd?.ToString("dd/MM/yyyy") ?? L.T("sheet.indefinite", _culture))}"
                                : null;
                            var beforeValue = d.BeforeValue is not null
                                ? $"{d.BeforeValue.Value.ToString("N2")} {(d.BeforeCurrency ?? "")}".TrimEnd()
                                : null;
                            var afterValue = d.AfterValue is not null
                                ? $"{d.AfterValue.Value.ToString("N2")} {(d.AfterCurrency ?? "")}".TrimEnd()
                                : null;
                            <div>
                                <dt>@L.T("sheet.derived_change", _culture)</dt>
                                <dd>
                                    @if (beforePeriod is not null || afterPeriod is not null)
                                    {
                                        <span>@L.T("sheet.derived_period", _culture): @(beforePeriod ?? "—") → @(afterPeriod ?? "—")</span><br />
                                    }
                                    @if (beforeValue is not null || afterValue is not null)
                                    {
                                        <span>@L.T("sheet.derived_value", _culture): @(beforeValue ?? "—") → @(afterValue ?? "—")</span>
                                    }
                                </dd>
                            </div>
                        }
                    }
                </dl>
                <div class="next-action">
                    <span class="status-label muted" title="@d.VersionId">@d.VersionId.ToString().Substring(0, 8)…</span>
                </div>
            </article>
        }
    </section>
}

<!-- SEÇÃO SOLICITAÇÕES ODCA RELACIONADAS AO CONTRATO -->
@if (sheet.Solicitations is { Count: > 0 })
{
    <section id="solicitacoes" class="renewal-list">
        <div class="list-header">
            <h2>@L.T("sheet.solicitations", _culture)</h2>
            <span>@L.T("sheet.sol_count", _culture, sheet.Solicitations.Count.ToString(System.Globalization.CultureInfo.InvariantCulture))</span>
        </div>
        @foreach (var sol in sheet.Solicitations)
        {
            <article class="renewal-row">
                <div>
                    <span class="status-label">@SolStatus(sol.Status)</span>
                    <h3>@sol.Subject</h3>
                </div>
                <dl>
                    <div><dt>@L.T("common.service", _culture)</dt><dd>@SolService(sol.ServiceType)</dd></div>
                    <div><dt>@L.T("common.priority", _culture)</dt><dd>@SolPriority(sol.Priority)</dd></div>
                    @if (sol.SlaDueOn.HasValue)
                    {
                        <div><dt>@L.T("sheet.sla_due", _culture)</dt><dd>@sol.SlaDueOn.Value.ToString("dd/MM/yyyy")</dd></div>
                    }
                </dl>
                <div class="next-action">
                    <a class="button button-quiet" asp-controller="Solicitacoes" asp-action="Detail"
                       asp-route-tenantId="@tenantId" asp-route-id="@sol.Id">@L.T("common.open", _culture)</a>
                </div>
            </article>
        }
    </section>
}

<!-- SEÇÃO HISTÓRICO DO CONTRATO (B.3.2c) -->
@if (Model.CanReadHistory)
{
    <section id="historico" class="renewal-list" aria-label="@L.T("sheet.history_aria", _culture)">
        <div class="list-header">
            <h2>@L.T("sheet.history", _culture)</h2>
            <span>@L.T("sheet.events_count", _culture, Model.EventTotal.ToString(System.Globalization.CultureInfo.InvariantCulture))</span>
        </div>

        @if (Model.Events.Count == 0)
        {
            <div class="empty-state">
                <strong>@L.T("sheet.no_events_title", _culture)</strong>
                <p>@L.T("sheet.no_events_body", _culture)</p>
            </div>
        }
        else
        {
            @foreach (var ev in Model.Events)
            {
                <article class="renewal-row">
                    <div>
                        <span class="status-label">@EventLabel(ev.Type)</span>
                        <p class="muted"><small>@ev.Type</small></p>
                    </div>
                    <dl>
                        <div>
                            <dt>@L.T("sheet.when", _culture)</dt>
                            <dd>@ev.OccurredAt.ToString("dd/MM/yyyy HH:mm")</dd>
                        </div>
                        <div>
                            <dt>@L.T("sheet.by_actor", _culture)</dt>
                            <dd>@(string.IsNullOrWhiteSpace(ev.Actor) ? L.T("sheet.system", _culture) : ev.Actor)</dd>
                        </div>
                    </dl>
                    <div class="next-action">
                        @if (!string.IsNullOrWhiteSpace(ev.Details))
                        {
                            <small class="muted">@ev.Details</small>
                        }
                    </div>
                </article>
            }

            @if (Model.EventTotal > Model.EventPage * 50)
            {
                <div class="form-actions-row">
                    <a class="button button-quiet"
                       href="@EventPageUrl(tenantIdValue, sheet.ContractId, Model.EventPage + 1, Model.FromSource, Model.Year, Model.Month, Model.Scope, Model.Kind, Model.Urgency, Model.ViewId, Model.SelectedObligationId)">@L.T("sheet.next_events", _culture)</a>
                </div>
            }
        }
    </section>
}

<!-- SEÇÃO AÇÕES DO CICLO DE VIDA (B.3.2c) -->
<section id="acoes" class="renewal-list" aria-label="@L.T("sheet.actions_aria", _culture)">
    <div class="list-header">
        <h2>@L.T("sheet.actions", _culture)</h2>
        <span class="muted">@L.T("sheet.actions_note", _culture)</span>
    </div>

    @if (!Model.CanManageContracts)
    {
        <p class="muted">@L.T("sheet.actions_readonly", _culture)</p>
    }
    else
    {
        <div class="form-actions-row form-stack">
            @if (sheet.Status != "closed")
            {
                <form id="duplicate-form" method="post" asp-action="Duplicate" asp-route-tenantId="@tenantId" asp-route-contractId="@sheet.ContractId"
                      asp-route-from="@Model.FromSource" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
                      asp-route-scope="@Model.Scope" asp-route-kind="@Model.Kind" asp-route-urgency="@Model.Urgency" asp-route-viewId="@Model.ViewId" asp-route-obrigacao="@Model.SelectedObligationId">
                    @Html.AntiForgeryToken()
                    <button class="button button-primary" type="button"
                            data-confirm-open data-confirm-form="duplicate-form"
                            data-confirm-title="@L.T("sheet.duplicate_btn", _culture)"
                            data-confirm-body="@L.T("sheet.dup_confirm_body", _culture)"
                            data-confirm-action="@L.T("sheet.dup_action", _culture)">@L.T("sheet.duplicate_btn", _culture)</button>
                </form>
            }

            @if (sheet.Status == "active" || sheet.Status == "expired")
            {
                <details data-dirty-form>
                    <summary class="button button-quiet">@L.T("sheet.archive_btn", _culture)</summary>
                    <div class="details-subpanel">
                        <form id="archive-form" method="post" asp-action="Archive" asp-route-tenantId="@tenantId" asp-route-contractId="@sheet.ContractId"
                              asp-route-from="@Model.FromSource" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
                              asp-route-scope="@Model.Scope" asp-route-kind="@Model.Kind" asp-route-urgency="@Model.Urgency" asp-route-viewId="@Model.ViewId" asp-route-obrigacao="@Model.SelectedObligationId"
                              class="form-stack">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="version" value="@sheet.Version" />
                            <label>@L.T("sheet.archive_reason_optional", _culture)
                                <textarea name="reason" rows="2" maxlength="500" placeholder="@L.T("sheet.archive_reason_ph", _culture)"></textarea>
                            </label>
                            <button class="button button-quiet" type="button"
                                    data-confirm-open data-confirm-form="archive-form"
                                    data-confirm-title="@L.T("sheet.archive_contract_btn", _culture)"
                                    data-confirm-body="@L.T("sheet.archive_confirm_body", _culture, sheet.Title)"
                                    data-confirm-action="@L.T("sheet.archive_btn", _culture)">@L.T("sheet.archive_contract_btn", _culture)</button>
                        </form>
                    </div>
                </details>
            }

            @if (sheet.Status == "archived")
            {
                <form id="restore-form" method="post" asp-action="Restore" asp-route-tenantId="@tenantId" asp-route-contractId="@sheet.ContractId"
                      asp-route-from="@Model.FromSource" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
                      asp-route-scope="@Model.Scope" asp-route-kind="@Model.Kind" asp-route-urgency="@Model.Urgency" asp-route-viewId="@Model.ViewId" asp-route-obrigacao="@Model.SelectedObligationId">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="version" value="@sheet.Version" />
                    <button class="button button-primary" type="button"
                            data-confirm-open data-confirm-form="restore-form"
                            data-confirm-title="@L.T("sheet.restore_btn", _culture)"
                            data-confirm-body="@L.T("sheet.restore_confirm_body", _culture, sheet.Title)"
                            data-confirm-action="@L.T("sheet.restore_action", _culture)">@L.T("sheet.restore_btn", _culture)</button>
                </form>
            }

            @if (sheet.Status != "closed")
            {
                <details data-dirty-form>
                    <summary class="button button-danger">@L.T("sheet.close_btn", _culture)</summary>
                    <div class="details-subpanel">
                        <form id="close-form" method="post" asp-action="Close" asp-route-tenantId="@tenantId" asp-route-contractId="@sheet.ContractId"
                              asp-route-from="@Model.FromSource" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
                              asp-route-scope="@Model.Scope" asp-route-kind="@Model.Kind" asp-route-urgency="@Model.Urgency" asp-route-viewId="@Model.ViewId" asp-route-obrigacao="@Model.SelectedObligationId"
                              class="form-stack">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="version" value="@sheet.Version" />
                            <label>@L.T("sheet.close_date_label", _culture)
                                <input type="date" name="closedOn" required min="@todayStr" value="@todayStr" />
                            </label>
                            <label>@L.T("sheet.closure_reason_label", _culture)
                                <textarea name="closureReason" rows="3" required minlength="5" maxlength="2000" placeholder="@L.T("sheet.close_reason_ph", _culture)"></textarea>
                            </label>
                            <button class="button button-danger" type="button"
                                    data-confirm-open data-confirm-form="close-form"
                                    data-confirm-title="@L.T("sheet.close_confirm_title", _culture)"
                                    data-confirm-body="@L.T("sheet.close_confirm_body", _culture, sheet.Title)"
                                    data-confirm-action="@L.T("sheet.close_confirm_title", _culture)">@L.T("sheet.close_confirm_title", _culture)</button>
                        </form>
                    </div>
                </details>
            }
        </div>

        <p class="muted">
            @L.T("sheet.close_vs_archive", _culture)
        </p>
    }

    <!-- NOVA SOLICITACAO ODCA A PARTIR DO CONTRATO (Item 19) -->
    <details data-dirty-form style="margin-top:1rem;">
        <summary class="button button-quiet">@L.T("sheet.new_sol_btn", _culture)</summary>
        <div class="details-subpanel">
            <form id="new-solicitation-form" class="form-stack" method="post"
                  asp-controller="Solicitacoes" asp-action="Create"
                  asp-route-tenantId="@tenantId"
                  data-context="contract" data-contract-id="@sheet.ContractId"
                  data-contract-title="@sheet.Title">
                @Html.AntiForgeryToken()
                <input type="hidden" name="contractContext" value="@sheet.ContractId" />
                <label>@L.T("common.service", _culture)
                    <select name="service" required>
                        <option value="" disabled selected>@L.T("sheet.select_service", _culture)</option>
                        <option value="revisao">@L.T("sheet.svc_documental_review", _culture)</option>
                        <option value="adaptacao">@L.T("sheet.svc_model_adaptation", _culture)</option>
                        <option value="esclarecimento">@L.T("sheet.svc_contractual_clarification", _culture)</option>
                        <option value="suporte_tecnico">@L.T("sol.service.suporte_tecnico", _culture)</option>
                    </select>
                </label>
                <label>@L.T("common.priority", _culture)
                    <select name="priority">
                        <option value="normal" selected>@L.T("sol.priority.normal", _culture)</option>
                        <option value="alta">@L.T("sol.priority.alta", _culture)</option>
                        <option value="critica">@L.T("sol.priority.critica", _culture)</option>
                        <option value="baixa">@L.T("sol.priority.baixa", _culture)</option>
                    </select>
                </label>
                <label>@L.T("sheet.subject_label", _culture)
                    <input type="text" name="subject" required minlength="5" maxlength="300"
                           value="@(L.T("sheet.subject_default", _culture, sheet.Title))" />
                </label>
                <label>@L.T("common.description", _culture)
                    <textarea name="body" rows="3" required minlength="10" maxlength="5000"
                              placeholder="@L.T("sheet.sol_desc_ph", _culture)"></textarea>
                </label>
                <p class="muted"><small>@L.T("sheet.sol_sla_note", _culture)</small></p>
                <button class="button button-primary" type="submit">@L.T("sheet.send_sol", _culture)</button>
            </form>
        </div>
    </details>
</section>

<!-- DRAWER DE HISTÓRICO DE OBRIGAÇÕES -->
<div id="history-backdrop" class="history-drawer-backdrop" hidden></div>
<aside id="history-drawer" class="history-drawer" aria-labelledby="history-drawer-title" aria-modal="true" role="dialog" hidden>
    <div class="history-drawer-header">
        <h3 id="history-drawer-title">@L.T("sheet.drawer_title", _culture)</h3>
        <button type="button" id="history-drawer-close" class="button button-quiet" aria-label="@L.T("sheet.drawer_close_aria", _culture)">✕</button>
    </div>
    <div id="history-drawer-subtitle" class="muted"></div>
    <div id="history-drawer-content" role="region" aria-live="polite">
        <p class="muted">@L.T("sheet.drawer_loading", _culture)</p>
    </div>
</aside>

<script>
document.addEventListener('DOMContentLoaded', () => {
    // D-OC42 (S8): bag de mensagens do drawer em português da cultura atual (padrão canônico da página).
    const drawerI18n = @System.Text.Json.JsonSerializer.Serialize(new
    {
        culture = _culture ?? "pt-BR",
        loading = L.T("sheet.drawer_loading", _culture),
        sessionExpired = L.T("sheet.session_expired", _culture),
        forbidden = L.T("sheet.drawer_forbidden", _culture),
        notFound = L.T("sheet.drawer_not_found", _culture),
        fetchFail = L.T("sheet.drawer_fetch_fail", _culture),
        noEvents = L.T("sheet.drawer_no_events", _culture),
        eventWord = L.T("sheet.event_word", _culture),
        byPrefix = L.T("sheet.by_prefix", _culture),
        system = L.T("sheet.system", _culture),
        error = L.T("sheet.drawer_error", _culture)
    });

    // Subnav sticky com aria-current
    function updateSubnavActive() {
        const hash = window.location.hash || '#detalhes';
        document.querySelectorAll('.sheet-subnav a').forEach(link => {
            const href = link.getAttribute('href');
            if (href && href.startsWith('#')) {
                if (href === hash) {
                    link.setAttribute('aria-current', 'true');
                    link.classList.add('active');
                } else {
                    link.removeAttribute('aria-current');
                    link.classList.remove('active');
                }
            }
        });
    }
    window.addEventListener('hashchange', updateSubnavActive);
    updateSubnavActive();

    // Drawer de histórico seguro
    const backdrop = document.getElementById('history-backdrop');
    const drawer = document.getElementById('history-drawer');
    const closeBtn = document.getElementById('history-drawer-close');
    const content = document.getElementById('history-drawer-content');
    const subtitle = document.getElementById('history-drawer-subtitle');

    function closeDrawer() {
        if (backdrop) backdrop.hidden = true;
        if (drawer) drawer.hidden = true;
    }

    closeBtn?.addEventListener('click', closeDrawer);
    backdrop?.addEventListener('click', closeDrawer);
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && drawer && !drawer.hidden) {
            closeDrawer();
        }
    });

    document.querySelectorAll('.btn-history-drawer').forEach(btn => {
        btn.addEventListener('click', async () => {
            const id = btn.getAttribute('data-id');
            const title = btn.getAttribute('data-title');
            if (!id) return;

            if (subtitle) subtitle.textContent = title || '';
            if (content) content.textContent = drawerI18n.loading;
            if (backdrop) backdrop.hidden = false;
            if (drawer) drawer.hidden = false;

            try {
                const response = await fetch(`/organizacoes/@tenantId/obrigacoes/${id}/historico`);
                if (!content) return;
                content.textContent = '';

                if (response.redirected || response.status === 401) {
                    content.textContent = drawerI18n.sessionExpired;
                    setTimeout(() => window.location.assign('/entrar?ReturnUrl=' + encodeURIComponent(window.location.pathname + window.location.search)), 1200);
                    return;
                }

                if (response.status === 403) {
                    const alert = document.createElement('div');
                    alert.className = 'validation-summary';
                    alert.textContent = drawerI18n.forbidden;
                    content.appendChild(alert);
                    return;
                }

                if (response.status === 404) {
                    const p = document.createElement('p');
                    p.className = 'muted';
                    p.textContent = drawerI18n.notFound;
                    content.appendChild(p);
                    return;
                }

                if (!response.ok) {
                    const p = document.createElement('p');
                    p.className = 'muted';
                    p.textContent = drawerI18n.fetchFail;
                    content.appendChild(p);
                    return;
                }

                const data = await response.json();
                const items = data.events || data.Items || [];
                if (items.length === 0) {
                    const p = document.createElement('p');
                    p.className = 'muted';
                    p.textContent = drawerI18n.noEvents;
                    content.appendChild(p);
                    return;
                }

                const list = document.createElement('div');
                list.className = 'form-stack';

                items.forEach(ev => {
                    const card = document.createElement('article');
                    card.className = 'comment-card';

                    const header = document.createElement('div');
                    header.className = 'list-header';

                    const typeSpan = document.createElement('strong');
                    typeSpan.textContent = ev.eventType || ev.EventType || drawerI18n.eventWord;
                    header.appendChild(typeSpan);

                    const dateSpan = document.createElement('small');
                    dateSpan.className = 'muted';
                    const dt = ev.occurredAt || ev.OccurredAt;
                    dateSpan.textContent = dt ? new Date(dt).toLocaleString(drawerI18n.culture) : '';
                    header.appendChild(dateSpan);

                    card.appendChild(header);

                    const actorP = document.createElement('p');
                    const actorBold = document.createElement('strong');
                    actorBold.textContent = ev.actor || ev.Actor || drawerI18n.system;
                    actorP.appendChild(document.createTextNode(drawerI18n.byPrefix));
                    actorP.appendChild(actorBold);
                    card.appendChild(actorP);

                    const details = ev.details || ev.Details;
                    if (details) {
                        const detP = document.createElement('div');
                        detP.className = 'muted';
                        detP.textContent = typeof details === 'string' ? details : JSON.stringify(details);
                        card.appendChild(detP);
                    }

                    list.appendChild(card);
                });

                content.appendChild(list);
            } catch (err) {
                if (content) content.textContent = drawerI18n.error;
            }
        });
    });

    // B.3.2c — formulário de detalhes: envia o responsável apenas se mudou ou se pediu remoção explícita
    const detailsForm = document.getElementById('details-form');
    if (detailsForm) {
        detailsForm.addEventListener('submit', () => {
            const ownerSelect = detailsForm.querySelector('select[name="ownerId"]');
            const clearOwner = detailsForm.querySelector('input[name="clearOwner"]');
            if (!ownerSelect || !clearOwner) return;
            if (!clearOwner.checked && ownerSelect.value === (ownerSelect.dataset.initial || '')) {
                ownerSelect.value = '';
            }
        });
    }
});
</script>
