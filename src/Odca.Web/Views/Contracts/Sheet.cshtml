@model Odca.Web.Models.ContractSheetViewModel
@{
    var tenantId = ViewData["TenantId"];
    var sheet = Model.Sheet;
    var notice = TempData["ContractSheetNotice"] as string;
    var error = TempData["ContractSheetError"] as string ?? Model.Error;
    var todayStr = (sheet?.Today ?? DateOnly.FromDateTime(DateTime.Today)).ToString("yyyy-MM-dd");
    var isAmendmentRequired = sheet?.Renewal?.InThreeMonthWindow == true;
    var returnUrl = tenantId is not null && sheet is not null
        ? Odca.Web.Controllers.ContractsController.BuildReturnUrl(
            (Guid)tenantId,
            sheet.ContractId,
            "#revisao",
            Model.FromSource,
            Model.Year,
            Model.Month,
            Model.Scope,
            Model.Kind,
            Model.Urgency,
            Model.ViewId,
            Model.SelectedObligationId)
        : string.Empty;
}
@if (sheet is null)
{
    <div class="empty-state">
        <strong>Ficha indisponível</strong>
        <p>@(error ?? "O contrato não está acessível no contexto do usuário ou organização atual.")</p>
        <a class="button button-quiet" asp-controller="Inbox" asp-action="Index" asp-route-tenantId="@tenantId">Ir para a caixa operacional</a>
    </div>
    return;
}

<header class="renewal-heading">
    <div>
        <nav class="breadcrumb-trail" aria-label="Navegação estrutural">
            @if (Model.FromSource == "agenda")
            {
                <a asp-controller="Agenda" asp-action="Index" asp-route-tenantId="@tenantId"
                   asp-route-year="@Model.Year" asp-route-month="@Model.Month" asp-route-scope="@Model.Scope">← Agenda</a>
            }
            else
            {
                <a asp-controller="Inbox" asp-action="Index" asp-route-tenantId="@tenantId"
                   asp-route-scope="@Model.Scope" asp-route-kind="@Model.Kind" asp-route-urgency="@Model.Urgency" asp-route-viewId="@Model.ViewId">← Caixa operacional</a>
            }
            <span>/ Contratos</span>
        </nav>
        <div class="form-actions-row">
            <h1>@sheet.Title</h1>
            @if (sheet.HasImportAwaitingReview)
            {
                @if (sheet.ImportId.HasValue)
                {
                    <a class="chip-warning" asp-controller="Imports" asp-action="Review" asp-route-tenantId="@tenantId" asp-route-importId="@sheet.ImportId.Value">
                        <span class="status-label">Importação</span>
                        <span>Aguardando revisão</span>
                    </a>
                }
                else
                {
                    <a class="chip-warning" asp-controller="Imports" asp-action="Index" asp-route-tenantId="@tenantId" asp-route-awaitingReview="true">
                        <span class="status-label">Importação</span>
                        <span>Aguardando revisão</span>
                    </a>
                }
            }
        </div>
        <p class="muted">
            Situação: <strong>@sheet.Status</strong> ·
            Vigência: @(sheet.StartsOn?.ToString("dd/MM/yyyy") ?? "Início n/d") a @(sheet.EndsOn?.ToString("dd/MM/yyyy") ?? "Sem término") ·
            Tipo: @(sheet.ContractType ?? "Geral") ·
            Responsável: @(sheet.OwnerName ?? "Não atribuído") ·
            Versão otimista: @sheet.Version
        </p>
    </div>
</header>

<!-- SUBNAV STICKY COM ARIA-CURRENT -->
<nav class="sheet-subnav" aria-label="Seções da ficha">
    <a href="#obrigacoes">Obrigações</a>
    <a href="#renovacao">Renovação</a>
    <a href="#revisao">Revisão</a>
    <a href="#minutas">Minutas</a>
    <a href="#documentos">Documentos</a>
    <a asp-controller="Renewals" asp-action="Index" asp-route-tenantId="@tenantId" asp-route-counterparty="@sheet.Title">Central de renovações</a>
</nav>

@if (!string.IsNullOrWhiteSpace(notice))
{
    <div class="banner-notice-success" role="status">
        @notice
    </div>
}

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="validation-summary" role="alert">
        @error
    </div>
}

<!-- SEÇÃO RENOVAÇÃO -->
<section id="renovacao" class="renewal-cards" aria-label="Indicadores de vigência e renovação">
    <div>
        <strong>@(sheet.StartsOn?.ToString("dd/MM/yyyy") ?? "—")</strong>
        <span>Início da vigência</span>
    </div>
    <div>
        <strong>@(sheet.Renewal?.EndsOn?.ToString("dd/MM/yyyy") ?? "—")</strong>
        <span>Término da vigência</span>
    </div>
    <div>
        <strong>@(sheet.Renewal?.NoticeDueOn?.ToString("dd/MM/yyyy") ?? "—")</strong>
        <span>Aviso prévio limite</span>
    </div>
    <div>
        <strong>@(sheet.Renewal?.InThreeMonthWindow == true ? "Sim" : "Não")</strong>
        <span>Janela de 3 meses</span>
    </div>
</section>

<!-- PAINEL DE PROPOSTA DE RENOVAÇÃO / ADITIVO -->
<details class="filter-panel">
    <summary><strong>Registrar proposta de alteração ou renovação</strong> (Apenas proposta · Efeito em vigência somente na formalização)</summary>
    <form id="renewal-proposal-form" method="post" asp-action="CreateRenewalProposal" asp-route-tenantId="@tenantId" asp-route-contractId="@sheet.ContractId"
          asp-route-from="@Model.FromSource" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
          asp-route-scope="@Model.Scope" asp-route-kindFilter="@Model.Kind" asp-route-urgency="@Model.Urgency" asp-route-viewId="@Model.ViewId" asp-route-obrigacao="@Model.SelectedObligationId"
          class="form-grid">
        @Html.AntiForgeryToken()
        <input type="hidden" name="contractVersion" value="@sheet.Version" />
        
        <label>Tipo de alteração
            <select name="kind" required>
                @if (isAmendmentRequired)
                {
                    <option value="amendment" selected>Aditivo contratual (Obrigatório na janela)</option>
                }
                else
                {
                    <option value="renewal">Renovação de vigência</option>
                    <option value="amendment">Aditivo (alteração de escopo/valor/prazo)</option>
                }
            </select>
        </label>

        <label>Efeito a partir de (EffectiveOn)
            <input type="date" name="effectiveOn" value="@todayStr" required />
        </label>

        <label>Início proposto
            <input type="date" name="proposedStartDate" value="@(sheet.StartsOn?.ToString("yyyy-MM-dd"))" />
        </label>

        <label>Novo término proposto
            <input type="date" name="proposedEndDate" value="@(sheet.EndsOn?.AddYears(1).ToString("yyyy-MM-dd"))" />
        </label>

        <label>Responsável
            <select name="responsibleId" required>
                <option value="">Selecione um membro</option>
                @foreach (var m in Model.ActiveMembers)
                {
                    <option value="@m.UserId">@m.Name (@m.Email)</option>
                }
            </select>
        </label>

        <label>Valor proposto
            <input type="number" step="0.01" min="0" name="proposedValue" placeholder="0.00" />
        </label>

        <label>Moeda
            <input type="text" name="currency" maxlength="3" value="BRL" />
        </label>

        <label class="form-grid-full">Justificativa / Motivo da alteração
            <textarea name="reason" rows="2" required placeholder="Descreva o motivo da renovação ou alteração contratual"></textarea>
        </label>

        <div class="form-grid-full form-actions-row">
            <button class="button button-primary" type="button" data-confirm-open data-confirm-form="renewal-proposal-form"
                    data-confirm-title="Confirmar proposta de alteração"
                    data-confirm-body="Deseja registrar uma proposta de alteração/renovação para o contrato '@sheet.Title'? A proposta deixa de ser apenas intenção e altera a vigência somente quando formalizada e aplicada na Central de Renovações."
                    data-confirm-action="Registrar proposta">Registrar proposta</button>
            <a class="button button-quiet" asp-controller="Renewals" asp-action="Index" asp-route-tenantId="@tenantId" asp-route-counterparty="@sheet.Title">Ver na Central de Renovações</a>
            <span class="muted">Formalizar e aplicar exclusivamente na Central de Renovações (sem /apply na ficha).</span>
        </div>
    </form>
</details>

<!-- SEÇÃO REVISÃO E MINUTA EM ANDAMENTO -->
<section id="revisao" class="renewal-list">
    <div class="list-header">
        <h2>Revisão e Minuta em Andamento</h2>
        @if (sheet.DraftId.HasValue)
        {
            <div class="form-actions-row">
                <a class="button button-primary" href="/organizacoes/@tenantId/estudio/minutas/@sheet.DraftId.Value?returnUrl=@Uri.EscapeDataString(returnUrl)">
                    Abrir minuta no Estúdio
                </a>
                <a class="button button-quiet" href="/organizacoes/@tenantId/estudio/minutas/@sheet.DraftId.Value/checklist?version=@sheet.Version" target="_blank">
                    Checklist
                </a>
                <a class="button button-quiet" href="/organizacoes/@tenantId/estudio/comparar" target="_blank">
                    Comparar versões
                </a>
            </div>
        }
    </div>

    @if (sheet.CurrentReview is null)
    {
        <div class="empty-state">
            <strong>Nenhuma revisão formal aberta</strong>
            <p>Este contrato não possui fluxo de revisão em trâmite no momento.</p>
            @if (sheet.DraftId.HasValue)
            {
                <p class="muted">Você pode trabalhar no rascunho da minuta diretamente pelo Estúdio de Contratos.</p>
            }
        </div>
    }
    else
    {
        <div class="renewal-cards">
            <div>
                <strong>@sheet.CurrentReview.Status</strong>
                <span>Status da revisão</span>
            </div>
            <div>
                <strong>@(sheet.CurrentReview.CurrentReviewerName ?? "Sem revisor designado")</strong>
                <span>Revisor atual</span>
            </div>
            <div>
                <strong>@(sheet.CurrentReview.DueAt?.ToString("dd/MM/yyyy HH:mm") ?? "Sem prazo")</strong>
                <span>Prazo limite</span>
            </div>
        </div>
    }

    <!-- FORMULÁRIO DE ENCAMINHAMENTO DE REVISÃO -->
    @if (sheet.DraftId.HasValue)
    {
        <details class="filter-panel" @(sheet.CurrentReview is null ? "open" : "")>
            <summary><strong>Encaminhar versão para revisão formal</strong></summary>
            @if (Model.Versions.Count == 0)
            {
                <div class="empty-state">
                    <p>Nenhuma versão numerada foi gerada ainda para esta minuta.</p>
                    <a class="button button-quiet" href="/organizacoes/@tenantId/estudio/minutas/@sheet.DraftId.Value?returnUrl=@Uri.EscapeDataString(returnUrl)">
                        Gerar versão no Estúdio
                    </a>
                </div>
            }
            else
            {
                <form method="post" asp-action="SubmitReview" asp-route-tenantId="@tenantId" asp-route-contractId="@sheet.ContractId"
                      asp-route-from="@Model.FromSource" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
                      asp-route-scope="@Model.Scope" asp-route-kind="@Model.Kind" asp-route-urgency="@Model.Urgency" asp-route-viewId="@Model.ViewId" asp-route-obrigacao="@Model.SelectedObligationId"
                      class="form-grid">
                    @Html.AntiForgeryToken()
                    <label>Versão a revisar
                        <select name="generatedVersionId" required>
                            @foreach (var v in Model.Versions)
                            {
                                <option value="@v.Id">Versão @v.Number (@v.Status) — @v.Author</option>
                            }
                        </select>
                    </label>

                    <label>Revisor designado
                        <select name="reviewerId" required>
                            @foreach (var r in Model.Reviewers)
                            {
                                <option value="@r.Id">@r.Name</option>
                            }
                        </select>
                    </label>

                    <label>Prazo limite (opcional)
                        <input type="datetime-local" name="dueAt" />
                    </label>

                    <label class="form-grid-full">Instruções para o revisor
                        <textarea name="instructions" rows="2" placeholder="Ex.: Verificar cláusula de SLA e rescisão motivada"></textarea>
                    </label>

                    <div class="form-grid-full form-actions-row">
                        <button class="button button-primary" type="submit">Encaminhar para revisão</button>
                    </div>
                </form>
            }
        </details>
    }

    <!-- COMENTÁRIOS NO RASCUNHO -->
    @if (sheet.DraftId.HasValue)
    {
        <details class="filter-panel" open>
            <summary><strong>Comentários contextuais na minuta</strong> <span class="muted">(Comentário não equivale à aprovação formal)</span></summary>
            <div>
                <form method="post" asp-action="AddComment" asp-route-tenantId="@tenantId" asp-route-contractId="@sheet.ContractId"
                      asp-route-from="@Model.FromSource" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
                      asp-route-scope="@Model.Scope" asp-route-kind="@Model.Kind" asp-route-urgency="@Model.Urgency" asp-route-viewId="@Model.ViewId" asp-route-obrigacao="@Model.SelectedObligationId"
                      class="form-stack">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="draftId" value="@sheet.DraftId.Value" />
                    <input type="hidden" name="draftRevision" value="@sheet.Version" />
                    <label>Referência (cláusula ou seção)
                        <input type="text" name="reference" placeholder="Ex.: Cláusula 3.2" maxlength="100" />
                    </label>
                    <label>Comentário
                        <textarea name="body" rows="2" required placeholder="Insira seu apontamento operacional"></textarea>
                    </label>
                    <div>
                        <button class="button button-quiet" type="submit">Adicionar comentário</button>
                    </div>
                </form>

                @if (Model.Comments.Count > 0)
                {
                    <div class="form-stack">
                        @foreach (var comment in Model.Comments)
                        {
                            <div class="comment-card">
                                <div class="list-header">
                                    <div>
                                        <strong>@comment.Author</strong>
                                        <span class="status-badge @(comment.Resolved ? "status-approved" : "status-pending")">
                                            @(comment.Resolved ? "Resolvido" : "Pendente")
                                        </span>
                                        <span class="muted">Ref: @comment.Reference</span>
                                    </div>
                                    <small class="muted">@comment.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                                </div>
                                <p>@comment.Body</p>
                                <div class="form-actions-row">
                                    <form id="comment-state-form-@comment.Id" method="post" asp-action="ChangeCommentState" asp-route-tenantId="@tenantId" asp-route-contractId="@sheet.ContractId"
                                          asp-route-draftId="@sheet.DraftId.Value" asp-route-commentId="@comment.Id" asp-route-operation="@(comment.Resolved ? "reopen" : "resolve")"
                                          asp-route-from="@Model.FromSource" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
                                          asp-route-scope="@Model.Scope" asp-route-kind="@Model.Kind" asp-route-urgency="@Model.Urgency" asp-route-viewId="@Model.ViewId" asp-route-obrigacao="@Model.SelectedObligationId">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="currentResolved" value="@comment.Resolved.ToString().ToLowerInvariant()" />
                                        <button class="button button-quiet" type="button" data-confirm-open data-confirm-form="comment-state-form-@comment.Id"
                                                data-confirm-title="@(comment.Resolved ? "Reabrir apontamento" : "Resolver apontamento")"
                                                data-confirm-body="Deseja realmente @(comment.Resolved ? "reabrir a pendência" : "resolver o apontamento") '@comment.Reference'?"
                                                data-confirm-action="@(comment.Resolved ? "Reabrir pendência" : "Marcar como resolvido")">
                                            @(comment.Resolved ? "Reabrir pendência" : "Marcar como resolvido")
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </details>
    }
</section>

<!-- SEÇÃO OBRIGAÇÕES -->
<section id="obrigacoes" class="renewal-list">
    <div class="list-header">
        <h2>Obrigações contratuais</h2>
        <div class="form-actions-row">
            <a class="button button-quiet" asp-controller="Obligations" asp-action="Index" asp-route-tenantId="@tenantId" asp-route-contractId="@sheet.ContractId">Ver na central de obrigações</a>
            <span>@sheet.OpenObligations.Count aberta(s)</span>
        </div>
    </div>

    <!-- FORMULÁRIO DE NOVA OBRIGAÇÃO -->
    <details class="filter-panel">
        <summary><strong>+ Adicionar nova obrigação para este contrato</strong></summary>
        <form id="create-obligation-form" method="post" asp-action="CreateObligation" asp-route-tenantId="@tenantId" asp-route-contractId="@sheet.ContractId"
              asp-route-from="@Model.FromSource" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
              asp-route-scope="@Model.Scope" asp-route-kind="@Model.Kind" asp-route-urgency="@Model.Urgency" asp-route-viewId="@Model.ViewId" asp-route-obrigacao="@Model.SelectedObligationId"
              class="form-grid">
            @Html.AntiForgeryToken()
            <label>Título da obrigação
                <input type="text" name="title" required maxlength="160" placeholder="Ex.: Entrega de relatório mensal" />
            </label>
            <label>Parte devedora / obrigada
                <input type="text" name="obligatedParty" required maxlength="120" placeholder="Ex.: Contratada" />
            </label>
            <label>Categoria
                <select name="category" required>
                    <option value="delivery">Entrega</option>
                    <option value="document">Documento</option>
                    <option value="renewal">Renovação</option>
                    <option value="communication">Comunicação</option>
                    <option value="financial">Obrigação financeira</option>
                    <option value="other">Outra</option>
                </select>
            </label>
            <label>Prioridade
                <select name="priority" required>
                    <option value="low">Baixa</option>
                    <option value="normal" selected>Normal</option>
                    <option value="high">Alta</option>
                    <option value="critical">Crítica</option>
                </select>
            </label>
            <label>Prazo de cumprimento
                <input type="date" name="dueDate" required value="@todayStr" />
            </label>
            <label>Responsável interno
                <select name="ownerId" required>
                    <option value="">Selecione o responsável</option>
                    @foreach (var m in Model.ActiveMembers)
                    {
                        <option value="@m.UserId">@m.Name (@m.Email)</option>
                    }
                </select>
            </label>
            <label>Valor (se financeira)
                <input type="number" step="0.01" min="0" name="amount" placeholder="0.00" />
            </label>
            <label>Moeda
                <input type="text" name="currency" maxlength="3" value="BRL" />
            </label>
            <label class="form-grid-full">Justificativa pós-vigência (obrigatória se o prazo for posterior ao término @(sheet.EndsOn?.ToString("dd/MM/yyyy") ?? "não informado"))
                <input type="text" name="postTermReason" maxlength="500" placeholder="Justifique o dever posterior ao término" />
            </label>
            <label class="form-grid-full check-line">
                <input type="checkbox" name="evidenceRequired" value="true" />
                <span>Exigir evidência documental segura anexada para cumprimento</span>
            </label>
            <label class="form-grid-full">Instruções ou descrição
                <textarea name="description" rows="2" placeholder="Detalhes operacionais para o cumprimento"></textarea>
            </label>
            <div class="form-grid-full">
                <button class="button button-primary" type="button"
                        data-confirm-open data-confirm-form="create-obligation-form"
                        data-confirm-title="Confirmar criação de obrigação"
                        data-confirm-body="Deseja criar a obrigação para o contrato '@sheet.Title'? Ela ficará disponível na caixa operacional após criação."
                        data-confirm-action="Criar obrigação">Criar obrigação</button>
            </div>
        </form>
    </details>

    @if (sheet.OpenObligations.Count == 0)
    {
        <div class="empty-state">
            <strong>Nenhuma obrigação pendente</strong>
            <p>Todas as obrigações deste contrato foram cumpridas ou não há pendências cadastradas.</p>
        </div>
    }
    else
    {
        @foreach (var item in sheet.OpenObligations)
        {
            var isSelected = Model.SelectedObligationId == item.SourceId;
            <article class="renewal-row @(isSelected ? "urgent" : null)">
                <div>
                    <span class="status-label">@item.Urgency · @item.Status</span>
                    <h3>@item.Title</h3>
                    <p>Responsável: <strong>@(item.OwnerName ?? "Não atribuído")</strong></p>
                </div>
                <dl>
                    <div>
                        <dt>Prazo</dt>
                        <dd>@(item.DueOn?.ToString("dd/MM/yyyy") ?? "Sem data")</dd>
                    </div>
                </dl>
                <div class="form-actions-row">
                    <!-- BOTÃO HISTÓRICO (DRAWER) -->
                    <button type="button" class="button button-quiet btn-history-drawer"
                            data-id="@item.SourceId" data-title="@item.Title">
                        Ver histórico
                    </button>

                    <!-- AÇÃO INICIAR -->
                    @if (item.Status == "open")
                    {
                        <form id="start-form-@item.SourceId" method="post" asp-action="PerformObligationAction" asp-route-tenantId="@tenantId" asp-route-contractId="@sheet.ContractId" asp-route-id="@item.SourceId" asp-route-operation="start"
                              asp-route-from="@Model.FromSource" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
                              asp-route-scope="@Model.Scope" asp-route-kind="@Model.Kind" asp-route-urgency="@Model.Urgency" asp-route-viewId="@Model.ViewId" asp-route-obrigacao="@Model.SelectedObligationId">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="version" value="@item.Version" />
                            <button class="button button-quiet" type="button"
                                    data-confirm-open data-confirm-form="start-form-@item.SourceId"
                                    data-confirm-title="Confirmar início da obrigação"
                                    data-confirm-body="Deseja iniciar a obrigação '@item.Title'?"
                                    data-confirm-action="Iniciar">Iniciar</button>
                        </form>
                    }

                    <!-- AÇÃO CUMPRIR -->
                    <details>
                        <summary class="button button-quiet">Cumprir</summary>
                        <div class="details-subpanel">
                            <form id="fulfill-form-@item.SourceId" method="post" asp-action="PerformObligationAction" asp-route-tenantId="@tenantId" asp-route-contractId="@sheet.ContractId" asp-route-id="@item.SourceId" asp-route-operation="fulfill"
                                  asp-route-from="@Model.FromSource" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
                                  asp-route-scope="@Model.Scope" asp-route-kind="@Model.Kind" asp-route-urgency="@Model.Urgency" asp-route-viewId="@Model.ViewId" asp-route-obrigacao="@Model.SelectedObligationId"
                                  class="form-stack">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="version" value="@item.Version" />
                                <label>Data de efetivação (vazio = fuso da organização)
                                    <input type="date" name="effectiveAt" value="@todayStr" />
                                </label>
                                <label>Documento de evidência (versão segura)
                                    <select name="evidenceDocumentVersionId">
                                        <option value="">Sem anexo</option>
                                        @foreach (var doc in sheet.Documents.Where(d => d.SafetyState == "safe"))
                                        {
                                            <option value="@doc.VersionId">@doc.Name</option>
                                        }
                                    </select>
                                </label>
                                <label>Nota de cumprimento
                                    <input type="text" name="note" placeholder="Observações" />
                                </label>
                                <button class="button button-primary" type="button" data-confirm-open data-confirm-form="fulfill-form-@item.SourceId"
                                        data-confirm-title="Confirmar cumprimento"
                                        data-confirm-body="Deseja registrar o cumprimento da obrigação '@item.Title'?"
                                        data-confirm-action="Confirmar cumprimento">Confirmar cumprimento</button>
                            </form>
                        </div>
                    </details>

                    <!-- AÇÃO REAGENDAR -->
                    <details>
                        <summary class="button button-quiet">Reagendar</summary>
                        <div class="details-subpanel">
                            <form id="reschedule-form-@item.SourceId" method="post" asp-action="PerformObligationAction" asp-route-tenantId="@tenantId" asp-route-contractId="@sheet.ContractId" asp-route-id="@item.SourceId" asp-route-operation="reschedule"
                                  asp-route-from="@Model.FromSource" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
                                  asp-route-scope="@Model.Scope" asp-route-kind="@Model.Kind" asp-route-urgency="@Model.Urgency" asp-route-viewId="@Model.ViewId" asp-route-obrigacao="@Model.SelectedObligationId"
                                  class="form-stack">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="version" value="@item.Version" />
                                <label>Novo prazo
                                    <input type="date" name="dueDate" required />
                                </label>
                                <label>Motivo do reagendamento
                                    <input type="text" name="reason" required placeholder="Justificativa" />
                                </label>
                                <button class="button button-primary" type="button"
                                        data-confirm-open data-confirm-form="reschedule-form-@item.SourceId"
                                        data-confirm-title="Confirmar reagendamento"
                                        data-confirm-body="Deseja reagendar a obrigação '@item.Title'?"
                                        data-confirm-action="Reagendar">Reagendar</button>
                            </form>
                        </div>
                    </details>

                    <!-- AÇÃO REATRIBUIR -->
                    <details>
                        <summary class="button button-quiet">Reatribuir</summary>
                        <div class="details-subpanel">
                            <form id="reassign-form-@item.SourceId" method="post" asp-action="PerformObligationAction" asp-route-tenantId="@tenantId" asp-route-contractId="@sheet.ContractId" asp-route-id="@item.SourceId" asp-route-operation="reassign"
                                  asp-route-from="@Model.FromSource" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
                                  asp-route-scope="@Model.Scope" asp-route-kind="@Model.Kind" asp-route-urgency="@Model.Urgency" asp-route-viewId="@Model.ViewId" asp-route-obrigacao="@Model.SelectedObligationId"
                                  class="form-stack">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="version" value="@item.Version" />
                                <label>Novo responsável
                                    <select name="ownerId" required>
                                        <option value="">Selecione</option>
                                        @foreach (var m in Model.ActiveMembers.Where(m => m.UserId != item.OwnerId))
                                        {
                                            <option value="@m.UserId">@m.Name</option>
                                        }
                                    </select>
                                </label>
                                <label>Motivo da reatribuição
                                    <input type="text" name="reason" required placeholder="Justificativa" />
                                </label>
                                <button class="button button-primary" type="button"
                                        data-confirm-open data-confirm-form="reassign-form-@item.SourceId"
                                        data-confirm-title="Confirmar reatribuição"
                                        data-confirm-body="Deseja reatribuir a obrigação '@item.Title' para outro responsável?"
                                        data-confirm-action="Reatribuir">Reatribuir</button>
                            </form>
                        </div>
                    </details>

                    <!-- AÇÃO CANCELAR -->
                    <details>
                        <summary class="button button-quiet">Cancelar</summary>
                        <div class="details-subpanel">
                            <form id="cancel-form-@item.SourceId" method="post" asp-action="PerformObligationAction" asp-route-tenantId="@tenantId" asp-route-contractId="@sheet.ContractId" asp-route-id="@item.SourceId" asp-route-operation="cancel"
                                  asp-route-from="@Model.FromSource" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
                                  asp-route-scope="@Model.Scope" asp-route-kind="@Model.Kind" asp-route-urgency="@Model.Urgency" asp-route-viewId="@Model.ViewId" asp-route-obrigacao="@Model.SelectedObligationId"
                                  class="form-stack">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="version" value="@item.Version" />
                                <label>Motivo do cancelamento
                                    <input type="text" name="reason" required placeholder="Justificativa" />
                                </label>
                                <button class="button button-danger" type="button" data-confirm-open data-confirm-form="cancel-form-@item.SourceId"
                                        data-confirm-title="Confirmar cancelamento"
                                        data-confirm-body="Deseja realmente cancelar a obrigação '@item.Title'?"
                                        data-confirm-action="Confirmar cancelamento">Confirmar cancelamento</button>
                            </form>
                        </div>
                    </details>
                </div>
            </article>
        }
    }
</section>

<!-- SEÇÃO MINUTAS SUGERIDAS -->
<section id="minutas" class="renewal-list">
    <div class="list-header">
        <h2>Minutas operacionais sugeridas</h2>
        @if (sheet.CanInstallOfficialLibrary)
        {
            <form id="install-library-form" method="post" asp-action="InstallOfficialLibrary" asp-route-tenantId="@tenantId" asp-route-contractId="@sheet.ContractId"
                  asp-route-from="@Model.FromSource" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
                  asp-route-scope="@Model.Scope" asp-route-kind="@Model.Kind" asp-route-urgency="@Model.Urgency" asp-route-viewId="@Model.ViewId" asp-route-obrigacao="@Model.SelectedObligationId">
                @Html.AntiForgeryToken()
                <button class="button button-primary" type="button"
                        data-confirm-open data-confirm-form="install-library-form"
                        data-confirm-title="Instalar biblioteca oficial"
                        data-confirm-body="Deseja instalar os modelos oficiais de minutas para o tenant? Modelos já instalados não serão duplicados."
                        data-confirm-action="Instalar biblioteca">Instalar biblioteca oficial</button>
            </form>
        }
    </div>
    <p class="muted">
        Modelos são pontos de partida operacionais recomendados pelo contexto contratual. Revisar antes de usar; não constituem parecer jurídico nem garantia de conformidade.
    </p>

    @if (sheet.RecommendedTemplates is null || sheet.RecommendedTemplates.Count == 0)
    {
        <div class="empty-state">
            <strong>Nenhuma minuta sugerida no momento</strong>
            <p>Enquanto houver revisão aberta fora da janela de renovação, minutas primárias são ocultadas.</p>
        </div>
    }
    else
    {
        @foreach (var template in sheet.RecommendedTemplates)
        {
            <article class="renewal-row">
                <div>
                    <span class="status-label">@template.ContractType</span>
                    <h3>@template.Name</h3>
                    <p>@template.Reason</p>
                </div>
                <div class="form-actions-row">
                    <form id="draft-form-@template.Key" method="post" asp-action="StartOfficialDraft" asp-route-tenantId="@tenantId" asp-route-contractId="@sheet.ContractId"
                          asp-route-from="@Model.FromSource" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
                          asp-route-scope="@Model.Scope" asp-route-kind="@Model.Kind" asp-route-urgency="@Model.Urgency" asp-route-viewId="@Model.ViewId" asp-route-obrigacao="@Model.SelectedObligationId">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="officialKey" value="@template.Key" />
                        <input type="hidden" name="sheetVersion" value="@sheet.Version" />
                        <button class="button button-primary" type="button"
                                data-confirm-open data-confirm-form="draft-form-@template.Key"
                                data-confirm-title="Gerar rascunho oficial"
                                data-confirm-body="Deseja criar um rascunho de '@template.Name' para o contrato '@sheet.Title'? A minuta será aberta no Estúdio para preenchimento e revisão."
                                data-confirm-action="Gerar rascunho">Gerar rascunho oficial</button>
                    </form>
                    <a class="button button-quiet" asp-controller="Studio" asp-action="Index" asp-route-tenantId="@tenantId" asp-route-type="@template.ContractType">Ver no Estúdio</a>
                </div>
            </article>
        }
    }
</section>

<!-- SEÇÃO DOCUMENTOS RECENTES -->
<section id="documentos" class="renewal-list">
    <div class="list-header">
        <h2>Documentos recentes</h2>
        <span>@sheet.Documents.Count documento(s)</span>
    </div>
    @if (sheet.Documents.Count == 0)
    {
        <p class="muted">Nenhum documento anexado a este contrato.</p>
    }
    else
    {
        @foreach (var document in sheet.Documents)
        {
            <article class="renewal-row">
                <div>
                    <span class="status-label">@document.SafetyState</span>
                    <h3>@document.Name</h3>
                </div>
                <dl>
                    <div>
                        <dt>Última atualização</dt>
                        <dd>@document.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</dd>
                    </div>
                </dl>
                <div class="next-action">
                    @if (document.SafetyState == "safe")
                    {
                        <a class="button button-quiet"
                           asp-controller="Contracts" asp-action="DownloadDocument"
                           asp-route-tenantId="@tenantId" asp-route-contractId="@sheet.ContractId"
                           asp-route-documentId="@document.DocumentId" asp-route-versionId="@document.VersionId"
                           asp-route-from="@Model.FromSource" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
                           asp-route-scope="@Model.Scope" asp-route-kind="@Model.Kind" asp-route-urgency="@Model.Urgency" asp-route-viewId="@Model.ViewId">Baixar</a>
                    }
                    else
                    {
                        <span class="status-label muted" title="Documento em análise de segurança. Download indisponível.">Quarentena</span>
                    }
                </div>
            </article>
        }
    }
</section>

<!-- DRAWER DE HISTÓRICO DE OBRIGAÇÕES -->
<div id="history-backdrop" class="history-drawer-backdrop" hidden></div>
<aside id="history-drawer" class="history-drawer" aria-labelledby="history-drawer-title" aria-modal="true" role="dialog" hidden>
    <div class="history-drawer-header">
        <h3 id="history-drawer-title">Histórico da obrigação</h3>
        <button type="button" id="history-drawer-close" class="button button-quiet" aria-label="Fechar histórico">✕</button>
    </div>
    <div id="history-drawer-subtitle" class="muted"></div>
    <div id="history-drawer-content" role="region" aria-live="polite">
        <p class="muted">Carregando histórico...</p>
    </div>
</aside>

<script>
document.addEventListener('DOMContentLoaded', () => {
    // Subnav sticky com aria-current
    function updateSubnavActive() {
        const hash = window.location.hash || '#obrigacoes';
        document.querySelectorAll('.sheet-subnav a').forEach(link => {
            const href = link.getAttribute('href');
            if (href && href.startsWith('#')) {
                if (href === hash) {
                    link.setAttribute('aria-current', 'true');
                    link.classList.add('active');
                } else {
                    link.removeAttribute('aria-current');
                    link.classList.remove('active');
                }
            }
        });
    }
    window.addEventListener('hashchange', updateSubnavActive);
    updateSubnavActive();

    // Drawer de histórico seguro
    const backdrop = document.getElementById('history-backdrop');
    const drawer = document.getElementById('history-drawer');
    const closeBtn = document.getElementById('history-drawer-close');
    const content = document.getElementById('history-drawer-content');
    const subtitle = document.getElementById('history-drawer-subtitle');

    function closeDrawer() {
        if (backdrop) backdrop.hidden = true;
        if (drawer) drawer.hidden = true;
    }

    closeBtn?.addEventListener('click', closeDrawer);
    backdrop?.addEventListener('click', closeDrawer);
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && drawer && !drawer.hidden) {
            closeDrawer();
        }
    });

    document.querySelectorAll('.btn-history-drawer').forEach(btn => {
        btn.addEventListener('click', async () => {
            const id = btn.getAttribute('data-id');
            const title = btn.getAttribute('data-title');
            if (!id) return;

            if (subtitle) subtitle.textContent = title || '';
            if (content) content.textContent = 'Carregando histórico...';
            if (backdrop) backdrop.hidden = false;
            if (drawer) drawer.hidden = false;

            try {
                const response = await fetch(`/organizacoes/@tenantId/obrigacoes/${id}/historico`);
                if (!content) return;
                content.textContent = '';

                if (response.status === 403) {
                    const alert = document.createElement('div');
                    alert.className = 'validation-summary';
                    alert.textContent = 'Acesso restrito: você não possui permissão para visualizar o histórico desta obrigação (somente o responsável ou usuários com tenant.obligations.read_all).';
                    content.appendChild(alert);
                    return;
                }

                if (response.status === 404) {
                    const p = document.createElement('p');
                    p.className = 'muted';
                    p.textContent = 'Histórico não encontrado ou obrigação excluída.';
                    content.appendChild(p);
                    return;
                }

                if (!response.ok) {
                    const p = document.createElement('p');
                    p.className = 'muted';
                    p.textContent = 'Não foi possível consultar o histórico no momento.';
                    content.appendChild(p);
                    return;
                }

                const data = await response.json();
                const items = data.events || data.Items || [];
                if (items.length === 0) {
                    const p = document.createElement('p');
                    p.className = 'muted';
                    p.textContent = 'Nenhum evento registrado até o momento.';
                    content.appendChild(p);
                    return;
                }

                const list = document.createElement('div');
                list.className = 'form-stack';

                items.forEach(ev => {
                    const card = document.createElement('article');
                    card.className = 'comment-card';

                    const header = document.createElement('div');
                    header.className = 'list-header';

                    const typeSpan = document.createElement('strong');
                    typeSpan.textContent = ev.eventType || ev.EventType || 'Evento';
                    header.appendChild(typeSpan);

                    const dateSpan = document.createElement('small');
                    dateSpan.className = 'muted';
                    const dt = ev.occurredAt || ev.OccurredAt;
                    dateSpan.textContent = dt ? new Date(dt).toLocaleString('pt-BR') : '';
                    header.appendChild(dateSpan);

                    card.appendChild(header);

                    const actorP = document.createElement('p');
                    const actorBold = document.createElement('strong');
                    actorBold.textContent = ev.actor || ev.Actor || 'Sistema';
                    actorP.appendChild(document.createTextNode('Por: '));
                    actorP.appendChild(actorBold);
                    card.appendChild(actorP);

                    const details = ev.details || ev.Details;
                    if (details) {
                        const detP = document.createElement('div');
                        detP.className = 'muted';
                        detP.textContent = typeof details === 'string' ? details : JSON.stringify(details);
                        card.appendChild(detP);
                    }

                    list.appendChild(card);
                });

                content.appendChild(list);
            } catch (err) {
                if (content) content.textContent = 'Erro ao carregar o histórico.';
            }
        });
    });
});
</script>
