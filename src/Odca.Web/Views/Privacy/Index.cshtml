@model PrivacyRequestViewModel
@{
    var _culture = (string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey];
    ViewData["Title"] = L.T("priv.title", _culture);
}
<section class="narrow">
    <div class="card">
        <p class="eyebrow">@L.T("priv.public_channel", _culture)</p>
        <h1>@L.T("priv.title", _culture)</h1>
        <p class="muted">@L.T("priv.intro", _culture)</p>

        <details class="help-card"><summary>@L.T("common.how_to_use", _culture)</summary><p>@L.T("priv.manual_body", _culture)</p></details>

        @if (Model.Protocol is not null)
        {
            <div class="success" role="status">
                <strong>@L.T("priv.received", _culture)</strong>
                <p>@Model.ConfirmationMessage</p>
                <p>@L.T("priv.protocol", _culture) <code>@Model.Protocol</code></p>
            </div>
            <a class="button button-link" asp-action="Index">@L.T("priv.open_another", _culture)</a>
        }
        else
        {
            <form method="post" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="validation" role="alert"></div>
                <label for="Email">@L.T("priv.email_label", _culture)</label>
                <input asp-for="Email" autocomplete="email" />
                <span asp-validation-for="Email" class="validation"></span>

                <label for="RequestType">@L.T("priv.type_label", _culture)</label>
                <select asp-for="RequestType">
                    <option value="">@L.T("common.select", _culture)</option>
                    <option value="access">@L.T("priv.type_access", _culture)</option>
                    <option value="correction">@L.T("priv.type_correction", _culture)</option>
                    <option value="sharing">@L.T("priv.type_sharing", _culture)</option>
                    <option value="portability">@L.T("priv.type_portability", _culture)</option>
                    <option value="blocking">@L.T("priv.type_blocking", _culture)</option>
                    <option value="deletion">@L.T("priv.type_deletion", _culture)</option>
                    <option value="revocation">@L.T("priv.type_revocation", _culture)</option>
                    <option value="review">@L.T("priv.type_review", _culture)</option>
                </select>
                <span asp-validation-for="RequestType" class="validation"></span>

                <label for="Details">@L.T("priv.details_label", _culture)</label>
                <textarea asp-for="Details" rows="6"></textarea>
                <span asp-validation-for="Details" class="validation"></span>
                <p class="muted">@L.T("priv.details_hint", _culture)</p>

                <button class="button button-primary" type="submit">@L.T("priv.submit", _culture)</button>
            </form>
        }

        <p class="muted privacy-note">@L.T("priv.contact_note", _culture)</p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
