@model Odca.Contracts.Administration.SlaPolicyRow[]
@using Odca.Contracts.Administration
@{
    var _c = (string?)Context.Items[Odca.Web.Middleware.CultureMiddleware.ItemsKey];
    ViewData["Title"] = L.T("configuracoes-operacionais", _c);
    string PlanLabel(string value) => value switch { "basic" => "Basic", "intermediate" => L.T("reg.plan_intermediate", _c), "enterprise" => "Enterprise", _ => value };
    string ServiceLabel(string value) => value switch { "revisao" => L.T("platform.sla_svc_revisao", _c), "adaptacao" => L.T("platform.sla_svc_adaptacao", _c), "esclarecimento" => L.T("platform.sla_svc_esclarecimento", _c), "suporte_tecnico" => L.T("platform.sla_svc_suporte", _c), _ => value };
    string PriorityLabel(string value) => value switch { "baixa" => L.T("common.prio_low", _c), "normal" => L.T("common.prio_normal", _c), "alta" => L.T("common.prio_high", _c), "critica" => L.T("common.prio_critical", _c), _ => value };
    string Hours(int minutes) => minutes % 60 == 0 ? $"{(minutes / 60d).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)} h" : $"{minutes} min";
    var order = new Dictionary<string, int> { ["baixa"] = 0, ["normal"] = 1, ["alta"] = 2, ["critica"] = 3 };
    var rows = Model.OrderBy(r => r.PlanCode).ThenBy(r => r.Service).ThenBy(r => order.GetValueOrDefault(r.Priority, 99)).ToArray();
}
<nav class="breadcrumb" aria-label="@L.T("common.breadcrumb_aria",_c)"><a asp-controller="Home" asp-action="Index">@L.T("visao-global",_c)</a><span>/</span><span aria-current="page">@L.T("configuracoes-operacionais",_c)</span></nav>
<header class="page-heading"><div><p class="eyebrow">@L.T("support.eyebrow",_c)</p><h1>@L.T("platform.sla_h1",_c)</h1><p>@L.T("platform.sla_intro",_c)</p></div></header>
<div class="responsive-table panel"><table>
<thead><tr><th>@L.T("platform.sla_th_plan",_c)</th><th>@L.T("platform.sla_th_service",_c)</th><th>@L.T("platform.sla_th_priority",_c)</th><th>@L.T("platform.sla_th_first",_c)</th><th>@L.T("platform.sla_th_resolution",_c)</th><th>@L.T("platform.sla_th_window",_c)</th><th>@L.T("platform.sla_th_calendar",_c)</th><th>@L.T("common.situation",_c)</th></tr></thead>
<tbody>
@foreach(var row in rows)
{
    <tr>
      <td data-label="@L.T("platform.sla_th_plan",_c)">@PlanLabel(row.PlanCode)</td>
      <td data-label="@L.T("platform.sla_th_service",_c)">@ServiceLabel(row.Service)</td>
      <td data-label="@L.T("platform.sla_th_priority",_c)">@PriorityLabel(row.Priority)</td>
      <td data-label="@L.T("platform.sla_th_first",_c)">@Hours(row.FirstResponseMinutes)</td>
      <td data-label="@L.T("platform.sla_th_resolution",_c)">@Hours(row.ResolutionMinutes)</td>
      <td data-label="@L.T("platform.sla_th_window",_c)">@row.BusinessStart–@row.BusinessEnd</td>
      <td data-label="@L.T("platform.sla_th_calendar",_c)">@(row.Calendar == "dias_uteis" ? L.T("admin.sla_business_days",_c) : L.T("platform.sla_calendar_continuous",_c))</td>
      <td data-label="@L.T("common.situation",_c)"><span class="status-badge">@(row.Enabled ? L.T("platform.sla_st_active",_c) : L.T("platform.sla_st_disabled",_c))</span></td>
    </tr>
}
</tbody>
</table></div>
<details class="help-card"><summary>@L.T("platform.sla_help_title",_c)</summary><p>@L.T("platform.sla_help_body",_c)</p></details>
